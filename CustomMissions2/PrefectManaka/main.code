#################################
# Settings
#################################
enableLog = true

#################################
# Code
#################################
if _save.progress == null
	_save.progress = 0

prefect = CreateThread("prefect")

prefect:
	thread = _this
	thread.Goto("initialize")

	missionPanel = CreateMissionPanel()
	messengerChat = CreateMessengerChat("PrefectManaka")

	showMP:
		if mp == null
			mp = missionPanel
		if progress == null
			mp.SetGaugeVisible(false)
		else
			mp.SetGaugeProgress(progress)
			mp.SetGaugeVisible(true)

		if rp == null
			rp = ""
		mp.SetRPText(rp)

		if text == null
			mp.SetVisible(false)
		else
			mp.SetText(text)
			mp.SetVisible(true)

	timedDisplay:
		if mp == null
			mp = CreateMissionPanel()
			mp.SetText(text)
			mp.SetGaugeVisible(true)
			mp.SetVisible(true)
		if t == null
			t = 0
		t = t + _timediff
		if t < duration
			mp.SetGaugeProgress(t / duration)
		else
			mp.SetVisible(false)

	waitCondition:
		if duration == null
			duration = 0
		if maxDuration == null
			maxDuration = 0
		if condition.Check()
			duration = duration + _timediff
			if duration >= maxDuration
				thread.Goto(next)
		else
			if reset
				duration = 0
		if maxDuration > 0
			mp.SetGaugeProgress(duration/maxDuration)

	waitConditionFail:
		if !condition.Check()
			thread.Goto(next)
		if zone != null
			if !zone.Inside()
				thread.Goto(next)

	waitConditionInZone:
		if duration == null
			duration = 0
		if maxDuration == null
			maxDuration = 0
		if zone.Inside()
			if condition.Check()
				duration = duration + _timediff
				zone.SetColor(0.5, 1, 0.5)
				if duration >= maxDuration
					zone.SetVisible(false)
					thread.Goto(next)
			else
				if reset
					duration = 0
				zone.SetColor(1, 1, 0.5)
			if maxDuration > 0
				mp.SetGaugeProgress(duration/maxDuration)
		else
			zone.SetColor(1, 0.75, 0.5)
			if reset
				duration = 0

	waitClick:
		if index == null
			index = 0
		if messengerChat.Clicked() == index
			thread.Goto(next)

	waitStage:
		if _state.Position.stage == stage
			thread.Goto(next)

	waitStageChange:
		if _stagechanged
			thread.Goto(next)

	initialize:
		if enableLog
			Log("prefect: initialize")
		cp = "cp" + _save.progress + "pre"
		thread.Goto(cp)

