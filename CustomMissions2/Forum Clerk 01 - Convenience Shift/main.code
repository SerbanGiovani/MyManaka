			lastzone.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）大腿出了汗，丝袜贴着皮肤。空调风钻进夹克下面，凉得我腿根发紧。", duration=6.0))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）如果把丝袜也脱掉，脚步声会不会变轻？还是我的心跳会变得更吵？", duration=5.6))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="stocking_interact")
	
	stocking_interact:
		missionpanel.SetText("把丝袜留在杂志架旁")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		stocking_prompt_area = CreateInteractArea(stage="Convenience", x=-2.1, y=0.12, z=-14.15, r=0.45, text="脱下丝袜")
		
		wait_stocking_prompt:
			if stocking_prompt_area.Check()
				SetAction("TakeOffPants")
				stocking_off_sound.Play()
				missionpanel.SetVisible(false)
				thread.Goto("stocking_takeoff_wait")
		listener = CreateListenerLocal("wait_stocking_prompt")
	
	stocking_takeoff_wait:
		listener = CreateListenerLocal("wait_listener", duration=2.6, nextcheckpoint="stocking_after")
	
	stocking_after:
		UnequipCosplay("m_cosplay_suit_chic_stocking")
		SetAction("None")
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）空气直接碰到腿上，凉意细细地爬上来。我突然觉得自己比刚才更没有退路。", duration=6.0))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, text="鞋子还在。至少走路的声音还正常。", duration=3.5))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）可我已经开始讨厌这个“至少”了。", duration=3.6))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="stocking_hip_shake")
	
	stocking_hip_shake:
		area = CreateArea(type="sphere", stage="Convenience", x=-2.0, y=0.12, z=-13.95, r=0.75)
		zone = CreateZone(area)
		condition = CreateCondition(hip_shake_condition_text)
		missionpanel.SetText("脱掉丝袜后，扶着货架扭动屁股")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(true)
		listener = CreateListenerLocal("generic_listener", nextcheckpoint="go_light", maxduration=4, panelmode=2, reset=true)
	
	go_light:
		area = CreateArea(type="sphere", stage="Convenience", x=-3.18, y=0.12, z=-8.97, r=0.8)
		zone = CreateZone(area)
		condition = CreateCondition("[!Cosplay_m_cosplay_suit_chic_shirt,!Cosplay_m_cosplay_suit_chic_skirt,!Cosplay_m_cosplay_suit_chic_stocking,Cosplay_m_cosplay_suit_chic_shoes]")
		missionpanel.SetText("前往货架灯下：走到冷白灯最亮的位置")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(true)
		listener = CreateListenerLocal("move_to_zone_listener", nextcheckpoint="shoes_prompt")
	
	shoes_prompt:
