	work_delivery:
		if lastzone != null
			lastzone.SetVisible(false)
		missionpanel.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）我站在工作位旁，把想象中的商品放到台面上。手还没有停。", duration=5.0))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）这个动作太荒唐了。可正因为像工作的一部分，才让我更不敢相信自己正在享受。", duration=6.6))
		sd.Insert(SP_Ecstasy(key="jump", value=0.9))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, text="停下……现在必须停下。", duration=2.8))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）可是越想停，越像把自己推到了最后一步。", duration=4.0))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="climax")
	
	climax:
