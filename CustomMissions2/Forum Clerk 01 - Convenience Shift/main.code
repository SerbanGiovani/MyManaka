		SetAction("None")
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）现在我下面是光溜溜的了。布料从腿边离开的感觉轻得吓人，也刺激得让我差点忘了呼吸。", duration=7.0))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）还要经过门口。希望他们不会发现。没想到，我会做出这样大胆的事。", duration=6.4))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="return_work_pee")
	
