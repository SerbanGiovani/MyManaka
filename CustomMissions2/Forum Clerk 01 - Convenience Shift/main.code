		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）白色衬衣重新贴到身上，我终于像一点店员了。可正因为被遮住了，那个念头反而更清楚。", duration=6.6))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）突然想尝试更大胆的事情。只要下面没有内裤，就不会弄湿。现在停下还来得及……可是我不想停。", duration=7.6))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="pre_pee_panties_prompt")
	
