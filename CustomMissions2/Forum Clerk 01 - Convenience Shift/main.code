			lastzone.SetVisible(false)
		missionpanel.SetText("把鞋子留在货架灯下")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		shoes_prompt_area = CreateInteractArea(stage="Convenience", x=-3.0, y=0.12, z=-8.72, r=0.45, text="脱下鞋子")
		
