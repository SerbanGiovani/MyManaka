		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		recover_skirt_area = CreateInteractArea(stage="Convenience", x=-0.95, y=0.12, z=-12.2, r=0.45, text="穿回裙子")
		
		wait_recover_skirt:
			if recover_skirt_area.Check()
				EquipCosplay("m_cosplay_suit_chic_skirt")
				missionpanel.SetVisible(false)
				thread.Goto("recover_skirt_done")
		listener = CreateListenerLocal("wait_recover_skirt")
	
	recover_skirt_done:
		if lastzone != null
			lastzone.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）裙子重新遮住身体的时候，我才意识到自己刚才胆子有多大。不是被谁推着，是我自己一步步走到这里的。", duration=6.8))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）衬衫早就穿回去了。现在看起来终于又完整了，可我已经知道这身制服下面藏过什么。", duration=6.8))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）最后回收银台，把论坛草稿发出去。不是给谁看，只是怕明天醒来以后，我会假装这一切没发生过。", duration=7.0))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="forum_post")
	
	recover_shirt:
		area = CreateArea(type="sphere", stage="Convenience", x=-2.95, y=0.12, z=-8.1, r=0.7)
		zone = CreateZone(area)
		condition = CreateCondition("Action_None")
		missionpanel.SetText("返回冷饮柜找回衬衫")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(true)
		listener = CreateListenerLocal("move_to_zone_listener", nextcheckpoint="recover_shirt_prompt")
	
	recover_shirt_prompt:
		if lastzone != null
			lastzone.SetVisible(false)
		missionpanel.SetText("穿回衬衫")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		recover_shirt_area = CreateInteractArea(stage="Convenience", x=-2.95, y=0.12, z=-8.1, r=0.45, text="穿回衬衫")
		
		wait_recover_shirt:
			if recover_shirt_area.Check()
				EquipCosplay("m_cosplay_suit_chic_shirt")
				missionpanel.SetVisible(false)
				thread.Goto("recover_shirt_done")
		listener = CreateListenerLocal("wait_recover_shirt")
	
	recover_shirt_done:
		if lastzone != null
			lastzone.SetVisible(false)
		missionpanel.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）制服终于恢复完整。镜子里又是那个无聊的便利店员，可我已经知道她无聊起来会做什么。", duration=6.6))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）最后回收银台，把论坛草稿发出去。不是给谁看，只是怕明天醒来以后，我会假装这一切没发生过。", duration=7.0))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="forum_post")
	
	forum_post:
		area = CreateArea(type="sphere", stage="Convenience", x=1.27, y=0.12, z=-6.75, r=1.05)
		zone = CreateZone(area)
		condition = CreateCondition("Action_None")
		missionpanel.SetText("回到收银台，写下今晚的记录")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(true)
		listener = CreateListenerLocal("move_to_zone_listener", nextcheckpoint="forum_post_done")
	
	forum_post_done:
		if lastzone != null
			lastzone.SetVisible(false)
		missionpanel.SetVisible(false)
		camDir = Vector3Rotate(_state.Camera, Vector(0,0,1))
		snapshotobject = CreateSnapshot(position = _state.Camera, direction = camDir, width = 512, height = 512, fov = 60)
		_save.final_selfie_file = snapshotobject.Save(hidden = false)
		snapshotobject = null
		chat.Add("草稿：营业中的便利店。我本来只是想让夜班不那么无聊。结果我差一点认不出自己。", "Right", user="Manaka", silent=true)
		chat.Add("我盯着发送按钮看了很久，最后还是想给这条记录留下一个证据。", "Right", user="Manaka", silent=true)
		chat.SetButtons("继续发帖")
		missionpanel.SetText("打开手机论坛，继续发帖")
		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		listener = CreateListenerLocal("wait_final_forum_button")
	
	wait_final_forum_button:
		if chat.Clicked() == 0
			chat.SetButtons()
			missionpanel.SetVisible(false)
			chat.Add("补一句：我已经把制服穿回去了，店里也恢复得像什么都没发生。可是手还在抖。", "Right", user="Manaka", silent=true)
			chat.Add("附一张自拍。只露到这里就够了。", "Right", user="Manaka", silent=true)
			thread.Goto("final_forum_selfie")
	
	final_forum_selfie:
		file = _save.final_selfie_file
		chat.Add(file, "Right", user="Manaka", silent=true)
		chat.Add("发送。", "Right", user="Manaka", silent=true)
		
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）下班路上，夜风一吹，我才真正开始后怕。刚才要是有人走近，要是我慢了一秒……", duration=6.6))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）可是害怕里混着一点甜得发麻的东西。我不想承认，却已经开始回想每一步。", duration=6.4))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）屏幕暗下去以后，我把手机贴在胸口。不是后悔，只是不敢立刻再看自己发出去的东西。", duration=6.2))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="finish")
	
	finish:
		SetAction("None")
		CollectItem(itemtype="Coat")
		missionpanel.SetVisible(false)
		_save.checkpoint = 0
		npc_thinner_thread.Stop()
		subtitle_thread = null
		ecstasy_thread = null

	start_subtitles_and_wait:
		manager.Start(data=data)
		_result = CreateListenerLocal("subtitle_listener", manager=manager, nextstep=nextstep)
