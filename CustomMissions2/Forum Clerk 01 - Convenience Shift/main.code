		orgasmsound.Play()
		SetAction("None")
		sd = CreateList()
		sd.Insert(SP_Ecstasy(key="orgasm", value=2))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）世界一下子缩成柜台、灯光和自己急促的呼吸。我咬住嘴唇，身体还是忍不住发抖。", duration=6.2))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）我真的在上班的时候做完了。这个事实慢慢落下来，重得让我站不稳。", duration=6.2))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, text="先收拾好。快点。", duration=2.7))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="recovery_intro")
	
