		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(true)
		bus.flags["ecstasy.clamp"] = CreateList(min=0.35, max=0.9)
		listener = CreateListenerLocal("generic_listener", nextcheckpoint="pee_urgency", maxduration=8, panelmode=2, reset=true)
	
	pee_urgency:
		if lastzone != null
			lastzone.SetVisible(false)
		SetAction("None")
		missionpanel.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）刚站起来，腹部忽然一紧。不是兴奋过去了，是另一种更现实、更糟糕的急迫追了上来。", duration=6.2))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）如果就这样尿出来，内裤一定会湿。那样太明显了。果然还是先把衬衣穿上比较好……衬衣能挡住吗？", duration=7.4))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）这样不会被发现吧。不会的。只是回去整理一下工作区。只是这样而已。", duration=5.8))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="pre_pee_recover_shirt")
	
	pre_pee_recover_shirt:
		area = CreateArea(type="sphere", stage="Convenience", x=-2.95, y=0.12, z=-8.1, r=0.7)
