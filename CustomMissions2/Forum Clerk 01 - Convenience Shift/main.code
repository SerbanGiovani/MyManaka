		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）脚底刚碰到瓷砖，凉意就从脚心往上窜。我差点发出声音。", duration=5.2))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）没有丝袜，也没有鞋，只有夹克和名牌还在撑着我的店员身份。", duration=6.5))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）到这里就够了吧。可是身体像已经记住了刚才的节奏，根本不想听我说够了。", duration=6.0))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="light_touch")
	
	light_touch:
		area = CreateArea(type="sphere", stage="Convenience", x=-3.18, y=0.12, z=-8.97, r=0.8)
		zone = CreateZone(area)
