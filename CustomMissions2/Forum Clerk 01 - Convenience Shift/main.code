		missionpanel.SetVisible(true)
		missionpanel.SetGaugeVisible(false)
		pre_pee_shirt_area = CreateInteractArea(stage="Convenience", x=-2.95, y=0.12, z=-8.1, r=0.45, text="穿上衬衫")
		
