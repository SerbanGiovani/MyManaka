		missionpanel.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）店里的一切都和平时一样。货架、收银台、冰柜、门铃。只有我知道刚才发生了什么。", duration=6.3))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, text="（内心）兴奋退下去以后，害怕才慢慢追上来。我得把路线倒着走一遍，把自己拼回普通店员的样子。", duration=7.0))
