createrLongOrgasm_:
	#Note Event: List must have:
	# common: List see 'event.common'

	create:
		#Required
		#Returns event: List
		
		event = CreateList()
		event.common = CreateList()
		event.common.requiredProcessor = "processorLongOrgasm"
		event.common.name = StringsPool2.LongOrgasmString
		event.common.description = RandomString("LongOrgasm", StringsPool0)
		event.common.duration = Random(5, 11)
		event.common.delay = 9
		_result = event