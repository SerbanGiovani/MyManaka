adjustorRest_:
	#Note Event: List must have:
	# common： List see 'event.common'

	adjust:
		#Required
		#Params@arr event: List
		#Returns event: List
		event = _args[0]
		if _save.level == 0
			event.common.duration = event.common.duration * 1.45
		if _save.level > 1
			event.common.duration = event.common.duration * 0.75
		_result = event
