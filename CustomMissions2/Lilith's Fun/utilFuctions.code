GetWornCosplays:
	#Returns wornCosplays: List
	i = 0
	count = _state.Cosplay.Count()
	data = CreateList()
	while i < count
		cosplayItem = _state.Cosplay[i]
		# Keep going until we hit a duplicate entry
		if cosplayItem != _state.Cosplay[i+1]
			#Check if the item is actually worn
			if _state.Cosplay[cosplayItem] == true
				data.Insert(cosplayItem)
			i = i + 1
		# Quit once we have duplicate entries
		else
			i = count       
			if _state.Cosplay[cosplayItem] == true
				data.Insert(cosplayItem)
	_result = data

Foreach:
	#Params list: List, behaviour: Object
	#Note Behaviour must have fuction 'do' with params@key value: Any, and returns flag: Bool If flag is null, traverse next. If result is false, terminate the traversal of subsequent elements. If flag is true, skip next element
	#Note It returns current index when terminates traversal
	if list == null
		list = _args[0]
	if behaviour == null
		behaviour = _args[1]
	i = 0
	flag = null
	count = list.Count()
	while i < count
		flag = behaviour.do(value = list[i])
		if flag == null
			i = i + 1
		else
			if flag
				i = i + 2
			else
				_result = i
				i = count
	if _result == null
		_result = count

For:
	#Params list: List, behaviour: Object
	#Returns index: Number
	#Note Behaviour must implement the 'do' method. This method accepts params@key value: Any and returns result: Number|Bool, with the following rules for the return value:
	# result is false: Terminate the traversal of subsequent elements.
	# result is true: Restart the traversal.
	# result is a number in the open interval (1, -1) (i.e., -1 < result < 1): Skip subsequent elements according to the overall proportion.
	# result is any other integer: Skip of subsequent elements according to count.
	# result is null: traverse next
	#Note It returns current index when terminates traversal
	if list == null
		list = _args[0]
	if behaviour == null
		behaviour = _args[1]
	i = 0
	iterateFator = null
	count = list.Count()
	while i < count
		iterateFator = behaviour.do(value = list[i])
		if iterateFator != null
			if GetType(iterateFator) == "Number"
				if iterateFator < 1 && iterateFator > (-1)
					i = i + Floor(count * iterateFator)
				else
					i = i + Floor(iterateFator)
				if i < 0
					i = 0
			else
				if iterateFator
					i = 0
				else
					_result = i
					i = count
		else
			i = i + 1
	if _result == null
		_result = count

LocatePlayer:
	#Returns playerLocationVector: List
	p = _state.Position
	v = Vector(p.x,p.y,p.z)
	_result = v

LocateNpc:
	#Params npcPositon: List
	#Returns npcLocationVector: List
	if npcPositon == null
		p = _args[0]
	v = Vector(p.x,p.y,p.z)
	_result = v

SqrDistance:
	#Params v1: List, v2: List
	#Returns SqrDistance: Number
	if v1 == null
		v1 = _args[0]
	if v2 == null
		v2 = _args[1]
	_result = Vector3SqrLength(Vector3Sub(v1, v2))

ClearList:
	#Params list: List
	if list == null
		list = _args[0]
	list.Remove(index = 0, count = list.Count())
