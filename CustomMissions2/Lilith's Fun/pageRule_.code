pageRule_:
	chatter = null #Required
	requestQueue = null #Required
	callList = CreateList("__processDetailRule","__processBack")
	buttons = CreateList(StringsPool2.DetailRuleButtonString,StringsPool2.BackButtonString)

	exitFlag = false

	init:
		#Required
		#Params@arr newChatter: Object, newRequestQueue: Object
		newChatter = _args[0]
		newRequestQueue = _args[1]
		if newChatter != null && (newRequestQueue != null)
			chatter = newChatter
			requestQueue = newRequestQueue

	initUI:
		#Required
		if _state.Position.stage == "Apart"
			exitFlag = false
			chatter.Add(StringsPool1.CoreRuleString,"Left",user = StringsPool2.LilithString, silent = true)
			chatter.SetButtons(buttons)
		else
			exitFlag = true

	updateUI:
		#Required
		buttonIndex = chatter.Clicked()
		if buttonIndex != null && (!exitFlag)
			CallFunction(callList[buttonIndex])

	tryNextPage:
		#Required
		#Returns nextPageKey: String
		if exitFlag
			if _state.Position.stage == "Apart"
				_result = "pageMain"
			else
				_result = "pageNoConfig"

	__processDetailRule:
		chatter.Clear()
		chatter.Add(StringsPool1.CoreRuleString,"Left",user = StringsPool2.LilithString, silent = true)
		chatter.Add(StringsPool1.DetailRuleString,"Left",user = StringsPool2.SystemString, silent = true)

	__processBack:
		exitFlag = true