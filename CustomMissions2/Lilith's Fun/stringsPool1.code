StringsPool1 = CreateList()

StringsPool1.AnnoyedString0 = "You actually think this petty little trick can pull the wool over my eyes? I won't cough up any penny now!"
StringsPool1.AnnoyedString1 = "Do you think I’m blind? This half-assed trickery reeks of desperation. Save it—no cash for something this mind-numbingly boring!"
StringsPool1.AnnoyedString2 = "Cut the act! Your scheme’s as transparent as glass, and I’m not in the mood to humor it. No coins, no mercy!!"
StringsPool1.AnnoyedString3 = "Pitiful—this sad little stunt is even lamer than watching beggars beg. Not a single coin will I drop for you!"
StringsPool1.AnnoyedStringCount = 4


StringsPool1.WelcomeString0 = "So when do I get some real fun around here? Don’t sweat the cash—unless you’re trying to cheat me, by some stupid way, that is."
StringsPool1.WelcomeString1 = "Good,something that might not put me to sleep! Cash is just spare change to me, but try to swindle me, and you’ll regret crossing Lilith."
StringsPool1.WelcomeString2 = "You’ve got my attention at last! Spare me the cheap tricks—entertain me proper, and the coins will flow. But cheat me? Let’s just say I don’t forget slights."
StringsPool1.WelcomeString3 = "Oh? This might actually be fun—what a surprise! The purse is open… as long as you don’t pull the same garbage as the last fool who tried to con me."
StringsPool1.WelcomeStringCount = 4


StringsPool1.FailureString = " has gone down the drain…"
StringsPool1.FailureCalcString = "Only award "
StringsPool1.CalcString = " has been stuffed into your wallet~"


StringsPool1.stopString = "Emm… Back home. You don't have any qualification to amuse me.\n[You must reach max rank, and have all vibrators, eye mask, normal handcuff, all pistons.]"


StringsPool1.CoreRuleString = "Are you that desperate for my money? Ok~Ok~ First, listen my law—that's I'll toy with you any way I please! If you put on a good show and entertain me, the coins will stuff into your wallet, and the longer you last, the fatter your wallet gets~ I've got plenty of money, but I won't waste a penny on boring bugs. So don't think about cheating! Now, let's hurry up and get out here, to have fun!!"

StringsPool1.DetailRuleString = "[Prerequisites:\n* Reach the max rank and have all necessary items.\n* Disable all cheats (Skills: Time Stop, X-Ray Vision, Casual Anywhere and those two Invincibility Skills; Items: Body Paint, Invisibility Potion). Otherwise, Lilith will be annoyed!\n\nChallenge & Persistence:\n* Endure as long as you can under Lilith's teasing—dare to pull off high-risk actions to earn more RP! (If you really can't hold on, find a way to head back home.)\n\nRandom Events:\n* Lilith will constantly trigger random events, so stay ready with your countermeasures!\n* Events appear in the bottom-left corner with a countdown, and each refresh triggers with a short delay.\n* During this delay, Lilith will display her \"kind reminders\" at the top of the screen.\n\nRP Settlement:\n* Claim 100% of total RP if you successfully return home, 35% if you fail, and 0% if Lilith is annoyed.\n\nDetail RP Calculation:\n* uRP: Increases over time within NPC areas or in NPC's sight. Grows faster with fewer cosplays, higher detection levels, and more extreme actions (has a cap)!\n* base RP: Active within NPC areas. Higher uRP and more complete exposure result in higher values.\n* multi.: Multiplier. Higher with fewer cosplays, higher detection levels, and more extreme actions.\n* Accumulated per second: base RP × multi. → Added to total RP.]"

StringsPool1.ReadyString = "Show me everything you’ve got and amuse me properly."
StringsPool1.HelpString = "If you can't hold on, just send me a message, but you'll fail."
StringsPool1.UpLevelString = "Not bad—you’ve got some tricks up your sleeve. Then I won’t hold back."
StringsPool1.DownLevelString = "Already this scared? Hmm~ Alright, I’ll go easier on you."
StringsPool1.MaxLevelString = "Sure about that?! Hmm… Don’t go crying later~"
StringsPool1.CurrentLevelString = "Difficulty Level: "
StringsPool1.InitChatterString = "Anything?"


StringsPool1.Level0String = "[* 3 event slots.\n * Empty event lasts long and appear frequently.\n * Event Cosplays Holiday will allow some cosplays.\n * Event has plenty delay\n * Event Handcuff Locked lasts short.\n * Event Surprising Teleport and Someones Coming is disabled.\n * Event Cat And Mouse generates npc with low speed and he's difficult to catch you.\n * Event Seducing Charm makes npc's alertness rise slowly.\n * multi.×0.7, uRP×0.7, max uRP×1.2, base RP×1]"
StringsPool1.Level1String = "[* 3 event slots.\n * Empty events won't last too long and appear not so frequently.\n * Event Cosplays Holiday may not allow any cosplay.\n * Event has tight delay.\n * Event Cat And Mouse generates npc with normal speed.\n * Event Seducing Charm makes npc's alertness rise normally.\n * multi.×1, uRP×1, max uRP×1.5, base RP×1]"
StringsPool1.Level2String = "[* 4 event slots.\n * Empty event lasts short and appear infrequently.\n * Event Cosplays Holiday may not allow any cosplay.\n * Event has very tight delay.\n * Event Cat And Mouse generates npc with high speed and he's easy to catch you.\n * Event Seducing Charm makes npc's alertness rise quickly.\n * multi.×1.6, uRP×2.0, max uRP×2, base RP×1.1]"
StringsPool1.Level3String = "[* 5 event slots.\n * Empty event lasts short and aren't repeatable.\n * Event Cosplays Holiday won’t allow any cosplay.\n * Event has very tight delay.\n * Event Cat And Mouse generates npc with very high speed and he's very easy to catch you.\n * Event Seducing Charm makes npc's alertness rise very quickly.\n * multi.×1.6, uRP×3.2, max uRP×3, base RP×1.6]"


StringsPool1.StartPromptString0 = "Finally gonna start? Hurry and shoot me a message the second you're all set!"
StringsPool1.StartPromptString1 = "Don't scared and hurry up. Get prepped. Call me, and let me enjoy for a little while."
StringsPool1.StartPromptString2 = "Be quick! Don't make me wait all day! We can kick things off whenever you say~"
StringsPool1.StartPromptStringCount = 3