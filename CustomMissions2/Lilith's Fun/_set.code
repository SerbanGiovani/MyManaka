RecordSet:
	#Note Highly efficient,but only usable for String or Number types.
	valueGapCount = 0
	valueGaps = CreateList()
	length = 0
	values = CreateList()
	valueIndexes = CreateList()

	Contains:
		#Params value
		#Returns isInSet: Bool
		if value == null
			value = _args[0]
		if __IsValidValue(value)
			if valueIndexes[value] != null
				_result = true
			else
				_result = false

	Insert:
		#Params value: String|Number
		if value == null
			value = _args[0]
		if __IsValidValue(value)
			if valueIndexes[value] == null
				lastValueGapIndex = valueGapCount - 1
				if lastValueGapIndex >= 0
					valueGap = valueGaps[lastValueGapIndex]
					valueGaps[lastValueGapIndex] = null
					valueGapCount = lastValueGapIndex
					values[valueGap] = value
					valueIndexes[value] = valueGap
				else
					values[length] = value
					valueIndexes[value] = length
					length = length + 1

	InsertList:
		#Params valueList: List
		if valueList == null
			valueList = _args[0]
		if __IsList(valueList)
			i = 0
			count = valueList.Count()
			while i < count
				Insert(valueList[i])
				i = i + 1

	Remove:
		#Params value: String|Number
		if value == null
			value = _args[0]
		if __IsValidValue(value)
			valueIndex = valueIndexes[value]
			if valueIndex != null
				lastValueIndex = length - 1
				if valueIndex != lastValueIndex
					valueGaps[valueGapCount] = valueIndex
					valueGapCount = valueGapCount + 1
				else
					length = length - 1
				valueIndexes[value] = null
				values[valueIndex] = null

	RemoveList:
		#Params list: List
		if valueList == null
			valueList = _args[0]
		if __IsList(valueList)
			i = 0
			count = list.Count()
			while i < count
				Remove(valueList[i])
				i = i + 1

	Random:
		#Returns value: String|Number
		if length - valueGapCount > 0
			ClearGaps()
			r = RandomInt(0, length)
			_result = list[r]

	Clear:
		i = 0
		while i < length
			value = values[i]
			values[i] = null
			valueIndexes[value] = null
			i = i + 1
		valueGaps.Remove(index = 0, count = valueGapCount)
		valueGapCount = 0
		length = 0

	GetValues:
		#Returns values: List
		data = CreateList()
		i = 0
		while i < length
			value = values[i]
			if value != null
				data.Insert(value)
			i = i + 1
		_result = data

	GetCount:
		#Returns countOfValues: Number
		_result = length - valueGapCount

	ClearGaps:
		#Note Consider calling this method periodically to reduce fragmented space.
		while valueGapCount > 0
			reader = length - 1
			value = values[reader]
			if value != null
				valueGapCount = valueGapCount - 1
				valueGap = valueGaps[valueGapCount]
				valueGaps.Remove()
				if reader > valueGap
					values[valueGap] = value
					valueIndexes[value] = valueGap
					values.Remove()
					length = reader
			else
				length = reader

	__IsList:
		#Params@arr list: Any
		#Returns isList: Bool
		list = _args[0]
		if list != null
			type = GetType(list)
			if type == "List"
				_result = true
			else
				_result = false
		else
			_result = false

	__IsValidValue:
		#Params@arr value: Any
		#Returns isStringOrNumber: Bool
		value = _args[0]
		if value != null
			type = GetType(value)
			if type == "String" || type == "Number"
				_result = true
			else
				_result = false
		else
			_result = false





ArraySet:
	#Note Suitable for any data type, but with lower efficiency.
	values = CreateList()
	count = 0
	Contains:
		#Params value
		#Returns isInSet: Bool
		if value == null
			value = _args[0]
		if value != null
			i = 0
			count = values.Count()
			while i < count
				if values[i] == value
					_result = true
					i = count
				i = i + 1
			if i == count
				_result = false
		else
			_result = false

	Random:
		#Returns value: Any
		if count > 0
			r = RandomInt(0, count)
			_result = values[r]

	Insert:
		#Params value: Any
		if value == null
			value = _args[0]
		if value != null && !Contains(value)
			values.Insert(value)
			count = count + 1

	InsertList:
		#Params list: List
		if valueList == null
			valueList = _args[0]
		if __IsList(valueList)
			i = 0
			count0 = valueList.Count()
			while i < count0
				Insert(valueList[i])
				i = i + 1

	Remove:
		#Params value: String|Number
		if value == null
			value = _args[0]
		if value != null
			i = 0
			targetIndex = -1
			count = values.Count()
			while i < count
				if values[i] == value
					targetIndex = i
					i = count
				i = i + 1
			if targetIndex >= 0
				values.Remove(targetIndex)
				count = count - 1

	RemoveList:
		#Params valueList: List
		if valueList == null
			valueList = _args[0]
		if __IsList(valueList)
			i = 0
			count0 = valueList.Count()
			while i < count0
				Remove(valueList[i])
				i = i + 1

	Clear:
		values.Remove(index = 0, count = count)
		count = 0

	GetValues:
		#Returns values: List
		data = Copy(values, true)
		_result = data

	GetCount:
		#Returns countOfValues: Number
		_result = count

	__IsList:
		#Params@arr list: Any
		#Returns isList: Bool
		list = _args[0]
		if list != null
			type = GetType(list)
			if type == "List"
				_result = true
			else
				_result = false
		else
			_result = false