processorEcstasyCurse_:
	#Note Event: List must have:
	# negWeight: Number
	# stayWeight: Number
	# posWeight: Number
	# maxNegRate: Number
	# maxPosRate: Number
	# interval: Number
	# common： List see 'event.common'
	timer = 0
	start:
		#Required
		#Params@arr event: List
		timer = 0

	end:
		#Required
		#Params@arr event: List

	update:
		#Required
		#Params@arr event: List
		event = _args[0]
		if timer >= event.interval
			event = _args[0]
			totalWeight = event.negWeight + event.posWeight + event.stayWeight
			r = Random(0, totalWeight)
			rate = 0
			progress = 0
			progress = progress + event.negWeight
			if progress >= r
				rate = __calcRate(event.maxNegRate)
			else
				progress = progress + event.posWeight
				if progress >= rate
					rate = __calcRate(event.maxPosRate)
			AddEcstasy(rate * _timediff)
		timer = timer +_timediff

	__calcRate:
		#Params@arr maxRate: Number
		#Returns rate: Number
		maxRate = _args[0]
		a = Random(1, 6)
		a = 1 / a
		_result = a * maxRate
