createrSurprisingAction_:
	#Note Event: List must have:
	# action: String
	# duration: Number
	# interval: Number
	# chance: Number
	# exclusive: Object(RecordSet, record excluded actions)
	# common： List, see 'event.common'

	create:
		#Required
		#Returns event: List
		
		event = CreateList()
		event.common = CreateList()
		event.common.requiredProcessor = "processorSurprisingAction"
		event.common.name = StringsPool2.SurprisingActionString
		event.common.description = RandomString("SurprisingAction", StringsPool0)
		event.common.duration = Random(50, 80)
		event.action = "GanimataWalk"
		event.duration =  Random(4, 8)
		event.interval = Random(15, 20)
		event.chance = Random(0.15, 0.35)
		event.exclusive = CreateThread("RecordSet")
		event.exclusive.Insert("SexStandBack")
		event.exclusive.Insert("SexKijoui")
		_result = event

