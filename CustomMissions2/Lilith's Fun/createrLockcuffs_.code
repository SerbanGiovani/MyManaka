createrLockcuffs_:
	#Note Event: List must have:
	# common: List see 'event.common'

	create:
		#Required
		#Returns event: List
		
		event = CreateList()
		event.common = CreateList()
		event.common.requiredProcessor = "processorLockcuffs"
		event.common.name = StringsPool2.LockcuffsString
		event.common.description = RandomString("Lockcuffs", StringsPool0)
		event.common.duration = Random(25, 45)
		_result = event