	tm_zone4.SetColor(1,0.2,0.2)

	tm_area5 = CreateArea(type="sphere", stage="Residence", x=9.17, y=-0.10, z=-78.70, r=2.5, outline=true, compass=false)
	tm_zone5 = CreateZone(tm_area5)
	tm_zone5.SetVisible(false)
	tm_zone5.SetColor(1,0.2,0.2)

	tm_area6 = CreateArea(type="sphere", stage="Residence", x=8.47, y=-0.10, z=-102.42, r=3, outline=true, compass=false)
	tm_zone6 = CreateZone(tm_area6)
	tm_zone6.SetVisible(false)
	tm_zone6.SetColor(1,0.2,0.2)

	tm_area8 = CreateArea(type="sphere", stage="Residence", x=33.18, y=-0.22, z=-78.91, r=3.5, outline=true, compass=false)
	tm_zone8 = CreateZone(tm_area8)
	tm_zone8.SetVisible(false)
	tm_zone8.SetColor(1,0.2,0.2)

	tm_area14 = CreateArea(type="sphere", stage="Residence", x=-9.57, y=-0.10, z=-78.74, r=2.5, outline=true, compass=false)
	tm_zone14 = CreateZone(tm_area14)
	tm_zone14.SetVisible(false)
	tm_zone14.SetColor(1,0.2,0.2)

	# Safe preparation location.
	tm_area17 = CreateArea(type="sphere", stage="Residence", x=-30.28, y=-0.11, z=-111.89, r=2, outline=true, compass=false)
	tm_zone17 = CreateZone(tm_area17)
	tm_zone17.SetVisible(false)
	tm_zone17.SetColor(0.2,0.65,1)

	# Dynamic upper-left Energy overlay.
	tm_energy_overlay = CreateText()
	tm_energy_overlay.SetAnchor(0.11, 0.935)
	tm_energy_overlay.SetAlignment("TopLeft")
	tm_energy_overlay.SetSize(27)
	tm_energy_overlay.SetWidth(520)
	tm_energy_overlay.SetFace(dilate=0.3)
	tm_energy_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_energy_overlay.SetFrontLayer(true)
	tm_energy_overlay.Clear()

	tm_energy_overlay_alt = CreateText()
	tm_energy_overlay_alt.SetAnchor(0.11, 0.935)
	tm_energy_overlay_alt.SetAlignment("TopLeft")
	tm_energy_overlay_alt.SetSize(27)
	tm_energy_overlay_alt.SetWidth(520)
	tm_energy_overlay_alt.SetFace(dilate=0.3)
	tm_energy_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_energy_overlay_alt.SetFrontLayer(true)
	tm_energy_overlay_alt.Clear()

	# Dynamic top-center Round and countdown overlay.
	tm_status_overlay = CreateText()
	tm_status_overlay.SetAnchor(0.51, 0.90)
	tm_status_overlay.SetAlignment("Top")
	tm_status_overlay.SetSize(25)
	tm_status_overlay.SetWidth(500)
	tm_status_overlay.SetFace(dilate=0.3)
	tm_status_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_status_overlay.SetFrontLayer(true)
	tm_status_overlay.Clear()

	tm_status_overlay_alt = CreateText()
	tm_status_overlay_alt.SetAnchor(0.51, 0.90)
	tm_status_overlay_alt.SetAlignment("Top")
	tm_status_overlay_alt.SetSize(25)
	tm_status_overlay_alt.SetWidth(500)
	tm_status_overlay_alt.SetFace(dilate=0.3)
	tm_status_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_status_overlay_alt.SetFrontLayer(true)
	tm_status_overlay_alt.Clear()

	# Reserved blue-zone overlay for future special location missions.
	tm_special_overlay = CreateText()
	tm_special_overlay.SetAnchor(0.04, 0.82)
	tm_special_overlay.SetAlignment("TopLeft")
	tm_special_overlay.SetSize(24)
	tm_special_overlay.SetWidth(620)
	tm_special_overlay.SetFace(dilate=0.3)
	tm_special_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_special_overlay.SetFrontLayer(true)
	tm_special_overlay.Clear()

	tm_special_overlay_alt = CreateText()
	tm_special_overlay_alt.SetAnchor(0.04, 0.82)
	tm_special_overlay_alt.SetAlignment("TopLeft")
	tm_special_overlay_alt.SetSize(24)
	tm_special_overlay_alt.SetWidth(620)
	tm_special_overlay_alt.SetFace(dilate=0.3)
	tm_special_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	tm_special_overlay_alt.SetFrontLayer(true)
	tm_special_overlay_alt.Clear()

	tm_reward_overlay_timer = 0
	tm_reward_overlay = CreateText()
	tm_reward_overlay.SetAnchor(0.5, 0.5)
	tm_reward_overlay.SetAlignment("Top")
	tm_reward_overlay.SetSize(36)
	tm_reward_overlay.SetWidth(1200)
	tm_reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	tm_reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	tm_reward_overlay.SetFrontLayer(true)
	tm_reward_overlay.Clear()

	tm_listener = CreateListenerLocal("update")
	Log("ManakaPlus v2: Teleporting Madness module loaded.")

	Start:
		CleanupRuntime()
		tm_active = true
		tm_completed_signal = false
		tm_finish_message = ""
		tm_energy = tm_start_energy
		effective_max_energy = GetEffectiveMaxEnergy()
		if tm_energy > effective_max_energy
			tm_energy = effective_max_energy
		tm_round = 0
		tm_time_left = tm_prepare_duration
		tm_current_zone = 17
		tm_zone_grace = 0.75
		tm_rp_bank = 0
		tm_rp_last_total = GetCurrentEarnRP()
		tm_overlay_timer = 0
		tm_overlay_flip = 0
		tm_force_timer = 0
		tm_coat_displaced = false
		tm_coat_punished_ever = false
		tm_remote_displaced = false
		tm_remote_punished_ever = false
		tm_remote_move_pending = false
		tm_remote_drop_index = 0
		tm_vibrator_forced = false
		tm_vibrator_applied = false
		tm_eyemask_forced = false
		tm_coat_drop_index = 0
		tm_instant_multiplier = 1.2
		tm_special_visible = true
		tm_special_overlay_flip = 0
		tm_naked_recharge_timer = 0
		tm_peeing_recharge_timer = 0
		tm_accumulator_timer = 0
		tm_orgasm_was_active = tm_condition_orgasm.Check()
		tm_first_normal_free = true
		tm_daylight_start = tm_condition_daytime.Check()
		tm_difficulty_mp_bonus = GetTotalMPBonus()
		tm_endless_completed_rounds = 0
		tm_endless_rp_reward = 0
		tm_endless_mp_reward = 0
		HideAllZones()
		safe_position = GetZonePosition(index=17)
		SetPlayerPosition(position=safe_position)
		tm_zone17.SetVisible(true)
		UpdateOverlays()
		UpdateSpecialOverlay()

	Reset:
		tm_active = false
		tm_reward_overlay_timer = 0
		tm_reward_overlay.Clear()
		tm_completed_signal = false
		tm_finish_message = ""
		CleanupRuntime()

	ResetDifficulty:
		tm_total_rounds = 10
		tm_endless = false
		tm_teleport_duration = 45
		tm_start_energy = 72
		tm_max_energy = 120
		tm_rp_required = 40
		tm_rp_energy_gain = 8

	IsActive:
		_result = tm_active

	ConsumeCompleted:
		_result = tm_completed_signal
		tm_completed_signal = false

	GetFinishMessage:
		_result = tm_finish_message

	GlobalCancel:
		if tm_active
			if tm_endless
				EndEndlessMission()
			else
				tm_active = false
				CleanupRuntime()

	GetMissionText:
		if tm_endless
			_result = "在各区域间随机传送，并且不能离开传送区域。谨慎计算能量，尽可能坚持更多轮次\n奖励：根据完成轮数计算"
		else
			_result = "在各区域间随机传送，并且不能离开传送区域。谨慎计算能量并坚持 " + tm_total_rounds + " 轮\n奖励：150 RP + 150 Manaka 点数"

	GetRulesText:
		_result = "屏幕左上角会出现名为“传送能量（TE）”的新界面，默认初始值为 72\n\n每次普通传送消耗 " + tm_teleport_cost + " 点传送能量，初始安全区倒计时与第一次普通传送免费\n\n传送地点分为低、中、高风险三组。能量越少，被传送到高风险地点的概率越高\n\n如果能量不足以支付普通传送，你会受到惩罚并被送往随机高风险地点\n\n普通传送默认每 45 秒发生一次，可在难度菜单中调整\n\n你可以通过正常赚取 RP 或完成特殊任务恢复能量\n\n即时传送会额外消耗能量，并使当前传送计时增加 " + tm_instant_time_bonus + " 秒。连续使用会提高能量费用，直到下一次普通传送发生\n\n按 [ 显示或隐藏特殊任务\n按 ] 立即传送\n按 \\ 结束无限模式并结算奖励\n\n坚持完成全部轮次即可完成任务，祝你好运！"

	GetDifficultyText:
		text = "Manaka 点数总加成：" + GetTotalMPBonus() + " MP\n白天加成：50 Manaka 点数"
		if tm_endless
			text = text + "\n\n无限模式会根据完成轮数给予奖励，从第 16 轮开始奖励提高\n\n使用 ManakaPlus v2 > 取消当前任务，或按 \\ 结束无限模式并结算全部累计奖励。白天与难度的 Manaka 点数加成仅在完成至少 10 轮后发放"
		_result = text

	GetRoundsLabel:
		if tm_endless
			_result = "轮数：无限"
		else
			_result = "轮数：" + tm_total_rounds

	GetTeleportIntervalLabel:
		_result = "传送间隔：" + tm_teleport_duration + " 秒"

	GetStartingEnergyLabel:
		_result = "初始能量：" + tm_start_energy

	GetMaxEnergyLabel:
		_result = "最大能量：" + tm_max_energy

	GetRPEnergyLabel:
		_result = "每获得 RP：+" + tm_rp_energy_gain

	GetRPRequiredLabel:
		_result = "每获得 " + tm_rp_required + " RP"

	CycleRounds:
		if tm_endless
			tm_endless = false
			tm_total_rounds = 5
		elseif tm_total_rounds == 5
			tm_total_rounds = 10
		elseif tm_total_rounds == 10
			tm_total_rounds = 15
		else
			tm_endless = true

	CycleTeleportInterval:
		if tm_teleport_duration >= 60
			tm_teleport_duration = 15
		else
			tm_teleport_duration = tm_teleport_duration + 5

	CycleStartingEnergy:
		if tm_start_energy == 24
			tm_start_energy = 48
		elseif tm_start_energy == 48
			tm_start_energy = 72
		elseif tm_start_energy == 72
			tm_start_energy = 96
		else
			tm_start_energy = 24

	CycleMaxEnergy:
		if tm_max_energy >= 192
			tm_max_energy = 48
		else
			tm_max_energy = tm_max_energy + 24

	CycleRPEnergyGain:
		if tm_rp_energy_gain == 4
			tm_rp_energy_gain = 6
		elseif tm_rp_energy_gain == 6
			tm_rp_energy_gain = 8
		elseif tm_rp_energy_gain == 8
			tm_rp_energy_gain = 10
		elseif tm_rp_energy_gain == 10
			tm_rp_energy_gain = 12
		else
			tm_rp_energy_gain = 4

	CycleRPRequired:
		if tm_rp_required >= 80
			tm_rp_required = 20
		else
			tm_rp_required = tm_rp_required + 10

	GetTotalMPBonus:
		bonus = 0
		if tm_endless == false && tm_total_rounds == 15
			bonus = bonus + 50
		if tm_teleport_duration <= 40
			bonus = bonus + ((45 - tm_teleport_duration) / 5) * 30
		if tm_start_energy == 48
			bonus = bonus + 20
		elseif tm_start_energy == 24
			bonus = bonus + 40
		if tm_max_energy == 96
			bonus = bonus + 30
		elseif tm_max_energy == 72
			bonus = bonus + 60
		elseif tm_max_energy == 48
			bonus = bonus + 90
		if tm_rp_energy_gain == 6
			bonus = bonus + 30
		elseif tm_rp_energy_gain == 4
			bonus = bonus + 60
		if tm_rp_required == 50
			bonus = bonus + 30
		elseif tm_rp_required == 60
			bonus = bonus + 60
		elseif tm_rp_required == 70
			bonus = bonus + 90
		elseif tm_rp_required == 80
			bonus = bonus + 120
		_result = Floor(bonus)

	ShowRewardOverlay:
		tm_reward_overlay.Clear()
		tm_reward_overlay.Add(text="" + Floor(reward_rp) + " RP + " + Floor(reward_mp) + " Manaka Points Added")
		tm_reward_overlay_timer = 5

	CleanupRuntime:
		HideAllZones()
		ClearOverlays()
		RestoreMissionItems()
		SetVibrator("Off")
		if tm_vibrator_applied
			UnequipAdultToy("Vibrator")
		if tm_eyemask_forced
			UnequipAdultToy("EyeMask")
		SetVibrator("Off")
		tm_vibrator_forced = false
		tm_vibrator_applied = false
		tm_eyemask_forced = false
		tm_remote_move_pending = false
		tm_remote_drop_index = 0
		tm_coat_drop_index = 0
		tm_instant_multiplier = 1.2
		tm_special_visible = true
		tm_special_overlay_flip = 0
		tm_naked_recharge_timer = 0
		tm_peeing_recharge_timer = 0
		tm_accumulator_timer = 0
		tm_orgasm_was_active = false
		tm_first_normal_free = false
		tm_current_zone = 0
		tm_zone_grace = 0

	RestoreMissionItems:
		if tm_coat_punished_ever
			if tm_condition_coat.Check() == false
				coat_collected = CollectItem(itemtype="Coat")
				if coat_collected
					coat_return_position = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=1)
					DropItem(itemtype="Coat", position=coat_return_position, compass=false)
			tm_coat_displaced = false
			tm_coat_punished_ever = false
			tm_coat_drop_index = 0
		if tm_remote_punished_ever
			if tm_condition_remote.Check() == false
				CollectItem(itemtype="VibeRemocon")
			tm_remote_displaced = false
			tm_remote_punished_ever = false

	FinishMission:
		reward_mp = 150 + tm_difficulty_mp_bonus
		if tm_daylight_start
			reward_mp = reward_mp + 50
		AddCurrentEarnRP(150)
		manaka_points.Add(amount=reward_mp)
		mainthread.UpdateHub()
		ShowRewardOverlay(reward_rp=150, reward_mp=reward_mp)
		_save.ManakaPlusV2ResidenceTeleportingMadnessCompleted = true
		tm_finish_message = "传送狂乱已完成\n奖励：150 RP + " + reward_mp + " Manaka 点数"
		tm_active = false
		CleanupRuntime()
		tm_completed_signal = true

	CompleteEndlessRound:
		while tm_endless_completed_rounds < tm_round
			tm_endless_completed_rounds = tm_endless_completed_rounds + 1
			if tm_endless_completed_rounds >= 16
				tm_endless_rp_reward = tm_endless_rp_reward + 40
				tm_endless_mp_reward = tm_endless_mp_reward + 30
			else
				tm_endless_rp_reward = tm_endless_rp_reward + 25
				tm_endless_mp_reward = tm_endless_mp_reward + 20

	EndEndlessMission:
		if tm_active && tm_endless
			reward_rp = tm_endless_rp_reward
			reward_mp = tm_endless_mp_reward
			if tm_endless_completed_rounds >= 10
				reward_mp = reward_mp + tm_difficulty_mp_bonus
				if tm_daylight_start
					reward_mp = reward_mp + 50
			AddCurrentEarnRP(reward_rp)
			manaka_points.Add(amount=reward_mp)
			mainthread.UpdateHub()
			ShowRewardOverlay(reward_rp=reward_rp, reward_mp=reward_mp)
			if tm_endless_completed_rounds >= 10
				_save.ManakaPlusV2ResidenceTeleportingMadnessCompleted = true
			tm_finish_message = "无限模式已结束，共完成 " + tm_endless_completed_rounds + " 轮\n奖励：" + reward_rp + " RP + " + reward_mp + " Manaka 点数"
			tm_active = false
			CleanupRuntime()
			tm_completed_signal = true

	IsTeleportSafetyChipEquipped:
		_result = mainthread.IsShopItemEquipped(item="teleport_safety_chip")

	IsEnergyOrgasmConverterEquipped:
		_result = mainthread.IsShopItemEquipped(item="energy_orgasm_converter")

	GetEffectiveMaxEnergy:
		_result = tm_max_energy

	GetEffectiveRPRequired:
		_result = tm_rp_required

	ProcessMissionItemEffects:
		if tm_energy > tm_max_energy
			tm_energy = tm_max_energy

	ClearOverlays:
		tm_energy_overlay.Clear()
		tm_energy_overlay_alt.Clear()
		tm_status_overlay.Clear()
		tm_status_overlay_alt.Clear()
		tm_special_overlay.Clear()
		tm_special_overlay_alt.Clear()

	UpdateOverlays:
		time_display = Floor(tm_time_left + 0.999)
		if time_display < 0
			time_display = 0
		energy_text = "Teleporting Energy: " + Floor(tm_energy)
		if tm_endless
			status_text = "Round: " + tm_round + " / Endless\nNext Teleport: " + time_display + "s"
		else
			status_text = "Round: " + tm_round + " / " + tm_total_rounds + "\nNext Teleport: " + time_display + "s"
		if tm_overlay_flip == 0
			tm_energy_overlay.Clear()
			tm_energy_overlay_alt.Clear()
			tm_status_overlay.Clear()
			tm_status_overlay_alt.Clear()
			tm_energy_overlay.Add(text=energy_text, duration=-1)
			tm_status_overlay.Add(text=status_text, duration=-1)
			tm_overlay_flip = 1
		else
			tm_energy_overlay.Clear()
			tm_energy_overlay_alt.Clear()
			tm_status_overlay.Clear()
			tm_status_overlay_alt.Clear()
			tm_energy_overlay_alt.Add(text=energy_text, duration=-1)
			tm_status_overlay_alt.Add(text=status_text, duration=-1)
			tm_overlay_flip = 0
	UpdateSpecialOverlay:
		tm_special_overlay.Clear()
		tm_special_overlay_alt.Clear()
		if tm_special_visible
			orgasm_rule_text = "Orgasm: -12 TE\nSelf-handcuffed Orgasm: only -4 TE"
			if IsEnergyOrgasmConverterEquipped()
				orgasm_rule_text = "Orgasm: +2 TE (Energy Orgasm Converter)"
			special_text = "Special Missions\nNaked: +1 TE every 3s\nNaked while the Coat is outside your zone: +1 TE every 2s\nDetection Risk 50% or lower: +1 TE per RP recharge\nDetection Risk above 50%: +2 TE per RP recharge\nPeeing: +1 TE every 3s\n" + orgasm_rule_text
			if tm_endless
				display_mp_reward = tm_endless_mp_reward
				if tm_endless_completed_rounds >= 10
					display_mp_reward = display_mp_reward + tm_difficulty_mp_bonus
					if tm_daylight_start
						display_mp_reward = display_mp_reward + 50
				special_text = special_text + "\n\nTotal Rewards: " + tm_endless_rp_reward + " RP / " + display_mp_reward + " MP\nPress \\ or use ManakaPlus v2 > Cancel current Mission to end and collect."
			if tm_special_overlay_flip == 0
				tm_special_overlay.Add(text=special_text, duration=-1)
				tm_special_overlay_flip = 1
			else
				tm_special_overlay_alt.Add(text=special_text, duration=-1)
				tm_special_overlay_flip = 0
	ToggleSpecialOverlay:
		if tm_special_visible
			tm_special_visible = false
		else
			tm_special_visible = true
		UpdateSpecialOverlay()

	ReleaseForcedEyeMask:
		if tm_eyemask_forced
			UnequipAdultToy("EyeMask")
			tm_eyemask_forced = false

	CoatOutsideCurrentZone:
		_result = false
		if tm_coat_displaced && tm_condition_coat.Check() == false && tm_coat_drop_index != tm_current_zone
			_result = true

	ProcessNakedRecharge:
		if tm_condition_naked.Check()
			recharge_interval = 3
			if CoatOutsideCurrentZone()
				recharge_interval = 2
			tm_naked_recharge_timer = tm_naked_recharge_timer + _timediff
			while tm_naked_recharge_timer >= recharge_interval
				tm_naked_recharge_timer = tm_naked_recharge_timer - recharge_interval
				tm_energy = tm_energy + 1
				effective_max = GetEffectiveMaxEnergy()
				if tm_energy > effective_max
					tm_energy = effective_max
		else
			tm_naked_recharge_timer = 0

	ProcessPeeingRecharge:
		if tm_condition_peeing.Check()
			tm_peeing_recharge_timer = tm_peeing_recharge_timer + _timediff
			while tm_peeing_recharge_timer >= 3
				tm_peeing_recharge_timer = tm_peeing_recharge_timer - 3
				tm_energy = tm_energy + 1
				effective_max = GetEffectiveMaxEnergy()
				if tm_energy > effective_max
					tm_energy = effective_max
		else
			tm_peeing_recharge_timer = 0

	ProcessOrgasmPenalty:
		orgasm_now = tm_condition_orgasm.Check()
		if orgasm_now && tm_orgasm_was_active == false
			if IsEnergyOrgasmConverterEquipped()
				tm_energy = tm_energy + 2
				effective_max = GetEffectiveMaxEnergy()
				if tm_energy > effective_max
					tm_energy = effective_max
			else
				orgasm_penalty = 12
				if tm_condition_handcuffs_back.Check()
					orgasm_penalty = 4
				tm_energy = tm_energy - orgasm_penalty
				if tm_energy < 0
					tm_energy = 0
		tm_orgasm_was_active = orgasm_now


	TrackEarnedRP:
		current_rp_total = GetCurrentEarnRP()
		rp_gain = current_rp_total - tm_rp_last_total
		if rp_gain > 0
			# GetCurrentEarnRP contains RP after the current RP multiplier.
			# Normalize it so the displayed base RP rates remain the mission's Energy currency.
			base_rp_gain = rp_gain
			rp_multiplier = _state.RpBonus
			if rp_multiplier != null && rp_multiplier > 0
				base_rp_gain = rp_gain / rp_multiplier
			tm_rp_bank = tm_rp_bank + base_rp_gain
			effective_rp_required = GetEffectiveRPRequired()
			while tm_rp_bank >= effective_rp_required
				tm_rp_bank = tm_rp_bank - effective_rp_required
				detection_bonus = 2
				if _state.Detection <= 0.5
					detection_bonus = 1
				tm_energy = tm_energy + tm_rp_energy_gain + detection_bonus
				effective_max = GetEffectiveMaxEnergy()
				if tm_energy > effective_max
					tm_energy = effective_max
		tm_rp_last_total = current_rp_total

	AttemptNextRound:
		if tm_first_normal_free
			ReleaseForcedEyeMask()
			risk_group = PickRiskGroup()
			next_zone = PickLocation(group=risk_group)
			tm_round = tm_round + 1
			TeleportToZone(index=next_zone)
			tm_time_left = tm_teleport_duration
			tm_instant_multiplier = 1.2
			tm_first_normal_free = false
		elseif tm_energy >= tm_teleport_cost
			ReleaseForcedEyeMask()
			tm_energy = tm_energy - tm_teleport_cost
			risk_group = PickRiskGroup()
			next_zone = PickLocation(group=risk_group)
			tm_round = tm_round + 1
			TeleportToZone(index=next_zone)
			tm_time_left = tm_teleport_duration
			tm_instant_multiplier = 1.2
		else
			ApplyInsufficientEnergyPunishment()

	AttemptInstantTeleport:
		instant_cost = Ceil(tm_teleport_cost * tm_instant_multiplier)
		if tm_energy >= instant_cost
			ReleaseForcedEyeMask()
			tm_energy = tm_energy - instant_cost
			risk_group = PickRiskGroup()
			next_zone = PickLocation(group=risk_group)
			TeleportToZone(index=next_zone)
			tm_time_left = tm_time_left + tm_instant_time_bonus
			tm_instant_multiplier = tm_instant_multiplier + 0.2
			if tm_instant_multiplier > 2
				tm_instant_multiplier = 2

	PickRiskGroup:
		low_chance = 5
		medium_chance = 15
		if tm_energy >= 96
			low_chance = 65
			medium_chance = 25
		elseif tm_energy >= 72
			low_chance = 50
			medium_chance = 35
		elseif tm_energy >= 48
			low_chance = 35
			medium_chance = 40
		elseif tm_energy >= 24
			low_chance = 20
			medium_chance = 40

		if IsTeleportSafetyChipEquipped()
			high_chance = 100 - low_chance - medium_chance
			safety_shift = 10
			if high_chance < safety_shift
				safety_shift = high_chance
			low_chance = low_chance + safety_shift

		medium_limit = low_chance + medium_chance
		roll = RandomInt(1, 100)
		if roll <= low_chance
			_result = "Low"
		elseif roll <= medium_limit
			_result = "Medium"
		else
			_result = "High"

	PickLocation:
		if group == null
			group = _args[0]
		candidate = tm_current_zone
		attempts = 0
		while candidate == tm_current_zone && attempts < 10
			if group == "Low"
				choice = RandomInt(1, 3)
				if choice == 1
					candidate = 3
				elseif choice == 2
					candidate = 9
				else
					candidate = 13
			elseif group == "Medium"
				choice = RandomInt(1, 8)
				if choice == 1
					candidate = 1
				elseif choice == 2
					candidate = 2
				elseif choice == 3
					candidate = 7
				elseif choice == 4
					candidate = 10
				elseif choice == 5
					candidate = 11
				elseif choice == 6
					candidate = 12
				elseif choice == 7
					candidate = 15
				else
					candidate = 16
			else
				choice = RandomInt(1, 5)
				if choice == 1
					candidate = 4
				elseif choice == 2
					candidate = 5
				elseif choice == 3
					candidate = 6
				elseif choice == 4
					candidate = 8
				else
					candidate = 14
			attempts = attempts + 1
		_result = candidate

	ApplyInsufficientEnergyPunishment:
		# Punishment teleports never increase the completed round count.
		tm_energy = tm_energy + 24
		effective_max = GetEffectiveMaxEnergy()
		if tm_energy > effective_max
			tm_energy = effective_max

		if tm_condition_coat.Check()
			MoveCoatToRandomMissionZone()
		elseif tm_remote_displaced == false
			# Force the toy first. The remote is created shortly afterward by the game,
			# so its actual displacement is completed by the update listener.
			EquipAdultToy("Vibrator")
			SetVibrator("Random")
			tm_vibrator_forced = true
			tm_vibrator_applied = true
			BeginRemoteDisplacement()
		else
			EquipAdultToy("EyeMask")
			tm_eyemask_forced = true

		punishment_zone = PickLocation(group="High")
		TeleportToZone(index=punishment_zone)
		tm_time_left = tm_teleport_duration

	MoveCoatToRandomMissionZone:
		DropItem(itemtype="Coat", position=_state.Position, compass=false)
		CollectItem(itemtype="Coat")
		drop_index = RandomInt(1, 17)
		tm_coat_drop_index = drop_index
		drop_position = GetZonePosition(index=drop_index)
		DropItem(itemtype="Coat", position=drop_position, compass=false)
		tm_coat_displaced = true
		tm_coat_punished_ever = true

	BeginRemoteDisplacement:
		tm_remote_displaced = true
		tm_remote_punished_ever = true
		tm_remote_move_pending = true
		tm_remote_drop_index = RandomInt(1, 17)

	ProcessRemoteDisplacement:
		if tm_remote_move_pending
			if tm_condition_vibrator.Check() == false
				EquipAdultToy("Vibrator")
			SetVibrator("Random")
			if tm_condition_remote.Check()
				drop_position = GetZonePosition(index=tm_remote_drop_index)
				dropped_remote = DropItem(itemtype="VibeRemocon", position=drop_position, compass=false)
				if dropped_remote != null
					tm_remote_move_pending = false

	GetZonePosition:
		if index == null
			index = _args[0]
		if index == 1
			_result = CreateList(stage="Residence", x=-26.31, y=-0.10, z=-101.28, rx=0, ry=0, rz=0, rw=1)
		elseif index == 2
			_result = CreateList(stage="Residence", x=-5.20, y=-0.10, z=-101.20, rx=0, ry=0, rz=0, rw=1)
		elseif index == 3
			_result = CreateList(stage="Residence", x=-40.58, y=-0.10, z=-104.01, rx=0, ry=0, rz=0, rw=1)
		elseif index == 4
			_result = CreateList(stage="Residence", x=-35.56, y=-0.10, z=-73.22, rx=0, ry=0, rz=0, rw=1)
		elseif index == 5
			_result = CreateList(stage="Residence", x=9.17, y=-0.10, z=-78.70, rx=0, ry=0, rz=0, rw=1)
		elseif index == 6
			_result = CreateList(stage="Residence", x=8.47, y=-0.10, z=-102.42, rx=0, ry=0, rz=0, rw=1)
		elseif index == 7
			_result = CreateList(stage="Residence", x=33.05, y=-0.22, z=-121.51, rx=0, ry=0, rz=0, rw=1)
		elseif index == 8
			_result = CreateList(stage="Residence", x=33.18, y=-0.22, z=-78.91, rx=0, ry=0, rz=0, rw=1)
		elseif index == 9
			_result = CreateList(stage="Residence", x=29.28, y=-0.11, z=-102.21, rx=0, ry=0, rz=0, rw=1)
		elseif index == 10
			_result = CreateList(stage="Residence", x=8.77, y=-0.11, z=-89.25, rx=0, ry=0, rz=0, rw=1)
		elseif index == 11
			_result = CreateList(stage="Residence", x=-11.94, y=-0.10, z=-88.40, rx=0, ry=0, rz=0, rw=1)
		elseif index == 12
			_result = CreateList(stage="Residence", x=-5.33, y=-0.10, z=-112.68, rx=0, ry=0, rz=0, rw=1)
		elseif index == 13
			_result = CreateList(stage="Residence", x=1.49, y=-0.11, z=-105.78, rx=0, ry=0, rz=0, rw=1)
		elseif index == 14
			_result = CreateList(stage="Residence", x=-9.57, y=-0.10, z=-78.74, rx=0, ry=0, rz=0, rw=1)
		elseif index == 15
			_result = CreateList(stage="Residence", x=8.85, y=-0.10, z=-120.83, rx=0, ry=0, rz=0, rw=1)
		elseif index == 16
			_result = CreateList(stage="Residence", x=-10.33, y=-0.09, z=-127.38, rx=0, ry=0, rz=0, rw=1)
		else
			_result = CreateList(stage="Residence", x=-30.28, y=-0.11, z=-111.89, rx=0, ry=0, rz=0, rw=1)

	TeleportToZone:
		if index == null
			index = _args[0]
		HideAllZones()
		tm_current_zone = index
		ShowCurrentZone()
		tm_zone_grace = 0.75
		position = GetZonePosition(index=index)
		SetPlayerPosition(position=position)

	ReturnPlayerToCurrentZone:
		position = GetZonePosition(index=tm_current_zone)
		SetPlayerPosition(position=position)
		tm_zone_grace = 0.5

	ShowCurrentZone:
		if tm_current_zone == 1
			tm_zone1.SetVisible(true)
		elseif tm_current_zone == 2
			tm_zone2.SetVisible(true)
		elseif tm_current_zone == 3
			tm_zone3.SetVisible(true)
		elseif tm_current_zone == 4
			tm_zone4.SetVisible(true)
		elseif tm_current_zone == 5
			tm_zone5.SetVisible(true)
		elseif tm_current_zone == 6
			tm_zone6.SetVisible(true)
		elseif tm_current_zone == 7
			tm_zone7.SetVisible(true)
		elseif tm_current_zone == 8
			tm_zone8.SetVisible(true)
		elseif tm_current_zone == 9
			tm_zone9.SetVisible(true)
		elseif tm_current_zone == 10
			tm_zone10.SetVisible(true)
		elseif tm_current_zone == 11
			tm_zone11.SetVisible(true)
		elseif tm_current_zone == 12
			tm_zone12.SetVisible(true)
		elseif tm_current_zone == 13
			tm_zone13.SetVisible(true)
		elseif tm_current_zone == 14
			tm_zone14.SetVisible(true)
		elseif tm_current_zone == 15
			tm_zone15.SetVisible(true)
		elseif tm_current_zone == 16
			tm_zone16.SetVisible(true)
		elseif tm_current_zone == 17
			tm_zone17.SetVisible(true)

	CurrentZoneInside:
		_result = true
		if tm_current_zone == 1
			_result = tm_zone1.Inside()
		elseif tm_current_zone == 2
			_result = tm_zone2.Inside()
		elseif tm_current_zone == 3
			_result = tm_zone3.Inside()
		elseif tm_current_zone == 4
			_result = tm_zone4.Inside()
		elseif tm_current_zone == 5
			_result = tm_zone5.Inside()
		elseif tm_current_zone == 6
			_result = tm_zone6.Inside()
		elseif tm_current_zone == 7
			_result = tm_zone7.Inside()
		elseif tm_current_zone == 8
			_result = tm_zone8.Inside()
		elseif tm_current_zone == 9
			_result = tm_zone9.Inside()
		elseif tm_current_zone == 10
			_result = tm_zone10.Inside()
		elseif tm_current_zone == 11
			_result = tm_zone11.Inside()
		elseif tm_current_zone == 12
			_result = tm_zone12.Inside()
		elseif tm_current_zone == 13
			_result = tm_zone13.Inside()
		elseif tm_current_zone == 14
			_result = tm_zone14.Inside()
		elseif tm_current_zone == 15
			_result = tm_zone15.Inside()
		elseif tm_current_zone == 16
			_result = tm_zone16.Inside()
		elseif tm_current_zone == 17
			_result = tm_zone17.Inside()

	HideAllZones:
		tm_zone1.SetVisible(false)
		tm_zone2.SetVisible(false)
		tm_zone3.SetVisible(false)
		tm_zone4.SetVisible(false)
		tm_zone5.SetVisible(false)
		tm_zone6.SetVisible(false)
		tm_zone7.SetVisible(false)
		tm_zone8.SetVisible(false)
		tm_zone9.SetVisible(false)
		tm_zone10.SetVisible(false)
		tm_zone11.SetVisible(false)
		tm_zone12.SetVisible(false)
		tm_zone13.SetVisible(false)
		tm_zone14.SetVisible(false)
		tm_zone15.SetVisible(false)
		tm_zone16.SetVisible(false)
		tm_zone17.SetVisible(false)

	update:
		if tm_reward_overlay_timer > 0
			tm_reward_overlay_timer = tm_reward_overlay_timer - _timediff
			if tm_reward_overlay_timer <= 0
				tm_reward_overlay.Clear()

		if tm_active
			ProcessMissionItemEffects()
			TrackEarnedRP()
			ProcessNakedRecharge()
			ProcessPeeingRecharge()
			ProcessOrgasmPenalty()

			if tm_input_endless_cancel.WasPressed() && tm_endless
				EndEndlessMission()

			if tm_active
				if tm_input_special_toggle.WasPressed()
					ToggleSpecialOverlay()
				if tm_input_instant_teleport.WasPressed()
					AttemptInstantTeleport()

				# Retrieved punishment items immediately become available for a future punishment again.
				if tm_coat_displaced && tm_condition_coat.Check()
					tm_coat_displaced = false
					tm_coat_drop_index = 0
				if tm_remote_displaced && tm_remote_move_pending == false && tm_condition_remote.Check()
					tm_remote_displaced = false
					tm_vibrator_forced = false

				# Keep forced punishment equipment active until its stated release condition.
				tm_force_timer = tm_force_timer + _timediff
				if tm_force_timer >= 0.5
					tm_force_timer = 0
					if tm_remote_move_pending
						ProcessRemoteDisplacement()
					if tm_vibrator_forced && tm_condition_remote.Check() == false
						if tm_condition_vibrator.Check() == false
							EquipAdultToy("Vibrator")
						SetVibrator("Random")
					if tm_eyemask_forced && tm_condition_eyemask.Check() == false
						EquipAdultToy("EyeMask")

				# Leaving any active mission zone simply returns the player to its center.
				if tm_zone_grace > 0
					tm_zone_grace = tm_zone_grace - _timediff
				else
					if CurrentZoneInside() == false
						ReturnPlayerToCurrentZone()

				tm_time_left = tm_time_left - _timediff
				if tm_time_left <= 0
					if tm_endless
						CompleteEndlessRound()
						AttemptNextRound()
					elseif tm_round >= tm_total_rounds
						FinishMission()
					else
						AttemptNextRound()

				if tm_active
					tm_overlay_timer = tm_overlay_timer + _timediff
					if tm_overlay_timer >= 0.2
						tm_overlay_timer = 0
						UpdateOverlays()
						UpdateSpecialOverlay()

# ============================================================
# RESIDENCE HOME SWEET HOME
# ============================================================
manakaplus_v22_residence_home_sweet_home:
	thread = _this
	active = false
	completed_signal = false
	difficulty = "Normal"
	stationary_phone_use_min = 8
	stationary_phone_use_max = 13
	stationary_phone_break = 7
	moving_interval = 2
	patrol_speed = 1
	extreme_patrol_pairs = false
	punishment_mode = false
	punishment_wait_timer = 0
	punishment_active = false
	punishment_handcuff_added_by_mission = false
	reward_overlay_timer = 0
	toll_paid = false
	toll_timer = 0
	locked_vibrator = false
	locked_titrotor = false
	locked_kurirotor = false
	locked_pistonanal = false
	locked_pistonpussy = false
	locked_handcuff = false
	toll_ticket_active = false
	coat_moved = false
	last_reward_rp = 150
	last_reward_mp = 150
	toy_force_timer = 0
	eyemask_timer = 0
	eyemask_force_timer = 0
	eyemask_added_by_mission = false
	moving_index = 0
	moving_direction = 1
	moving_timer = 0
	moving_touch_cooldown = 0
	stationary_npcs = CreateList()
	patrol1_npc = null
	patrol1_npc_b = null
	patrol2_npc = null
	patrol2_npc_b = null
	special_npc = null
	patrol1_phase = 0
	patrol1_index = 0
	patrol1_next_index = 1
	patrol1_b_index = 2
	patrol1_b_next_index = 3
	patrol1_scan_step = 0
	patrol1_scan_timer = 0
	patrol2_phase = 0
	patrol2_index = 0
	patrol2_next_index = 1
	patrol2_b_index = 2
	patrol2_b_next_index = 3
	patrol2_scan_step = 0
	patrol2_scan_timer = 0
	special_phase = 0
	special_index = 0
	special_next_index = 1
	special_wait_timer = 0

	manaka_points = CreateThread("manakaplus_v22_manaka_points")

	condition_vibrator = CreateCondition("[AdultToy_Vibrator]")
	condition_titrotor = CreateCondition("[AdultToy_TitRotor]")
	condition_kurirotor = CreateCondition("[AdultToy_KuriRotor]")
	condition_pistonanal = CreateCondition("[AdultToy_PistonAnal]")
	condition_pistonpussy = CreateCondition("[AdultToy_PistonPussy]")
	condition_eyemask = CreateCondition("[AdultToy_EyeMask]")
	condition_blindfolded = CreateCondition("[Blindfolded]")
	condition_handcuffsback = CreateCondition("[HandcuffsBack]")
	condition_self_handcuff = CreateCondition("[AdultToy_Handcuff]")

	start_position = Vector(37.45, -0.11, -120.80)
	start_rotation = Quaternion(0.00000, -0.69227, 0.00000, 0.72164)
	destination_position = Vector(-29.17, -0.09, -117.42)
	home_total_distance = 0
	home_distance = 0
	home_gauge = 0
	toys_position = Vector(29.26, -0.11, -121.41)
	barrier1_return_position = Vector(-9.66, -0.11, -73.79)

	start_area = CreateArea(type="sphere", stage="Residence", x=37.45, y=-0.11, z=-120.80, r=1, outline=true, compass=false)
	start_zone = CreateZone(start_area)
	start_zone.SetVisible(false)
	start_zone.SetColor(0.2,0.65,1)

	destination_area = CreateArea(type="sphere", stage="Residence", x=-29.17, y=-0.09, z=-117.42, r=1, outline=true, compass=true)
	destination_zone = CreateZone(destination_area)
	destination_zone.SetVisible(false)
	destination_zone.SetColor(0.2,1,0.2)

	toys_area = CreateArea(type="sphere", stage="Residence", x=29.26, y=-0.11, z=-121.41, r=0.6, outline=true, compass=false)
	toys_zone = CreateZone(toys_area)
	toys_zone.SetVisible(false)
	toys_zone.SetColor(1,0.65,0.2)

	toys_gate_visible_area = CreateArea(type="cuboid", stage="Residence", x1=26.78, y1=-0.11, z1=-124.38, x2=26.78, y2=-0.11, z2=-118.38, w=2, h=1, outline=true, compass=false)
	toys_gate_visible_zone = CreateZone(toys_gate_visible_area)
	toys_gate_visible_zone.SetVisible(false)
	toys_gate_visible_zone.SetColor(1,0.2,0.2)
	toys_gate_trigger_area = CreateArea(type="cuboid", stage="Residence", x1=26.78, y1=-1.61, z1=-124.38, x2=26.78, y2=-1.61, z2=-118.38, w=2, h=4, outline=true, compass=false)
	toys_gate_trigger_zone = CreateZone(toys_gate_trigger_area)
	toys_gate_trigger_zone.SetVisible(false)

	barrier1_visible_area = CreateArea(type="cuboid", stage="Residence", x1=-12.28, y1=-0.11, z1=-76.35, x2=-12.28, y2=-0.11, z2=-70.35, w=2, h=1, outline=true, compass=false)
	barrier1_visible_zone = CreateZone(barrier1_visible_area)
	barrier1_visible_zone.SetVisible(false)
	barrier1_visible_zone.SetColor(1,0.2,0.2)
	barrier1_trigger_area = CreateArea(type="cuboid", stage="Residence", x1=-12.28, y1=-1.61, z1=-76.35, x2=-12.28, y2=-1.61, z2=-70.35, w=2, h=4, outline=true, compass=false)
	barrier1_trigger_zone = CreateZone(barrier1_trigger_area)
	barrier1_trigger_zone.SetVisible(false)

	moving_zones = CreateList()
	moving_i = 0
	while moving_i < 12
		moving_ratio = moving_i / 11.0
		moving_x = 33.17 + (33.11 - 33.17) * moving_ratio
		moving_y = -0.21
		moving_z = -82.38 + (-118.19 + 82.38) * moving_ratio
		moving_visible_area = CreateArea(type="cuboid", stage="Residence", x1=moving_x, y1=moving_y, z1=moving_z - 0.9, x2=moving_x, y2=moving_y, z2=moving_z + 0.9, w=18, h=1, outline=true, compass=false)
		moving_visible_zone = CreateZone(moving_visible_area)
		moving_visible_zone.SetVisible(false)
		moving_visible_zone.SetColor(1,0.15,0.15)
		moving_trigger_area = CreateArea(type="cuboid", stage="Residence", x1=moving_x, y1=moving_y - 1.5, z1=moving_z - 0.9, x2=moving_x, y2=moving_y - 1.5, z2=moving_z + 0.9, w=18, h=4, outline=true, compass=false)
		moving_trigger_zone = CreateZone(moving_trigger_area)
		moving_trigger_zone.SetVisible(false)
		moving_zones.Insert(CreateList(visible=moving_visible_zone, trigger=moving_trigger_zone))
		moving_i = moving_i + 1

	main_panel = CreateMissionPanel()
	main_panel.SetVisible(false)
	main_panel.SetGaugeVisible(false)
	main_panel.SetRPText("")

	toys_panel = CreateMissionPanel()
	toys_panel.SetVisible(false)
	toys_panel.SetGaugeVisible(true)
	toys_panel.SetGaugeProgress(0)
	toys_panel.SetRPText("")

	reward_overlay = CreateText()
	reward_overlay.SetAnchor(0.5, 0.5)
	reward_overlay.SetAlignment("Top")
	reward_overlay.SetSize(36)
	reward_overlay.SetWidth(1200)
	reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	reward_overlay.SetFrontLayer(true)
	reward_overlay.Clear()

	patrol1_points = CreateList(Vector(-9.57, -0.10, -78.70), Vector(9.17, -0.11, -78.67), Vector(8.20, -0.11, -102.60), Vector(-14.93, -0.11, -101.11))
	patrol2_points = CreateList(Vector(-26.29, -0.09, -101.26), Vector(-5.08, -0.09, -101.31), Vector(-14.52, -0.09, -113.48), Vector(-26.52, -0.09, -123.59))
	special_points = CreateList(Vector(0.04, -0.11, -104.85), Vector(6.47, -0.11, -110.37))
	special_rotations = CreateList(Quaternion(0.00000, -0.27900, 0.00000, 0.96029), Quaternion(0.00000, 0.74898, 0.00000, 0.66259))
	scan_rotations = CreateList(Quaternion(0,0,0,1), Quaternion(0,0.38268,0,0.92388), Quaternion(0,0.70711,0,0.70711), Quaternion(0,0.92388,0,0.38268), Quaternion(0,1,0,0), Quaternion(0,0.92388,0,-0.38268), Quaternion(0,0.70711,0,-0.70711), Quaternion(0,0.38268,0,-0.92388))

	listener = CreateListenerLocal("update")

	GetDifficultyBonus:
		_result = 0
		if difficulty == "Hard"
			_result = 100
		elseif difficulty == "Extreme"
			_result = 200

	GetPunishmentBonus:
		_result = 0
		if punishment_mode
			_result = 100

	GetRewardRP:
		_result = 150 + GetDifficultyBonus() + GetPunishmentBonus()

	GetRewardMP:
		_result = 150 + GetDifficultyBonus() + GetPunishmentBonus()

	GetMissionText:
		reward_rp = GetRewardRP()
		reward_mp = GetRewardMP()
		_result = "甜蜜之家\n真菜香必须找到安全回家的路线，避开沿途的社区巡逻与危险区域\n\n条件：全裸\n奖励：" + reward_rp + " RP + " + reward_mp + " Manaka 点数"
		if difficulty == "Hard"
			_result = _result + "\n困难难度加成：+100 RP + 100 Manaka 点数"
		elseif difficulty == "Extreme"
			_result = _result + "\n极限难度加成：+200 RP + 200 Manaka 点数"
		if punishment_mode
			_result = _result + "\n惩罚模式加成：+100 RP + 100 Manaka 点数\n\n惩罚模式：真菜香每隔 35–60 秒会被随机戴上眼罩并铐住"

	GetDifficultyLabel:
		_result = "普通"
		if difficulty == "Hard"
			_result = "困难"
		elseif difficulty == "Extreme"
			_result = "极限"

	GetPunishmentLabel:
		_result = "关闭"
		if punishment_mode
			_result = "开启"

	SetPunishmentOff:
		punishment_mode = false

	TogglePunishment:
		if punishment_mode
			punishment_mode = false
		else
			punishment_mode = true

	GetPhoneUseDuration:
		_result = RandomInt(stationary_phone_use_min, stationary_phone_use_max)

	IsSMTollTicketEquipped:
		_result = mainthread.IsShopItemEquipped(item="sm_toll_ticket")

	GetTollText:
		_result = "至少装备 1 个震动器以解除此屏障"
		if difficulty == "Hard"
			_result = "装备 3 个震动器以解除此屏障"
		elseif difficulty == "Extreme"
			_result = "装备 3 个震动器与 2 个活塞机以解除此屏障"
		if IsSMTollTicketEquipped()
			_result = _result + "\n额外通行条件：主动使用手铐\n效果：震动器变为弱档，活塞机变为低速"

	SetDifficultyNormal:
		difficulty = "Normal"
		stationary_phone_use_min = 8
		stationary_phone_use_max = 13
		stationary_phone_break = 7
		moving_interval = 2
		patrol_speed = 1
		extreme_patrol_pairs = false

	SetDifficultyHard:
		difficulty = "Hard"
		stationary_phone_use_min = 8
		stationary_phone_use_max = 9
		stationary_phone_break = 6
		moving_interval = 1
		patrol_speed = 1.2
		extreme_patrol_pairs = false

	SetDifficultyExtreme:
		difficulty = "Extreme"
		stationary_phone_use_min = 7
		stationary_phone_use_max = 8
		stationary_phone_break = 5
		moving_interval = 0.5
		patrol_speed = 1.2
		extreme_patrol_pairs = true

	CycleDifficulty:
		if difficulty == "Normal"
			SetDifficultyHard()
		elseif difficulty == "Hard"
			SetDifficultyExtreme()
		else
			SetDifficultyNormal()

	IsActive:
		_result = active

	ConsumeCompleted:
		_result = completed_signal
		completed_signal = false

	RandomAvatar:
		avatar_roll = RandomInt(0, 4)
		_result = "NewFemale"
		if avatar_roll == 1
			_result = "PreviousFemale"
		elseif avatar_roll == 2
			_result = "NewMale"
		elseif avatar_roll == 3
			_result = "PreviousMale"

	Start:
		if active == false
			active = true
			completed_signal = false
			toll_paid = false
			toll_timer = 0
			locked_vibrator = false
			locked_titrotor = false
			locked_kurirotor = false
			locked_pistonanal = false
			locked_pistonpussy = false
			locked_handcuff = false
			toll_ticket_active = false
			coat_moved = false
			toy_force_timer = 0
			punishment_wait_timer = RandomInt(35,61)
			punishment_active = false
			punishment_handcuff_added_by_mission = false
			eyemask_timer = 0
			eyemask_force_timer = 0
			eyemask_added_by_mission = false
			moving_index = 0
			moving_direction = 1
			moving_timer = 0
			moving_touch_cooldown = 0
			UnequipAllCosplay()
			MoveCoatAway()
			SpawnNPCs()
			PrimeHomeSweetHomeCuboids()
			ShowMissionZones()
			home_total_distance = Vector3Distance(start_position, destination_position)
			main_panel.SetText("找到安全回家的路线")
			main_panel.SetRPText("" + GetRewardRP() + " RP + " + GetRewardMP() + " MP")
			main_panel.SetGaugeVisible(true)
			main_panel.SetGaugeProgress(0)
			main_panel.SetVisible(true)
			SetPlayerPosition(position=start_position, rotation=start_rotation)

	MoveCoatAway:
		DropItem(itemtype="Coat", position=_state.Position, compass=false)
		CollectItem(itemtype="Coat")
		coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
		DropItem(itemtype="Coat", stage="Apart", position=coat_away_pos, compass=false)
		coat_moved = true

	RestoreCoat:
		if coat_moved
			CollectItem(itemtype="Coat")
			coat_return_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
			DropItem(itemtype="Coat", position=coat_return_pos, compass=false)
			coat_moved = false

	ShowMissionZones:
		start_zone.SetVisible(true)
		destination_zone.SetVisible(true)
		toys_zone.SetVisible(true)
		toys_gate_visible_zone.SetVisible(true)
		barrier1_visible_zone.SetVisible(true)
		moving_i = 0
		while moving_i < moving_zones.Count()
			moving_entry = moving_zones[moving_i]
			if moving_i == moving_index
				moving_entry.visible.SetVisible(true)
			else
				moving_entry.visible.SetVisible(false)
			moving_i = moving_i + 1

	HideMissionZones:
		start_zone.SetVisible(false)
		destination_zone.SetVisible(false)
		toys_zone.SetVisible(false)
		toys_gate_visible_zone.SetVisible(false)
		barrier1_visible_zone.SetVisible(false)
		moving_i = 0
		while moving_i < moving_zones.Count()
			moving_entry = moving_zones[moving_i]
			moving_entry.visible.SetVisible(false)
			moving_i = moving_i + 1

	PrimeHomeSweetHomeCuboids:
		# CMv2 2.2.1 can throw while destroying a cuboid whose SquareEffect
		# was never initialized. Prime every HSH cuboid once while Residence
		# is loaded, then immediately hide it before normal zone display.
		toys_gate_visible_zone.SetVisible(true)
		toys_gate_visible_zone.SetVisible(false)
		toys_gate_trigger_zone.SetVisible(true)
		toys_gate_trigger_zone.SetVisible(false)
		barrier1_visible_zone.SetVisible(true)
		barrier1_visible_zone.SetVisible(false)
		barrier1_trigger_zone.SetVisible(true)
		barrier1_trigger_zone.SetVisible(false)
		moving_i = 0
		while moving_i < moving_zones.Count()
			moving_entry = moving_zones[moving_i]
			moving_entry.visible.SetVisible(true)
			moving_entry.visible.SetVisible(false)
			moving_entry.trigger.SetVisible(true)
			moving_entry.trigger.SetVisible(false)
			moving_i = moving_i + 1


	SpawnNPCs:
		stationary_npcs = CreateList()
		stationary_data = CreateList()
		stationary_data.Insert(CreateList(position=Vector(27.66, -0.11, -80.51), rotation=Quaternion(0.00000, 0.00786, 0.00000, 0.99997)))
		stationary_data.Insert(CreateList(position=Vector(10.72, -0.11, -77.51), rotation=Quaternion(0.00000, 0.99985, 0.00000, -0.01746)))
		stationary_data.Insert(CreateList(position=Vector(-17.31, -0.11, -96.55), rotation=Quaternion(0.00000, 0.71139, 0.00000, 0.70280)))
		stationary_data.Insert(CreateList(position=Vector(-4.87, -0.11, -103.94), rotation=Quaternion(0.00000, -0.00089, 0.00000, 1.00000)))
		stationary_data.Insert(CreateList(position=Vector(10.33, -0.11, -90.90), rotation=Quaternion(0.00000, -0.66197, 0.00000, 0.74953)))
		stationary_data.Insert(CreateList(position=Vector(5.12, -0.11, -103.05), rotation=Quaternion(0.00000, 0.39473, 0.00000, 0.91880)))
		stationary_data.Insert(CreateList(position=Vector(-27.91, -0.11, -103.32), rotation=Quaternion(0.00000, 0.70771, 0.00000, 0.70650)))
		stationary_data.Insert(CreateList(position=Vector(-15.14, -0.09, -128.10), rotation=Quaternion(0.00000, 0.00178, 0.00000, 1.00000)))
		stationary_data.Insert(CreateList(position=Vector(8.31, -0.09, -121.84), rotation=Quaternion(0.00000, 0.33799, 0.00000, 0.94115)))
		if difficulty == "Hard" || difficulty == "Extreme"
			stationary_data.Insert(CreateList(position=Vector(27.51, -0.11, -98.99), rotation=Quaternion(0.00000, 0.73787, 0.00000, 0.67494)))
			stationary_data.Insert(CreateList(position=Vector(-12.52, -0.11, -83.77), rotation=Quaternion(0.00000, 0.71509, 0.00000, 0.69904)))
			stationary_data.Insert(CreateList(position=Vector(38.81, -0.10, -109.87), rotation=Quaternion(0.00000, -0.66312, 0.00000, 0.74851)))
			stationary_data.Insert(CreateList(position=Vector(-11.78, -0.11, -117.39), rotation=Quaternion(0.00000, -0.69652, 0.00000, 0.71753)))
		stationary_i = 0
		while stationary_i < stationary_data.Count()
			stationary_info = stationary_data[stationary_i]
			stationary_npc = CreateNPC(RandomAvatar(), position=stationary_info.position, rotation=stationary_info.rotation)
			stationary_npc.SkipStrangeness(false)
			stationary_npc.CanGameOver(true)
			stationary_npc.Smartphone(true)
			stationary_npc.Headset(false)
			stationary_npc.Stopped(false)
			stationary_npc.ClearWaypoints()
			stationary_npc.AddWaypoint(stationary_info.position)
			stationary_npcs.Insert(CreateList(npc=stationary_npc, phone=true, timer=GetPhoneUseDuration()))
			stationary_i = stationary_i + 1

		patrol1_npc = CreateNPC(RandomAvatar(), position=patrol1_points[0], rotation=Quaternion(0,0,0,1))
		PrepareEnemyNPC(npc=patrol1_npc)
		patrol1_npc.Stopped(true)
		patrol1_npc.ClearWaypoints()
		patrol1_npc.AddWaypoint(patrol1_points[0])
		patrol1_phase = 0
		patrol1_index = 0
		patrol1_next_index = 1
		patrol1_b_index = 2
		patrol1_b_next_index = 3
		patrol1_scan_step = 0
		patrol1_scan_timer = 0
		patrol1_npc.Warp(rotation=scan_rotations[0])
		patrol1_npc_b = null
		if extreme_patrol_pairs
			patrol1_npc_b = CreateNPC(RandomAvatar(), position=patrol1_points[2], rotation=Quaternion(0,0,0,1))
			PrepareEnemyNPC(npc=patrol1_npc_b)
			patrol1_npc_b.Stopped(true)
			patrol1_npc_b.ClearWaypoints()
			patrol1_npc_b.AddWaypoint(patrol1_points[2])
			patrol1_npc_b.Warp(rotation=scan_rotations[0])

		patrol2_npc = CreateNPC(RandomAvatar(), position=patrol2_points[0], rotation=Quaternion(0,0,0,1))
		PrepareEnemyNPC(npc=patrol2_npc)
		patrol2_npc.Stopped(true)
		patrol2_npc.ClearWaypoints()
		patrol2_npc.AddWaypoint(patrol2_points[0])
		patrol2_phase = 0
		patrol2_index = 0
		patrol2_next_index = 1
		patrol2_b_index = 2
		patrol2_b_next_index = 3
		patrol2_scan_step = 0
		patrol2_scan_timer = 0
		patrol2_npc.Warp(rotation=scan_rotations[0])
		patrol2_npc_b = null
		if extreme_patrol_pairs
			patrol2_npc_b = CreateNPC(RandomAvatar(), position=patrol2_points[2], rotation=Quaternion(0,0,0,1))
			PrepareEnemyNPC(npc=patrol2_npc_b)
			patrol2_npc_b.Stopped(true)
			patrol2_npc_b.ClearWaypoints()
			patrol2_npc_b.AddWaypoint(patrol2_points[2])
			patrol2_npc_b.Warp(rotation=scan_rotations[0])

		special_npc = CreateNPC(RandomAvatar(), position=special_points[0], rotation=special_rotations[0])
		PrepareEnemyNPC(npc=special_npc)
		special_npc.Stopped(true)
		special_npc.ClearWaypoints()
		special_npc.AddWaypoint(special_points[0])
		special_phase = 0
		special_index = 0
		special_next_index = 1
		special_wait_timer = 0

	PrepareEnemyNPC:
		npc.SkipStrangeness(false)
		npc.CanGameOver(true)
		npc.Smartphone(false)
		npc.Headset(false)
		npc.Speed(patrol_speed)
		npc.Stopped(false)

	UpdateStationaryNPCs:
		stationary_i = 0
		while stationary_i < stationary_npcs.Count()
			stationary_entry = stationary_npcs[stationary_i]
			if stationary_entry.npc != null
				stationary_entry.timer = stationary_entry.timer - _timediff
				if stationary_entry.timer <= 0
					if stationary_entry.phone
						stationary_entry.phone = false
						stationary_entry.timer = stationary_phone_break
						stationary_entry.npc.Smartphone(false)
					else
						stationary_entry.phone = true
						stationary_entry.timer = GetPhoneUseDuration()
						stationary_entry.npc.Smartphone(true)
			stationary_i = stationary_i + 1

	UpdatePatrol1:
		if patrol1_npc != null
			if patrol1_phase == 0
				patrol1_scan_timer = patrol1_scan_timer + _timediff
				if patrol1_scan_step == 0 || patrol1_scan_step == 2 || patrol1_scan_step == 4 || patrol1_scan_step == 6
					if patrol1_scan_timer >= 3
						patrol1_scan_timer = 0
						if patrol1_scan_step >= 6
							patrol1_phase = 1
							patrol1_next_index = patrol1_index + 1
							if patrol1_next_index >= patrol1_points.Count()
								patrol1_next_index = 0
							patrol1_npc.ClearWaypoints()
							patrol1_npc.AddWaypoint(patrol1_points[patrol1_next_index])
							patrol1_npc.Stopped(false)
							if extreme_patrol_pairs && patrol1_npc_b != null
								patrol1_b_next_index = patrol1_b_index + 1
								if patrol1_b_next_index >= patrol1_points.Count()
									patrol1_b_next_index = 0
								patrol1_npc_b.ClearWaypoints()
								patrol1_npc_b.AddWaypoint(patrol1_points[patrol1_b_next_index])
								patrol1_npc_b.Stopped(false)
						else
							patrol1_scan_step = patrol1_scan_step + 1
							patrol1_npc.Warp(rotation=scan_rotations[patrol1_scan_step])
							if extreme_patrol_pairs && patrol1_npc_b != null
								patrol1_npc_b.Warp(rotation=scan_rotations[patrol1_scan_step])
				else
					if patrol1_scan_timer >= 0.35
						patrol1_scan_timer = 0
						patrol1_scan_step = patrol1_scan_step + 1
						patrol1_npc.Warp(rotation=scan_rotations[patrol1_scan_step])
						if extreme_patrol_pairs && patrol1_npc_b != null
							patrol1_npc_b.Warp(rotation=scan_rotations[patrol1_scan_step])
			else
				patrol1_arrived = patrol1_npc.Finished()
				if extreme_patrol_pairs && patrol1_npc_b != null
					patrol1_arrived = patrol1_arrived && patrol1_npc_b.Finished()
				if patrol1_arrived
					patrol1_index = patrol1_next_index
					patrol1_phase = 0
					patrol1_scan_timer = 0
					patrol1_scan_step = 0
					patrol1_npc.ClearWaypoints()
					patrol1_npc.AddWaypoint(patrol1_points[patrol1_index])
					patrol1_npc.Stopped(true)
					patrol1_npc.Warp(rotation=scan_rotations[0])
					if extreme_patrol_pairs && patrol1_npc_b != null
						patrol1_b_index = patrol1_b_next_index
						patrol1_npc_b.ClearWaypoints()
						patrol1_npc_b.AddWaypoint(patrol1_points[patrol1_b_index])
						patrol1_npc_b.Stopped(true)
						patrol1_npc_b.Warp(rotation=scan_rotations[0])

	UpdatePatrol2:
		if patrol2_npc != null
			if patrol2_phase == 0
				patrol2_scan_timer = patrol2_scan_timer + _timediff
				if patrol2_scan_step == 0 || patrol2_scan_step == 2 || patrol2_scan_step == 4 || patrol2_scan_step == 6
					if patrol2_scan_timer >= 3
						patrol2_scan_timer = 0
						if patrol2_scan_step >= 6
							patrol2_phase = 1
							patrol2_next_index = patrol2_index + 1
							if patrol2_next_index >= patrol2_points.Count()
								patrol2_next_index = 0
							patrol2_npc.ClearWaypoints()
							patrol2_npc.AddWaypoint(patrol2_points[patrol2_next_index])
							patrol2_npc.Stopped(false)
							if extreme_patrol_pairs && patrol2_npc_b != null
								patrol2_b_next_index = patrol2_b_index + 1
								if patrol2_b_next_index >= patrol2_points.Count()
									patrol2_b_next_index = 0
								patrol2_npc_b.ClearWaypoints()
								patrol2_npc_b.AddWaypoint(patrol2_points[patrol2_b_next_index])
								patrol2_npc_b.Stopped(false)
						else
							patrol2_scan_step = patrol2_scan_step + 1
							patrol2_npc.Warp(rotation=scan_rotations[patrol2_scan_step])
							if extreme_patrol_pairs && patrol2_npc_b != null
								patrol2_npc_b.Warp(rotation=scan_rotations[patrol2_scan_step])
				else
					if patrol2_scan_timer >= 0.35
						patrol2_scan_timer = 0
						patrol2_scan_step = patrol2_scan_step + 1
						patrol2_npc.Warp(rotation=scan_rotations[patrol2_scan_step])
						if extreme_patrol_pairs && patrol2_npc_b != null
							patrol2_npc_b.Warp(rotation=scan_rotations[patrol2_scan_step])
			else
				patrol2_arrived = patrol2_npc.Finished()
				if extreme_patrol_pairs && patrol2_npc_b != null
					patrol2_arrived = patrol2_arrived && patrol2_npc_b.Finished()
				if patrol2_arrived
					patrol2_index = patrol2_next_index
					patrol2_phase = 0
					patrol2_scan_timer = 0
					patrol2_scan_step = 0
					patrol2_npc.ClearWaypoints()
					patrol2_npc.AddWaypoint(patrol2_points[patrol2_index])
					patrol2_npc.Stopped(true)
					patrol2_npc.Warp(rotation=scan_rotations[0])
					if extreme_patrol_pairs && patrol2_npc_b != null
						patrol2_b_index = patrol2_b_next_index
						patrol2_npc_b.ClearWaypoints()
						patrol2_npc_b.AddWaypoint(patrol2_points[patrol2_b_index])
						patrol2_npc_b.Stopped(true)
						patrol2_npc_b.Warp(rotation=scan_rotations[0])

	UpdateSpecialPatrol:
		if special_npc != null
			if special_phase == 0
				special_wait_timer = special_wait_timer + _timediff
				if special_wait_timer >= 5
					special_wait_timer = 0
					special_next_index = 1 - special_index
					special_phase = 1
					special_npc.ClearWaypoints()
					special_npc.AddWaypoint(special_points[special_next_index], special_rotations[special_next_index])
					special_npc.Stopped(false)
			elseif special_npc.Finished()
				special_index = special_next_index
				special_phase = 0
				special_wait_timer = 0
				special_npc.ClearWaypoints()
				special_npc.AddWaypoint(special_points[special_index])
				special_npc.Stopped(true)
				special_npc.Warp(rotation=special_rotations[special_index])

	UpdateMovingZone:
		moving_timer = moving_timer + _timediff
		if moving_timer >= moving_interval
			moving_timer = moving_timer - moving_interval
			moving_entry = moving_zones[moving_index]
			moving_entry.visible.SetVisible(false)
			moving_index = moving_index + moving_direction
			if moving_index >= moving_zones.Count() - 1
				moving_index = moving_zones.Count() - 1
				moving_direction = -1
			elseif moving_index <= 0
				moving_index = 0
				moving_direction = 1
			moving_entry = moving_zones[moving_index]
			moving_entry.visible.SetVisible(true)

		if moving_touch_cooldown > 0
			moving_touch_cooldown = moving_touch_cooldown - _timediff
		moving_entry = moving_zones[moving_index]
		if moving_touch_cooldown <= 0 && moving_entry.trigger.Inside()
			moving_touch_cooldown = 1
			if eyemask_timer <= 0
				eyemask_added_by_mission = condition_eyemask.Check() == false
			eyemask_timer = eyemask_timer + 15
			SetPlayerPosition(position=start_position, rotation=start_rotation)

	UpdateEyeMaskPunishment:
		if eyemask_timer > 0
			eyemask_timer = eyemask_timer - _timediff
			eyemask_force_timer = eyemask_force_timer + _timediff
			if eyemask_force_timer >= 0.3
				eyemask_force_timer = 0
				if condition_eyemask.Check() == false
					EquipAdultToy("EyeMask")
			if eyemask_timer <= 0
				eyemask_timer = 0
				if punishment_mode == false
					if eyemask_added_by_mission
						UnequipAdultToy("EyeMask")
					eyemask_added_by_mission = false

	UpdateToll:
		if toll_paid == false
			if toys_zone.Inside()
				toys_panel.SetVisible(true)
				toys_panel.SetText(GetTollText())
				toys_panel.SetRPText("")
				toll_valid = condition_vibrator.Check() || condition_titrotor.Check() || condition_kurirotor.Check()
				if difficulty == "Hard"
					toll_valid = condition_vibrator.Check() && condition_titrotor.Check() && condition_kurirotor.Check()
				elseif difficulty == "Extreme"
					toll_valid = condition_vibrator.Check() && condition_titrotor.Check() && condition_kurirotor.Check() && condition_pistonanal.Check() && condition_pistonpussy.Check()
				if IsSMTollTicketEquipped() && condition_self_handcuff.Check() == false
					toll_valid = false
				if toll_valid
					toll_timer = toll_timer + _timediff
					toys_zone.SetColor(0.2,1,0.2)
				else
					toll_timer = 0
					toys_zone.SetColor(1,0.65,0.2)
				toys_panel.SetGaugeProgress(toll_timer / 3)
				if toll_timer >= 3
					locked_vibrator = condition_vibrator.Check()
					locked_titrotor = condition_titrotor.Check()
					locked_kurirotor = condition_kurirotor.Check()
					locked_pistonanal = condition_pistonanal.Check()
					locked_pistonpussy = condition_pistonpussy.Check()
					toll_ticket_active = IsSMTollTicketEquipped()
					locked_handcuff = toll_ticket_active && condition_self_handcuff.Check()
					toll_paid = true
					toys_zone.SetVisible(false)
					toys_gate_visible_zone.SetVisible(false)
					toys_panel.SetVisible(false)
			else
				toll_timer = 0
				toys_panel.SetVisible(false)
		else
			toys_panel.SetVisible(false)
			toy_force_timer = toy_force_timer + _timediff
			if toy_force_timer >= 0.4
				toy_force_timer = 0
				if locked_vibrator && condition_vibrator.Check() == false
					EquipAdultToy("Vibrator")
				if locked_titrotor && condition_titrotor.Check() == false
					EquipAdultToy("TitRotor")
				if locked_kurirotor && condition_kurirotor.Check() == false
					EquipAdultToy("KuriRotor")
				if locked_pistonanal && condition_pistonanal.Check() == false
					EquipAdultToy("PistonAnal")
				if locked_pistonpussy && condition_pistonpussy.Check() == false
					EquipAdultToy("PistonPussy")
				if locked_handcuff && condition_handcuffsback.Check() == false
					LockHandcuffs(handcuffstype="Handcuff")
				if toll_ticket_active
					if locked_vibrator || locked_titrotor || locked_kurirotor
						SetVibrator("Low")
					if locked_pistonanal || locked_pistonpussy
						SetPiston("Low")
				else
					if locked_vibrator || locked_titrotor || locked_kurirotor
						SetVibrator("Random")
					if locked_pistonanal || locked_pistonpussy
						SetPiston("Random")

	UpdateRandomPunishment:
		if punishment_mode
			if punishment_active
				if condition_blindfolded.Check() == false && condition_handcuffsback.Check() == false
					punishment_active = false
					punishment_wait_timer = RandomInt(35,61)
					punishment_handcuff_added_by_mission = false
					if eyemask_timer <= 0
						eyemask_added_by_mission = false
			else
				punishment_wait_timer = punishment_wait_timer - _timediff
				if punishment_wait_timer <= 0
					if condition_blindfolded.Check() == false
						eyemask_added_by_mission = true
						EquipAdultToy("EyeMask")
					if condition_handcuffsback.Check() == false
						punishment_handcuff_added_by_mission = true
						LockHandcuffs(handcuffstype="Handcuff")
					punishment_active = true

	UpdateBarriers:
		if toll_paid == false && toys_gate_trigger_zone.Inside()
			SetPlayerPosition(position=toys_position)
		if barrier1_trigger_zone.Inside()
			SetPlayerPosition(position=barrier1_return_position)

	Finish:
		last_reward_rp = GetRewardRP()
		last_reward_mp = GetRewardMP()
		AddCurrentEarnRP(last_reward_rp)
		manaka_points.Add(amount=last_reward_mp)
		mainthread.UpdateHub()
		_save.ManakaPlusV2ResidenceHomeSweetHomeCompleted = true
		reward_overlay.Clear()
		reward_overlay.Add(text="" + last_reward_rp + " RP + " + last_reward_mp + " Manaka Points Added")
		reward_overlay_timer = 5
		completed_signal = true
		CleanupRuntime()

	Cancel:
		completed_signal = false
		reward_overlay_timer = 0
		reward_overlay.Clear()
		CleanupRuntime()

	CleanupRuntime:
		active = false
		HideMissionZones()
		main_panel.SetVisible(false)
		toys_panel.SetVisible(false)
		toys_panel.SetGaugeProgress(0)
		if toll_paid
			SetVibrator("Off")
			SetPiston("Off")
		if punishment_handcuff_added_by_mission || locked_handcuff
			UnlockHandcuffs()
		if eyemask_added_by_mission
			UnequipAdultToy("EyeMask")
		eyemask_timer = 0
		eyemask_force_timer = 0
		eyemask_added_by_mission = false
		CleanupNPCs()
		RestoreCoat()
		toll_paid = false
		toll_timer = 0
		locked_vibrator = false
		locked_titrotor = false
		locked_kurirotor = false
		locked_pistonanal = false
		locked_pistonpussy = false
		locked_handcuff = false
		toll_ticket_active = false
		toy_force_timer = 0
		punishment_wait_timer = 0
		punishment_active = false
		punishment_handcuff_added_by_mission = false

	RetireNPC:
		if npc != null
			if npc.IsAlive()
				npc.SkipStrangeness(true)
				npc.CanGameOver(false)
				npc.Smartphone(false)
				npc.Headset(false)
				npc.Stopped(false)
				npc.Warp(position=Vector(retire_x, -0.11, -145))
				npc.ClearWaypoints()
				npc.AddWaypoint(Vector(retire_x + 1, -0.11, -145), last=true)

	CleanupNPCs:
		stationary_i = 0
		while stationary_i < stationary_npcs.Count()
			stationary_entry = stationary_npcs[stationary_i]
			RetireNPC(npc=stationary_entry.npc, retire_x=55 + stationary_i)
			stationary_i = stationary_i + 1
		stationary_npcs = CreateList()
		RetireNPC(npc=patrol1_npc, retire_x=65)
		RetireNPC(npc=patrol1_npc_b, retire_x=66)
		RetireNPC(npc=patrol2_npc, retire_x=67)
		RetireNPC(npc=patrol2_npc_b, retire_x=68)
		RetireNPC(npc=special_npc, retire_x=69)
		patrol1_npc = null
		patrol1_npc_b = null
		patrol2_npc = null
		patrol2_npc_b = null
		special_npc = null

	update:
		if reward_overlay_timer > 0
			reward_overlay_timer = reward_overlay_timer - _timediff
			if reward_overlay_timer <= 0
				reward_overlay.Clear()

		if active
			UpdateStationaryNPCs()
			UpdatePatrol1()
			UpdatePatrol2()
			UpdateSpecialPatrol()
			UpdateMovingZone()
			UpdateEyeMaskPunishment()
			UpdateToll()
			UpdateRandomPunishment()
			UpdateBarriers()
			home_distance = Vector3Distance(_state.Position, destination_position)
			home_gauge = 0
			if home_total_distance > 0
				if home_distance < home_total_distance
					home_gauge = (home_total_distance - home_distance) / home_total_distance
			if destination_zone.Inside()
				home_gauge = 1
			main_panel.SetGaugeProgress(home_gauge)
			if destination_zone.Inside()
				Finish()

