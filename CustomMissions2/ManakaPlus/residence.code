	status_overlay_alt = CreateText()
	status_overlay_alt.SetAnchor(0.51, 0.90)
	status_overlay_alt.SetAlignment("Top")
	status_overlay_alt.SetSize(25)
	status_overlay_alt.SetWidth(600)
	status_overlay_alt.SetFace(dilate=0.3)
	status_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	status_overlay_alt.SetFrontLayer(true)
	status_overlay_alt.Clear()

	special_overlay = CreateText()
	special_overlay.SetAnchor(0.04, 0.82)
	special_overlay.SetAlignment("TopLeft")
	special_overlay.SetSize(24)
	special_overlay.SetWidth(620)
	special_overlay.SetFace(dilate=0.3)
	special_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	special_overlay.SetFrontLayer(true)
	special_overlay.Clear()

	special_overlay_alt = CreateText()
	special_overlay_alt.SetAnchor(0.04, 0.82)
	special_overlay_alt.SetAlignment("TopLeft")
	special_overlay_alt.SetSize(24)
	special_overlay_alt.SetWidth(620)
	special_overlay_alt.SetFace(dilate=0.3)
	special_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
	special_overlay_alt.SetFrontLayer(true)
	special_overlay_alt.Clear()

	reward_overlay = CreateText()
	reward_overlay.SetAnchor(0.5, 0.5)
	reward_overlay.SetAlignment("Top")
	reward_overlay.SetSize(36)
	reward_overlay.SetWidth(1200)
	reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	reward_overlay.SetFrontLayer(true)
	reward_overlay.Clear()
	reward_overlay_timer = 0

	listener = CreateListenerLocal("update")
	Log("ManakaPlus v2: Residence Dare module loaded.")

	Start:
		if active == false
			active = true
			state = 2
			completed_signal = false
			last_ep = 0
			remaining = 300
			elapsed = 0
			second_timer = 0
			prepare_timer = 0
			ep = 0
			rp_bank = 0
			rp_last_total = GetCurrentEarnRP()
			special_visible = true
			ep_overlay_flip = 0
			status_overlay_flip = 0
			special_overlay_flip = 0
			orgasm_was_active = false
			coat_moved = false
			coat_locked_for_run = false
			champion_detection_qualified = _state.Detection >= 0.8
			passive_second_timer = 0
			dare_start_random_warmup = RandomInt(0, 3)
			current_location = RandomInt(0, 3)
			location_cost_step = 0
			location_cost_idle = 0
			special_poll_remaining = special_poll_duration
			current_event_0 = 0
			current_event_1 = 0
			current_event_2 = 0
			current_event_3 = 0
			previous_common_0 = 0
			previous_common_1 = 0
			previous_common_2 = 0
			previous_time_event = 0
			previous_rare_event = 0
			poll_has_bodypaint_rare = false
			rare_bodypaint_done = false
			rare_detection_50_timer = 0
			rare_detection_70_timer = 0
			poll_rare_detection_50_done = false
			poll_rare_detection_70_done = false
			overlay_refresh_timer = 0
			zone_check_timer = 0
			npc_update_timer = 0
			time_event_11_blacklisted = false
			time_event_12_blacklisted = false
			time_event_13_blacklisted = false
			time_event_14_blacklisted = false
			ResetPollProgress()
			SetActiveLocation(_location=current_location)
			main_panel.SetVisible(false)
			main_panel.SetRPText("")
			main_panel.SetGaugeVisible(false)
			ClearOverlays()
			CleanupCrowdedNPCs()
			SpawnCrowdedNPCs()
			SetPlayerPosition(position=GetCurrentPosition())
			RollSpecialEvents()
			RefreshOverlays()

	ResetPollProgress:
		coat_remove_timer = 0
		poll_coat_remove_done = false
		poll_coat_return_done = false
		poll_orgasm_exposed_done = false
		poll_dildo_orgasm_done = false
		orgasm_exposed_count = 0
		dildo_orgasm_count = 0
		time_event_11_timer = 0
		time_event_11_orgasm_count = 0
		poll_time_event_11_done = false
		time_event_12_timer = 0
		poll_time_event_12_done = false
		time_event_13_orgasm_count = 0
		poll_time_event_13_done = false
		time_event_14_timer = 0
		poll_time_event_14_done = false
		rare_detection_50_timer = 0
		rare_detection_70_timer = 0
		poll_rare_detection_50_done = false
		poll_rare_detection_70_done = false

	IsActive:
		_result = active

	IsRunning:
		_result = active && state == 2

	ConsumeCompleted:
		_result = completed_signal
		completed_signal = false

	GetLastEP:
		_result = last_ep

	GetBestEP:
		if _save.ManakaPlusV2ResidenceDareBestEP == null
			_save.ManakaPlusV2ResidenceDareBestEP = 0
		_result = Floor(_save.ManakaPlusV2ResidenceDareBestEP)

	GetCurrentPosition:
		if current_location == 0
			_result = dare_position_0
		elseif current_location == 1
			_result = dare_position_1
		elseif current_location == 2
			_result = dare_position_2
		else
			_result = dare_position_3

	CurrentZoneInside:
		if current_location == 0
			_result = dare_zone_0.Inside()
		elseif current_location == 1
			_result = dare_zone_1.Inside()
		elseif current_location == 2
			_result = dare_zone_2.Inside()
		else
			_result = dare_zone_3.Inside()

	SetActiveLocation:
		current_location = _location
		RefreshZoneVisibility()

	RefreshZoneVisibility:
		show_zone = active && _state.Position.stage == "Residence"
		dare_zone_0.SetVisible(show_zone && current_location == 0)
		dare_zone_1.SetVisible(show_zone && current_location == 1)
		dare_zone_2.SetVisible(show_zone && current_location == 2)
		dare_zone_3.SetVisible(show_zone && current_location == 3)

	GetLocationChangeCost:
		if location_cost_step <= 0
			_result = 10
		elseif location_cost_step == 1
			_result = 12
		elseif location_cost_step == 2
			_result = 15
		else
			_result = 18

	ChangeLocation:
		cost_ep = GetLocationChangeCost()
		if ep < cost_ep
			return
		ep = ep - cost_ep
		if current_location == 0
			next_roll = RandomInt(0, 2)
			if next_roll == 0
				SetActiveLocation(_location=1)
			elseif next_roll == 1
				SetActiveLocation(_location=2)
			else
				SetActiveLocation(_location=3)
		elseif current_location == 1
			next_roll = RandomInt(0, 2)
			if next_roll == 0
				SetActiveLocation(_location=0)
			elseif next_roll == 1
				SetActiveLocation(_location=2)
			else
				SetActiveLocation(_location=3)
		elseif current_location == 2
			next_roll = RandomInt(0, 2)
			if next_roll == 0
				SetActiveLocation(_location=0)
			elseif next_roll == 1
				SetActiveLocation(_location=1)
			else
				SetActiveLocation(_location=3)
		else
			next_roll = RandomInt(0, 2)
			if next_roll == 0
				SetActiveLocation(_location=0)
			elseif next_roll == 1
				SetActiveLocation(_location=1)
			else
				SetActiveLocation(_location=2)
		SetPlayerPosition(position=GetCurrentPosition())
		if location_cost_step < 3
			location_cost_step = location_cost_step + 1
		location_cost_idle = 0
		RefreshZoneVisibility()

	RandomCrowdedAvatar:
		avatar_roll = RandomInt(0, 3)
		_result = "NewFemale"
		if avatar_roll == 1
			_result = "PreviousFemale"
		elseif avatar_roll == 2
			_result = "NewMale"
		elseif avatar_roll == 3
			_result = "PreviousMale"

	GetCrowdedPhoneUseDuration:
		_result = RandomInt(24, 70)

	GetCrowdedPhoneBreakDuration:
		_result = RandomInt(5, 7)

	SpawnCrowdedNPCs:
		crowded_npcs = CreateList()
		crowded_data = CreateList()
		crowded_data.Insert(CreateList(position=Vector(-9.30, -0.10, -72.29), rotation=Quaternion(0.00000, 0.99983, 0.00000, -0.01833)))
		crowded_data.Insert(CreateList(position=Vector(7.16, -0.09, -85.67), rotation=Quaternion(0.00000, 0.24277, 0.00000, 0.97009)))
		crowded_data.Insert(CreateList(position=Vector(-1.33, -0.08, -77.36), rotation=Quaternion(0.00000, 0.72718, 0.00000, 0.68645)))
		crowded_data.Insert(CreateList(position=Vector(-0.24, -0.08, -77.40), rotation=Quaternion(0.00000, -0.69529, 0.00000, 0.71873)))
		crowded_data.Insert(CreateList(position=Vector(15.06, -0.09, -80.43), rotation=Quaternion(0.00000, 0.02967, 0.00000, 0.99956)))
		crowded_data.Insert(CreateList(position=Vector(7.97, -0.09, -96.40), rotation=Quaternion(0.00000, 0.97815, 0.00000, 0.20791)))
		crowded_data.Insert(CreateList(position=Vector(6.98, -0.11, -111.80), rotation=Quaternion(0.00000, 0.17623, 0.00000, 0.98435)))
		crowded_data.Insert(CreateList(position=Vector(-4.27, -0.11, -103.09), rotation=Quaternion(0.00000, -0.55048, 0.00000, 0.83485)))
		crowded_data.Insert(CreateList(position=Vector(-13.41, -0.11, -95.45), rotation=Quaternion(0.00000, 0.92751, 0.00000, -0.37381)))
		crowded_data.Insert(CreateList(position=Vector(-26.32, -0.11, -100.20), rotation=Quaternion(0.00000, 0.82264, 0.00000, 0.56856)))
		crowded_data.Insert(CreateList(position=Vector(-0.89, -0.11, -98.50), rotation=Quaternion(0.00000, 0.94322, 0.00000, 0.33216)))
		crowded_data.Insert(CreateList(position=Vector(-12.87, -0.11, -85.13), rotation=Quaternion(0.00000, 0.30487, 0.00000, 0.95240)))
		crowded_i = 0
		while crowded_i < crowded_data.Count()
			crowded_info = crowded_data[crowded_i]
			crowded_npc = CreateNPC(RandomCrowdedAvatar(), position=crowded_info.position, rotation=crowded_info.rotation)
			crowded_npc.SkipStrangeness(false)
			crowded_npc.CanGameOver(true)
			crowded_npc.Smartphone(true)
			crowded_npc.Headset(false)
			crowded_npc.Stopped(false)
			crowded_npc.ClearWaypoints()
			crowded_npc.AddWaypoint(crowded_info.position)
			crowded_npcs.Insert(CreateList(npc=crowded_npc, phone=true, timer=GetCrowdedPhoneUseDuration()))
			crowded_i = crowded_i + 1

	UpdateCrowdedNPCs:
		crowded_i = 0
		while crowded_i < crowded_npcs.Count()
			crowded_entry = crowded_npcs[crowded_i]
			if crowded_entry.npc != null
				crowded_entry.timer = crowded_entry.timer - _delta
				if crowded_entry.timer <= 0
					if crowded_entry.phone
						crowded_entry.phone = false
						crowded_entry.timer = GetCrowdedPhoneBreakDuration()
						crowded_entry.npc.Smartphone(false)
					else
						crowded_entry.phone = true
						crowded_entry.timer = GetCrowdedPhoneUseDuration()
						crowded_entry.npc.Smartphone(true)
			crowded_i = crowded_i + 1

	RetireCrowdedNPC:
		if npc != null
			if npc.IsAlive()
				npc.SkipStrangeness(true)
				npc.CanGameOver(false)
				npc.Smartphone(false)
				npc.Headset(false)
				npc.Stopped(false)
				npc.Warp(position=Vector(retire_x, -0.11, -145))
				npc.ClearWaypoints()
				npc.AddWaypoint(Vector(retire_x + 1, -0.11, -145), last=true)

	CleanupCrowdedNPCs:
		crowded_i = 0
		while crowded_i < crowded_npcs.Count()
			crowded_entry = crowded_npcs[crowded_i]
			RetireCrowdedNPC(npc=crowded_entry.npc, retire_x=80 + crowded_i)
			crowded_i = crowded_i + 1
		crowded_npcs = CreateList()

	MoveCoatAway:
		DropItem(itemtype="Coat", position=_state.Position, compass=false)
		CollectItem(itemtype="Coat")
		coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
		DropItem(itemtype="Coat", stage="Apart", position=coat_away_pos, compass=false)
		coat_moved = true

	RestoreCoat:
		if coat_moved
			CollectItem(itemtype="Coat")
			coat_return_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
			DropItem(itemtype="Coat", position=coat_return_pos, compass=false)
			coat_moved = false
		coat_locked_for_run = false

	TrackEarnedRP:
		current_rp_total = GetCurrentEarnRP()
		rp_gain = current_rp_total - rp_last_total
		if rp_gain > 0
			rp_bank = rp_bank + rp_gain
			while rp_bank >= 10
				rp_bank = rp_bank - 10
				ep = ep + 1
		rp_last_total = current_rp_total

	MapCommonRollToEvent:
		if _roll == 0
			_result = 1
		elseif _roll == 1
			_result = 2
		elseif _roll == 2
			_result = 3
		elseif _roll == 3
			if coat_moved
				_result = 5
			else
				_result = 4
		elseif _roll == 4
			_result = 6
		elseif _roll == 5
			_result = 7
		elseif _roll == 6
			_result = 8
		elseif _roll == 7
			_result = 9
		else
			_result = 10

	IsVibeEvent:
		_result = _event == 8 || _event == 9 || _event == 10

	CommonEventAllowed:
		if (_event == 4 || _event == 5) && (coat_locked_for_run || poll_has_bodypaint_rare)
			_result = false
		else
			_result = true

	IsRareEvent:
		_result = _event == 15 || _event == 16 || _event == 17

	RollRareEvent:
		attempts = 0
		while attempts < 40
			rare_roll = RandomInt(0, 2)
			if rare_roll == 0
				rare_event = 15
			elseif rare_roll == 1
				rare_event = 16
			else
				rare_event = 17
			if rare_event != previous_rare_event
				if rare_event != 15 || rare_bodypaint_done == false
					_result = rare_event
					return
			attempts = attempts + 1
		if rare_bodypaint_done == false && previous_rare_event != 15
			_result = 15
		elseif previous_rare_event != 16
			_result = 16
		elseif previous_rare_event != 17
			_result = 17
		elseif rare_bodypaint_done == false
			_result = 15
		else
			_result = 16

	RollCommonEvent:
		attempts = 0
		while attempts < 120
			common_roll = RandomInt(0, 8)
			common_event = MapCommonRollToEvent(_roll=common_roll)
			if common_event != _exclude0 && common_event != _exclude1 && common_event != _exclude2 && common_event != _block0 && common_event != _block1 && common_event != _block2 && CommonEventAllowed(_event=common_event)
				if _has_vibe == false || IsVibeEvent(_event=common_event) == false
					_result = common_event
					return
			attempts = attempts + 1
		if coat_moved
			chain_event = 5
		else
			chain_event = 4
			
		if chain_event != _exclude0 && chain_event != _exclude1 && chain_event != _exclude2 && chain_event != _block0 && chain_event != _block1 && chain_event != _block2 && CommonEventAllowed(_event=chain_event)
			_result = chain_event
			return
		if 1 != _exclude0 && 1 != _exclude1 && 1 != _exclude2 && 1 != _block0 && 1 != _block1 && 1 != _block2
			_result = 1
			return
		if 2 != _exclude0 && 2 != _exclude1 && 2 != _exclude2 && 2 != _block0 && 2 != _block1 && 2 != _block2
			_result = 2
			return
		if 3 != _exclude0 && 3 != _exclude1 && 3 != _exclude2 && 3 != _block0 && 3 != _block1 && 3 != _block2
			_result = 3
			return
		if 6 != _exclude0 && 6 != _exclude1 && 6 != _exclude2 && 6 != _block0 && 6 != _block1 && 6 != _block2
			_result = 6
			return
		if 7 != _exclude0 && 7 != _exclude1 && 7 != _exclude2 && 7 != _block0 && 7 != _block1 && 7 != _block2
			_result = 7
			return
		if _has_vibe == false
			if 8 != _exclude0 && 8 != _exclude1 && 8 != _exclude2 && 8 != _block0 && 8 != _block1 && 8 != _block2
				_result = 8
				return
			if 9 != _exclude0 && 9 != _exclude1 && 9 != _exclude2 && 9 != _block0 && 9 != _block1 && 9 != _block2
				_result = 9
				return
			if 10 != _exclude0 && 10 != _exclude1 && 10 != _exclude2 && 10 != _block0 && 10 != _block1 && 10 != _block2
				_result = 10
				return
		_result = 1

	IsTimeEventBlacklisted:
		if _event == 11
			_result = time_event_11_blacklisted
		elseif _event == 12
			_result = time_event_12_blacklisted
		elseif _event == 13
			_result = time_event_13_blacklisted
		elseif _event == 14
			_result = time_event_14_blacklisted
		else
			_result = true

	RollTimeEvent:
		attempts = 0
		while attempts < 80
			time_roll = RandomInt(0, 3)
			if time_roll == 0
				time_event = 11
			elseif time_roll == 1
				time_event = 12
			elseif time_roll == 2
				time_event = 13
			else
				time_event = 14
			if time_event != previous_time_event && IsTimeEventBlacklisted(_event=time_event) == false
				_result = time_event
				return
			attempts = attempts + 1
		if previous_time_event != 11 && time_event_11_blacklisted == false
			_result = 11
		elseif previous_time_event != 12 && time_event_12_blacklisted == false
			_result = 12
		elseif previous_time_event != 13 && time_event_13_blacklisted == false
			_result = 13
		elseif previous_time_event != 14 && time_event_14_blacklisted == false
			_result = 14
		elseif time_event_11_blacklisted == false
			_result = 11
		elseif time_event_12_blacklisted == false
			_result = 12
		elseif time_event_13_blacklisted == false
			_result = 13
		elseif time_event_14_blacklisted == false
			_result = 14
		else
			_result = 0

	EventInPoll:
		_result = current_event_0 == _event || current_event_1 == _event || current_event_2 == _event || current_event_3 == _event

	EventHidden:
		if _event == 4
			_result = poll_coat_remove_done
		elseif _event == 5
			_result = poll_coat_return_done
		elseif _event == 6
			_result = poll_orgasm_exposed_done
		elseif _event == 7
			_result = poll_dildo_orgasm_done
		elseif _event == 11
			_result = poll_time_event_11_done
		elseif _event == 12
			_result = poll_time_event_12_done
		elseif _event == 13
			_result = poll_time_event_13_done
		elseif _event == 14
			_result = poll_time_event_14_done
		elseif _event == 15
			_result = rare_bodypaint_done
		elseif _event == 16
			_result = poll_rare_detection_50_done
		elseif _event == 17
			_result = poll_rare_detection_70_done
		else
			_result = false

	RollSpecialEvents:
		previous_common_0 = current_event_0
		previous_common_1 = current_event_1
		previous_common_2 = current_event_2
		previous_time_event = current_event_3
		previous_rare_event = 0
		if IsRareEvent(_event=current_event_0)
			previous_rare_event = current_event_0
		elseif IsRareEvent(_event=current_event_1)
			previous_rare_event = current_event_1
		elseif IsRareEvent(_event=current_event_2)
			previous_rare_event = current_event_2
		rare_candidate = 0
		rare_slot = -1
		if RandomInt(0, 2) == 0
			rare_candidate = RollRareEvent()
			rare_slot = RandomInt(0, 2)
		poll_has_bodypaint_rare = rare_candidate == 15
		current_event_0 = 0
		current_event_1 = 0
		current_event_2 = 0
		has_vibe_now = false
		if rare_slot == 0
			current_event_0 = rare_candidate
		else
			current_event_0 = RollCommonEvent(_exclude0=0, _exclude1=0, _exclude2=0, _block0=previous_common_0, _block1=previous_common_1, _block2=previous_common_2, _has_vibe=false)
		has_vibe_now = IsVibeEvent(_event=current_event_0)
		if rare_slot == 1
			current_event_1 = rare_candidate
		else
			current_event_1 = RollCommonEvent(_exclude0=current_event_0, _exclude1=0, _exclude2=0, _block0=previous_common_0, _block1=previous_common_1, _block2=previous_common_2, _has_vibe=has_vibe_now)
		if has_vibe_now == false
			has_vibe_now = IsVibeEvent(_event=current_event_1)
		if rare_slot == 2
			current_event_2 = rare_candidate
		else
			current_event_2 = RollCommonEvent(_exclude0=current_event_0, _exclude1=current_event_1, _exclude2=0, _block0=previous_common_0, _block1=previous_common_1, _block2=previous_common_2, _has_vibe=has_vibe_now)
		current_event_3 = RollTimeEvent()
		special_poll_remaining = special_poll_duration
		ResetPollProgress()

	UpdatePassiveEP:
		exposed_now = condition_exposed_any.Check()
		passive_second_timer = passive_second_timer + _timediff
		while passive_second_timer >= 1
			passive_second_timer = passive_second_timer - 1
			if exposed_now
				if EventInPoll(_event=1) && condition_eyemask.Check()
					ep = ep + 0.50
				if EventInPoll(_event=2) && (condition_handcuffs_back.Check() || condition_handcuffs_object.Check())
					ep = ep + 0.50
				if EventInPoll(_event=3) && condition_peeing.Check()
					ep = ep + 1
				if EventInPoll(_event=8)
					if condition_vibrator_low.Check()
						ep = ep + 0.20
					if condition_titrotor_low.Check()
						ep = ep + 0.20
					if condition_kurirotor_low.Check()
						ep = ep + 0.20
				if EventInPoll(_event=9)
					if condition_vibrator_high.Check()
						ep = ep + 0.50
					if condition_titrotor_high.Check()
						ep = ep + 0.50
					if condition_kurirotor_high.Check()
						ep = ep + 0.50
				if EventInPoll(_event=10)
					if condition_vibrator_random.Check()
						ep = ep + 0.25
					if condition_titrotor_random.Check()
						ep = ep + 0.25
					if condition_kurirotor_random.Check()
						ep = ep + 0.25

	UpdateCommonEvents:
		if EventInPoll(_event=4)
			if poll_coat_remove_done == false
				if condition_exposed_all.Check()
					coat_remove_timer = coat_remove_timer + _timediff
				else
					coat_remove_timer = 0
				if coat_remove_timer >= 30
					ep = ep + 20
					MoveCoatAway()
					poll_coat_remove_done = true
					coat_remove_timer = 0
		else
			coat_remove_timer = 0

		if EventInPoll(_event=5) && poll_coat_return_done == false
			if _orgasm_triggered
				RestoreCoat()
				poll_coat_return_done = true

		if EventInPoll(_event=6)
			if poll_orgasm_exposed_done == false
				if _orgasm_triggered && condition_exposed_any.Check()
					orgasm_exposed_count = orgasm_exposed_count + 1
					if orgasm_exposed_count >= 2
						ep = ep + 10
						poll_orgasm_exposed_done = true
		else
			orgasm_exposed_count = 0

		if EventInPoll(_event=7)
			if poll_dildo_orgasm_done == false
				if _orgasm_triggered && condition_dildo_any.Check()
					dildo_orgasm_count = 1
					ep = ep + 10
					poll_dildo_orgasm_done = true
		else
			dildo_orgasm_count = 0

	UpdateTimeEvents:
		if EventInPoll(_event=11)
			if poll_time_event_11_done == false
				if condition_eyemask.Check() && condition_exposed_any.Check()
					time_event_11_timer = time_event_11_timer + _timediff
				else
					time_event_11_timer = 0
				if _orgasm_triggered
					time_event_11_orgasm_count = time_event_11_orgasm_count + 1
				if time_event_11_timer >= 30 && time_event_11_orgasm_count >= 1
					remaining = remaining + 60
					poll_time_event_11_done = true
					time_event_11_blacklisted = true
		else
			time_event_11_timer = 0
			time_event_11_orgasm_count = 0

		if EventInPoll(_event=12)
			if poll_time_event_12_done == false
				if condition_eyemask.Check() && condition_handcuffs_object.Check()
					time_event_12_timer = time_event_12_timer + _timediff
				else
					time_event_12_timer = 0
				if time_event_12_timer >= 30
					remaining = remaining + 60
					poll_time_event_12_done = true
					time_event_12_blacklisted = true
		else
			time_event_12_timer = 0

		if EventInPoll(_event=13)
			if poll_time_event_13_done == false
				if _orgasm_triggered && condition_exposed_all.Check()
					time_event_13_orgasm_count = time_event_13_orgasm_count + 1
					if time_event_13_orgasm_count >= 2
						remaining = remaining + 60
						poll_time_event_13_done = true
						time_event_13_blacklisted = true
		else
			time_event_13_orgasm_count = 0

		if EventInPoll(_event=14)
			if poll_time_event_14_done == false
				if condition_exposed_any.Check() && condition_vibrator_high.Check() && condition_titrotor_high.Check() && condition_kurirotor_high.Check()
					time_event_14_timer = time_event_14_timer + _timediff
				else
					time_event_14_timer = 0
				if time_event_14_timer >= 30
					remaining = remaining + 60
					poll_time_event_14_done = true
					time_event_14_blacklisted = true
		else
			time_event_14_timer = 0

	UpdateRareEvents:
		if EventInPoll(_event=15) && rare_bodypaint_done == false
			if condition_bodypaint.Check()
				ep = ep + 15
				if coat_moved == false
					MoveCoatAway()
				coat_locked_for_run = true
				rare_bodypaint_done = true
				poll_has_bodypaint_rare = false

		if EventInPoll(_event=16)
			if poll_rare_detection_50_done == false
				if _state.Detection >= 0.5 && condition_exposed_all.Check()
					rare_detection_50_timer = rare_detection_50_timer + _timediff
				else
					rare_detection_50_timer = 0
				if rare_detection_50_timer >= 30
					ep = ep + 15
					poll_rare_detection_50_done = true
		else
			rare_detection_50_timer = 0

		if EventInPoll(_event=17)
			if poll_rare_detection_70_done == false
				if _state.Detection >= 0.7 && condition_exposed_all.Check()
					rare_detection_70_timer = rare_detection_70_timer + _timediff
				else
					rare_detection_70_timer = 0
				if rare_detection_70_timer >= 30
					ep = ep + 25
					poll_rare_detection_70_done = true
		else
			rare_detection_70_timer = 0

	FormatTimeEvent:
		_result = "<i>" + _text + "</i>"

	BuildEventText:
		if _event == 1
			_result = "+ Blindfold while exposed : +0.50 EP/s"
		elseif _event == 2
			_result = "+ Handcuffed while exposed : +0.50 EP/s"
		elseif _event == 3
			_result = "+ Peeing while exposed : +1 EP/s"
		elseif _event == 4
			coat_remove_left = 30 - Floor(coat_remove_timer)
			_result = "* Naked to remove the Coat : " + coat_remove_left + "s  Reward 20 EP"
		elseif _event == 5
			_result = "* Orgasm 1 time to retrieve the Coat : 0/1"
		elseif _event == 6
			_result = "* Orgasm 2 times while exposed : " + orgasm_exposed_count + "/2  Reward 10 EP"
		elseif _event == 7
			_result = "* Using Dildo and Orgasm 1 time : " + dildo_orgasm_count + "/1  Reward 10 EP"
		elseif _event == 8
			_result = "+ Each Vibrator toy in Low speed while exposed : +0.20 EP/s"
		elseif _event == 9
			_result = "+ Each Vibrator toy in High speed while exposed : +0.50 EP/s"
		elseif _event == 10
			_result = "+ Each Vibrator toy in Random speed while exposed : +0.25 EP/s"
		elseif _event == 11
			time_event_11_left = 30 - Floor(time_event_11_timer)
			_result = FormatTimeEvent(_text="* Blindfold while exposed, then Orgasm 1 time : " + time_event_11_left + "s  Extend 60s")
		elseif _event == 12
			time_event_12_left = 30 - Floor(time_event_12_timer)
			_result = FormatTimeEvent(_text="* Blindfold + Object Handcuff : " + time_event_12_left + "s  Extend 60s")
		elseif _event == 13
			_result = FormatTimeEvent(_text="* While Naked, Orgasm 2 times : " + time_event_13_orgasm_count + "/2  Extend 60s")
		elseif _event == 14
			time_event_14_left = 30 - Floor(time_event_14_timer)
			_result = FormatTimeEvent(_text="* While exposed, use all 3 Vibrators at High speed : " + time_event_14_left + "s  Extend 60s")
		elseif _event == 15
			_result = "* Bodypaint to remove the Coat permanently : Reward 15 EP"
		elseif _event == 16
			rare_detection_50_left = 30 - Floor(rare_detection_50_timer)
			_result = "* Detection Risk no lower than 50% and Naked : " + rare_detection_50_left + "s  Reward 15 EP"
		else
			rare_detection_70_left = 30 - Floor(rare_detection_70_timer)
			_result = "* Detection Risk no lower than 70% and Naked : " + rare_detection_70_left + "s  Reward 25 EP"
	BuildSpecialText:
		result_text = "<size=112%><b>Special Events will change in : " + Floor(special_poll_remaining) + "s</b></size>"
		if current_event_0 != 0 && EventHidden(_event=current_event_0) == false
			result_text = result_text + "\n<size=110%>" + BuildEventText(_event=current_event_0) + "</size>"
		if current_event_1 != 0 && EventHidden(_event=current_event_1) == false
			result_text = result_text + "\n<size=110%>" + BuildEventText(_event=current_event_1) + "</size>"
		if current_event_2 != 0 && EventHidden(_event=current_event_2) == false
			result_text = result_text + "\n<size=110%>" + BuildEventText(_event=current_event_2) + "</size>"
		if current_event_3 != 0 && EventHidden(_event=current_event_3) == false
			result_text = result_text + "\n<size=110%>" + BuildEventText(_event=current_event_3) + "</size>"
		result_text = result_text + "\n\nPress ] to change the location , Cost " + GetLocationChangeCost() + " EP"
		result_text = result_text + "\nPress [ to show/hide the Special Mission Panel"
		_result = result_text
	RefreshOverlays:
		ep_text = "Exposure Point: " + Floor(ep)
		if ep_overlay_flip == 0
			ep_overlay.Clear()
			ep_overlay.Add(text=ep_text, duration=-1)
			ep_overlay_alt.Clear()
			ep_overlay_flip = 1
		else
			ep_overlay_alt.Clear()
			ep_overlay_alt.Add(text=ep_text, duration=-1)
			ep_overlay.Clear()
			ep_overlay_flip = 0
		status_text = "Dare Time: " + Floor(remaining) + "s"
		if remaining <= 60
			status_text = "<color=#ff3333>" + status_text + "</color>"
		if status_overlay_flip == 0
			status_overlay.Clear()
			status_overlay.Add(text=status_text, duration=-1)
			status_overlay_alt.Clear()
			status_overlay_flip = 1
		else
			status_overlay_alt.Clear()
			status_overlay_alt.Add(text=status_text, duration=-1)
			status_overlay.Clear()
			status_overlay_flip = 0
		special_overlay.Clear()
		special_overlay_alt.Clear()
		if special_visible
			special_text = BuildSpecialText()
			if special_overlay_flip == 0
				special_overlay.Add(text=special_text, duration=-1)
				special_overlay_flip = 1
			else
				special_overlay_alt.Add(text=special_text, duration=-1)
				special_overlay_flip = 0
	ClearOverlays:
		ep_overlay.Clear()
		ep_overlay_alt.Clear()
		status_overlay.Clear()
		status_overlay_alt.Clear()
		special_overlay.Clear()
		special_overlay_alt.Clear()

	Finish:
		last_ep = Floor(ep)
		if _save.ManakaPlusV2ResidenceDareBestEP == null
			_save.ManakaPlusV2ResidenceDareBestEP = 0
		if last_ep > _save.ManakaPlusV2ResidenceDareBestEP
			_save.ManakaPlusV2ResidenceDareBestEP = last_ep
		best_ep = Floor(_save.ManakaPlusV2ResidenceDareBestEP)
		if _save.ManakaPlusV2DaringSilverMedalOwned == null
			_save.ManakaPlusV2DaringSilverMedalOwned = false
		if _save.ManakaPlusV2DaringGoldMedalOwned == null
			_save.ManakaPlusV2DaringGoldMedalOwned = false
		if _save.ManakaPlusV2DaringChampionMedalOwned == null
			_save.ManakaPlusV2DaringChampionMedalOwned = false
		if best_ep >= 200
			_save.ManakaPlusV2DaringSilverMedalOwned = true
		if best_ep >= 400
			_save.ManakaPlusV2DaringGoldMedalOwned = true
		if last_ep >= 300 && champion_detection_qualified
			_save.ManakaPlusV2DaringChampionMedalOwned = true
		reward_overlay.Clear()
		reward_overlay.Add(text="Dare Completed\n" + last_ep + " EP Saved\nBest Record: " + best_ep + " EP")
		reward_overlay_timer = 5
		completed_signal = true
		CleanupRuntime()

	Cancel:
		completed_signal = false
		CleanupRuntime()

	CleanupRuntime:
		active = false
		state = 0
		dare_zone_0.SetVisible(false)
		dare_zone_1.SetVisible(false)
		dare_zone_2.SetVisible(false)
		dare_zone_3.SetVisible(false)
		main_panel.SetVisible(false)
		ClearOverlays()
		CleanupCrowdedNPCs()
		RestoreCoat()
		prepare_timer = 0
		passive_second_timer = 0
		current_event_0 = 0
		current_event_1 = 0
		current_event_2 = 0
		current_event_3 = 0
		previous_common_0 = 0
		previous_common_1 = 0
		previous_common_2 = 0
		previous_time_event = 0
		previous_rare_event = 0
		poll_has_bodypaint_rare = false
		rare_bodypaint_done = false
		rare_detection_50_timer = 0
		rare_detection_70_timer = 0
		poll_rare_detection_50_done = false
		poll_rare_detection_70_done = false
		overlay_refresh_timer = 0
		zone_check_timer = 0
		npc_update_timer = 0
		location_cost_step = 0
		location_cost_idle = 0
		champion_detection_qualified = false
		ResetPollProgress()

	update:
		if reward_overlay_timer > 0
			reward_overlay_timer = reward_overlay_timer - _timediff
			if reward_overlay_timer <= 0
				reward_overlay.Clear()
		if active
			npc_update_timer = npc_update_timer + _timediff
			if npc_update_timer >= 0.25
				UpdateCrowdedNPCs(_delta=npc_update_timer)
				npc_update_timer = 0
			if _state.Position.stage != "Residence"
				Cancel()
			else
				if champion_detection_qualified && _state.Detection < 0.8
					champion_detection_qualified = false
				zone_check_timer = zone_check_timer + _timediff
				if zone_check_timer >= 0.10
					zone_check_timer = 0
					if CurrentZoneInside() == false
						SetPlayerPosition(position=GetCurrentPosition())
				if state == 2
					TrackEarnedRP()
					location_cost_idle = location_cost_idle + _timediff
					if location_cost_step > 0 && location_cost_idle >= 60
						location_cost_step = 0
						location_cost_idle = 0
					orgasm_now = condition_orgasm.Check()
					orgasm_triggered = orgasm_now && orgasm_was_active == false
					UpdateCommonEvents(_orgasm_triggered=orgasm_triggered)
					UpdateRareEvents()
					UpdateTimeEvents(_orgasm_triggered=orgasm_triggered)
					orgasm_was_active = orgasm_now
					UpdatePassiveEP()
					special_poll_remaining = special_poll_remaining - _timediff
					if special_poll_remaining <= 0
						RollSpecialEvents()
					if input_special_toggle.WasPressed()
						if special_visible
							special_visible = false
						else
							special_visible = true
						overlay_refresh_timer = 1
					if input_change_location.WasPressed()
						ChangeLocation()
						overlay_refresh_timer = 1
					overlay_refresh_timer = overlay_refresh_timer + _timediff
					if overlay_refresh_timer >= 0.20
						overlay_refresh_timer = 0
						RefreshOverlays()
					second_timer = second_timer + _timediff
					while second_timer >= 1
						second_timer = second_timer - 1
						remaining = remaining - 1
						elapsed = elapsed + 1
					if remaining <= 0
						Finish()
