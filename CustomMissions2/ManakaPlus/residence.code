# ============================================================
# RESIDENCE
# ============================================================
manakaplus_v22_residence:
	thread = _this
	mission_active = false
	active_stage = ""
	residence_crowded_spawn_limit = 50
	residence_crowded_active = false
	residence_npc_spawn_timer = 0
	residence_npc_active = CreateList()
	residence_npc_spawn_points = CreateList()
	residence_stationary_npcs = CreateList()
	residence_community_chat = null
	residence_community_active = false
	residence_community_state = 0
	residence_community_panel = CreateMissionPanel()
	residence_community_panel.SetVisible(false)
	residence_community_panel.SetGaugeVisible(false)
	residence_community_panel.SetRPText("")
	residence_community_zone = null
	residence_community_duration = 0
	residence_community_start_pos = null
	residence_community_dest_pos = Vector(-12.86, -0.09, -82.28)
	residence_community_total_distance = 0
	residence_community_pee_dog = null
	residence_community_pee_stand = null
	residence_community_pee_spread = null
	residence_community_reward_timer = 0
	manaka_points = CreateThread("manakaplus_v22_manaka_points")
	residence_community_reward_overlay = CreateText()
	residence_community_reward_overlay.SetAnchor(0.5, 0.5)
	residence_community_reward_overlay.SetAlignment("Top")
	residence_community_reward_overlay.SetSize(36)
	residence_community_reward_overlay.SetWidth(1200)
	residence_community_reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	residence_community_reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	residence_community_reward_overlay.SetFrontLayer(true)
	residence_community_reward_overlay.Clear()
	warning_sound = CreateAudio("Asset/Simple_ding_sound.mp3")
	sandbox_missions = CreateThread("manakaplus_v22_residence_sandbox")

	idle:
		mission_active = false

	start_residence:
		warning_sound.Play()
		mission_active = true
		active_stage = "Residence"
		mainthread.UpdateHub()
		residence_crowded_active = crowded_enabled
		residence_crowded_spawn_limit = crowded_limit
		residence_npc_spawn_timer = 0
		residence_npc_active = CreateList()
		residence_npc_spawn_points = CreateList()
		residence_stationary_npcs = CreateList()

		if _state.Sitting
			SetAction("StandUp")

		SetStage("Residence")
		teleport_wait = 0
		listener = CreateListenerLocal("residence_teleport_wait")

	residence_teleport_wait:
		if mission_active
			teleport_wait = teleport_wait + _timediff
			if teleport_wait > 0.5
				SetPlayerPosition(x=-29.66, y=-0.10, z=-121.48, rx=0.00000, ry=1.00000, rz=0.00000, rw=0.00000)
				thread.Goto("residence_start")

	residence_start:
		# Residence-only mission Contacts are created after the real map is ready.
		sandbox_missions.Start()

		# The Town Community is recreated for every Residence run, like the Park contacts.
		residence_community_active = true
		residence_community_state = 0
		residence_community_duration = 0
		residence_community_reward_timer = 0
		residence_community_reward_overlay.Clear()
		residence_community_chat = CreateMessengerChat("小镇社区群", iconcolor = Color(0.2,0.65,0.35), icontext = "TC", icontextcolor = Color(1,1,1))
		residence_community_chat.Add("操你妈的，埃德加又买新车了？上次做生意他还欠我差不多7000块，都五个月了！那个傻逼根本不在这个群里，对吧？", "Left", user="Hank", silent=false)
		residence_community_chat.Add("注意用词，汉克", "Left", user="Cindy_moderator", silent=false)
		residence_community_chat.Add("珊迪关你屁事", "Left", user="Hank", silent=false)
		residence_community_chat.Add("[汉克已被移出群聊]", "Left", user="System", silent=true)
		residence_community_chat.Add("对，是一辆白色丰田AE86，我没记错的话。他上周五酒吧那晚还欠我 200 块", "Left", user="Bob", silent=false)
		residence_community_chat.SetButtons("看来有人刚买了新车")

		community_area = CreateArea(type="sphere", stage="Residence", x=-12.86, y=-0.09, z=-82.28, r=0.5, outline=true, compass=true)
		residence_community_zone = CreateZone(community_area)
		residence_community_zone.SetVisible(false)
		residence_community_zone.SetColor(0.3,0.8,1)
		residence_community_pee_dog = CreateCondition("[Action_PeeDog]")
		residence_community_pee_stand = CreateCondition("[Action_PeeStand]")
		residence_community_pee_spread = CreateCondition("[Action_PeeKaikyaku]")
		community_button_listener = CreateListenerLocal("residence_community_button_listener")
		community_mission_listener = CreateListenerLocal("residence_community_mission_listener")


		if residence_crowded_active
			# Nine verified route endpoints. Walkers always travel to a different group.
			residence_npc_spawn_points = CreateList()
			residence_npc_spawn_points.Insert(CreateList(group="A", position=Vector(-36.01, -0.11, -67.53), rotation=Quaternion(0.00000, 0.99982, 0.00000, -0.01922)))
			residence_npc_spawn_points.Insert(CreateList(group="A", position=Vector(-47.65, -0.11, -76.54), rotation=Quaternion(0.00000, 0.71243, 0.00000, 0.70174)))
			residence_npc_spawn_points.Insert(CreateList(group="B", position=Vector(40.30, -0.11, -78.88), rotation=Quaternion(0.00000, -0.71140, 0.00000, 0.70278)))
			residence_npc_spawn_points.Insert(CreateList(group="B", position=Vector(29.16, -0.11, -69.80), rotation=Quaternion(0.00000, 0.99972, 0.00000, -0.02359)))
			residence_npc_spawn_points.Insert(CreateList(group="C", position=Vector(43.36, -0.11, -120.57), rotation=Quaternion(0.00000, -0.70770, 0.00000, 0.70652)))
			residence_npc_spawn_points.Insert(CreateList(group="C", position=Vector(29.04, -0.11, -128.59), rotation=Quaternion(0.00000, 0.01313, 0.00000, 0.99991)))
			residence_npc_spawn_points.Insert(CreateList(group="D", position=Vector(-10.12, -0.11, -119.55), rotation=Quaternion(0.00000, -0.70584, 0.00000, 0.70837)))
			residence_npc_spawn_points.Insert(CreateList(group="D", position=Vector(-27.45, -0.10, -124.74), rotation=Quaternion(0.00000, -0.00099, 0.00000, 1.00000)))
			residence_npc_spawn_points.Insert(CreateList(group="E", position=Vector(-43.74, -0.09, -94.10), rotation=Quaternion(0.00000, 0.73375, 0.00000, 0.67942)))

			# Nine stationary residents. A zero-distance waypoint settles their idle animation without retiring them.
			stationary_data = CreateList()
			stationary_data.Insert(CreateList(position=Vector(-4.32, -0.11, -109.16), rotation=Quaternion(0.00000, 0.05845, 0.00000, 0.99829), phone=false, headset=false))
			stationary_data.Insert(CreateList(position=Vector(-4.36, -0.11, -110.13), rotation=Quaternion(0.00000, -0.71325, 0.00000, 0.70091), phone=true, headset=false))
			stationary_data.Insert(CreateList(position=Vector(-16.84, -0.11, -124.85), rotation=Quaternion(0.00000, 0.03224, 0.00000, 0.99948), phone=true, headset=false))
			stationary_data.Insert(CreateList(position=Vector(-14.26, -0.11, -112.60), rotation=Quaternion(0.00000, -0.22410, 0.00000, 0.97457), phone=false, headset=true))
			stationary_data.Insert(CreateList(position=Vector(-1.33, -0.11, -100.09), rotation=Quaternion(0.00000, 0.00786, 0.00000, 0.99997), phone=false, headset=false))
			stationary_data.Insert(CreateList(position=Vector(7.37, -0.11, -121.81), rotation=Quaternion(0.00000, 0.23429, 0.00000, 0.97217), phone=true, headset=false))
			stationary_data.Insert(CreateList(position=Vector(7.83, -0.11, -120.66), rotation=Quaternion(0.00000, 0.98212, 0.00000, -0.18824), phone=false, headset=true))
			stationary_data.Insert(CreateList(position=Vector(-0.17, -0.11, -104.79), rotation=Quaternion(0.00000, -0.84758, 0.00000, 0.53066), phone=false, headset=false))
			stationary_data.Insert(CreateList(position=Vector(-43.19, 0.01, -102.78), rotation=Quaternion(0.00000, 0.95237, 0.00000, -0.30495), phone=false, headset=false))
			i = 0
			while i < stationary_data.Count()
				info = stationary_data[i]
				avatar_roll = RandomInt(0, 4)
				avatar_type = "NewFemale"
				if avatar_roll == 1
					avatar_type = "PreviousFemale"
				if avatar_roll == 2
					avatar_type = "NewMale"
				if avatar_roll == 3
					avatar_type = "PreviousMale"
				npc = CreateNPC(avatar_type, position=info.position, rotation=info.rotation)
				npc.SkipStrangeness(false)
				npc.CanGameOver(true)
				npc.Smartphone(info.phone)
				npc.Headset(info.headset)
				npc.ClearWaypoints()
				npc.AddWaypoint(info.position)
				residence_stationary_npcs.Insert(npc)
				i = i + 1
			crowded_listener = CreateListenerLocal("residence_crowded_listener")

		mainthread.ArmStageWatch()

	residence_community_button_listener:
		if mission_active
			if residence_community_active && residence_community_state == 0
				clicked = residence_community_chat.Clicked()
				if clicked != null
					residence_community_chat.SetButtons()
					residence_community_state = 1
					residence_community_start_pos = Vector(_state.Position.x, _state.Position.y, _state.Position.z)
					residence_community_total_distance = Vector3Distance(residence_community_start_pos, residence_community_dest_pos)
					residence_community_zone.SetVisible(true)
					residence_community_panel.SetVisible(true)
					residence_community_panel.SetText("找到埃德加的白色丰田")
					residence_community_panel.SetRPText("")
					residence_community_panel.SetGaugeVisible(true)
					residence_community_panel.SetGaugeProgress(0)

	residence_community_mission_listener:
		if residence_community_reward_timer > 0
			residence_community_reward_timer = residence_community_reward_timer - _timediff
			if residence_community_reward_timer <= 0
				residence_community_reward_overlay.Clear()
		if mission_active
			if residence_community_active
				if residence_community_state == 1
					community_distance = Vector3Distance(_state.Position, residence_community_dest_pos)
					community_gauge = 0
					if residence_community_total_distance > 0
						if community_distance < residence_community_total_distance
							community_gauge = (residence_community_total_distance - community_distance) / residence_community_total_distance
					residence_community_panel.SetGaugeProgress(community_gauge)
					if residence_community_zone.Inside()
						residence_community_state = 2
						residence_community_duration = 0
						residence_community_panel.SetText("在车上排尿 10 秒")
						residence_community_panel.SetRPText("100 RP + 100 MP")
						residence_community_panel.SetGaugeVisible(true)
						residence_community_panel.SetGaugeProgress(0)

				if residence_community_state == 2
					community_peeing = false
					if residence_community_pee_dog.Check()
						community_peeing = true
					if residence_community_pee_stand.Check()
						community_peeing = true
					if residence_community_pee_spread.Check()
						community_peeing = true
					if residence_community_zone.Inside() && community_peeing
						residence_community_duration = residence_community_duration + _timediff
					else
						residence_community_duration = 0
					residence_community_panel.SetGaugeProgress(residence_community_duration / 10)
					if residence_community_duration >= 10
						AddCurrentEarnRP(100)
						manaka_points.Add(amount=100)
						mainthread.UpdateHub()
						residence_community_reward_overlay.Clear()
						residence_community_reward_overlay.Add(text="100 RP + 100 Manaka Points Added")
						residence_community_reward_timer = 5
						residence_community_state = 3
						residence_community_active = false
						residence_community_zone.SetVisible(false)
						residence_community_panel.SetVisible(false)
						residence_community_chat.Add("[珊迪已邀请埃德加进入群聊]", "Left", user="System", silent=true)
						residence_community_chat.Add("我发誓一定会找到往我车上撒尿的人！我要把那个混蛋整得后悔出生！", "Left", user="Edgar", silent=false)
						residence_community_chat.Add("[鲍勃已邀请汉克进入群聊]", "Left", user="System", silent=true)

	residence_crowded_listener:
		if mission_active
			if residence_crowded_active
				if _state.Position.stage == "Residence"
					# Retired walkers are scene-owned; only drop finished references from our counter.
					i = residence_npc_active.Count() - 1
					while i >= 0
						entry = residence_npc_active[i]
						if entry.npc.Finished()
							residence_npc_active.Remove(i)
						i = i - 1

					residence_npc_spawn_timer = residence_npc_spawn_timer + _timediff
					if residence_npc_spawn_timer >= 5
						residence_npc_spawn_timer = 0
						if residence_npc_active.Count() < residence_crowded_spawn_limit
							spawn_index = RandomInt(0, residence_npc_spawn_points.Count())
							spawn_info = residence_npc_spawn_points[spawn_index]
							destination_index = RandomInt(0, residence_npc_spawn_points.Count())
							while residence_npc_spawn_points[destination_index].group == spawn_info.group
								destination_index = RandomInt(0, residence_npc_spawn_points.Count())
							destination_info = residence_npc_spawn_points[destination_index]

							avatar_roll = RandomInt(0, 4)
							avatar_type = "NewFemale"
							if avatar_roll == 1
								avatar_type = "PreviousFemale"
							if avatar_roll == 2
								avatar_type = "NewMale"
							if avatar_roll == 3
								avatar_type = "PreviousMale"

							npc = CreateNPC(avatar_type, position=spawn_info.position, rotation=spawn_info.rotation)
							npc.SkipStrangeness(false)
							npc.CanGameOver(true)
							npc.Stopped(false)
							accessory_roll = RandomInt(0, 100)
							walker_phone = false
							walker_headset = false
							if accessory_roll < 15
								walker_phone = true
							if accessory_roll >= 15 && accessory_roll < 30
								walker_headset = true
							npc.Smartphone(walker_phone)
							npc.Headset(walker_headset)
							npc.ClearWaypoints()
							npc.AddWaypoint(destination_info.position, last=true)
							residence_npc_active.Insert(CreateList(npc=npc))

	CancelCurrentMission:
		if sandbox_missions.IsActive()
			sandbox_missions.CancelCurrentMission()
		elseif residence_community_state != 0
			residence_community_state = 0
			residence_community_duration = 0
			if residence_community_zone != null
				residence_community_zone.SetVisible(false)
			if residence_community_panel != null
				residence_community_panel.SetVisible(false)
				residence_community_panel.SetGaugeProgress(0)
			if residence_community_chat != null
				residence_community_chat.Clear()
				residence_community_chat.Add("任务已取消，小镇社区群的委托已重新开放", "Left", user="小镇社区群", silent=true)
				residence_community_chat.SetButtons("看来有人刚买了新车")
		mainthread.UpdateHub()

	Cancel:
		sandbox_missions.Reset()
		mission_active = false
		active_stage = ""
		residence_crowded_active = false
		residence_npc_spawn_timer = 0
		residence_npc_active = CreateList()
		residence_npc_spawn_points = CreateList()
		residence_stationary_npcs = CreateList()
		residence_community_active = false
		residence_community_state = 0
		residence_community_duration = 0
		residence_community_reward_timer = 0
		residence_community_reward_overlay.Clear()
		if residence_community_chat != null
			residence_community_chat.SetButtons()
			residence_community_chat.Clear()
			residence_community_chat = null
		if residence_community_zone != null
			residence_community_zone.SetVisible(false)
		if residence_community_panel != null
			residence_community_panel.SetVisible(false)
			residence_community_panel.SetGaugeVisible(false)
			residence_community_panel.SetGaugeProgress(0)
			residence_community_panel.SetRPText("")
		thread.Goto("idle")

# ============================================================
# RESIDENCE SANDBOX
# ============================================================
manakaplus_v22_residence_sandbox:
	thread = _this
	active = false
	contact = null
	contact_was_open = false
	menu_state = "main"
	mission_active = false
	mission_preparing = false
	prepare_step = 0
	prepare_timer = 0
	coat_moved = false
	selected_time = 5
	always_naked = false
	interruptible = true
	locked_mp_reward = 150
	progress = 0
	outfit_lock_timer = 0
	reward_overlay_timer = 0

	done1 = false
	done2 = false
	done3 = false
	done4 = false
	done5 = false
	done6 = false
	rung1 = false
	rung2 = false
	rung3 = false
	rung4 = false
	rung5 = false
	rung6 = false
	armed1 = false
	armed2 = false
	armed3 = false
	armed4 = false
	armed5 = false
	armed6 = false
	timer1 = 0
	timer2 = 0
	timer3 = 0
	timer4 = 0
	timer5 = 0
	timer6 = 0
	allow_bra = false
	allow_panties = false
	allow_necktie = false
	allow_hoodie = false
	allow_shirt = false
	allow_skirt = false
	allow_socks = false
	allow_shoes = false
	outfit_remaining = null

	manaka_points = CreateThread("manakaplus_v22_manaka_points")
	teleporting = CreateThread("manakaplus_v22_residence_teleporting")
	home_sweet_home = CreateThread("manakaplus_v22_residence_home_sweet_home")

	condition_bell = CreateCondition("[Action_Pinpon]")
	condition_daytime = CreateCondition("[IsDayTime]")
	condition_bra = CreateCondition("[Cosplay_m_cosplay_general_upper_bra]")
	condition_panties = CreateCondition("[Cosplay_m_cosplay_general_upper_ultimate_pants]")
	condition_necktie = CreateCondition("[Cosplay_m_cosplay_school_hoodie_necktie]")
	condition_hoodie = CreateCondition("[Cosplay_m_cosplay_school_hoodie_hoodie]")
	condition_shirt = CreateCondition("[Cosplay_m_cosplay_school_hoodie_shirt]")
	condition_skirt = CreateCondition("[Cosplay_m_cosplay_school_hoodie_skirt]")
	condition_socks = CreateCondition("[Cosplay_m_cosplay_school_hoodie_socks]")
	condition_shoes = CreateCondition("[Cosplay_m_cosplay_school_hoodie_shoes]")

	main_panel = CreateMissionPanel()
	main_panel.SetVisible(false)
	main_panel.SetGaugeVisible(true)
	main_panel.SetGaugeProgress(0)
	main_panel.SetRPText("")

	location1_panel = CreateMissionPanel()
	location1_panel.SetVisible(false)
	location1_panel.SetGaugeVisible(true)
	location1_panel.SetGaugeProgress(0)
	location1_panel.SetRPText("")
	location2_panel = CreateMissionPanel()
	location2_panel.SetVisible(false)
	location2_panel.SetGaugeVisible(true)
	location2_panel.SetGaugeProgress(0)
	location2_panel.SetRPText("")
	location3_panel = CreateMissionPanel()
	location3_panel.SetVisible(false)
	location3_panel.SetGaugeVisible(true)
	location3_panel.SetGaugeProgress(0)
	location3_panel.SetRPText("")
	location4_panel = CreateMissionPanel()
	location4_panel.SetVisible(false)
	location4_panel.SetGaugeVisible(true)
	location4_panel.SetGaugeProgress(0)
	location4_panel.SetRPText("")
	location5_panel = CreateMissionPanel()
	location5_panel.SetVisible(false)
	location5_panel.SetGaugeVisible(true)
	location5_panel.SetGaugeProgress(0)
	location5_panel.SetRPText("")
	location6_panel = CreateMissionPanel()
	location6_panel.SetVisible(false)
	location6_panel.SetGaugeVisible(true)
	location6_panel.SetGaugeProgress(0)
	location6_panel.SetRPText("")

	location1_area = CreateArea(type="sphere", stage="Residence", x=-5.62, y=-0.08, z=-85.53, r=1.2, outline=true, compass=true)
	location1_zone = CreateZone(location1_area)
	location1_zone.SetVisible(false)
	location1_zone.SetColor(1,0.65,0.2)
	location2_area = CreateArea(type="sphere", stage="Residence", x=-3.64, y=-0.10, z=-74.10, r=1.2, outline=true, compass=true)
	location2_zone = CreateZone(location2_area)
	location2_zone.SetVisible(false)
	location2_zone.SetColor(1,0.65,0.2)
	location3_area = CreateArea(type="sphere", stage="Residence", x=14.02, y=-0.10, z=-83.66, r=1.2, outline=true, compass=true)
	location3_zone = CreateZone(location3_area)
	location3_zone.SetVisible(false)
	location3_zone.SetColor(1,0.65,0.2)
	location4_area = CreateArea(type="sphere", stage="Residence", x=6.46, y=-0.10, z=-84.00, r=1.2, outline=true, compass=true)
	location4_zone = CreateZone(location4_area)
	location4_zone.SetVisible(false)
	location4_zone.SetColor(1,0.65,0.2)
	location5_area = CreateArea(type="sphere", stage="Residence", x=2.57, y=-0.10, z=-111.12, r=1.2, outline=true, compass=true)
	location5_zone = CreateZone(location5_area)
	location5_zone.SetVisible(false)
	location5_zone.SetColor(1,0.65,0.2)
	location6_area = CreateArea(type="sphere", stage="Residence", x=13.36, y=-0.08, z=-117.32, r=1.2, outline=true, compass=true)
	location6_zone = CreateZone(location6_area)
	location6_zone.SetVisible(false)
	location6_zone.SetColor(1,0.65,0.2)

	reward_overlay = CreateText()
	reward_overlay.SetAnchor(0.5, 0.5)
	reward_overlay.SetAlignment("Top")
	reward_overlay.SetSize(36)
	reward_overlay.SetWidth(1200)
	reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	reward_overlay.SetFrontLayer(true)
	reward_overlay.Clear()

	listener = CreateListenerLocal("update")
	Log("ManakaPlus v2: Residence Sandbox Mission Contact loaded.")

	Start:
		active = true
		contact_was_open = false
		menu_state = "main"
		selected_time = 5
		always_naked = false
		interruptible = true
		reward_overlay_timer = 0
		reward_overlay.Clear()
		ResetMissionState()
		teleporting.Reset()
		teleporting.ResetDifficulty()
		home_sweet_home.Cancel()
		home_sweet_home.SetDifficultyNormal()
		home_sweet_home.SetPunishmentOff()
		contact = CreateMessengerChat("沙盒任务", iconcolor=Color(0.85,0.38,0.18), icontext="SM", icontextcolor=Color(1,1,1))
		ShowMainMenu()

	Reset:
		active = false
		if teleporting.IsActive()
			teleporting.GlobalCancel()
		if home_sweet_home.IsActive()
			home_sweet_home.Cancel()
		CleanupMissionRuntime()
		reward_overlay_timer = 0
		reward_overlay.Clear()
		selected_time = 5
		always_naked = false
		interruptible = true
		if contact != null
			contact.SetButtons()
			contact.Clear()
			contact = null
		contact_was_open = false
		menu_state = "main"

	IsActive:
		_result = mission_active || mission_preparing || teleporting.IsActive() || home_sweet_home.IsActive()

	GetActiveMissionName:
		_result = ""
		if teleporting.IsActive()
			_result = "传送狂乱"
		elseif home_sweet_home.IsActive()
			_result = "甜蜜之家"
		elseif mission_active || mission_preparing
			_result = "烦人的邻居"

	CancelCurrentMission:
		if teleporting.IsActive()
			teleporting.GlobalCancel()
		elseif home_sweet_home.IsActive()
			home_sweet_home.Cancel()
		elseif mission_active || mission_preparing
			CleanupMissionRuntime()
		ShowMainMenu()

	ShowMainMenu:
		menu_state = "main"
		if contact != null
			active_name = GetActiveMissionName()
			if active_name == ""
				active_name = "无"
			contact.Clear()
			contact.Add("沙盒任务\n当前任务：" + active_name, "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("烦人的邻居", "传送狂乱", "甜蜜之家"), ids=CreateList("annoying", "teleporting", "home_sweet_home"))

	ShowAnnoyingDetails:
		menu_state = "annoying_details"
		if contact != null
			contact.Clear()
			contact.Add(BuildMissionText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("开始", "难度", "返回"), ids=CreateList("start", "difficulty", "return"))

	ShowAnnoyingDifficulty:
		menu_state = "annoying_difficulty"
		if contact != null
			contact.Clear()
			contact.Add(BuildDifficultyText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("时间：" + selected_time + "秒", "保持全裸：" + GetNakedText(), "可中断：" + GetInterruptibleText(), "返回"), ids=CreateList("time", "naked", "interruptible", "return"))


	ShowHomeSweetHomeDetails:
		menu_state = "home_sweet_home_details"
		if contact != null
			contact.Clear()
			contact.Add(home_sweet_home.GetMissionText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("开始", "难度：" + home_sweet_home.GetDifficultyLabel(), "惩罚模式：" + home_sweet_home.GetPunishmentLabel(), "返回"), ids=CreateList("start", "difficulty", "punishment", "return"))

	StartHomeSweetHome:
		if mission_active == false && mission_preparing == false && teleporting.IsActive() == false && home_sweet_home.IsActive() == false
			home_sweet_home.Start()
			menu_state = "home_sweet_home_active"
			if contact != null
				contact.Clear()
				contact.Add("甜蜜之家\n任务进行中\n\n使用 ManakaPlus v2 > 取消当前任务 即可停止", "Left", user="Residence", silent=true)
				contact.SetButtons()

	ShowHomeSweetHomeComplete:
		menu_state = "home_sweet_home_complete"
		if contact != null
			contact.Clear()
			hsh_reward_rp = home_sweet_home.GetRewardRP()
			hsh_reward_mp = home_sweet_home.GetRewardMP()
			contact.Add("甜蜜之家已完成\n\n获得" + hsh_reward_rp + " RP 与 " + hsh_reward_mp + " Manaka 点数", "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("返回"), ids=CreateList("return"))

	ShowTeleportingDetails:
		menu_state = "teleport_details"
		if contact != null
			contact.Clear()
			contact.Add(teleporting.GetMissionText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("开始", "难度", "规则与操作", "返回"), ids=CreateList("start", "difficulty", "rules", "return"))

	ShowTeleportingDifficulty:
		menu_state = "teleport_difficulty"
		if contact != null
			contact.Clear()
			contact.Add(teleporting.GetDifficultyText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList(teleporting.GetRoundsLabel(), teleporting.GetTeleportIntervalLabel(), teleporting.GetStartingEnergyLabel(), teleporting.GetMaxEnergyLabel(), teleporting.GetRPEnergyLabel(), teleporting.GetRPRequiredLabel(), "返回"), ids=CreateList("rounds", "interval", "start_energy", "max_energy", "rp_energy", "rp_required", "return"))

	ShowTeleportingRules:
		menu_state = "teleport_rules"
		if contact != null
			contact.Clear()
			contact.Add(teleporting.GetRulesText(), "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("返回"), ids=CreateList("return"))

	StartTeleportingMission:
		if mission_active == false && mission_preparing == false && teleporting.IsActive() == false && home_sweet_home.IsActive() == false
			teleporting.Start()
			menu_state = "teleport_active"
			if contact != null
				contact.Clear()
				contact.Add("传送狂乱\n任务进行中\n\n使用 ManakaPlus v2 > 取消当前任务 可停止任务，或结算无限模式奖励", "Left", user="Residence", silent=true)
				contact.SetButtons()

	ShowTeleportingComplete:
		menu_state = "teleport_complete"
		if contact != null
			contact.Clear()
			message = teleporting.GetFinishMessage()
			if message == ""
				message = "传送狂乱已完成"
			contact.Add(message, "Left", user="Residence", silent=true)
			contact.SetButtons(CreateList("返回"), ids=CreateList("return"))

	GetNakedText:
		_result = "关闭"
		if always_naked
			_result = "开启"

	GetInterruptibleText:
		_result = "关闭"
		if interruptible
			_result = "开启"

	GetTimeBonus:
		_result = 0
		if selected_time == 8
			_result = 30
		elseif selected_time == 10
			_result = 60

	GetNakedBonus:
		_result = 0
		if always_naked
			_result = 40

	GetInterruptibleBonus:
		_result = 0
		if interruptible == false
			_result = 30

	GetDetectionBonus:
		# Use the live runtime value when Start is pressed, matching v1.3 Downtown.
		_result = 0
		if _state.Detection < 0.3
			_result = 80
		elseif _state.Detection <= 0.5
			_result = 40
		elseif _state.Detection <= 0.7
			_result = 20

	BuildMissionText:
		requirement_text = "任务要求：胸罩、蕾丝内裤、学生制服A"
		if always_naked
			requirement_text = "任务要求：全裸"
		_result = requirement_text + "\n奖励：150 RP + 150 Manaka 点数\n按响六家门铃，并在每个区域停留 " + selected_time + " 秒。若提前离开，需要再次按门铃才能继续"

	BuildDifficultyText:
		selected_bonus = GetTimeBonus() + GetNakedBonus() + GetInterruptibleBonus()
		_result = "Manaka 点数总加成：" + selected_bonus + "\n露出可疑度加成：51–70% 时 20 Manaka 点数 | 30–50% 时 40 点 | 低于 30% 时 80 点 | 高于 70% 时无加成\n白天加成：30 Manaka 点数"

	CycleTime:
		if selected_time == 5
			selected_time = 8
		elseif selected_time == 8
			selected_time = 10
		else
			selected_time = 5
		ShowAnnoyingDifficulty()

	ToggleNaked:
		if always_naked
			always_naked = false
		else
			always_naked = true
		ShowAnnoyingDifficulty()

	ToggleInterruptible:
		if interruptible
			interruptible = false
		else
			interruptible = true
		ShowAnnoyingDifficulty()


	BeginMission:
		if mission_active == false && mission_preparing == false && teleporting.IsActive() == false && home_sweet_home.IsActive() == false
			mission_active = true
			mission_preparing = true
			prepare_step = 0
			prepare_timer = 0
			progress = 0
			outfit_lock_timer = 0
			locked_mp_reward = 150 + GetDetectionBonus() + GetTimeBonus() + GetNakedBonus() + GetInterruptibleBonus()
			if condition_daytime.Check()
				locked_mp_reward = locked_mp_reward + 30
			InitializeLocationState()
			MoveCoatAway()
			ShowAllUnfinishedZones()
			main_panel.SetText("已完成地点：0/6")
			main_panel.SetGaugeProgress(0)
			main_panel.SetVisible(true)
			menu_state = "active"
			if contact != null
				contact.Clear()
				contact.Add("烦人的邻居\n任务进行中\n\n使用 ManakaPlus v2 > 取消当前任务 即可停止", "Left", user="Residence", silent=true)
				contact.SetButtons()

	InitializeLocationState:
		done1 = false
		done2 = false
		done3 = false
		done4 = false
		done5 = false
		done6 = false
		rung1 = false
		rung2 = false
		rung3 = false
		rung4 = false
		rung5 = false
		rung6 = false
		armed1 = false
		armed2 = false
		armed3 = false
		armed4 = false
		armed5 = false
		armed6 = false
		timer1 = 0
		timer2 = 0
		timer3 = 0
		timer4 = 0
		timer5 = 0
		timer6 = 0
		allow_bra = true
		allow_panties = true
		allow_necktie = true
		allow_hoodie = true
		allow_shirt = true
		allow_skirt = true
		allow_socks = true
		allow_shoes = true
		outfit_remaining = CreateList("m_cosplay_general_upper_bra", "m_cosplay_general_upper_ultimate_pants", "m_cosplay_school_hoodie_necktie", "m_cosplay_school_hoodie_hoodie", "m_cosplay_school_hoodie_shirt", "m_cosplay_school_hoodie_skirt", "m_cosplay_school_hoodie_socks", "m_cosplay_school_hoodie_shoes")

	MoveCoatAway:
		DropItem(itemtype="Coat", position=_state.Position, compass=false)
		CollectItem(itemtype="Coat")
		coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
		DropItem(itemtype="Coat", stage="Apart", position=coat_away_pos, compass=false)
		coat_moved = true

	RestoreCoat:
		if coat_moved
			CollectItem(itemtype="Coat")
			coat_return_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
			DropItem(itemtype="Coat", position=coat_return_pos, compass=false)
			coat_moved = false

	PrepareMission:
		prepare_timer = prepare_timer + _timediff
		if always_naked
			if prepare_step == 0 && prepare_timer >= 0.25
				UnequipAllCosplay()
				prepare_step = 3
				mission_preparing = false
		else
			if prepare_step == 0 && prepare_timer >= 0.25
				UnequipAllCosplay()
				prepare_timer = 0
				prepare_step = 1
			elseif prepare_step == 1 && prepare_timer >= 0.25
				EquipAllowedOutfit()
				prepare_timer = 0
				prepare_step = 2
			elseif prepare_step == 2 && prepare_timer >= 0.75
				# Do not block the mission on outfit condition checks.
				# The hard-force monitor below keeps the allowed outfit restored.
				EquipAllowedOutfit()
				mission_preparing = false
				prepare_step = 3

	EquipAllowedOutfit:
		# Equip the complete starting outfit in one call, matching the proven v1.3 pattern.
		if allow_bra && allow_panties && allow_necktie && allow_hoodie && allow_shirt && allow_skirt && allow_socks && allow_shoes
			EquipCosplay("m_cosplay_general_upper_bra", "m_cosplay_general_upper_ultimate_pants", "m_cosplay_school_hoodie_necktie", "m_cosplay_school_hoodie_hoodie", "m_cosplay_school_hoodie_shirt", "m_cosplay_school_hoodie_skirt", "m_cosplay_school_hoodie_socks", "m_cosplay_school_hoodie_shoes")
		else
			if allow_bra
				EquipCosplay("m_cosplay_general_upper_bra")
			if allow_panties
				EquipCosplay("m_cosplay_general_upper_ultimate_pants")
			if allow_necktie
				EquipCosplay("m_cosplay_school_hoodie_necktie")
			if allow_hoodie
				EquipCosplay("m_cosplay_school_hoodie_hoodie")
			if allow_shirt
				EquipCosplay("m_cosplay_school_hoodie_shirt")
			if allow_skirt
				EquipCosplay("m_cosplay_school_hoodie_skirt")
			if allow_socks
				EquipCosplay("m_cosplay_school_hoodie_socks")
			if allow_shoes
				EquipCosplay("m_cosplay_school_hoodie_shoes")

	ForceAllowedOutfit:
		if always_naked == false && mission_preparing == false
			outfit_lock_timer = outfit_lock_timer + _timediff
			if outfit_lock_timer >= 1
				# Town Inspector pattern: only rebuild the outfit when an allowed piece is missing.
				missing_required = false
				if allow_bra && condition_bra.Check() == false
					missing_required = true
				if allow_panties && condition_panties.Check() == false
					missing_required = true
				if allow_necktie && condition_necktie.Check() == false
					missing_required = true
				if allow_hoodie && condition_hoodie.Check() == false
					missing_required = true
				if allow_shirt && condition_shirt.Check() == false
					missing_required = true
				if allow_skirt && condition_skirt.Check() == false
					missing_required = true
				if allow_socks && condition_socks.Check() == false
					missing_required = true
				if allow_shoes && condition_shoes.Check() == false
					missing_required = true
				if missing_required
					UnequipAllCosplay()
					EquipAllowedOutfit()
				outfit_lock_timer = 0

	RemoveTwoOutfitItems:
		if always_naked == false
			remove_count = 0
			while remove_count < 2 && outfit_remaining.Count() > 0
				remove_index = RandomInt(0, outfit_remaining.Count() - 1)
				remove_item = outfit_remaining[remove_index]
				UnequipCosplay(remove_item)
				if remove_item == "m_cosplay_general_upper_bra"
					allow_bra = false
				elseif remove_item == "m_cosplay_general_upper_ultimate_pants"
					allow_panties = false
				elseif remove_item == "m_cosplay_school_hoodie_necktie"
					allow_necktie = false
				elseif remove_item == "m_cosplay_school_hoodie_hoodie"
					allow_hoodie = false
				elseif remove_item == "m_cosplay_school_hoodie_shirt"
					allow_shirt = false
				elseif remove_item == "m_cosplay_school_hoodie_skirt"
					allow_skirt = false
				elseif remove_item == "m_cosplay_school_hoodie_socks"
					allow_socks = false
				elseif remove_item == "m_cosplay_school_hoodie_shoes"
					allow_shoes = false
				outfit_remaining.Remove(remove_index)
				remove_count = remove_count + 1

	ShowAllUnfinishedZones:
		if done1
			location1_zone.SetVisible(false)
		else
			location1_zone.SetVisible(true)
		if done2
			location2_zone.SetVisible(false)
		else
			location2_zone.SetVisible(true)
		if done3
			location3_zone.SetVisible(false)
		else
			location3_zone.SetVisible(true)
		if done4
			location4_zone.SetVisible(false)
		else
			location4_zone.SetVisible(true)
		if done5
			location5_zone.SetVisible(false)
		else
			location5_zone.SetVisible(true)
		if done6
			location6_zone.SetVisible(false)
		else
			location6_zone.SetVisible(true)

	HideAllZones:
		location1_zone.SetVisible(false)
		location2_zone.SetVisible(false)
		location3_zone.SetVisible(false)
		location4_zone.SetVisible(false)
		location5_zone.SetVisible(false)
		location6_zone.SetVisible(false)

	HideLocationPanels:
		location1_panel.SetVisible(false)
		location1_panel.SetGaugeProgress(0)
		location1_panel.SetRPText("")
		location2_panel.SetVisible(false)
		location2_panel.SetGaugeProgress(0)
		location2_panel.SetRPText("")
		location3_panel.SetVisible(false)
		location3_panel.SetGaugeProgress(0)
		location3_panel.SetRPText("")
		location4_panel.SetVisible(false)
		location4_panel.SetGaugeProgress(0)
		location4_panel.SetRPText("")
		location5_panel.SetVisible(false)
		location5_panel.SetGaugeProgress(0)
		location5_panel.SetRPText("")
		location6_panel.SetVisible(false)
		location6_panel.SetGaugeProgress(0)
		location6_panel.SetRPText("")

	ResetMissionState:
		mission_active = false
		mission_preparing = false
		prepare_step = 0
		prepare_timer = 0
		progress = 0
		outfit_lock_timer = 0
		HideAllZones()
		HideLocationPanels()
		main_panel.SetVisible(false)
		main_panel.SetGaugeProgress(0)
		main_panel.SetRPText("")

	CleanupMissionOutfit:
		UnequipCosplay("m_cosplay_general_upper_bra", "m_cosplay_general_upper_ultimate_pants", "m_cosplay_school_hoodie_necktie", "m_cosplay_school_hoodie_hoodie", "m_cosplay_school_hoodie_shirt", "m_cosplay_school_hoodie_skirt", "m_cosplay_school_hoodie_socks", "m_cosplay_school_hoodie_shoes")

	CleanupMissionRuntime:
		if mission_active || mission_preparing || coat_moved
			CleanupMissionOutfit()
			RestoreCoat()
		ResetMissionState()

	FinishMission:
		AddCurrentEarnRP(150)
		manaka_points.Add(amount=locked_mp_reward)
		mainthread.UpdateHub()
		reward_overlay.Clear()
		reward_overlay.Add(text="150 RP + " + locked_mp_reward + " Manaka Points Added")
		reward_overlay_timer = 5
		_save.ManakaPlusV2ResidenceAnnoyingNeighborCompleted = true
		CleanupMissionOutfit()
		RestoreCoat()
		ResetMissionState()
		ShowAnnoyingDetails()

	UpdateMission:
		main_panel.SetText("" + progress + "/6 个地点已完成")
		main_panel.SetGaugeProgress(progress / 6.0)
		main_panel.SetVisible(true)
		ShowAllUnfinishedZones()
		ForceAllowedOutfit()

		# House 1.
		if done1 == false && location1_zone.Inside()
			location1_panel.SetText("按响门铃，并且不要离开区域")
			location1_panel.SetVisible(true)
			if condition_bell.Check()
				if rung1 == false
					RemoveTwoOutfitItems()
					rung1 = true
				armed1 = true
			if armed1
				timer1 = timer1 + _timediff
			location1_panel.SetGaugeProgress(timer1 / selected_time)
			location1_panel.SetRPText("" + Floor(timer1) + "/" + selected_time + "秒")
			if timer1 >= selected_time
				done1 = true
				armed1 = false
				location1_zone.SetVisible(false)
				location1_panel.SetVisible(false)
				progress = progress + 1
		else
			location1_panel.SetVisible(false)
			if armed1
				armed1 = false
				if interruptible == false
					timer1 = 0

		# House 2.
		if done2 == false && location2_zone.Inside()
			location2_panel.SetText("按响门铃，并且不要离开区域")
			location2_panel.SetVisible(true)
			if condition_bell.Check()
				if rung2 == false
					RemoveTwoOutfitItems()
					rung2 = true
				armed2 = true
			if armed2
				timer2 = timer2 + _timediff
			location2_panel.SetGaugeProgress(timer2 / selected_time)
			location2_panel.SetRPText("" + Floor(timer2) + "/" + selected_time + "秒")
			if timer2 >= selected_time
				done2 = true
				armed2 = false
				location2_zone.SetVisible(false)
				location2_panel.SetVisible(false)
				progress = progress + 1
		else
			location2_panel.SetVisible(false)
			if armed2
				armed2 = false
				if interruptible == false
					timer2 = 0

		# House 3.
		if done3 == false && location3_zone.Inside()
			location3_panel.SetText("按响门铃，并且不要离开区域")
			location3_panel.SetVisible(true)
			if condition_bell.Check()
				if rung3 == false
					RemoveTwoOutfitItems()
					rung3 = true
				armed3 = true
			if armed3
				timer3 = timer3 + _timediff
			location3_panel.SetGaugeProgress(timer3 / selected_time)
			location3_panel.SetRPText("" + Floor(timer3) + "/" + selected_time + "秒")
			if timer3 >= selected_time
				done3 = true
				armed3 = false
				location3_zone.SetVisible(false)
				location3_panel.SetVisible(false)
				progress = progress + 1
		else
			location3_panel.SetVisible(false)
			if armed3
				armed3 = false
				if interruptible == false
					timer3 = 0

		# House 4.
		if done4 == false && location4_zone.Inside()
			location4_panel.SetText("按响门铃，并且不要离开区域")
			location4_panel.SetVisible(true)
			if condition_bell.Check()
				if rung4 == false
					RemoveTwoOutfitItems()
					rung4 = true
				armed4 = true
			if armed4
				timer4 = timer4 + _timediff
			location4_panel.SetGaugeProgress(timer4 / selected_time)
			location4_panel.SetRPText("" + Floor(timer4) + "/" + selected_time + "秒")
			if timer4 >= selected_time
				done4 = true
				armed4 = false
				location4_zone.SetVisible(false)
				location4_panel.SetVisible(false)
				progress = progress + 1
		else
			location4_panel.SetVisible(false)
			if armed4
				armed4 = false
				if interruptible == false
					timer4 = 0

		# House 5.
		if done5 == false && location5_zone.Inside()
			location5_panel.SetText("按响门铃，并且不要离开区域")
			location5_panel.SetVisible(true)
			if condition_bell.Check()
				if rung5 == false
					RemoveTwoOutfitItems()
					rung5 = true
				armed5 = true
			if armed5
				timer5 = timer5 + _timediff
			location5_panel.SetGaugeProgress(timer5 / selected_time)
			location5_panel.SetRPText("" + Floor(timer5) + "/" + selected_time + "秒")
			if timer5 >= selected_time
				done5 = true
				armed5 = false
				location5_zone.SetVisible(false)
				location5_panel.SetVisible(false)
				progress = progress + 1
		else
			location5_panel.SetVisible(false)
			if armed5
				armed5 = false
				if interruptible == false
					timer5 = 0

		# House 6.
		if done6 == false && location6_zone.Inside()
			location6_panel.SetText("按响门铃，并且不要离开区域")
			location6_panel.SetVisible(true)
			if condition_bell.Check()
				if rung6 == false
					RemoveTwoOutfitItems()
					rung6 = true
				armed6 = true
			if armed6
				timer6 = timer6 + _timediff
			location6_panel.SetGaugeProgress(timer6 / selected_time)
			location6_panel.SetRPText("" + Floor(timer6) + "/" + selected_time + "秒")
			if timer6 >= selected_time
				done6 = true
				armed6 = false
				location6_zone.SetVisible(false)
				location6_panel.SetVisible(false)
				progress = progress + 1
		else
			location6_panel.SetVisible(false)
			if armed6
				armed6 = false
				if interruptible == false
					timer6 = 0

		main_panel.SetText("" + progress + "/6 个地点已完成")
		main_panel.SetGaugeProgress(progress / 6.0)
		if progress >= 6 && mission_active
			FinishMission()


	update:
		if reward_overlay_timer > 0
			reward_overlay_timer = reward_overlay_timer - _timediff
			if reward_overlay_timer <= 0
				reward_overlay.Clear()

		if active && contact != null
			opened = contact.Opened()
			if opened && contact_was_open == false
				ShowMainMenu()
			contact_was_open = opened

			clicked = contact.Clicked()
			if clicked != null
				if menu_state == "main"
					if clicked == "annoying"
						ShowAnnoyingDetails()
					elseif clicked == "teleporting"
						ShowTeleportingDetails()
					elseif clicked == "home_sweet_home"
						ShowHomeSweetHomeDetails()
				elseif menu_state == "annoying_details"
					if clicked == "start"
						BeginMission()
					elseif clicked == "difficulty"
						ShowAnnoyingDifficulty()
					elseif clicked == "return"
						ShowMainMenu()
				elseif menu_state == "annoying_difficulty"
					if clicked == "time"
						CycleTime()
					elseif clicked == "naked"
						ToggleNaked()
					elseif clicked == "interruptible"
						ToggleInterruptible()
					elseif clicked == "return"
						ShowAnnoyingDetails()
				elseif menu_state == "home_sweet_home_details"
					if clicked == "start"
						StartHomeSweetHome()
					elseif clicked == "difficulty"
						home_sweet_home.CycleDifficulty()
						ShowHomeSweetHomeDetails()
					elseif clicked == "punishment"
						home_sweet_home.TogglePunishment()
						ShowHomeSweetHomeDetails()
					elseif clicked == "return"
						ShowMainMenu()
				elseif menu_state == "home_sweet_home_complete"
					ShowHomeSweetHomeDetails()
				elseif menu_state == "teleport_details"
					if clicked == "start"
						StartTeleportingMission()
					elseif clicked == "difficulty"
						ShowTeleportingDifficulty()
					elseif clicked == "rules"
						ShowTeleportingRules()
					elseif clicked == "return"
						ShowMainMenu()
				elseif menu_state == "teleport_difficulty"
					if clicked == "rounds"
						teleporting.CycleRounds()
						ShowTeleportingDifficulty()
					elseif clicked == "interval"
						teleporting.CycleTeleportInterval()
						ShowTeleportingDifficulty()
					elseif clicked == "start_energy"
						teleporting.CycleStartingEnergy()
						ShowTeleportingDifficulty()
					elseif clicked == "max_energy"
						teleporting.CycleMaxEnergy()
						ShowTeleportingDifficulty()
					elseif clicked == "rp_energy"
						teleporting.CycleRPEnergyGain()
						ShowTeleportingDifficulty()
					elseif clicked == "rp_required"
						teleporting.CycleRPRequired()
						ShowTeleportingDifficulty()
					elseif clicked == "return"
						ShowTeleportingDetails()
				elseif menu_state == "teleport_rules"
					ShowTeleportingDetails()
				elseif menu_state == "teleport_complete"
					ShowTeleportingDetails()

		if active && teleporting.ConsumeCompleted()
			ShowTeleportingComplete()

		if active && home_sweet_home.ConsumeCompleted()
			ShowHomeSweetHomeComplete()

		if active && mission_active
			if mission_preparing
				PrepareMission()
			else
				UpdateMission()

# ============================================================
# RESIDENCE TELEPORTING
# ============================================================
manakaplus_v22_residence_teleporting:
	thread = _this

	# Difficulty-ready defaults. These values can be changed by the future Difficulty menu.
