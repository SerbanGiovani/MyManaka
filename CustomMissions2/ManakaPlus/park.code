	bigj_button_listener:
		if mission_active
			if bigj_active && bigj_done == false
				if bigj_chat != null
					if bigj_chat.Clicked() != null
						if bigj_gallery == null
							bigj_condition_photo = CreateCondition("[NearNPC]")
							bigj_gallery = CreateGallery(bigj_condition_photo)
						bigj_gallery.Show()

	bigj_confirm_listener:
		if mission_active
			if bigj_active && bigj_done == false
				if bigj_gallery != null
					if bigj_gallery.Confirmed()
						selection = bigj_gallery.GetSelection()
						if selection.Count()>0
							bigj_chat.SetButtons()
							bigj_chat.Add(selection["0"], "Right", silent=true)
							if bigj_mission == 1
								AddCurrentEarnRP(200)
								bigj_chat.Add("非常不错，我喜欢你的热情，姑娘。下次见", "Left", user="BigJ", silent=false)
							if bigj_mission == 2
								AddCurrentEarnRP(225)
								bigj_chat.Add("你从来没让 BigJ 失望过，嘿嘿嘿", "Left", user="BigJ", silent=false)
							if bigj_mission == 3
								AddCurrentEarnRP(250)
								bigj_chat.Add("我的天！今天是我有生以来最高兴的一天！", "Left", user="BigJ", silent=false)
							bigj_done = true
							bigj_active = false
							bigj_condition_photo = null
							bigj_gallery = null



	HideAllTeleportZones:
		if park_tp_central_zone != null
			park_tp_central_zone.SetVisible(false)
