		park_walk_dest_pos = Vector(111.23, 49.02, 109.84)
		park_walk_total_distance = Vector3Distance(park_walk_start_pos, park_walk_dest_pos)
		park_toilet_start_pos = Vector(37.57, 50.01, 47.97)
		park_toilet_dest_pos = Vector(119.85, 49.06, 126.91)
		park_toilet_total_distance = Vector3Distance(park_toilet_start_pos, park_toilet_dest_pos)
		park_toilet_caged_warning_pos = Vector(118.67, 49.06, 125.65)

