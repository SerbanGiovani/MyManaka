	RefreshNakedProgressOverlay:
		park_progress_text = "Stay in the Path, Earn 5000 RP\nProgress: " + Floor(park_rp_progress) + " / " + park_rp_target + " RP"
		if park_naked_progress_overlay_flip == 0
			park_naked_progress_overlay.Clear()
			park_naked_progress_overlay.Add(text=park_progress_text, duration=-1)
			park_naked_progress_overlay_alt.Clear()
			park_naked_progress_overlay_flip = 1
		else
			park_naked_progress_overlay_alt.Clear()
			park_naked_progress_overlay_alt.Add(text=park_progress_text, duration=-1)
			park_naked_progress_overlay.Clear()
			park_naked_progress_overlay_flip = 0
	ClearNakedProgressOverlay:
		park_naked_progress_overlay.Clear()
		park_naked_progress_overlay_alt.Clear()

	SyncRPBaseline:
		park_rp_last_total = GetCurrentEarnRP()

	IsCurrentMissionActive:
		_result = park_naked_started || park_teleport_test_started || park_walk_state == 1 || park_cage_state == 1 || park_toilet_state == 1 || park_toilet_caged_state == 1


	Cancel:
		mission_active = false
		active_stage = ""
		ClearNakedProgressOverlay()
		if park_start_zone != null
			park_start_zone.SetVisible(false)
		if park_path_zone != null
			park_path_zone.SetVisible(false)
		if park_naked_panel != null
			park_naked_panel.SetVisible(false)
		if park_teleport_panel != null
			park_teleport_panel.SetVisible(false)
		if park_crowded_panel != null
			park_crowded_panel.SetVisible(false)
		HideAllTeleportZones()
		if park_walk_start_zone != null
			park_walk_start_zone.SetVisible(false)
		if park_walk_dest_zone != null
			park_walk_dest_zone.SetVisible(false)
		if park_walk_panel != null
			park_walk_panel.SetVisible(false)
		if park_cage_zone != null
			park_cage_zone.SetVisible(false)
		if park_cage_panel != null
			park_cage_panel.SetVisible(false)
		if park_toilet_start_zone != null
			park_toilet_start_zone.SetVisible(false)
		if park_toilet_dest_zone != null
			park_toilet_dest_zone.SetVisible(false)
		if park_toilet_panel != null
			park_toilet_panel.SetVisible(false)
		if park_toilet_punish_panel != null
			park_toilet_punish_panel.SetVisible(false)
		if park_toilet_caged_start_zone != null
			park_toilet_caged_start_zone.SetVisible(false)
		if park_toilet_caged_warning_zone != null
			park_toilet_caged_warning_zone.SetVisible(false)
		if park_toilet_caged_panel != null
			park_toilet_caged_panel.SetVisible(false)
		if park_toilet_caged_info_panel != null
			park_toilet_caged_info_panel.SetVisible(false)
		if park_toilet_caged_main_panel != null
			park_toilet_caged_main_panel.SetVisible(false)
		if park_side_notice_panel != null
			park_side_notice_panel.SetVisible(false)
		if park_walk_state == 1
			SetAction("None")
		if bigj_chat != null
			bigj_chat.SetButtons()
			bigj_chat.Clear()
			bigj_chat = null
		bigj_active = false
		bigj_done = false
		bigj_mission = 0
		bigj_condition_photo = null
		bigj_gallery = null
		if park_coat_moved
			CollectItem(itemtype="Coat")
			park_coat_return_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
			DropItem(itemtype="Coat", position=park_coat_return_pos, compass=false)
			park_coat_moved = false
		thread.Goto("idle")

