		# Anonymous_95 panels, conditions, contact, and listeners are owned by its own module.

		park_condition_naked = CreateCondition("[Exposed_All]")
		park_condition_handbra = CreateCondition("[Action_Tebura]")
		park_condition_hipthrust = CreateCondition("[Action_GanimataKoshiHeko]")
		park_condition_path = CreateCondition("[NPCArea]")
		park_condition_coat = CreateCondition("[(CoatFrontClosed,CoatFrontOpen1,CoatFrontOpen2,CoatBackClosed,CoatBackOpen)]")
		park_condition_ganimata_walk = CreateCondition("[Action_GanimataWalk]")
		park_condition_no_dash = CreateCondition("[!Dashing]")

		listener = CreateListenerLocal("park_listener")
		mainthread.ArmStageWatch()

	park_listener:
		if mission_active
			if mainthread.AnonymousIsBusy()
				if park_cage_zone != null
					park_cage_zone.SetVisible(false)
				if park_cage_panel != null
					park_cage_panel.SetVisible(false)

			# Global stage reset: Park stage stays active only while player remains in Park.
			if mission_active
				if _state.Position.stage != "Park"
					mainthread.RequestReset()

			if park_naked_started == false && park_teleport_test_started == false
				if park_start_zone.Inside()
					park_naked_panel.SetVisible(true)
					park_naked_panel.SetText("全裸保持 5 秒以开始全裸挑战；必须留在道路范围内")
					park_naked_panel.SetRPText("")
					park_naked_panel.SetGaugeVisible(true)
					if park_condition_naked.Check()
						park_naked_duration = park_naked_duration + _timediff
					else
						park_naked_duration = 0
					park_naked_panel.SetGaugeProgress(park_naked_duration / 5)

					park_teleport_panel.SetVisible(true)
					park_teleport_panel.SetText("保持手遮胸 5 秒，开始随机传送挑战")
					park_teleport_panel.SetRPText("")
					park_teleport_panel.SetGaugeVisible(true)
					if park_condition_handbra.Check()
						park_teleport_duration = park_teleport_duration + _timediff
					else
						park_teleport_duration = 0
					park_teleport_panel.SetGaugeProgress(park_teleport_duration / 5)
					if park_teleport_duration >= 5
						park_teleport_test_started = true
						park_teleport_intro_active = true
						park_teleport_intro_timer = 0
						park_teleport_round = 0
						park_teleport_round_timer = 0
						park_teleport_zone_grace = 0
						park_teleport_previous_index = -1
						park_teleport_current_index = -1
						park_start_zone.SetVisible(false)
						park_naked_panel.SetVisible(false)
						park_crowded_panel.SetVisible(false)
						park_teleport_panel.SetVisible(true)
						park_teleport_panel.SetText("这是没有奖励的自由挑战，做好准备")
						park_teleport_panel.SetRPText("")
						park_teleport_panel.SetGaugeVisible(true)
						park_teleport_panel.SetGaugeProgress(0)
					if park_naked_duration >= 5
						CollectItem(itemtype="Coat")
						coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", stage="Apart", position=coat_away_pos, compass=false)
						park_coat_moved = true
						park_naked_started = true
						park_start_zone.SetVisible(false)
						park_path_zone.SetVisible(true)
						park_walk_start_zone.SetVisible(true)
						park_cage_zone.SetVisible(true)
						park_toilet_start_zone.SetVisible(true)
						park_toilet_caged_start_zone.SetVisible(true)
						park_rp_progress = 0
						park_rp_last_total = GetCurrentEarnRP()
						park_rp_ready = false
						park_penalty_timer = 0
						park_naked_progress_overlay_timer = 0
						park_naked_progress_overlay_flip = 0
						park_naked_progress_overlay.Clear()
						park_naked_progress_overlay_alt.Clear()
						park_naked_panel.SetVisible(false)
						park_teleport_panel.SetVisible(false)
						park_crowded_panel.SetVisible(false)
						park_side_notice_timer = 15
						bigj_active = true
						bigj_done = false
						bigj_mission = 1
						bigj_condition_photo = CreateCondition("[NearNPC]")
						bigj_gallery = CreateGallery(bigj_condition_photo)
						bigj_chat = CreateMessengerChat("BigJ", iconfilename = "Asset/BigJIcon.png", iconcolor = Color(0.7,0.2,1), icontext = "BJ", icontextcolor = Color(1,1,1))
						bigj_chat.Add("嘿，迷人的真菜香！BigJ 来了，也是你作品的忠实粉丝，嘿嘿嘿。听说你需要帮忙赚点 RP？靠近别人时拍一张自慰照发给 BigJ，BigJ 就给你 200 RP，很划算吧？", "Left", user="BigJ", silent=false)
						bigj_chat.SetButtons("发送照片")
						bigj_button_listener = CreateListenerLocal("bigj_button_listener")
						bigj_confirm_listener = CreateListenerLocal("bigj_confirm_listener")
						# Anonymous_95 now appears when Park stage starts, not after Naked pre-check.
				else
					park_naked_duration = 0
					park_teleport_duration = 0
					park_crowded_duration = 0
					park_start_zone.SetColor(1,0.75,0.5)
					park_naked_panel.SetVisible(false)
					park_teleport_panel.SetVisible(false)
					park_crowded_panel.SetVisible(false)
			if park_naked_started
				park_path_zone.SetVisible(true)
				if park_path_zone.Inside()
					current_park_rp_total = GetCurrentEarnRP()
					if park_condition_path.Check()
						park_path_zone.SetColor(0.5,1,0.5)
						park_penalty_timer = 0
						if park_rp_ready == false
							park_rp_ready = true
							park_rp_last_total = current_park_rp_total
						park_rp_gain = current_park_rp_total - park_rp_last_total
						if park_rp_gain > 0
							park_rp_progress = park_rp_progress + park_rp_gain
						park_rp_last_total = current_park_rp_total
					else
						park_path_zone.SetColor(1,0.2,0.2)
						park_penalty_timer = park_penalty_timer + _timediff
						if park_penalty_timer >= 2
							park_penalty_timer = 0
							park_penalty_amount = 10
							if park_rp_progress > 2500
								park_penalty_amount = 20
							if park_rp_progress > 4000
								park_penalty_amount = 30
							AddCurrentEarnRP(0 - park_penalty_amount)
							park_rp_progress = park_rp_progress - park_penalty_amount
							if park_rp_progress < 0
								park_rp_progress = 0
						park_rp_last_total = GetCurrentEarnRP()
						park_rp_ready = true
					if park_rp_progress > park_rp_target
						park_rp_progress = park_rp_target
					if bigj_done && bigj_mission == 1 && park_rp_progress >= 1500
						bigj_mission = 2
						bigj_done = false
						bigj_active = true
						bigj_condition_photo = CreateCondition("[NearNPC,Orgasm]")
						bigj_gallery = CreateGallery(bigj_condition_photo)
						bigj_chat.Add("火热的 RP 来咯！这是你的下一剂兴奋剂：靠近某个人，并在高潮的瞬间拍照", "Left", user="BigJ", silent=false)
						bigj_chat.SetButtons("发送照片")
					if bigj_done && bigj_mission == 2 && park_rp_progress >= 3000
						bigj_mission = 3
						bigj_done = false
						bigj_active = true
						bigj_condition_photo = CreateCondition("[AdultToy_EyeMask,NearNPC,Action_Haigure]")
						bigj_gallery = CreateGallery(bigj_condition_photo)
						bigj_chat.Add("小鸟在天上飞，RP 在 BigJ 手里……你只需要戴上眼罩，靠近某个人，再摆出高叉姿势", "Left", user="BigJ", silent=false)
						bigj_chat.SetButtons("发送照片")
					park_naked_progress_overlay_timer = park_naked_progress_overlay_timer + _timediff
					if park_naked_progress_overlay_timer >= 0.20
						park_naked_progress_overlay_timer = 0
						RefreshNakedProgressOverlay()
					if park_side_notice_timer > 0
						park_side_notice_timer = park_side_notice_timer - _timediff
						park_side_notice_panel.SetVisible(true)
						park_side_notice_panel.SetText("地图上出现了新任务，请查看罗盘导航")
						park_side_notice_panel.SetGaugeVisible(true)
						park_side_notice_panel.SetGaugeProgress(park_side_notice_timer / 15)
					else
						park_side_notice_panel.SetVisible(false)
					if park_rp_progress >= park_rp_target
						AddCurrentEarnRP(5000)
						if park_coat_moved
							CollectItem(itemtype="Coat")
							park_finish_coat_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
							DropItem(itemtype="Coat", position=park_finish_coat_pos, compass=false)
							park_coat_moved = false
						park_naked_started = false
						park_path_zone.SetVisible(false)
						ClearNakedProgressOverlay()
						mainthread.RequestReset()
				else
					ClearNakedProgressOverlay()

				# Park side mission 01: Spread-leg walk road route.
				if park_walk_state == 0
					park_walk_start_zone.SetVisible(true)
					park_walk_dest_zone.SetVisible(false)
					if park_walk_start_zone.Inside()
						park_walk_panel.SetVisible(true)
						park_walk_panel.SetText("使用叉腿走路前往道路另一端")
						park_walk_panel.SetRPText("")
						park_walk_panel.SetGaugeVisible(true)
						if park_condition_ganimata_walk.Check()
							park_walk_precheck_duration = park_walk_precheck_duration + _timediff
							park_walk_start_zone.SetColor(0.5,1,0.5)
						else
							park_walk_precheck_duration = 0
							park_walk_start_zone.SetColor(1,0.75,0.5)
						park_walk_panel.SetGaugeProgress(park_walk_precheck_duration / 3)
						if park_walk_precheck_duration >= 3
							park_walk_state = 1
							park_walk_start_zone.SetVisible(false)
							park_walk_dest_zone.SetVisible(true)
							park_walk_precheck_duration = 0
							park_walk_panel.SetGaugeProgress(0)
					else
						park_walk_precheck_duration = 0
						park_walk_panel.SetVisible(false)
				if park_walk_state == 1
					park_walk_dest_zone.SetVisible(true)
					park_walk_panel.SetVisible(true)
					park_walk_panel.SetText("使用叉腿走路前往道路另一端")
					park_walk_panel.SetRPText("500 RP")
					park_walk_panel.SetGaugeVisible(true)
					park_walk_distance = Vector3Distance(_state.Position, park_walk_dest_pos)
					park_walk_gauge = 0
					if park_walk_distance < park_walk_total_distance
						park_walk_gauge = (park_walk_total_distance - park_walk_distance) / park_walk_total_distance
					if park_walk_distance <= 1
						park_walk_gauge = 1
					park_walk_panel.SetGaugeProgress(park_walk_gauge)
					park_walk_force_timer = park_walk_force_timer + _timediff
					if park_walk_force_timer >= 0.4
						park_walk_force_timer = 0
						if _state.Sitting
							SetAction("StandUp")
						if _state.Crouching
							SetAction("None")
						if _state.Action != "GanimataWalk"
							SetAction("GanimataWalk")
					if park_walk_dest_zone.Inside()
						AddCurrentEarnRP(500)
						SetAction("None")
						park_walk_state = 2
						park_walk_dest_zone.SetVisible(false)
						park_walk_panel.SetVisible(false)
				if park_walk_state == 2
					park_walk_start_zone.SetVisible(false)
					park_walk_dest_zone.SetVisible(false)
					park_walk_panel.SetVisible(false)

				# Park side mission 02: Caged Zone timer. Leaving the area resets this side mission to pre-check.
				if park_cage_state == 0 && mainthread.AnonymousIsBusy() == false
					park_cage_zone.SetVisible(true)
					if park_cage_zone.Inside()
						park_cage_panel.SetVisible(true)
						park_cage_panel.SetText("保持手遮胸以激活囚笼区域")
						park_cage_panel.SetRPText("")
						park_cage_panel.SetGaugeVisible(true)
						if park_condition_handbra.Check()
							park_cage_precheck_duration = park_cage_precheck_duration + _timediff
							park_cage_zone.SetColor(0.5,1,0.5)
						else
							park_cage_precheck_duration = 0
							park_cage_zone.SetColor(1,0.75,0.5)
						park_cage_panel.SetGaugeProgress(park_cage_precheck_duration / 3)
						if park_cage_precheck_duration >= 3
							park_cage_state = 1
							park_cage_duration = 0
							park_cage_precheck_duration = 0
							park_cage_panel.SetGaugeProgress(0)
					else
						park_cage_precheck_duration = 0
						park_cage_panel.SetVisible(false)
				if park_cage_state == 1 && mainthread.AnonymousIsBusy() == false
					park_cage_zone.SetVisible(true)
					park_cage_panel.SetVisible(true)
					park_cage_panel.SetText("120 秒内不要离开此区域")
					park_cage_panel.SetRPText("500 RP")
					park_cage_panel.SetGaugeVisible(true)
					if park_cage_zone.Inside()
						park_cage_duration = park_cage_duration + _timediff
						park_cage_zone.SetColor(0.5,1,0.5)
					else
						park_cage_state = 0
						park_cage_duration = 0
						park_cage_precheck_duration = 0
						park_cage_zone.SetColor(1,0.75,0.5)
					park_cage_panel.SetGaugeProgress(park_cage_duration / 120)
					if park_cage_duration >= 120
						AddCurrentEarnRP(500)
						park_cage_state = 2
						park_cage_zone.SetVisible(false)
						park_cage_panel.SetVisible(false)
				if park_cage_state == 2
					park_cage_zone.SetVisible(false)
					park_cage_panel.SetVisible(false)

				# Park side mission 03: no-running toilet route, with safe non-stacking punishment.
				if park_toilet_state == 0
					park_toilet_start_zone.SetVisible(true)
					park_toilet_dest_zone.SetVisible(false)
					if park_toilet_start_zone.Inside()
						park_toilet_panel.SetVisible(true)
						park_toilet_panel.SetText("保持手遮胸开始：禁止奔跑，前往公园厕所")
						park_toilet_panel.SetRPText("")
						park_toilet_panel.SetGaugeVisible(true)
						if park_condition_handbra.Check()
							park_toilet_precheck_duration = park_toilet_precheck_duration + _timediff
							park_toilet_start_zone.SetColor(0.5,1,0.5)
						else
							park_toilet_precheck_duration = 0
							park_toilet_start_zone.SetColor(1,0.75,0.5)
						park_toilet_panel.SetGaugeProgress(park_toilet_precheck_duration / 3)
						if park_toilet_precheck_duration >= 3
							park_toilet_state = 1
							park_toilet_start_zone.SetVisible(false)
							park_toilet_dest_zone.SetVisible(true)
							park_toilet_precheck_duration = 0
							park_toilet_panel.SetGaugeProgress(0)
					else
						park_toilet_precheck_duration = 0
						park_toilet_panel.SetVisible(false)
				if park_toilet_state == 1
					park_toilet_dest_zone.SetVisible(true)
					park_toilet_panel.SetVisible(true)
					park_toilet_panel.SetText("禁止奔跑，前往公园厕所")
					park_toilet_panel.SetRPText("750 RP")
					park_toilet_panel.SetGaugeVisible(true)
					park_toilet_distance = Vector3Distance(_state.Position, park_toilet_dest_pos)
					park_toilet_gauge = 0
					if park_toilet_distance < park_toilet_total_distance
						park_toilet_gauge = (park_toilet_total_distance - park_toilet_distance) / park_toilet_total_distance
					if park_toilet_distance <= 1
						park_toilet_gauge = 1
					park_toilet_panel.SetGaugeProgress(park_toilet_gauge)
					if !park_condition_no_dash.Check()
						if park_toilet_punish_active == false
							park_toilet_punish_active = true
						park_toilet_punish_duration = 0
					if park_toilet_dest_zone.Inside()
						AddCurrentEarnRP(750)
						park_toilet_state = 2
						park_toilet_dest_zone.SetVisible(false)
						park_toilet_panel.SetVisible(false)
						park_toilet_punish_active = false
						park_toilet_punish_duration = 0
						park_toilet_force_timer = 0
						SetVibrator("Off")
						UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
						SetVibrator("Off")
						park_toilet_punish_panel.SetVisible(false)
				if park_toilet_state == 2
					park_toilet_start_zone.SetVisible(false)
					park_toilet_dest_zone.SetVisible(false)
					park_toilet_panel.SetVisible(false)

				if park_toilet_punish_active && park_toilet_state == 1
					park_toilet_punish_panel.SetVisible(true)
					park_toilet_punish_panel.SetText("违反规则，已追加惩罚")
					park_toilet_punish_panel.SetRPText("")
					park_toilet_punish_panel.SetGaugeVisible(true)
					park_toilet_force_timer = park_toilet_force_timer + _timediff
					if park_toilet_force_timer >= 0.4
						park_toilet_force_timer = 0
						if !_state.AdultToys["Vibrator"]
							EquipAdultToy("Vibrator")
						if !_state.AdultToys["TitRotor"]
							EquipAdultToy("TitRotor")
						if !_state.AdultToys["KuriRotor"]
							EquipAdultToy("KuriRotor")
						SetVibrator("High")
					park_toilet_punish_duration = park_toilet_punish_duration + _timediff
					park_toilet_punish_panel.SetGaugeProgress(park_toilet_punish_duration / 8)
					if park_toilet_punish_duration >= 8
						park_toilet_punish_active = false
						park_toilet_punish_duration = 0
						SetVibrator("Off")
						UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
						SetVibrator("Off")
						park_toilet_punish_panel.SetVisible(false)
				else
					park_toilet_punish_panel.SetVisible(false)


				# Park side mission 04: Toilet Caged. Warning sound + coat hiding test.
				if park_toilet_caged_state == 0
					park_toilet_caged_start_zone.SetVisible(true)
					park_toilet_caged_warning_zone.SetVisible(false)
					if park_toilet_caged_start_zone.Inside()
						park_toilet_caged_panel.SetVisible(true)
						park_toilet_caged_panel.SetText("保持手遮胸开始厕所囚笼挑战；最好在厕所内有 NPC 时开始")
						park_toilet_caged_panel.SetRPText("")
						park_toilet_caged_panel.SetGaugeVisible(true)
						if park_condition_handbra.Check()
							park_toilet_caged_precheck_duration = park_toilet_caged_precheck_duration + _timediff
							park_toilet_caged_start_zone.SetColor(0.5,1,0.5)
						else
							park_toilet_caged_precheck_duration = 0
							park_toilet_caged_start_zone.SetColor(1,0.75,0.5)
						park_toilet_caged_panel.SetGaugeProgress(park_toilet_caged_precheck_duration / 3)
						if park_toilet_caged_precheck_duration >= 3
							park_toilet_caged_state = 1
							park_toilet_caged_precheck_duration = 0
							park_toilet_caged_duration = 0
							park_toilet_caged_hide_penalty_timer = 0
							park_toilet_caged_sound_cooldown = 0
							# Return the coat for this side mission. No coat teleport checks while active.
							CollectItem(itemtype="Coat")
							park_toilet_caged_coat_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
							DropItem(itemtype="Coat", position=park_toilet_caged_coat_pos, compass=false)
							park_toilet_caged_panel.SetVisible(false)
							park_toilet_caged_warning_zone.SetVisible(true)
					else
						park_toilet_caged_precheck_duration = 0
						park_toilet_caged_panel.SetVisible(false)
						park_toilet_caged_start_zone.SetColor(1,0.75,0.5)
				if park_toilet_caged_state == 1
					park_toilet_caged_start_zone.SetVisible(true)
					park_toilet_caged_warning_zone.SetVisible(true)
					park_toilet_caged_info_panel.SetVisible(true)
					park_toilet_caged_info_panel.SetText("注意听 *叮* 声，它会提醒你有 NPC 进入厕所")
					park_toilet_caged_info_panel.SetRPText("")
					park_toilet_caged_info_panel.SetGaugeVisible(false)
					park_toilet_caged_main_panel.SetVisible(true)
					park_toilet_caged_main_panel.SetText("不要离开此区域，坚持 120 秒；躲藏会缓慢扣除进度")
					park_toilet_caged_main_panel.SetRPText("750 RP")
					park_toilet_caged_main_panel.SetGaugeVisible(true)

					if park_toilet_caged_sound_cooldown > 0
						park_toilet_caged_sound_cooldown = park_toilet_caged_sound_cooldown - _timediff
					if park_toilet_caged_sound_cooldown < 0
						park_toilet_caged_sound_cooldown = 0
					if park_toilet_caged_sound_cooldown == 0
						npc_warning_found = false
						npc_i = _state.NPCs.Count()
						while npc_i > 0
							npc_i -= 1
							npc_state = _state.NPCs[npc_i]
							if Vector3Distance(npc_state.Position, park_toilet_caged_warning_pos) <= 0.5
								npc_warning_found = true
								npc_i = 0
						if npc_warning_found
							warning_sound.Play()
							park_toilet_caged_sound_cooldown = 3

					if park_toilet_caged_start_zone.Inside()
						park_toilet_caged_start_zone.SetColor(0.5,1,0.5)
						if park_condition_coat.Check()
							park_toilet_caged_hide_penalty_timer = park_toilet_caged_hide_penalty_timer + _timediff
							if park_toilet_caged_hide_penalty_timer >= 2
								park_toilet_caged_hide_penalty_timer = 0
								park_toilet_caged_duration = park_toilet_caged_duration - 1
								if park_toilet_caged_duration < 0
									park_toilet_caged_duration = 0
						else
							park_toilet_caged_duration = park_toilet_caged_duration + _timediff
							park_toilet_caged_hide_penalty_timer = 0
					else
						# Leaving the zone ends this attempt and moves the coat away again.
						DropItem(itemtype="Coat", position=_state.Position, compass=false)
						CollectItem(itemtype="Coat")
						park_toilet_caged_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", stage="Apart", position=park_toilet_caged_away_pos, compass=false)
						park_toilet_caged_state = 0
						park_toilet_caged_duration = 0
						park_toilet_caged_precheck_duration = 0
						park_toilet_caged_hide_penalty_timer = 0
						park_toilet_caged_sound_cooldown = 0
						park_toilet_caged_info_panel.SetVisible(false)
						park_toilet_caged_main_panel.SetVisible(false)
						park_toilet_caged_warning_zone.SetVisible(false)
