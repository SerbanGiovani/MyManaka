	idle:
		mission_active = false

	start_park:
		warning_sound.Play()
		mission_active = true
		park_teleport_setting = teleport_duration
		park_teleport_round_target = teleport_rounds
		park_teleport_endless = teleport_endless
		active_stage = "Park"
		mainthread.UpdateHub()

		if _state.Sitting
			SetAction("StandUp")

		SetStage("Park")
		teleport_wait = 0
		listener = CreateListenerLocal("park_teleport_wait")

	park_teleport_wait:
		if mission_active
			teleport_wait = teleport_wait + _timediff
			if teleport_wait > 0.5
				SetPlayerPosition(x=65.67, y=50.03, z=36.66, rx=0.00000, ry=1.00000, rz=0.00000, rw=0.00000)
				thread.Goto("park_start")

	park_start:
		# Park warm-up setup. Small interact point + hidden whole-map/path zone.
		park_start_area = CreateArea(type="sphere", stage="Park", x=65.67, y=50.03, z=36.66, r=0.5, outline=true, compass=true)
		park_start_zone = CreateZone(park_start_area)
		park_start_zone.SetVisible(true)
		park_start_zone.SetColor(1,0.75,0.5)

		park_path_area = CreateArea(type="sphere", stage="Park", x=75.67, y=52.08, z=83.53, r=999, outline=false, compass=false)
