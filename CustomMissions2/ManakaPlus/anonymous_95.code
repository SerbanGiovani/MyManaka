	anon95_dare_overlay_alt.SetWidth(1000)
	anon95_dare_overlay_alt.SetFace(color=Color(1,1,1,1), dilate=0.35)
	anon95_dare_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	anon95_dare_overlay_alt.SetFrontLayer(true)
	anon95_dare_overlay_alt.Clear()

	# Create these in the module root scope. The module remains alive for the whole mod session.
	anon95_chat_listener_handle = CreateListener("anon95_chat_listener")
	anon95_runtime_listener_handle = CreateListener("anon95_runtime_listener")

	idle:
		active = false

	Start:
		active = true
		session_stage = _state.Position.stage
		anon95_last_stage = session_stage
		anon95_dare_completed = false
		anon95_dare_available = session_stage == "Park"
		anon95_done = false
		anon95_reward_overlay_timer = 0
		anon95_reward_overlay.Clear()
		anon95_branch = 0
		anon95_dare_state = 0
		anon95_dare_precheck_duration = 0
		anon95_dare_remaining = 300
		anon95_dare_elapsed = 0
		anon95_dare_second_timer = 0
		anon95_dare_overlay_refresh_timer = 0
		anon95_dare_overlay_flip = 0
		anon95_dare_overlay.Clear()
		anon95_dare_overlay_alt.Clear()
		anon95_dare_passive_timer = 0
		anon95_dare_passive_bank = 0
		anon95_dare_tempcoat_active = false
		anon95_dare_coat_displaced = false
		anon95_dare_tempcoat_remaining = 0
		anon95_dare_tempcoat_second_timer = 0
		anon95_dare_nipple_duration = 0
		anon95_dare_nipple_done = false
		anon95_dare_nipple_locked = false
		anon95_dare_tempcoat_duration = 0
		anon95_dare_tempcoat_locked = false
		anon95_dare_ibalance_duration = 0
		anon95_dare_ibalance_done = false
		anon95_dare_toys_unlocked = false
		anon95_dare_blindfold_unlocked = false
		anon95_dare_blindfold_wear_duration = 0
		anon95_dare_orgasm_unlocked = false
		anon95_dare_orgasm_was_active = false
		anon95_dare_pee_unlocked = false
		anon95_gamble_state = 0
		anon95_gamble_prep_timer = 0
		anon95_gamble_elapsed = 0
		anon95_gamble_second_timer = 0
		anon95_gamble_force_timer = 0
		anon95_gamble_code = CreateList()
		anon95_gamble_guess = CreateList()
		anon95_gamble_selected = 0
		anon95_gamble_actions = 15
		anon95_gamble_rp_bank = 0
		anon95_gamble_rp_last_total = GetCurrentEarnRP()
		anon95_gamble_blindfold_mode = false
		anon95_gamble_move_duration = 0
		anon95_gamble_toy_disabled = false
		anon95_gamble_toy_return_timer = 0
		anon95_gamble_orgasm_was_active = false
		anon95_gamble_overlay_flip = 0
		anon95_dare_area = CreateArea(type="sphere", stage="Park", x=71.00, y=52.08, z=75.10, r=4, outline=true, compass=true)
		anon95_dare_zone = CreateZone(anon95_dare_area)
		anon95_dare_zone.SetVisible(false)
		anon95_dare_zone.SetColor(1,0.2,1)
		anon95_dare_dest_pos = Vector(71.00, 52.08, 75.10)

		anon95_dare_panel = CreateMissionPanel()
		anon95_dare_panel.SetVisible(false)
		anon95_dare_panel.SetGaugeVisible(true)
		anon95_dare_warning_panel = CreateMissionPanel()
		anon95_dare_warning_panel.SetVisible(false)
		anon95_dare_nipple_panel = CreateMissionPanel()
		anon95_dare_nipple_panel.SetVisible(false)
		anon95_dare_tempcoat_panel = CreateMissionPanel()
		anon95_dare_tempcoat_panel.SetVisible(false)
		anon95_dare_ibalance_panel = CreateMissionPanel()
		anon95_dare_ibalance_panel.SetVisible(false)
		anon95_dare_toys_panel = CreateMissionPanel()
		anon95_dare_toys_panel.SetVisible(false)
		anon95_dare_blindfold_panel = CreateMissionPanel()
		anon95_dare_blindfold_panel.SetVisible(false)
		anon95_dare_orgasm_panel = CreateMissionPanel()
		anon95_dare_orgasm_panel.SetVisible(false)
		anon95_dare_pee_panel = CreateMissionPanel()
		anon95_dare_pee_panel.SetVisible(false)
		anon95_gamble_panel = CreateMissionPanel()
		anon95_gamble_panel.SetVisible(false)
		anon95_gamble_panel.SetGaugeVisible(true)
		anon95_gamble_panel.SetRPText("")
		anon95_gamble_action_overlay = CreateText()
		anon95_gamble_action_overlay.SetAnchor(0.11, 0.935)
		anon95_gamble_action_overlay.SetAlignment("TopLeft")
		anon95_gamble_action_overlay.SetSize(27)
		anon95_gamble_action_overlay.SetWidth(520)
		anon95_gamble_action_overlay.SetFace(dilate=0.3)
		anon95_gamble_action_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
		anon95_gamble_action_overlay.SetFrontLayer(true)
		anon95_gamble_action_overlay.Clear()
		anon95_gamble_action_overlay_alt = CreateText()
		anon95_gamble_action_overlay_alt.SetAnchor(0.11, 0.935)
		anon95_gamble_action_overlay_alt.SetAlignment("TopLeft")
		anon95_gamble_action_overlay_alt.SetSize(27)
		anon95_gamble_action_overlay_alt.SetWidth(520)
		anon95_gamble_action_overlay_alt.SetFace(dilate=0.3)
		anon95_gamble_action_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
		anon95_gamble_action_overlay_alt.SetFrontLayer(true)
		anon95_gamble_action_overlay_alt.Clear()
		anon95_gamble_action_overlay_flip = 0
		anon95_gamble_rp_panel = CreateMissionPanel()
		anon95_gamble_rp_panel.SetVisible(false)
		anon95_gamble_rp_panel.SetGaugeVisible(true)
		anon95_gamble_rp_panel.SetRPText("")
		anon95_gamble_toy_panel = CreateMissionPanel()
		anon95_gamble_toy_panel.SetVisible(false)
		anon95_gamble_toy_panel.SetGaugeVisible(true)
		anon95_gamble_toy_panel.SetRPText("")
		anon95_gamble_overlay = CreateText()
		anon95_gamble_overlay.SetAnchor(0.5, 0.88)
		anon95_gamble_overlay.SetAlignment("Top")
		anon95_gamble_overlay.SetSize(28)
		anon95_gamble_overlay.SetWidth(1000)
		anon95_gamble_overlay.SetFace(dilate=0.3)
		anon95_gamble_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
		anon95_gamble_overlay.SetFrontLayer(true)
		anon95_gamble_overlay.Clear()
		anon95_gamble_overlay_alt = CreateText()
		anon95_gamble_overlay_alt.SetAnchor(0.5, 0.88)
		anon95_gamble_overlay_alt.SetAlignment("Top")
		anon95_gamble_overlay_alt.SetSize(28)
		anon95_gamble_overlay_alt.SetWidth(1000)
		anon95_gamble_overlay_alt.SetFace(dilate=0.3)
		anon95_gamble_overlay_alt.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.3)
		anon95_gamble_overlay_alt.SetFrontLayer(true)
		anon95_gamble_overlay_alt.Clear()

		anon95_input_up = CreateInput("<Keyboard>/quote")
		anon95_input_down = CreateInput("<Keyboard>/slash")
		anon95_input_left = CreateInput("<Keyboard>/comma")
		anon95_input_right = CreateInput("<Keyboard>/period")
		anon95_condition_nipple = CreateCondition("[Action_ChikubiRotate]")
		anon95_condition_clit = CreateCondition("[Action_OnaniArmKuri]")
		anon95_condition_ibalance = CreateCondition("[Action_IBalance]")
		anon95_condition_vibrator_random = CreateCondition("[AdultToy_Vibrator,VibrationRandom]")
		anon95_condition_titrotor_random = CreateCondition("[AdultToy_TitRotor,VibrationRandom]")
		anon95_condition_kurirotor_random = CreateCondition("[AdultToy_KuriRotor,VibrationRandom]")
		anon95_condition_blindfold = CreateCondition("[AdultToy_EyeMask]")
		anon95_condition_orgasm = CreateCondition("[Orgasm]")
		anon95_condition_handcuffsback = CreateCondition("[HandcuffsBack]")
		anon95_condition_peeing = CreateCondition("[Peeing]")
		anon95_condition_moving = CreateCondition("[Moving]")
		anon95_condition_dashing = CreateCondition("[Dashing]")
		anon95_condition_npca = CreateCondition("[NPCArea]")
		anon95_condition_handbra = CreateCondition("[Action_Tebura]")

		anon95_chat = CreateMessengerChat("Anonymous_95", iconfilename = "Asset/Anonymous95Icon.png", iconcolor = Color(0.05,0.05,0.05), icontext = "95", icontextcolor = Color(1,1,1))
		if _state.Position.stage == "Residence"
			anon95_root_mode = 1
			anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
			anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
		else
			anon95_dare_available = _state.Position.stage == "Park" && anon95_dare_completed == false
			if anon95_dare_available
				anon95_root_mode = 2
				anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
			else
				anon95_root_mode = 0
				anon95_chat.Add("觉得自己今天走运吗？", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
	anon95_chat_listener:
		if active
			current_anon95_stage = _state.Position.stage
			if current_anon95_stage != anon95_last_stage
				if current_anon95_stage == "Park"
					anon95_dare_completed = false
				anon95_last_stage = current_anon95_stage
			if anon95_branch == 0
				current_dare_available = current_anon95_stage == "Park" && anon95_dare_completed == false
				current_root_mode = 0
				if current_anon95_stage == "Residence"
					current_root_mode = 1
				elseif current_dare_available
					current_root_mode = 2
				if current_dare_available != anon95_dare_available || current_root_mode != anon95_root_mode
					anon95_dare_available = current_dare_available
					anon95_root_mode = current_root_mode
					anon95_chat.Clear()
					if anon95_root_mode == 1
						anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
						anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
					elseif anon95_root_mode == 2
						anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
						anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
					else
						anon95_chat.Add("觉得自己今天走运吗？", "Left", user="Anonymous_95", silent=false)
						anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
			if anon95_branch == 1 && current_anon95_stage != "Park"
				RestoreDareCoat()
				anon95_branch = 0
				anon95_dare_state = 0
				anon95_dare_zone.SetVisible(false)
				anon95_dare_panel.SetVisible(false)
				anon95_dare_warning_panel.SetVisible(false)
				anon95_dare_nipple_panel.SetVisible(false)
				anon95_dare_tempcoat_panel.SetVisible(false)
				anon95_dare_ibalance_panel.SetVisible(false)
				anon95_dare_toys_panel.SetVisible(false)
				anon95_dare_blindfold_panel.SetVisible(false)
				anon95_dare_orgasm_panel.SetVisible(false)
				anon95_dare_pee_panel.SetVisible(false)
				anon95_chat.Clear()
				anon95_chat.Add("挑战已取消，返回公园后可以再次尝试", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
				anon95_dare_available = false
				mainthread.UpdateHub()
			if anon95_branch == 3 && current_anon95_stage != "Residence"
				residence_dare.Cancel()
				anon95_branch = 0
				anon95_residence_dare_menu = "home"
				anon95_chat.Clear()
				if current_anon95_stage == "Park" && anon95_dare_completed == false
					anon95_root_mode = 2
					anon95_dare_available = true
					anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
					anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
				elseif current_anon95_stage == "Residence"
					anon95_root_mode = 1
					anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
					anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
				else
					anon95_root_mode = 0
					anon95_dare_available = false
					anon95_chat.Add("住宅区挑战已取消，返回住宅区后可以再次尝试", "Left", user="Anonymous_95", silent=false)
					anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
				mainthread.UpdateHub()
			if anon95_chat != null && anon95_done == false
				clicked = anon95_chat.Clicked()
				if clicked != null
					mainthread.UpdateHub()
					handled_click = false
					if anon95_branch == 0
						if current_anon95_stage == "Residence"
							if clicked == "dare" || clicked == 0
								anon95_branch = 3
								anon95_residence_dare_menu = "home"
								anon95_chat.Clear()
								res_best_ep = residence_dare.GetBestEP()
								anon95_chat.Add("最佳纪录：" + res_best_ep + "\n\n挑战是一项在限定区域和时间内赚取暴露点数（EP）的挑战\n\n不要逞强到失败——只有成功结束挑战时，本局获得的 EP 才会保存", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始", "规则与操作", "特殊奖励", "返回"), ids=CreateList("start", "rules", "rewards", "return"))
								handled_click = true
								mainthread.UpdateHub()
							if clicked == "gamble" || clicked == 1
								anon95_branch = 2
								anon95_gamble_state = 0
								anon95_gamble_blindfold_mode = false
								anon95_chat.Add("这是一个迷你开锁游戏。你会被铐住。要逃脱并赢得赌博，必须在 240 秒内破解锁具\n\n使用逗号（,）和句号（.）移动位置；使用斜杠（/）和撇号（'）更改数字。找出由 9 个数字组成的钥匙组合。选中正确数字时会响起 *叮* 声，请仔细听\n\n眼罩模式下，每获得 50 RP 会得到更多行动点数\n\n奖励：200 RP + 200 Manaka 点数", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
								handled_click = true
								mainthread.UpdateHub()
						elseif anon95_dare_available
							if clicked == "dare" || clicked == 0
								session_stage = current_anon95_stage
								anon95_branch = 1
								anon95_dare_state = 0
								anon95_chat.Add("目的地已标记，祝你好运。", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始", "返回"), ids=CreateList("start", "return"))
								handled_click = true
								mainthread.UpdateHub()
							if clicked == "gamble" || clicked == 1
								anon95_branch = 2
								anon95_gamble_state = 0
								anon95_gamble_blindfold_mode = false
								anon95_chat.Add("这是一个迷你开锁游戏。你会被铐住。要逃脱并赢得赌博，必须在 240 秒内破解锁具\n\n使用逗号（,）和句号（.）移动位置；使用斜杠（/）和撇号（'）更改数字。找出由 9 个数字组成的钥匙组合。选中正确数字时会响起 *叮* 声，请仔细听\n\n眼罩模式下，每获得 50 RP 会得到更多行动点数\n\n奖励：200 RP + 200 Manaka 点数", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
								handled_click = true
								mainthread.UpdateHub()
						else
							if clicked == "gamble" || clicked == 0
								anon95_branch = 2
								anon95_gamble_state = 0
								anon95_gamble_blindfold_mode = false
								anon95_chat.Add("这是一个迷你开锁游戏。你会被铐住。要逃脱并赢得赌博，必须在 240 秒内破解锁具\n\n使用逗号（,）和句号（.）移动位置；使用斜杠（/）和撇号（'）更改数字。找出由 9 个数字组成的钥匙组合。选中正确数字时会响起 *叮* 声，请仔细听\n\n眼罩模式下，每获得 50 RP 会得到更多行动点数\n\n奖励：200 RP + 200 Manaka 点数", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
								handled_click = true
								mainthread.UpdateHub()
					if handled_click == false && anon95_branch == 1
						if anon95_dare_state == 0
							if clicked == "start" || clicked == 0
								anon95_dare_state = 1
								anon95_dare_total_distance = Vector3Distance(_state.Position, anon95_dare_dest_pos)
								anon95_chat.SetButtons()
							if clicked == "return" || clicked == 1
								RestoreDareCoat()
								anon95_branch = 0
								anon95_dare_state = 0
								anon95_chat.Clear()
								anon95_dare_available = _state.Position.stage == "Park" && anon95_dare_completed == false
								if anon95_dare_available
									anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
									anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
								else
									anon95_chat.Add("觉得自己今天走运吗？", "Left", user="Anonymous_95", silent=false)
									anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
								mainthread.UpdateHub()
						else
							if clicked == "start" || clicked == 0
								DropItem(itemtype="Coat", position=_state.Position, compass=false)
								CollectItem(itemtype="Coat")
								anon95_cancel_coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
								DropItem(itemtype="Coat", stage="Apart", position=anon95_cancel_coat_away_pos, compass=false)
								anon95_dare_coat_displaced = true
								anon95_dare_state = 0
								anon95_dare_precheck_duration = 0
								anon95_dare_remaining = 300
								anon95_dare_elapsed = 0
								anon95_dare_tempcoat_active = false
