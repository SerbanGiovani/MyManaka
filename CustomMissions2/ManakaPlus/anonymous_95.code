									anon95_dare_orgasm_panel.SetVisible(false)
								else
									anon95_dare_orgasm_panel.SetVisible(true)
									anon95_dare_orgasm_panel.SetText("高潮会使进度增加 30 秒；主动使用手铐时此效果无效")
							else
								anon95_dare_orgasm_panel.SetVisible(false)
							anon95_dare_passive_timer = anon95_dare_passive_timer + _timediff
							if anon95_dare_passive_timer >= 2
								anon95_dare_passive_timer = anon95_dare_passive_timer - 2
								if anon95_dare_toys_unlocked
									if anon95_condition_vibrator_random.Check()
										anon95_dare_passive_bank = anon95_dare_passive_bank + 0.25
									if anon95_condition_titrotor_random.Check()
										anon95_dare_passive_bank = anon95_dare_passive_bank + 0.25
									if anon95_condition_kurirotor_random.Check()
										anon95_dare_passive_bank = anon95_dare_passive_bank + 0.25
								if anon95_dare_blindfold_unlocked
									if anon95_condition_blindfold.Check() && anon95_dare_blindfold_wear_duration >= 15
										anon95_dare_passive_bank = anon95_dare_passive_bank + 0.50
								if anon95_dare_passive_bank >= 1
									anon95_dare_passive_bank = anon95_dare_passive_bank - 1
									anon95_dare_remaining = anon95_dare_remaining - 1
							if anon95_dare_orgasm_unlocked
								if anon95_condition_orgasm.Check()
									if anon95_dare_orgasm_was_active == false
										if !anon95_condition_handcuffsback.Check()
											anon95_dare_remaining = anon95_dare_remaining + 30
									anon95_dare_orgasm_was_active = true
								else
									anon95_dare_orgasm_was_active = false
							if anon95_dare_remaining <= 0
								AddCurrentEarnRP(800)
								RestoreDareCoat()
								anon95_chat.Clear()
								anon95_chat.Add("很好", "Left", user="Anonymous_95", silent=false)
								anon95_done = false
								anon95_dare_completed = true
								anon95_dare_available = false
								anon95_branch = 0
								anon95_dare_state = 0
