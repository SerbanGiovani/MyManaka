								if anon95_condition_blindfold.Check()
									anon95_dare_blindfold_wear_duration = anon95_dare_blindfold_wear_duration + _timediff
								else
									anon95_dare_blindfold_wear_duration = 0
								if anon95_dare_blindfold_wear_duration >= 15
									anon95_dare_blindfold_panel.SetVisible(false)
								else
									anon95_dare_blindfold_panel.SetVisible(true)
									anon95_dare_blindfold_panel.SetText("戴上眼罩满 15 秒后，主计时每 2 秒额外减少 0.50 秒")
							else
								anon95_dare_blindfold_wear_duration = 0
								anon95_dare_blindfold_panel.SetVisible(false)
