							if anon95_gamble_guess[anon95_gamble_selected] == anon95_gamble_code[anon95_gamble_selected]
								warning_sound.Play()
						if anon95_input_right.WasPressed()
							anon95_gamble_selected = anon95_gamble_selected + 1
							if anon95_gamble_selected > 8
								anon95_gamble_selected = 0
							if anon95_gamble_guess[anon95_gamble_selected] == anon95_gamble_code[anon95_gamble_selected]
