								anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
								mainthread.UpdateHub()
						else
							if clicked == "return" || clicked == 0
								handled_click = true
								anon95_residence_dare_menu = "home"
								anon95_chat.Clear()
								res_best_ep = residence_dare.GetBestEP()
								anon95_chat.Add("最佳纪录：" + res_best_ep + "\n\n挑战是一项在限定区域和时间内赚取暴露点数（EP）的挑战\n\n不要逞强到失败——只有成功结束挑战时，本局获得的 EP 才会保存", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始", "规则与操作", "特殊奖励", "返回"), ids=CreateList("start", "rules", "rewards", "return"))
								mainthread.UpdateHub()
					if handled_click == false && anon95_branch == 2
						if anon95_gamble_state == 0
							if clicked == "gamble_start" || clicked == 0
								anon95_gamble_state = 1
								session_stage = _state.Position.stage
								anon95_gamble_prep_timer = 0
								anon95_gamble_elapsed = 0
								anon95_gamble_second_timer = 0
								anon95_gamble_force_timer = 0
								anon95_gamble_actions = 15
								anon95_gamble_rp_bank = 0
								anon95_gamble_rp_last_total = GetCurrentEarnRP()
								anon95_gamble_move_duration = 0
								anon95_gamble_toy_disabled = false
								anon95_gamble_toy_return_timer = 0
								anon95_chat.SetButtons()
							if clicked == "gamble_blindfold" || clicked == 1
								if anon95_gamble_blindfold_mode
									anon95_gamble_blindfold_mode = false
									anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
								else
									anon95_gamble_blindfold_mode = true
									anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：开启", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
							if clicked == "return" || clicked == 2
								anon95_branch = 0
								anon95_gamble_state = 0
								anon95_chat.Clear()
								return_stage = _state.Position.stage
								if return_stage == "Residence"
									anon95_root_mode = 1
									anon95_dare_available = false
									anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
									anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
								else
									anon95_dare_available = return_stage == "Park" && anon95_dare_completed == false
									if anon95_dare_available
										anon95_root_mode = 2
										anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
										anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
									else
										anon95_root_mode = 0
										anon95_chat.Add("觉得自己今天走运吗？", "Left", user="Anonymous_95", silent=false)
										anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
								mainthread.UpdateHub()
						else
							if clicked == "gamble_start" || clicked == 0
								UnlockHandcuffs()
								SetVibrator("Off")
								UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
								if anon95_gamble_blindfold_mode
									UnequipAdultToy("EyeMask")
								SetVibrator("Off")
								anon95_gamble_state = 0
								anon95_gamble_prep_timer = 0
