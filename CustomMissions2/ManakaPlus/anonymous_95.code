							anon95_gamble_rp_panel.SetText("每获得 50 RP，增加 8 点行动点数")
						else
							anon95_gamble_rp_panel.SetText("每获得 50 RP，增加 5 点行动点数")
						anon95_gamble_rp_panel.SetGaugeVisible(true)
						anon95_gamble_rp_panel.SetGaugeProgress(anon95_gamble_rp_bank / 50)
						if anon95_gamble_toy_disabled
							anon95_gamble_toy_panel.SetVisible(false)
						else
							anon95_gamble_toy_panel.SetVisible(true)
							anon95_gamble_toy_panel.SetText("高潮会重置锁具，保持移动可暂时禁用此效果")
							anon95_gamble_toy_panel.SetGaugeProgress(anon95_gamble_move_duration / 10)
						anon95_gamble_solved = true
						anon95_gamble_i = 0
						while anon95_gamble_i < 9
							if anon95_gamble_guess[anon95_gamble_i] != anon95_gamble_code[anon95_gamble_i]
								anon95_gamble_solved = false
							anon95_gamble_i = anon95_gamble_i + 1
						if anon95_gamble_solved
							AddCurrentEarnRP(200)
							manaka_points.Add(amount=200)
							mainthread.UpdateHub()
							anon95_reward_overlay.Clear()
							anon95_reward_overlay.Add(text="200 RP + 200 Manaka Points Added")
							anon95_reward_overlay_timer = 5
							UnlockHandcuffs()
							SetVibrator("Off")
							UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
							if anon95_gamble_blindfold_mode
								UnequipAdultToy("EyeMask")
							SetVibrator("Off")
							anon95_chat.Clear()
							anon95_chat.Add("很好", "Left", user="Anonymous_95", silent=false)
							anon95_gamble_state = 0
							if anon95_gamble_blindfold_mode
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：开启", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
							else
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
							anon95_gamble_panel.SetVisible(false)
							anon95_gamble_action_overlay.Clear()
							anon95_gamble_action_overlay_alt.Clear()
							anon95_gamble_rp_panel.SetVisible(false)
							anon95_gamble_toy_panel.SetVisible(false)
							anon95_gamble_overlay.Clear()
							anon95_gamble_overlay_alt.Clear()
						if anon95_gamble_elapsed >= 240 && anon95_done == false
							UnlockHandcuffs()
							SetVibrator("Off")
							UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
							if anon95_gamble_blindfold_mode
								UnequipAdultToy("EyeMask")
							SetVibrator("Off")
							anon95_chat.Clear()
							anon95_chat.Add("运气不太好", "Left", user="Anonymous_95", silent=false)
							anon95_gamble_state = 0
							anon95_gamble_elapsed = 0
							anon95_gamble_panel.SetVisible(false)
							anon95_gamble_action_overlay.Clear()
							anon95_gamble_action_overlay_alt.Clear()
							anon95_gamble_rp_panel.SetVisible(false)
							anon95_gamble_toy_panel.SetVisible(false)
							anon95_gamble_overlay.Clear()
							anon95_gamble_overlay_alt.Clear()
							if anon95_gamble_blindfold_mode
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：开启", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))
							else
								anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))




	RefreshParkDareOverlay:
		dare_overlay_text = "Do not leave this zone. Survive. " + anon95_dare_remaining + "s\nReward: 1000 RP"
		if anon95_dare_remaining <= 60
			dare_overlay_text = "<color=#ff3333>" + dare_overlay_text + "</color>"
		if anon95_dare_overlay_flip == 0
			anon95_dare_overlay.Clear()
			anon95_dare_overlay.Add(text=dare_overlay_text, duration=-1)
			anon95_dare_overlay_alt.Clear()
			anon95_dare_overlay_flip = 1
		else
			anon95_dare_overlay_alt.Clear()
			anon95_dare_overlay_alt.Add(text=dare_overlay_text, duration=-1)
			anon95_dare_overlay.Clear()
			anon95_dare_overlay_flip = 0
	ClearParkDareOverlay:
		anon95_dare_overlay.Clear()
		anon95_dare_overlay_alt.Clear()
		anon95_dare_overlay_refresh_timer = 0


	RestoreDareCoat:
		if anon95_dare_coat_displaced
			CollectItem(itemtype="Coat")
			anon95_dare_coat_return_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
			DropItem(itemtype="Coat", position=anon95_dare_coat_return_pos, compass=false)
			anon95_dare_coat_displaced = false


	RefreshContact:
		if anon95_chat != null
			anon95_chat.Clear()
			anon95_last_stage = _state.Position.stage
			anon95_dare_available = anon95_last_stage == "Park" && anon95_dare_completed == false
			if anon95_last_stage == "Residence"
				anon95_root_mode = 1
				anon95_chat.Add("挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
			elseif anon95_dare_available
				anon95_root_mode = 2
				anon95_chat.Add("来一场 800 的挑战，还是赌博？", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
			else
				anon95_root_mode = 0
				anon95_chat.Add("觉得自己今天走运吗？", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))

	IsBusy:
		_result = active && (anon95_branch != 0 || residence_dare.IsActive())

	CancelMission:
		if anon95_branch == 1
			RestoreDareCoat()
		if anon95_branch == 3
			residence_dare.Cancel()
		if anon95_branch == 2 && anon95_gamble_state > 0
			UnlockHandcuffs()
		SetVibrator("Off")
		UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
		if anon95_gamble_blindfold_mode
			UnequipAdultToy("EyeMask")
		SetVibrator("Off")
		anon95_dare_zone.SetVisible(false)
		anon95_dare_panel.SetVisible(false)
		ClearParkDareOverlay()
		anon95_dare_warning_panel.SetVisible(false)
		anon95_dare_nipple_panel.SetVisible(false)
		anon95_dare_tempcoat_panel.SetVisible(false)
		anon95_dare_ibalance_panel.SetVisible(false)
		anon95_dare_toys_panel.SetVisible(false)
		anon95_dare_blindfold_panel.SetVisible(false)
		anon95_dare_orgasm_panel.SetVisible(false)
		anon95_dare_pee_panel.SetVisible(false)
		anon95_gamble_panel.SetVisible(false)
		anon95_gamble_rp_panel.SetVisible(false)
		anon95_gamble_toy_panel.SetVisible(false)
		anon95_gamble_overlay.Clear()
		anon95_gamble_overlay_alt.Clear()
		anon95_gamble_action_overlay.Clear()
		anon95_gamble_action_overlay_alt.Clear()
		anon95_branch = 0
		anon95_done = false
		anon95_gamble_state = 0
		anon95_dare_state = 0
		anon95_residence_dare_menu = "home"
		anon95_dare_available = _state.Position.stage == "Park" && anon95_dare_completed == false
		anon95_chat.Clear()
		anon95_chat.Add("已取消。", "Left", user="Anonymous_95", silent=false)
		if _state.Position.stage == "Residence"
			anon95_root_mode = 1
			anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
		elseif anon95_dare_available
			anon95_root_mode = 2
			anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
		else
			anon95_root_mode = 0
			anon95_chat.SetButtons(CreateList("赌博"), ids=CreateList("gamble"))
		mainthread.UpdateHub()
