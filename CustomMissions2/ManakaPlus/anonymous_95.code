								if anon95_condition_peeing.Check()
									anon95_dare_pee_panel.SetVisible(false)
								else
									anon95_dare_pee_panel.SetVisible(true)
									anon95_dare_pee_panel.SetText("排尿时，主计时每秒额外减少 0.25 秒")
