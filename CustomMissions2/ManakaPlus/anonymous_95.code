								anon95_dare_toys_panel.SetVisible(false)
								anon95_dare_blindfold_panel.SetVisible(false)
								anon95_dare_orgasm_panel.SetVisible(false)
								anon95_dare_pee_panel.SetVisible(false)
								anon95_chat.Add("已取消", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("开始", "返回"), ids=CreateList("start", "return"))
					if handled_click == false && anon95_branch == 3
						if anon95_residence_dare_menu == "home"
							if clicked == "start" || clicked == 0
								handled_click = true
								residence_dare.Start()
								anon95_chat.Clear()
								anon95_chat.Add("祝你好运。", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons()
								mainthread.UpdateHub()
							if clicked == "rules" || clicked == 1
								handled_click = true
								anon95_residence_dare_menu = "rules"
								anon95_chat.Clear()
								anon95_chat.Add("屏幕左上角会出现暴露点数计数器，显示本次挑战获得的 EP 总数。EP 只会在挑战成功结束后保存。\n\n挑战期间每获得 10 RP，会自动转换为 1 EP。住宅区挑战持续 300 秒\n\n特殊事件每 80 秒轮换一次。每份列表包含三个普通或稀有任务栏位，以及一个延时事件栏位。每份列表最多出现一个稀有事件，部分特殊任务每局只能完成一次\n\n你不能离开 挑战区域。当前 挑战区域在任务期间会保持可见。按 ] 可切换到其他 挑战区域，所需 EP 会显示在特殊任务面板上。连续使用会提高 EP 费用；停止切换一段时间后费用会重置\n\n按 [ 可显示或隐藏特殊任务面板", "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("返回"), ids=CreateList("return"))
								mainthread.UpdateHub()
							if clicked == "rewards" || clicked == 2
								handled_click = true
								anon95_residence_dare_menu = "reward"
								anon95_chat.Clear()
								silver_reward_text = "-最佳纪录达到至少 200 EP：大胆者银牌"
								gold_reward_text = "-最佳纪录达到至少 400 EP：大胆者金牌"
								champion_reward_text = "-全程露出可疑度不低于 80%，并获得至少 300 EP：大胆者冠军奖牌"
								if _save.ManakaPlusV2DaringSilverMedalOwned == true
									silver_reward_text = "已拥有大胆者银牌"
								if _save.ManakaPlusV2DaringGoldMedalOwned == true
									gold_reward_text = "已拥有大胆者金牌"
								if _save.ManakaPlusV2DaringChampionMedalOwned == true
									champion_reward_text = "已拥有大胆者冠军奖牌"
								anon95_chat.Add(silver_reward_text + "\n" + gold_reward_text + "\n" + champion_reward_text, "Left", user="Anonymous_95", silent=false)
								anon95_chat.SetButtons(CreateList("返回"), ids=CreateList("return"))
								mainthread.UpdateHub()
							if clicked == "return" || clicked == 3
