								else
									anon95_chat.SetButtons(CreateList("开始赌博", "眼罩：关闭", "返回"), ids=CreateList("gamble_start", "gamble_blindfold", "return"))

	anon95_runtime_listener:
		if anon95_reward_overlay_timer > 0
			anon95_reward_overlay_timer = anon95_reward_overlay_timer - _timediff
			if anon95_reward_overlay_timer <= 0
				anon95_reward_overlay.Clear()
		if active && anon95_branch == 3
			if residence_dare.ConsumeCompleted()
				res_ep = residence_dare.GetLastEP()
				res_best_ep = residence_dare.GetBestEP()
				anon95_branch = 0
				anon95_chat.Clear()
				anon95_chat.Add("住宅区挑战完成，已保存 " + res_ep + " EP。最佳纪录：" + res_best_ep + " EP。", "Left", user="Anonymous_95", silent=false)
				anon95_chat.SetButtons(CreateList("挑战", "赌博"), ids=CreateList("dare", "gamble"))
				anon95_root_mode = 1
				mainthread.UpdateHub()
		if active
			if active && anon95_chat != null
				# Anonymous_95 Dare branch for Park.
				if anon95_branch == 1 && anon95_done == false && session_stage == "Park"
					anon95_dare_zone.SetVisible(true)
					if anon95_dare_state == 1
						anon95_dare_panel.SetVisible(true)
						anon95_dare_panel.SetText("前往指定地点")
						anon95_dare_panel.SetRPText("")
						anon95_dare_panel.SetGaugeVisible(true)
						anon95_dist = Vector3Distance(_state.Position, anon95_dare_dest_pos)
						anon95_gauge = 0
						if anon95_dare_total_distance > 0
							if anon95_dist < anon95_dare_total_distance
								anon95_gauge = (anon95_dare_total_distance - anon95_dist) / anon95_dare_total_distance
						if anon95_dist <= 4
							anon95_gauge = 1
						anon95_dare_panel.SetGaugeProgress(anon95_gauge)
						if anon95_dare_zone.Inside()
							anon95_dare_state = 2
							anon95_dare_precheck_duration = 0
					if anon95_dare_state == 2
						anon95_dare_panel.SetVisible(true)
						anon95_dare_panel.SetText("保持手遮胸以开始极限任务，做好准备")
						anon95_dare_panel.SetRPText("")
						anon95_dare_panel.SetGaugeVisible(true)
						anon95_dare_warning_panel.SetVisible(true)
						anon95_dare_warning_panel.SetText("警告：任务面板数量很多。开始前请调整显示设置或 UI 缩放")
						if anon95_dare_zone.Inside()
							if anon95_condition_handbra.Check()
								anon95_dare_precheck_duration = anon95_dare_precheck_duration + _timediff
							else
								anon95_dare_precheck_duration = 0
						else
							anon95_dare_precheck_duration = 0
						anon95_dare_panel.SetGaugeProgress(anon95_dare_precheck_duration / 3)
						if anon95_dare_precheck_duration >= 3
							anon95_dare_state = 3
							anon95_dare_precheck_duration = 0
							anon95_dare_remaining = 300
							anon95_dare_elapsed = 0
							anon95_dare_second_timer = 0
							anon95_dare_passive_timer = 0
							anon95_dare_passive_bank = 0
							anon95_dare_tempcoat_active = false
							anon95_dare_tempcoat_remaining = 0
							anon95_dare_nipple_duration = 0
							anon95_dare_nipple_done = false
							anon95_dare_nipple_locked = false
							anon95_dare_tempcoat_duration = 0
							anon95_dare_tempcoat_locked = false
							anon95_dare_ibalance_duration = 0
							anon95_dare_ibalance_done = false
							anon95_dare_toys_unlocked = false
							anon95_dare_blindfold_unlocked = false
							anon95_dare_blindfold_wear_duration = 0
							anon95_dare_orgasm_unlocked = false
							anon95_dare_orgasm_was_active = false
							anon95_dare_pee_unlocked = false
							anon95_dare_panel.SetVisible(false)
							anon95_dare_overlay_refresh_timer = 0
							anon95_dare_overlay_flip = 0
							anon95_dare_overlay.Clear()
							anon95_dare_overlay_alt.Clear()
							RefreshParkDareOverlay()
							anon95_dare_warning_panel.SetVisible(false)
					if anon95_dare_state == 3
						if anon95_dare_zone.Inside()
							anon95_dare_second_timer = anon95_dare_second_timer + _timediff
							if anon95_dare_second_timer >= 1
								anon95_dare_second_timer = anon95_dare_second_timer - 1
								anon95_dare_remaining = anon95_dare_remaining - 1
								anon95_dare_elapsed = anon95_dare_elapsed + 1
								if anon95_dare_pee_unlocked
									if anon95_condition_peeing.Check()
										anon95_dare_passive_bank = anon95_dare_passive_bank + 0.25
						else
							DropItem(itemtype="Coat", position=_state.Position, compass=false)
							CollectItem(itemtype="Coat")
							anon95_coat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
							DropItem(itemtype="Coat", stage="Apart", position=anon95_coat_away_pos, compass=false)
							anon95_dare_coat_displaced = true
							anon95_dare_state = 2
							anon95_dare_remaining = 300
							anon95_dare_elapsed = 0
							anon95_dare_second_timer = 0
							anon95_dare_passive_timer = 0
							anon95_dare_passive_bank = 0
							anon95_dare_tempcoat_active = false
							anon95_dare_tempcoat_remaining = 0
							anon95_dare_nipple_duration = 0
							anon95_dare_nipple_done = false
							anon95_dare_nipple_locked = false
							anon95_dare_tempcoat_duration = 0
							anon95_dare_tempcoat_locked = false
							anon95_dare_ibalance_duration = 0
							anon95_dare_ibalance_done = false
							anon95_dare_toys_unlocked = false
							anon95_dare_blindfold_unlocked = false
							anon95_dare_blindfold_wear_duration = 0
							anon95_dare_orgasm_unlocked = false
							anon95_dare_pee_unlocked = false
							ClearParkDareOverlay()
							anon95_dare_panel.SetVisible(true)
							anon95_dare_warning_panel.SetVisible(true)
							anon95_dare_warning_panel.SetText("警告：任务面板数量很多。开始前请调整显示设置或 UI 缩放")
							anon95_dare_nipple_panel.SetVisible(false)
							anon95_dare_tempcoat_panel.SetVisible(false)
							anon95_dare_ibalance_panel.SetVisible(false)
							anon95_dare_toys_panel.SetVisible(false)
							anon95_dare_blindfold_panel.SetVisible(false)
							anon95_dare_orgasm_panel.SetVisible(false)
							anon95_dare_pee_panel.SetVisible(false)

						if anon95_dare_state == 3
							if anon95_dare_nipple_done == false && anon95_dare_remaining <= 200
								anon95_dare_nipple_locked = true
							anon95_dare_panel.SetVisible(false)
							anon95_dare_overlay_refresh_timer = anon95_dare_overlay_refresh_timer + _timediff
							if anon95_dare_overlay_refresh_timer >= 0.20
								anon95_dare_overlay_refresh_timer = 0
								RefreshParkDareOverlay()
							if anon95_dare_nipple_done == false && anon95_dare_nipple_locked == false
								anon95_dare_nipple_panel.SetVisible(true)
								anon95_dare_nipple_panel.SetText("进行玩弄乳头取回外套，但任务时间会增加 100 秒")
								anon95_dare_nipple_panel.SetGaugeVisible(true)
								if anon95_condition_nipple.Check()
									anon95_dare_nipple_duration = anon95_dare_nipple_duration + _timediff
								else
									anon95_dare_nipple_duration = 0
								anon95_dare_nipple_panel.SetGaugeProgress(anon95_dare_nipple_duration / 2)
								if anon95_dare_nipple_duration >= 2
									anon95_dare_nipple_done = true
									anon95_dare_remaining = anon95_dare_remaining + 100
									CollectItem(itemtype="Coat")
									anon95_coat_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
									DropItem(itemtype="Coat", position=anon95_coat_pos, compass=false)
									anon95_dare_coat_displaced = false
									anon95_dare_nipple_panel.SetVisible(false)
							else
								anon95_dare_nipple_panel.SetVisible(false)
								anon95_dare_nipple_duration = 0
							if anon95_dare_tempcoat_active
								anon95_dare_tempcoat_panel.SetVisible(true)
								anon95_dare_tempcoat_panel.SetText("外套将在" + anon95_dare_tempcoat_remaining)
								anon95_dare_tempcoat_panel.SetGaugeVisible(true)
								anon95_dare_tempcoat_panel.SetGaugeProgress(anon95_dare_tempcoat_remaining / 15)
								anon95_dare_tempcoat_second_timer = anon95_dare_tempcoat_second_timer + _timediff
								if anon95_dare_tempcoat_second_timer >= 1
									anon95_dare_tempcoat_second_timer = anon95_dare_tempcoat_second_timer - 1
									anon95_dare_tempcoat_remaining = anon95_dare_tempcoat_remaining - 1
								if anon95_dare_tempcoat_remaining <= 0
									DropItem(itemtype="Coat", position=_state.Position, compass=false)
									CollectItem(itemtype="Coat")
									anon95_tempcoat_away_pos = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
									DropItem(itemtype="Coat", stage="Apart", position=anon95_tempcoat_away_pos, compass=false)
									anon95_dare_coat_displaced = true
									anon95_dare_tempcoat_active = false
									anon95_dare_tempcoat_duration = 0
							else
								if anon95_dare_nipple_done || anon95_dare_tempcoat_locked
									anon95_dare_tempcoat_panel.SetVisible(false)
									anon95_dare_tempcoat_duration = 0
								else
									anon95_dare_tempcoat_panel.SetVisible(true)
									anon95_dare_tempcoat_panel.SetText("进行玩弄阴蒂可暂时取回外套 15 秒，同时增加 30 秒任务时间")
									anon95_dare_tempcoat_panel.SetGaugeVisible(true)
									if anon95_condition_clit.Check()
										anon95_dare_tempcoat_duration = anon95_dare_tempcoat_duration + _timediff
									else
										anon95_dare_tempcoat_duration = 0
									anon95_dare_tempcoat_panel.SetGaugeProgress(anon95_dare_tempcoat_duration / 2)
									if anon95_dare_tempcoat_duration >= 2
										anon95_dare_remaining = anon95_dare_remaining + 30
										anon95_dare_tempcoat_active = true
										anon95_dare_tempcoat_remaining = 16
										anon95_dare_tempcoat_second_timer = 0
										anon95_dare_tempcoat_duration = 0
										CollectItem(itemtype="Coat")
										anon95_tempcoat_pos = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
										DropItem(itemtype="Coat", position=anon95_tempcoat_pos, compass=false)
										anon95_dare_coat_displaced = false
							if anon95_dare_remaining <= 270 && anon95_dare_ibalance_done == false
								anon95_dare_ibalance_panel.SetVisible(true)
								anon95_dare_ibalance_panel.SetText("连续保持I字劈叉平衡 15 秒，可减少 30 秒任务时间")
								anon95_dare_ibalance_panel.SetGaugeVisible(true)
								if anon95_condition_ibalance.Check()
									anon95_dare_ibalance_duration = anon95_dare_ibalance_duration + _timediff
								else
									anon95_dare_ibalance_duration = 0
								anon95_dare_ibalance_panel.SetGaugeProgress(anon95_dare_ibalance_duration / 15)
								if anon95_dare_ibalance_duration >= 15
									anon95_dare_ibalance_done = true
									anon95_dare_remaining = anon95_dare_remaining - 30
									anon95_dare_ibalance_panel.SetVisible(false)
							else
								anon95_dare_ibalance_panel.SetVisible(false)
							if anon95_dare_remaining <= 240 || anon95_dare_ibalance_done
								anon95_dare_toys_unlocked = true
							if anon95_dare_remaining <= 210
								anon95_dare_blindfold_unlocked = true
							if anon95_dare_remaining <= 180
								anon95_dare_pee_unlocked = true
							if anon95_dare_remaining <= 120
								anon95_dare_orgasm_unlocked = true
