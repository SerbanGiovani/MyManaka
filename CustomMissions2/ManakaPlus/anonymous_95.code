										anon95_digit_ok = false
									if anon95_digit == 1 && anon95_count_1 >= 2
										anon95_digit_ok = false
									if anon95_digit == 2 && anon95_count_2 >= 2
										anon95_digit_ok = false
									if anon95_digit == 3 && anon95_count_3 >= 2
										anon95_digit_ok = false
