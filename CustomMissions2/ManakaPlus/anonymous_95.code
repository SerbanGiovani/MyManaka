	anon95_reward_overlay = CreateText()
	anon95_reward_overlay.SetAnchor(0.5, 0.5)
	anon95_reward_overlay.SetAlignment("Top")
	anon95_reward_overlay.SetSize(36)
	anon95_reward_overlay.SetWidth(1200)
	anon95_reward_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	anon95_reward_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	anon95_reward_overlay.SetFrontLayer(true)
	anon95_reward_overlay.Clear()

	anon95_dare_overlay = CreateText()
	anon95_dare_overlay.SetAnchor(0.51, 0.90)
	anon95_dare_overlay.SetAlignment("Top")
	anon95_dare_overlay.SetSize(28)
	anon95_dare_overlay.SetWidth(1000)
	anon95_dare_overlay.SetFace(color=Color(1,1,1,1), dilate=0.35)
	anon95_dare_overlay.SetOutline(color=Color(0.05,0.05,0.05,1), width=0.35)
	anon95_dare_overlay.SetFrontLayer(true)
