						else
							anon95_gamble_orgasm_was_active = false
						if anon95_gamble_toy_disabled
							anon95_gamble_toy_return_timer = anon95_gamble_toy_return_timer - _timediff
							if anon95_gamble_toy_return_timer <= 0
								anon95_gamble_toy_disabled = false
								anon95_gamble_move_duration = 0
						else
							if (anon95_condition_moving.Check() || anon95_condition_dashing.Check()) && anon95_condition_npca.Check()
								anon95_gamble_move_duration = anon95_gamble_move_duration + _timediff
							else
