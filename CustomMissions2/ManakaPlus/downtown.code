		downtown_laundry_outside_turn_timer = RandomInt(18,22)
		downtown_laundry_outside_direction = 0
		downtown_laundry_outside_detection_timer = 0
		downtown_laundry_start_pos = null
		downtown_laundry_dest_pos = Vector(-216.60, 0.45, -20.22)
		downtown_laundry_total_distance = 0
		downtown_marathon_state = 0
		downtown_marathon_precheck_duration = 0
		downtown_marathon_bodypaint_duration = 0
		downtown_marathon_elapsed_tick = 0
		downtown_marathon_minutes = 0
		downtown_marathon_seconds = 0
		downtown_marathon_start_pos = null
		downtown_marathon_dest_pos = null
		downtown_marathon_total_distance = 0

		# Persistent Downtown scenery NPC near The Hub.
		downtown_stage_phone_npc = CreateNPC("NewMale", position=Vector(-222.05, 0.28, -43.99), rotation=Quaternion(0.00000, -0.81810, 0.00000, 0.57507))
		downtown_stage_phone_npc.Smartphone(true)
		downtown_stage_phone_npc.SkipStrangeness(true)
		downtown_stage_phone_npc.CanGameOver(false)
		downtown_stage_phone_npc.ClearWaypoints()
		downtown_stage_phone_npc.AddWaypoint(Vector(-222.05, 0.28, -43.99))


		# Expert Mission 1 NPCs are spawned after the bridge pre-check.


		# Downtown BigJ: its own saved contact, isolated from Park BigJ.
		downtown_bigj_chat = CreateMessengerChat("BigJ", iconfilename = "Asset/BigJIcon.png", iconcolor = Color(0.7,0.2,1), icontext = "BJ", icontextcolor = Color(1,1,1))
		downtown_bigj_gallery = null
		downtown_bigj_mode = 0
		downtown_bigj_rebuild = true
		downtown_bigj_known_photos = GetAllSnapshots()
		downtown_bigj_scan_timer = 0
		downtown_bigj_last_mission_category = 0
		downtown_bigj_rebuild_listener = CreateListenerLocal("downtown_bigj_rebuild_listener")
		downtown_bigj_button_listener = CreateListenerLocal("downtown_bigj_button_listener")
		downtown_bigj_confirm_listener = CreateListenerLocal("downtown_bigj_confirm_listener")
		downtown_bigj_photo_scan_listener = CreateListenerLocal("downtown_bigj_photo_scan_listener")


		listener = CreateListenerLocal("downtown_runtime_listener")

	downtown_bigj_rebuild_listener:
		if mission_active
			if active_stage == "Downtown" && downtown_bigj_chat != null && downtown_bigj_rebuild
				downtown_bigj_rebuild = false
				downtown_bigj_gallery = null
				downtown_bigj_chat.Clear()
				if _save.DowntownBigJIntroDone != 1
					downtown_bigj_chat.Add("嘿嘿嘿！欢迎来到繁华街，迷人的真菜香！这里大得惊人——BigJ 的意思是，这里的机会也多得惊人\n\n露出社团的几个家伙在停车场设立了“任务中心”。姑娘，做其他事之前最好先去看看\n\n除此之外，BigJ 也准备了几笔全新的交易让你玩玩", "Left", user="BigJ", silent=false)
					downtown_bigj_chat.SetButtons(CreateList("所以是什么交易？"))
				else
					# Keep one compact base intro after the first conversation / chat clearing.
					# Once Expert is unlocked, the same intro also explains the Expert photo deal.
					if _save.DowntownXP >= 500 || _save.DowntownBigJExpertIntroDone == 1
						downtown_bigj_chat.Add("姑娘，你随时都可以把想发的照片交给 BigJ。交易规则如下：\n\n- 新手任务期间拍摄的照片：100 RP 与 15 XP\n- 专家任务期间拍摄的照片：200 RP 与 30 XP\n\n不过 BigJ 不收二手货——同一张老照片不能重复使用，姑娘\n\n去吧，让 BigJ 看看你的新游乐场，嘿嘿嘿", "Left", user="BigJ", silent=true)
					else
						downtown_bigj_chat.Add("姑娘，你随时都可以把想发的照片交给 BigJ。交易规则如下：\n\n- 新手任务期间拍摄的照片：100 RP 与 15 XP\n\n不过 BigJ 不收二手货——同一张老照片不能重复使用，姑娘\n\n去吧，让 BigJ 看看你的新游乐场，嘿嘿嘿", "Left", user="BigJ", silent=true)
					history_index = 0
					while history_index < _save.DowntownBigJHistoryType.Count()
						history_type = _save.DowntownBigJHistoryType[history_index]
						if history_type == 1
							history_image = _save.DowntownBigJHistoryImage[history_index]
							history_reply = _save.DowntownBigJHistoryReply[history_index]
							history_tag = _save.DowntownBigJHistoryTag[history_index]
							downtown_bigj_chat.Add(history_image, "Right", silent=true)
							if history_reply == 1
								downtown_bigj_reply_text = "不错嘛，真菜香"
							if history_reply == 2
								downtown_bigj_reply_text = "哇哦！"
							if history_reply == 3
								downtown_bigj_reply_text = "BigJ 简直不敢相信自己的眼睛！"
							if history_tag == 1
								downtown_bigj_reply_text = downtown_bigj_reply_text + "\n+100 RP , +15 XP"
							if history_tag == 2
								downtown_bigj_reply_text = downtown_bigj_reply_text + "\n+200 RP , +30 XP"
							downtown_bigj_chat.Add(downtown_bigj_reply_text, "Left", user="BigJ", silent=true)
						if history_type == 2
							downtown_bigj_chat.Add("你居然全裸跑遍了繁华街？BigJ 知道你很大胆，但这也太屌了！\n\n+5000 RP", "Left", user="BigJ", silent=true)
						if history_type == 3
							downtown_bigj_chat.Add("你居然蒙着眼完成了马拉松？！BigJ 简直不敢相信自己的眼睛，真是讽刺，毕竟你当时根本用不了自己的眼睛！\n\n+5000 RP", "Left", user="BigJ", silent=true)
						if history_type == 4
							downtown_bigj_chat.Add("全身赤裸地踏遍繁华街的每个角落，这才叫征服整座城市，姑娘！BigJ 服了！\n\n+5000 RP", "Left", user="BigJ", silent=true)
						if history_type == 5
							downtown_bigj_chat.Add("全程叉腿走路穿过了那片闹市区？哇哦！真菜香，你该不会是什么隐身大师吧！\n\n+5000 RP", "Left", user="BigJ", silent=true)
						# Expert deal history type 6 is intentionally not rebuilt here.
						# Its reward details are merged into the single compact base intro above,
						# while the live one-time Expert unlock message still appears when earned.
						history_index = history_index + 1
					downtown_bigj_chat.SetButtons(CreateList("发送照片", "清除发送过的照片"))

	downtown_bigj_button_listener:
		if mission_active
			if active_stage == "Downtown" && downtown_bigj_chat != null
				downtown_bigj_clicked = downtown_bigj_chat.Clicked()
				if downtown_bigj_clicked != null
					if _save.DowntownBigJIntroDone != 1
						_save.DowntownBigJIntroDone = 1
						downtown_bigj_mode = 0
						downtown_bigj_rebuild = true
					else
						if downtown_bigj_mode == 0
							if downtown_bigj_clicked == 0
								downtown_bigj_gallery = CreateGallery("downtown_bigj_gallery_filter")
								downtown_bigj_gallery.Show()
							if downtown_bigj_clicked == 1
								downtown_bigj_mode = 1
								downtown_bigj_chat.Clear()
								downtown_bigj_chat.Add("这只会清除之前的聊天消息与已提交照片，已经使用过的照片依然无法再次提交", "Left", user="BigJ", silent=true)
								downtown_bigj_chat.SetButtons(CreateList("清除聊天记录", "返回"))
						else
							if downtown_bigj_clicked == 0
								_save.DowntownBigJHistoryType = CreateList()
								_save.DowntownBigJHistoryImage = CreateList()
								_save.DowntownBigJHistoryReply = CreateList()
								_save.DowntownBigJHistoryTag = CreateList()
								downtown_bigj_mode = 0
								downtown_bigj_rebuild = true
							if downtown_bigj_clicked == 1
								downtown_bigj_mode = 0
								downtown_bigj_rebuild = true

	downtown_bigj_confirm_listener:
		if mission_active
			if active_stage == "Downtown" && downtown_bigj_gallery != null
				if downtown_bigj_gallery.Confirmed()
					downtown_bigj_selection = downtown_bigj_gallery.GetSelection()
					if downtown_bigj_selection.Count() > 0
						downtown_bigj_photo = downtown_bigj_selection["0"]
						downtown_bigj_photo_index = -1
						downtown_bigj_find_index = 0
						while downtown_bigj_find_index < _save.DowntownBigJEligiblePhotos.Count()
							if _save.DowntownBigJEligiblePhotos[downtown_bigj_find_index] == downtown_bigj_photo
								downtown_bigj_photo_index = downtown_bigj_find_index
							downtown_bigj_find_index = downtown_bigj_find_index + 1
						if downtown_bigj_photo_index >= 0 && !_save.DowntownBigJUsedPhotos.Contains(downtown_bigj_photo)
							downtown_bigj_photo_tag = _save.DowntownBigJEligibleTags[downtown_bigj_photo_index]
							downtown_bigj_reply_code = RandomInt(1,4)
							_save.DowntownBigJUsedPhotos.Insert(downtown_bigj_photo)
							_save.DowntownBigJEligiblePhotos.Remove(downtown_bigj_photo_index)
							_save.DowntownBigJEligibleTags.Remove(downtown_bigj_photo_index)
							_save.DowntownBigJHistoryType.Insert(1)
							_save.DowntownBigJHistoryImage.Insert(downtown_bigj_photo)
							_save.DowntownBigJHistoryReply.Insert(downtown_bigj_reply_code)
							_save.DowntownBigJHistoryTag.Insert(downtown_bigj_photo_tag)
							if downtown_bigj_photo_tag == 1
								AddCurrentEarnRP(100)
								_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 100
								_save.DowntownXP = _save.DowntownXP + 15
							if downtown_bigj_photo_tag == 2
								AddCurrentEarnRP(200)
								_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 200
								_save.DowntownXP = _save.DowntownXP + 30
							downtown_bigj_chat.SetButtons()
							downtown_bigj_chat.Add(downtown_bigj_photo, "Right", silent=true)
							if downtown_bigj_reply_code == 1
								downtown_bigj_reply_text = "不错嘛，真菜香"
							if downtown_bigj_reply_code == 2
								downtown_bigj_reply_text = "哇哦！"
							if downtown_bigj_reply_code == 3
								downtown_bigj_reply_text = "BigJ 简直不敢相信自己的眼睛！"
							if downtown_bigj_photo_tag == 1
								downtown_bigj_reply_text = downtown_bigj_reply_text + "\n+100 RP , +15 XP"
							if downtown_bigj_photo_tag == 2
								downtown_bigj_reply_text = downtown_bigj_reply_text + "\n+200 RP , +30 XP"
							downtown_bigj_chat.Add(downtown_bigj_reply_text, "Left", user="BigJ", silent=false)
							downtown_bigj_chat.SetButtons(CreateList("发送照片", "清除发送过的照片"))
					downtown_bigj_gallery = null

	downtown_bigj_photo_scan_listener:
		if mission_active
			if active_stage == "Downtown"
				downtown_bigj_current_category = 0
				if downtown_state > 0 && downtown_state < 70
					downtown_bigj_current_category = 1
				if downtown_state >= 70 && downtown_state < 100
					downtown_bigj_current_category = 2
				if downtown_state >= 110 && downtown_state < 120
					downtown_bigj_current_category = 2
				if downtown_bigj_current_category > 0
					downtown_bigj_last_mission_category = downtown_bigj_current_category
				downtown_bigj_scan_timer = downtown_bigj_scan_timer + _timediff
				if downtown_bigj_scan_timer >= 0.25
					downtown_bigj_scan_timer = 0
					downtown_bigj_scan_category = downtown_bigj_current_category
					if downtown_bigj_scan_category == 0
						downtown_bigj_scan_category = downtown_bigj_last_mission_category
					downtown_bigj_all_photos = GetAllSnapshots()
					downtown_bigj_scan_index = 0
					while downtown_bigj_scan_index < downtown_bigj_all_photos.Count()
						downtown_bigj_scan_photo = downtown_bigj_all_photos[downtown_bigj_scan_index]
						if !downtown_bigj_known_photos.Contains(downtown_bigj_scan_photo)
							downtown_bigj_known_photos.Insert(downtown_bigj_scan_photo)
							if downtown_bigj_scan_category > 0 && !_save.DowntownBigJUsedPhotos.Contains(downtown_bigj_scan_photo) && !_save.DowntownBigJEligiblePhotos.Contains(downtown_bigj_scan_photo)
								_save.DowntownBigJEligiblePhotos.Insert(downtown_bigj_scan_photo)
								_save.DowntownBigJEligibleTags.Insert(downtown_bigj_scan_category)
						downtown_bigj_scan_index = downtown_bigj_scan_index + 1
					if downtown_bigj_current_category == 0
						downtown_bigj_last_mission_category = 0

	downtown_bigj_gallery_filter:
		_result = false
		if _save.DowntownBigJEligiblePhotos != null
			downtown_bigj_filter_index = 0
			while downtown_bigj_filter_index < _save.DowntownBigJEligiblePhotos.Count()
				downtown_bigj_filter_ref = _save.DowntownBigJEligiblePhotos[downtown_bigj_filter_index]
				if !_save.DowntownBigJUsedPhotos.Contains(downtown_bigj_filter_ref)
					downtown_bigj_filter_data = GetSnapshotData(downtown_bigj_filter_ref)
					if downtown_bigj_filter_data != null
						if data.Camera.stage == downtown_bigj_filter_data.Camera.stage && data.Camera.x == downtown_bigj_filter_data.Camera.x && data.Camera.y == downtown_bigj_filter_data.Camera.y && data.Camera.z == downtown_bigj_filter_data.Camera.z && data.Camera.rx == downtown_bigj_filter_data.Camera.rx && data.Camera.ry == downtown_bigj_filter_data.Camera.ry && data.Camera.rz == downtown_bigj_filter_data.Camera.rz && data.Camera.rw == downtown_bigj_filter_data.Camera.rw && data.Position.stage == downtown_bigj_filter_data.Position.stage && data.Position.x == downtown_bigj_filter_data.Position.x && data.Position.y == downtown_bigj_filter_data.Position.y && data.Position.z == downtown_bigj_filter_data.Position.z
							_result = true
				downtown_bigj_filter_index = downtown_bigj_filter_index + 1

	downtown_runtime_listener:
		if mission_active
			if active_stage == "Downtown"
				if _state.Position.stage != "StationFront"
					mainthread.RequestReset()

			# BigJ Expert deal unlocks once when the Expert mission zone requirement is reached.
			if downtown_bigj_chat != null && _save.DowntownBigJIntroDone == 1 && _save.DowntownXP >= 500 && _save.DowntownBigJExpertIntroDone != 1
				_save.DowntownBigJExpertIntroDone = 1
				_save.DowntownBigJHistoryType.Insert(6)
				_save.DowntownBigJHistoryImage.Insert("")
				_save.DowntownBigJHistoryReply.Insert(0)
				_save.DowntownBigJHistoryTag.Insert(0)
				if downtown_bigj_mode == 0 && !downtown_bigj_rebuild
					downtown_bigj_chat.Add("BigJ 有新消息了，真菜香！任务中心的专家任务终于开放了，风险越高，交易越划算：专家任务期间拍摄的每张新照片可获得 200 RP 与 30 XP。让 BigJ 看看，当繁华街不再温柔时你能做到什么，嘿嘿嘿", "Left", user="BigJ", silent=false)

			# Downtown shortcuts are idle-only. Hide and disable both during any accepted mission.
			if downtown_state == 0
				if downtown_tp_a_zone != null
					downtown_tp_a_zone.SetVisible(true)
				if downtown_tp_b_zone != null
					downtown_tp_b_zone.SetVisible(true)
			else
				if downtown_tp_a_zone != null
					downtown_tp_a_zone.SetVisible(false)
				if downtown_tp_b_zone != null
					downtown_tp_b_zone.SetVisible(false)

			if downtown_tp_cooldown > 0
				downtown_tp_cooldown = downtown_tp_cooldown - _timediff
			if downtown_state == 0 && downtown_tp_cooldown <= 0
				if downtown_tp_a_zone != null && downtown_tp_a_zone.Inside()
					SetPlayerPosition(x=-277.17, y=-0.16, z=9.91, rx=0, ry=1, rz=0, rw=0)
					downtown_tp_cooldown = 1
				if downtown_tp_b_zone != null && downtown_tp_b_zone.Inside()
					SetPlayerPosition(x=-232.43, y=-0.17, z=-40.72, rx=0, ry=1, rz=0, rw=0)
					downtown_tp_cooldown = 1

			# Hub rank / total RP display.
			if downtown_hub_zone != null && downtown_hub_zone.Inside()
				rank = "Novice"
				rank_display = "新手"
				next_xp = 200
				if _save.DowntownXP >= 200
					rank = "Apprentice"
					rank_display = "学徒"
					next_xp = 500
				if _save.DowntownXP >= 500
					rank = "Adept"
					rank_display = "熟练者"
					next_xp = 1000
				if _save.DowntownXP >= 1000
					rank = "Expert"
					rank_display = "专家"
					next_xp = 1800
				if _save.DowntownXP >= 1800
					rank = "Master"
					rank_display = "大师"
					next_xp = 0
				xp_text = "" + _save.DowntownXP + "/" + next_xp
				if rank == "Master"
					xp_text = "" + _save.DowntownXP + " XP"
				downtown_hub_panel.SetText("当前等级与 XP：" + rank_display + " - " + xp_text + "\n累计获得：" + "" + _save.ManakaPlusTotalRP + " RP")
				downtown_hub_panel.SetVisible(true)
			else
				downtown_hub_panel.SetVisible(false)

			if downtown_hub_zone != null && downtown_hub_zone.Inside()
				downtown_hub_title_panel.SetVisible(true)
			else
				downtown_hub_title_panel.SetVisible(false)


			# Persistent best completed times for both Downtown Marathon variants.
			if downtown_hub_zone != null && downtown_hub_zone.Inside()
				rookie_record_text = "--:--"
				if _save.DowntownRookieMarathonBestTotal > 0
					rookie_record_text = "" + _save.DowntownRookieMarathonBestMinutes + ":"
					if _save.DowntownRookieMarathonBestSeconds < 10
						rookie_record_text = rookie_record_text + "0"
					rookie_record_text = rookie_record_text + _save.DowntownRookieMarathonBestSeconds
				expert_record_text = "--:--"
				if _save.DowntownExpertMarathonBestTotal > 0
					expert_record_text = "" + _save.DowntownExpertMarathonBestMinutes + ":"
					if _save.DowntownExpertMarathonBestSeconds < 10
						expert_record_text = expert_record_text + "0"
					expert_record_text = expert_record_text + _save.DowntownExpertMarathonBestSeconds
				downtown_marathon_records_panel.SetText("马拉松纪录：\n新手：" + rookie_record_text + "，专家：" + expert_record_text)
				downtown_marathon_records_panel.SetVisible(true)
			else
				downtown_marathon_records_panel.SetVisible(false)

			if downtown_expert_zone != null && downtown_expert_zone.Inside() && _save.DowntownXP < 500
				downtown_expert_lock_panel.SetVisible(true)
			else
				downtown_expert_lock_panel.SetVisible(false)

			if downtown_challenge_zone != null && downtown_challenge_zone.Inside() && _save.DowntownXP < 1000
				downtown_challenge_lock_panel.SetVisible(true)
			else
				downtown_challenge_lock_panel.SetVisible(false)

			if downtown_challenge_zone != null && downtown_challenge_zone.Inside() && _save.DowntownXP >= 1000 && downtown_state == 0
				if _save.DowntownChallengeNakedMarathonCompleted == 1
					downtown_challenge_naked_marathon_panel.SetText("全裸马拉松已完成")
				else
					downtown_challenge_naked_marathon_panel.SetText("清除身体彩绘，以全裸状态完成冠军马拉松 - 300 XP")
				downtown_challenge_naked_marathon_panel.SetGaugeVisible(false)
				downtown_challenge_naked_marathon_panel.SetVisible(true)
				if _save.DowntownChallengeBlindfoldMarathonCompleted == 1
					downtown_challenge_blindfold_marathon_panel.SetText("眼罩马拉松已完成")
				else
					downtown_challenge_blindfold_marathon_panel.SetText("清除身体彩绘、戴上眼罩以全裸状态完成冠军马拉松 - 300 XP")
				downtown_challenge_blindfold_marathon_panel.SetGaugeVisible(false)
				downtown_challenge_blindfold_marathon_panel.SetVisible(true)
				if _save.DowntownChallengeInvisibleArchMageCompleted == 1
					downtown_challenge_invisible_arch_panel.SetText("隐形大师已完成")
				else
					downtown_challenge_invisible_arch_panel.SetText("全程仅使用叉腿走路完成“隐形大师”挑战 - 300 XP")
				downtown_challenge_invisible_arch_panel.SetGaugeVisible(false)
				downtown_challenge_invisible_arch_panel.SetVisible(true)
				if _save.DowntownChallengeNakedDowntownCompleted == 1
					downtown_challenge_naked_downtown_panel.SetText("全裸繁华街已完成")
					downtown_challenge_naked_downtown_panel.SetGaugeVisible(false)
					downtown_challenge_naked_downtown_panel.SetGaugeProgress(0)
					downtown_challenge_naked_downtown_replay_panel.SetText("保持手遮胸以再次游玩“全裸繁华街”")
					downtown_challenge_naked_downtown_replay_panel.SetGaugeVisible(true)
					if downtown_condition_handbra.Check() && downtown_challenge_condition_daylight.Check() && _state.Detection >= 0.5 && !downtown_condition_invisible.Check() && !downtown_condition_bodypaint.Check()
						downtown_challenge_nd_accept_duration = downtown_challenge_nd_accept_duration + _timediff
						downtown_challenge_naked_downtown_replay_panel.SetGaugeProgress(downtown_challenge_nd_accept_duration / 3)
					else
						downtown_challenge_nd_accept_duration = 0
						downtown_challenge_naked_downtown_replay_panel.SetGaugeProgress(0)
				else
					downtown_challenge_naked_downtown_replay_panel.SetVisible(false)
					downtown_challenge_naked_downtown_panel.SetText("全裸繁华街 - 白天、全裸、露出可疑度不低于 50% - 300 XP - 保持手遮胸接受")
					downtown_challenge_naked_downtown_panel.SetGaugeVisible(true)
					if downtown_condition_handbra.Check() && downtown_challenge_condition_daylight.Check() && _state.Detection >= 0.5 && !downtown_condition_invisible.Check() && !downtown_condition_bodypaint.Check()
						downtown_challenge_nd_accept_duration = downtown_challenge_nd_accept_duration + _timediff
						downtown_challenge_naked_downtown_panel.SetGaugeProgress(downtown_challenge_nd_accept_duration / 3)
					else
						downtown_challenge_nd_accept_duration = 0
						downtown_challenge_naked_downtown_panel.SetGaugeProgress(0)
				if downtown_challenge_nd_accept_duration >= 3
					downtown_challenge_naked_marathon_panel.SetVisible(false)
					downtown_challenge_blindfold_marathon_panel.SetVisible(false)
					downtown_challenge_invisible_arch_panel.SetVisible(false)
					downtown_challenge_naked_downtown_panel.SetVisible(false)
					downtown_challenge_naked_downtown_replay_panel.SetVisible(false)
					downtown_challenge_nd_accept_duration = 0
