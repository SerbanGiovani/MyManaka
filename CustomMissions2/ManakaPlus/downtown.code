							EquipAdultToy("Vibrator")
						SetVibrator("Random")
					if downtown_marathon_punish_eyemask > 0 && !_state.AdultToys["EyeMask"]
						EquipAdultToy("EyeMask")
					if downtown_marathon_punish_walk > 0
						if _state.Action != "GanimataWalk"
							SetAction("GanimataWalk")
				if downtown_marathon_punish_vibrator > 0
					downtown_marathon_punish_vibrator = downtown_marathon_punish_vibrator - _timediff
					if downtown_marathon_punish_vibrator <= 0
						SetVibrator("Off")
						UnequipAdultToy("Vibrator")
						SetVibrator("Off")
				if downtown_marathon_punish_eyemask > 0
					downtown_marathon_punish_eyemask = downtown_marathon_punish_eyemask - _timediff
