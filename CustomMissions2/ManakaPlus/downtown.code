	downtown_bigj_photo_scan_listener = null

	idle:
		mission_active = false

	start_downtown:
		mission_active = true
		active_stage = "Downtown"
		mainthread.UpdateHub()
		warning_sound.Play()

		if _state.Sitting
			SetAction("StandUp")

		SetStage("StationFront")
		downtown_stage_teleport_timer = 0
		listener = CreateListenerLocal("downtown_stage_wait")

	downtown_stage_wait:
		if mission_active
			downtown_stage_teleport_timer = downtown_stage_teleport_timer + _timediff
			if downtown_stage_teleport_timer > 0.5
				SetPlayerPosition(x=-217.26, y=0.28, z=-43.43, rx=0, ry=1, rz=0, rw=0)
				mainthread.ArmStageWatch()
				thread.Goto("downtown_start")
	downtown_start:
		# Initialize persistent Downtown progression safely.
		if _save.DowntownXP == null
			_save.DowntownXP = 0
		if _save.ManakaPlusTotalRP == null
			_save.ManakaPlusTotalRP = 0
		if _save.DowntownChallengeNakedMarathonCompleted == null
			_save.DowntownChallengeNakedMarathonCompleted = 0
