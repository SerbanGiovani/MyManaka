					downtown_state = 31

			if downtown_state == 30 || downtown_state == 31
				downtown_fail_timer = downtown_fail_timer - _timediff
				if downtown_fail_timer <= 0
					downtown_fail_panel.SetVisible(false)
					downtown_food_precheck_duration = 0
					downtown_food_detection_timer = 0
					downtown_food_progress = 0
					downtown_food1_done = false
					downtown_food2_done = false
					downtown_food3_done = false
					downtown_food1_remove_pending = false
					downtown_food2_remove_pending = false
					downtown_food3_remove_pending = false
					downtown_state = 0

			# Rookie Mission 3: Laundry Day. NPC observation + 120s survival.
			if downtown_state == 40 || downtown_state == 41 || downtown_state == 42
				# Outside NPC uses a short waypoint step to animate each random turn.
				if downtown_laundry_outside_npc != null
					if downtown_laundry_outside_turn_active == false
						downtown_laundry_outside_turn_timer = downtown_laundry_outside_turn_timer - _timediff
						if downtown_laundry_outside_turn_timer <= 0
							next_direction = RandomInt(0,2)
							if next_direction >= downtown_laundry_outside_direction
								next_direction = next_direction + 1
							downtown_laundry_outside_target_direction = next_direction
							downtown_laundry_outside_turn_active = true
							downtown_laundry_outside_turn_anim_timer = 0
							downtown_laundry_outside_npc.ClearWaypoints()
							if downtown_laundry_outside_target_direction == 0
								downtown_laundry_outside_npc.AddWaypoint(Vector(-218.99, 0.45, -20.29))
							if downtown_laundry_outside_target_direction == 1
								downtown_laundry_outside_npc.AddWaypoint(Vector(-218.62, 0.45, -19.96))
							if downtown_laundry_outside_target_direction == 2
								downtown_laundry_outside_npc.AddWaypoint(Vector(-218.29, 0.45, -20.33))
							if downtown_laundry_outside_target_direction == 3
								downtown_laundry_outside_npc.AddWaypoint(Vector(-218.66, 0.45, -20.66))
					else
						downtown_laundry_outside_turn_anim_timer = downtown_laundry_outside_turn_anim_timer + _timediff
						if downtown_laundry_outside_turn_anim_timer >= 1.2
							downtown_laundry_outside_direction = downtown_laundry_outside_target_direction
							if downtown_laundry_outside_direction == 0
								downtown_laundry_outside_npc.Warp(position=Vector(-218.64, 0.45, -20.31), rotation=Quaternion(0.00000, -0.68137, 0.00000, 0.73194))
							if downtown_laundry_outside_direction == 1
								downtown_laundry_outside_npc.Warp(position=Vector(-218.64, 0.45, -20.31), rotation=Quaternion(0.00000, 0.03576, 0.00000, 0.99936))
							if downtown_laundry_outside_direction == 2
								downtown_laundry_outside_npc.Warp(position=Vector(-218.64, 0.45, -20.31), rotation=Quaternion(0.00000, 0.73194, 0.00000, 0.68137))
							if downtown_laundry_outside_direction == 3
								downtown_laundry_outside_npc.Warp(position=Vector(-218.64, 0.45, -20.31), rotation=Quaternion(0.00000, 0.99936, 0.00000, -0.03576))
							downtown_laundry_outside_npc.ClearWaypoints()
							downtown_laundry_outside_npc.AddWaypoint(Vector(-218.64, 0.45, -20.31))
							downtown_laundry_outside_turn_active = false
							downtown_laundry_outside_turn_anim_timer = 0
							downtown_laundry_outside_turn_timer = RandomInt(18,22)

			if downtown_state == 40
				if downtown_laundry_zone.Inside()
					downtown_laundry_panel.SetVisible(false)
					downtown_laundry_zone.SetVisible(false)
					downtown_laundry_begin_panel.SetText("开始前可先观察NPC的移动路线；保持手遮胸开始")
					downtown_laundry_begin_panel.SetVisible(true)
					downtown_laundry_begin_panel.SetGaugeProgress(0)
					downtown_laundry_state = 41
					downtown_state = 41
				else
					laundry_distance = Vector3Distance(_state.Position, downtown_laundry_dest_pos)
					laundry_gauge = 0
					if downtown_laundry_total_distance > 0
						if laundry_distance < downtown_laundry_total_distance
							laundry_gauge = (downtown_laundry_total_distance - laundry_distance) / downtown_laundry_total_distance
					downtown_laundry_panel.SetGaugeProgress(laundry_gauge)

			if downtown_state == 41
				if downtown_condition_handbra.Check()
					downtown_laundry_begin_duration = downtown_laundry_begin_duration + _timediff
					downtown_laundry_begin_panel.SetGaugeProgress(downtown_laundry_begin_duration / 3)
					if downtown_laundry_begin_duration >= 3
						downtown_laundry_begin_panel.SetVisible(false)
						DropItem(itemtype="Coat", position=_state.Position, compass=false)
						CollectItem(itemtype="Coat")
						laundry_coat_away = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=laundry_coat_away, compass=false)
						downtown_coat_moved = true
						downtown_laundry_remaining = 120
						downtown_laundry_second_timer = 0
						downtown_laundry_rule_delay = 0
						downtown_condition_dashing = CreateCondition("[Dashing]")
						downtown_laundry_main_panel.SetText("不要离开洗衣店，坚持 90 秒")
						downtown_laundry_main_panel.SetVisible(true)
						downtown_laundry_main_panel.SetGaugeProgress(0)
						downtown_laundry_state = 42
						downtown_state = 42
				else
					downtown_laundry_begin_duration = 0
					downtown_laundry_begin_panel.SetGaugeProgress(0)

			if downtown_state == 42
				if downtown_laundry_zone.Inside() == false
					SetPlayerPosition(x=-216.60, y=0.45, z=-20.22, rx=0, ry=1, rz=0, rw=0)
				downtown_laundry_second_timer = downtown_laundry_second_timer + _timediff
				if downtown_laundry_second_timer >= 1
					downtown_laundry_second_timer = downtown_laundry_second_timer - 1
					downtown_laundry_remaining = downtown_laundry_remaining - 1
					if downtown_laundry_remaining < 0
						downtown_laundry_remaining = 0
				downtown_laundry_main_panel.SetText("不要离开洗衣店，坚持 " + downtown_laundry_remaining + "秒")
				downtown_laundry_main_panel.SetGaugeProgress((120 - downtown_laundry_remaining) / 120)
				downtown_laundry_rule_delay = downtown_laundry_rule_delay + _timediff
				if downtown_laundry_rule_delay >= 5
					downtown_laundry_rule_panel.SetText("洗衣店内禁止奔跑！")
					downtown_laundry_rule_panel.SetVisible(true)
					downtown_laundry_dash_check_timer = downtown_laundry_dash_check_timer + _timediff
					if downtown_laundry_dash_check_timer >= 0.2
						downtown_laundry_dash_check_timer = 0
						if downtown_laundry_mission_active && downtown_laundry_zone.Inside() && downtown_condition_dashing.Check() && downtown_laundry_punish_active == false
							downtown_laundry_punish_active = true
							downtown_laundry_punish_remaining = 12
				if downtown_laundry_punish_active
					downtown_laundry_force_timer = downtown_laundry_force_timer + _timediff
					if downtown_laundry_force_timer >= 0.5
						downtown_laundry_force_timer = 0
						if !_state.AdultToys["Vibrator"]
							EquipAdultToy("Vibrator")
						SetVibrator("Random")
					downtown_laundry_punish_remaining = downtown_laundry_punish_remaining - _timediff
					if downtown_laundry_punish_remaining <= 0
						downtown_laundry_punish_active = false
						downtown_laundry_punish_remaining = 0
						SetVibrator("Off")
						UnequipAdultToy("Vibrator")
						SetVibrator("Off")
				if downtown_laundry_remaining <= 0
					downtown_laundry_main_panel.SetVisible(false)
					downtown_laundry_rule_panel.SetVisible(false)
					downtown_laundry_punish_active = false
					downtown_laundry_mission_active = false
					downtown_laundry_punish_remaining = 0
					downtown_condition_dashing = null
					SetVibrator("Off")
					UnequipAdultToy("Vibrator")
					SetVibrator("Off")
					downtown_laundry_outside_detection_timer = 0
					if downtown_coat_moved
						CollectItem(itemtype="Coat")
						laundry_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=laundry_coat_return, compass=false)
						downtown_coat_moved = false
					if downtown_laundry_inside_npc != null
						downtown_laundry_inside_npc.ClearWaypoints()
						downtown_laundry_inside_npc.AddWaypoint(Vector(-232.43, -0.17, -40.72), last=true)
						downtown_laundry_inside_npc = null
					if downtown_laundry_outside_npc != null
						downtown_laundry_outside_npc.ClearWaypoints()
						downtown_laundry_outside_npc.AddWaypoint(Vector(-232.43, -0.17, -40.72), last=true)
						downtown_laundry_outside_npc = null
					downtown_laundry_report_panel.SetText("返回任务中心报告")
					downtown_laundry_report_panel.SetVisible(true)
					downtown_laundry_state = 43
					downtown_state = 43

			if downtown_state == 43
				if downtown_hub_zone != null && downtown_hub_zone.Inside()
					AddCurrentEarnRP(250)
					_save.DowntownXP = _save.DowntownXP + 75
					_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 250
					downtown_laundry_report_panel.SetVisible(false)
					if downtown_coat_moved
						CollectItem(itemtype="Coat")
						laundry_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=laundry_coat_return, compass=false)
						downtown_coat_moved = false
					downtown_fail_panel.SetText("任务完成：250 RP，75 XP")
					downtown_fail_panel.SetVisible(true)
					downtown_fail_timer = 5
					downtown_laundry_state = 44
					downtown_state = 44

			if downtown_state == 44
				downtown_fail_timer = downtown_fail_timer - _timediff
				if downtown_fail_timer <= 0
					downtown_fail_panel.SetVisible(false)
					downtown_laundry_precheck_duration = 0
					downtown_laundry_state = 0
					downtown_state = 0


			# Expert Mission 1: Crowded Overpass. Layer/empty mission shell.
			if downtown_state == 70
				if downtown_expert1_route_panel != null
					distance_left = Vector3Distance(Vector(_state.Position.x, _state.Position.y, _state.Position.z), downtown_expert1_dest_pos)
					progress = 1
					if downtown_expert1_total_distance > 0
						progress = 1 - (distance_left / downtown_expert1_total_distance)
					if progress < 0
						progress = 0
					if progress > 1
						progress = 1
					downtown_expert1_route_panel.SetGaugeProgress(progress)
				if downtown_expert1_start_zone.Inside()
					downtown_expert1_route_panel.SetVisible(false)
					downtown_expert1_main_panel.SetText("不要离开天桥，赚取 1200 RP。特殊任务会出现；站在此区域开始")
					downtown_expert1_main_panel.SetVisible(true)
					downtown_expert1_main_panel.SetGaugeProgress(0)
					downtown_state = 71

			if downtown_state == 71
				if downtown_expert1_start_zone.Inside()
					downtown_expert1_main_panel.SetText("不要离开天桥，赚取 1200 RP。特殊任务会出现；站在此区域开始")
					downtown_expert1_main_panel.SetVisible(true)
					downtown_expert1_ready_duration = downtown_expert1_ready_duration + _timediff
					downtown_expert1_main_panel.SetGaugeProgress(downtown_expert1_ready_duration / 5)
					if downtown_expert1_ready_duration >= 5
						downtown_expert1_ready_duration = 0
						downtown_expert1_rp_start_total = GetCurrentEarnRP()
						downtown_expert1_rp_progress = 0
						downtown_expert1_naked_done = false
						downtown_expert1_coat_done = false
						downtown_expert1_coat_available = true
						downtown_expert1_orgasm_done = false
						downtown_expert1_blindfold_done = false
						downtown_expert1_handcuff_done = false
						downtown_expert1_naked_duration = 0
						downtown_expert1_coat_duration = 0
						downtown_expert1_blindfold_duration = 0
						downtown_expert1_handcuff_duration = 0
						downtown_expert1_orgasm_count = 0
						downtown_expert1_orgasm_active = false
						downtown_expert1_coat_drop_pos = null

						downtown_expert1_main_panel.SetText("不要离开天桥，赚取 1200 RP；特殊任务会出现")
						downtown_expert1_main_panel.SetRPText("0/1200 RP")
						downtown_expert1_main_panel.SetGaugeProgress(0)
						downtown_expert1_naked_panel.SetText("全裸 60 秒")
						downtown_expert1_naked_panel.SetRPText("100 RP")
						downtown_expert1_naked_panel.SetVisible(true)
						downtown_expert1_naked_panel.SetGaugeProgress(0)
						downtown_expert1_coat_panel.SetText("在起始区域放下外套；任务结束后会归还")
						downtown_expert1_coat_panel.SetRPText("300 RP")
						downtown_expert1_coat_panel.SetVisible(true)
						downtown_expert1_coat_panel.SetGaugeProgress(0)
						downtown_expert1_orgasm_panel.SetText("使用震动器高潮 3 次")
						downtown_expert1_orgasm_panel.SetRPText("100 RP")
						downtown_expert1_orgasm_panel.SetVisible(true)
						downtown_expert1_orgasm_panel.SetGaugeProgress(0)
						downtown_expert1_blindfold_panel.SetText("露出状态下连续戴眼罩 60 秒")
						downtown_expert1_blindfold_panel.SetRPText("100 RP")
						downtown_expert1_blindfold_panel.SetVisible(true)
						downtown_expert1_blindfold_panel.SetGaugeProgress(0)
						downtown_expert1_handcuff_panel.SetText("露出状态下铐在物体上 40 秒")
						downtown_expert1_handcuff_panel.SetRPText("100 RP")
						downtown_expert1_handcuff_panel.SetVisible(true)
						downtown_expert1_handcuff_panel.SetGaugeProgress(0)
						downtown_expert1_block1_zone.SetVisible(true)
						downtown_expert1_block2_zone.SetVisible(true)
						if !downtown_expert1_spawned
							downtown_expert1_spawned = true
							downtown_expert1_npc1 = CreateNPC("NewFemale", position=Vector(-262.43, 7.54, 5.30), rotation=Quaternion(0.00000, -0.43131, 0.00000, 0.90220))
							downtown_expert1_npc1.Smartphone(true)
							downtown_expert1_npc1.SkipStrangeness(false)
							downtown_expert1_npc1.CanGameOver(true)
							downtown_expert1_npc1.ClearWaypoints()
							downtown_expert1_npc1.AddWaypoint(Vector(-262.43, 7.54, 5.30))
							downtown_expert1_npc2 = CreateNPC("NewFemale", position=Vector(-261.41, 7.54, 1.20), rotation=Quaternion(0.00000, 0.72718, 0.00000, 0.68645))
							downtown_expert1_npc2.Smartphone(true)
							downtown_expert1_npc2.SkipStrangeness(false)
							downtown_expert1_npc2.CanGameOver(true)
							downtown_expert1_npc2.ClearWaypoints()
							downtown_expert1_npc2.AddWaypoint(Vector(-261.41, 7.54, 1.20))
							downtown_expert1_npc3 = CreateNPC("NewMale", position=Vector(-261.27, 7.54, -1.31), rotation=Quaternion(0.00000, 0.71874, 0.00000, 0.69528))
							downtown_expert1_npc3.Headset(true)
							downtown_expert1_npc3.SkipStrangeness(false)
							downtown_expert1_npc3.CanGameOver(true)
							downtown_expert1_npc3.ClearWaypoints()
							downtown_expert1_npc3.AddWaypoint(Vector(-261.27, 7.54, -1.31))
							downtown_expert1_npc4 = CreateNPC("NewFemale", position=Vector(-262.56, 7.54, -8.06), rotation=Quaternion(0.00000, -0.76187, 0.00000, 0.64773))
							downtown_expert1_npc4.Smartphone(true)
							downtown_expert1_npc4.SkipStrangeness(false)
							downtown_expert1_npc4.CanGameOver(true)
							downtown_expert1_npc4.ClearWaypoints()
							downtown_expert1_npc4.AddWaypoint(Vector(-262.56, 7.54, -8.06))
							downtown_expert1_npc5 = CreateNPC("NewFemale", position=Vector(-262.59, 7.54, -1.27), rotation=Quaternion(0.00000, -0.71691, 0.00000, 0.69717))
							downtown_expert1_npc5.Smartphone(true)
							downtown_expert1_npc5.SkipStrangeness(false)
							downtown_expert1_npc5.CanGameOver(true)
							downtown_expert1_npc5.ClearWaypoints()
							downtown_expert1_npc5.AddWaypoint(Vector(-262.59, 7.54, -1.27))
							downtown_expert1_npc6 = CreateNPC("NewMale", position=Vector(-262.48, 7.54, -2.11), rotation=Quaternion(0.00000, -0.71203, 0.00000, 0.70215))
							downtown_expert1_npc6.Headset(true)
							downtown_expert1_npc6.SkipStrangeness(false)
							downtown_expert1_npc6.CanGameOver(true)
							downtown_expert1_npc6.ClearWaypoints()
							downtown_expert1_npc6.AddWaypoint(Vector(-262.48, 7.54, -2.11))
							downtown_expert1_npc7 = CreateNPC("NewFemale", position=Vector(-261.29, 7.54, -5.83), rotation=Quaternion(0.00000, 0.72956, 0.00000, 0.68392))
							downtown_expert1_npc7.Smartphone(true)
							downtown_expert1_npc7.SkipStrangeness(false)
							downtown_expert1_npc7.CanGameOver(true)
							downtown_expert1_npc7.ClearWaypoints()
							downtown_expert1_npc7.AddWaypoint(Vector(-261.29, 7.54, -5.83))
							downtown_expert1_npc8 = CreateNPC("NewMale", position=Vector(-262.62, 7.54, 4.74), rotation=Quaternion(0.00000, -0.54319, 0.00000, 0.83961))
							downtown_expert1_npc8.Headset(true)
							downtown_expert1_npc8.SkipStrangeness(false)
							downtown_expert1_npc8.CanGameOver(true)
							downtown_expert1_npc8.ClearWaypoints()
							downtown_expert1_npc8.AddWaypoint(Vector(-262.62, 7.54, 4.74))
							downtown_expert1_npc9 = CreateNPC("NewFemale", position=Vector(-262.51, 7.54, 2.51), rotation=Quaternion(0.00000, -0.69403, 0.00000, 0.71995))
							downtown_expert1_npc9.Smartphone(true)
							downtown_expert1_npc9.SkipStrangeness(false)
							downtown_expert1_npc9.CanGameOver(true)
							downtown_expert1_npc9.ClearWaypoints()
							downtown_expert1_npc9.AddWaypoint(Vector(-262.51, 7.54, 2.51))
							downtown_expert1_npc10 = CreateNPC("NewFemale", position=Vector(-262.55, 7.54, -4.37), rotation=Quaternion(0.00000, -0.72477, 0.00000, 0.68899))
							downtown_expert1_npc10.Smartphone(true)
							downtown_expert1_npc10.SkipStrangeness(false)
							downtown_expert1_npc10.CanGameOver(true)
							downtown_expert1_npc10.ClearWaypoints()
							downtown_expert1_npc10.AddWaypoint(Vector(-262.55, 7.54, -4.37))
							downtown_expert1_npc11 = CreateNPC("NewMale", position=Vector(-261.26, 7.54, -5.28), rotation=Quaternion(0.00000, 0.82015, 0.00000, 0.57215))
							downtown_expert1_npc11.Headset(true)
							downtown_expert1_npc11.SkipStrangeness(false)
							downtown_expert1_npc11.CanGameOver(true)
							downtown_expert1_npc11.ClearWaypoints()
							downtown_expert1_npc11.AddWaypoint(Vector(-261.26, 7.54, -5.28))
						downtown_expert1_watch_timer = 0
						downtown_expert1_watch_phase = 0
						downtown_expert1_watch_index = 0
						downtown_state = 72
				else
					downtown_expert1_ready_duration = 0
					downtown_expert1_main_panel.SetVisible(false)
					downtown_expert1_main_panel.SetGaugeProgress(0)

			if downtown_state == 72
				# Block zones push the player back to the overpass start.
				if downtown_expert1_block1_zone.Inside() || downtown_expert1_block2_zone.Inside()
					SetPlayerPosition(x=-261.90, y=7.54, z=-1.34, rx=0, ry=0, rz=0, rw=1)

				# Main Crowded Overpass RP tracking. Counts any RP source, but only writes 1200 RP to The Hub on success.
				downtown_expert1_rp_progress = GetCurrentEarnRP() - downtown_expert1_rp_start_total
				if downtown_expert1_rp_progress < 0
					downtown_expert1_rp_progress = 0
				if downtown_expert1_rp_progress > 1200
					downtown_expert1_rp_progress = 1200
				downtown_expert1_main_panel.SetGaugeProgress(downtown_expert1_rp_progress / 1200)
				downtown_expert1_main_panel.SetRPText("" + Floor(downtown_expert1_rp_progress) + "/1200 RP")

				# Start zone is the mini-mission board. Panels normally show only there,
				# but a panel can also appear outside when its own condition is actively progressing.
				expert1_in_start_zone = downtown_expert1_start_zone.Inside()

				# Remove the 300 RP coat shortcut once player reaches 400 RP progress.
				if downtown_expert1_coat_available && !downtown_expert1_coat_done && downtown_expert1_rp_progress >= 400
					downtown_expert1_coat_available = false
					downtown_expert1_coat_panel.SetVisible(false)

				expert1_naked_active = false
				if !downtown_expert1_naked_done
					if downtown_condition_expert1_naked.Check()
						expert1_naked_active = true
						downtown_expert1_naked_duration = downtown_expert1_naked_duration + _timediff
					downtown_expert1_naked_panel.SetGaugeProgress(downtown_expert1_naked_duration / 60)
					if expert1_in_start_zone || expert1_naked_active
						downtown_expert1_naked_panel.SetVisible(true)
					else
						downtown_expert1_naked_panel.SetVisible(false)
					if downtown_expert1_naked_duration >= 60
						AddCurrentEarnRP(100)
						downtown_expert1_naked_done = true
						downtown_expert1_naked_panel.SetVisible(false)

				coat_in_start_zone = false
				if downtown_expert1_coat_available && !downtown_expert1_coat_done
					downtown_expert1_coat_drop_pos = null
					coat_item_i = 0
					while coat_item_i < _state.DroppedItems.Count()
						if _state.DroppedItems[coat_item_i].Type == "Coat"
							coat_pos = _state.DroppedItems[coat_item_i].Position
							if coat_pos.stage == "StationFront"
								coat_distance = Vector3Distance(Vector(coat_pos.x, coat_pos.y, coat_pos.z), Vector(-261.90, 7.54, -1.34))
								if coat_distance <= 1.0
									coat_in_start_zone = true
									downtown_expert1_coat_drop_pos = coat_pos
						coat_item_i = coat_item_i + 1
					if coat_in_start_zone
						downtown_expert1_coat_duration = downtown_expert1_coat_duration + _timediff
					else
						downtown_expert1_coat_duration = 0
					downtown_expert1_coat_panel.SetGaugeProgress(downtown_expert1_coat_duration / 5)
					if expert1_in_start_zone || coat_in_start_zone
						downtown_expert1_coat_panel.SetVisible(true)
					else
						downtown_expert1_coat_panel.SetVisible(false)
					if downtown_expert1_coat_duration >= 5
						if downtown_expert1_coat_drop_pos != null
							if CollectItem(itemtype="Coat", position=downtown_expert1_coat_drop_pos)
								expert1_coat_away = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
								DropItem(itemtype="Coat", position=expert1_coat_away, compass=false)
								downtown_coat_moved = true
								downtown_expert1_coat_moved = true
								AddCurrentEarnRP(300)
								downtown_expert1_coat_done = true
								downtown_expert1_coat_available = false
								downtown_expert1_coat_panel.SetVisible(false)

				expert1_orgasm_active_now = false
				if !downtown_expert1_orgasm_done
					if downtown_condition_expert1_vibe_orgasm.Check()
						expert1_orgasm_active_now = true
						if !downtown_expert1_orgasm_active
							downtown_expert1_orgasm_count = downtown_expert1_orgasm_count + 1
							downtown_expert1_orgasm_active = true
					else
						downtown_expert1_orgasm_active = false
					downtown_expert1_orgasm_panel.SetGaugeProgress(downtown_expert1_orgasm_count / 3)
					if expert1_in_start_zone || expert1_orgasm_active_now
						downtown_expert1_orgasm_panel.SetVisible(true)
					else
						downtown_expert1_orgasm_panel.SetVisible(false)
					if downtown_expert1_orgasm_count >= 3
						AddCurrentEarnRP(100)
						downtown_expert1_orgasm_done = true
						downtown_expert1_orgasm_panel.SetVisible(false)

				expert1_blindfold_active = false
