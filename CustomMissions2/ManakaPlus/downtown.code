						downtown_champion_oldtrap4_direction = 1
					if downtown_champion_oldtrap4_index == 1
						downtown_champion_oldtrap4a_zone.SetVisible(true)
					if downtown_champion_oldtrap4_index == 2
						downtown_champion_oldtrap4b_zone.SetVisible(true)
					if downtown_champion_oldtrap4_index == 3
						downtown_champion_oldtrap4c_zone.SetVisible(true)
					if downtown_champion_oldtrap4_index == 4
						downtown_champion_oldtrap4d_zone.SetVisible(true)

				downtown_champion_bridge_trap_timer = downtown_champion_bridge_trap_timer + _timediff
				if downtown_champion_bridge_trap_timer >= 2
					downtown_champion_bridge_trap_timer = downtown_champion_bridge_trap_timer - 2
					if downtown_champion_bridge_trap_index == 1
						downtown_champion_bridge_trap1_zone.SetVisible(false)
					if downtown_champion_bridge_trap_index == 2
						downtown_champion_bridge_trap2_zone.SetVisible(false)
					if downtown_champion_bridge_trap_index == 3
						downtown_champion_bridge_trap3_zone.SetVisible(false)
					if downtown_champion_bridge_trap_index == 4
						downtown_champion_bridge_trap4_zone.SetVisible(false)
					if downtown_champion_bridge_trap_index == 5
						downtown_champion_bridge_trap5_zone.SetVisible(false)
					downtown_champion_bridge_trap_index = downtown_champion_bridge_trap_index + downtown_champion_bridge_trap_direction
					if downtown_champion_bridge_trap_index >= 5
						downtown_champion_bridge_trap_index = 5
						downtown_champion_bridge_trap_direction = -1
					if downtown_champion_bridge_trap_index <= 1
						downtown_champion_bridge_trap_index = 1
						downtown_champion_bridge_trap_direction = 1
					if downtown_champion_bridge_trap_index == 1
						downtown_champion_bridge_trap1_zone.SetVisible(true)
					if downtown_champion_bridge_trap_index == 2
						downtown_champion_bridge_trap2_zone.SetVisible(true)
					if downtown_champion_bridge_trap_index == 3
						downtown_champion_bridge_trap3_zone.SetVisible(true)
					if downtown_champion_bridge_trap_index == 4
						downtown_champion_bridge_trap4_zone.SetVisible(true)
					if downtown_champion_bridge_trap_index == 5
						downtown_champion_bridge_trap5_zone.SetVisible(true)

				downtown_champion_dynbar_timer = downtown_champion_dynbar_timer + _timediff
				if downtown_champion_dynbar_timer >= 1
					downtown_champion_dynbar_timer = downtown_champion_dynbar_timer - 1
					if downtown_champion_dynbar_radius == 1
						downtown_champion_dynbar_r1_zone.SetVisible(false)
					if downtown_champion_dynbar_radius == 2
						downtown_champion_dynbar_r2_zone.SetVisible(false)
					if downtown_champion_dynbar_radius == 3
						downtown_champion_dynbar_r3_zone.SetVisible(false)
					if downtown_champion_dynbar_radius == 4
						downtown_champion_dynbar_r4_zone.SetVisible(false)
					if downtown_champion_dynbar_radius == 5
						downtown_champion_dynbar_r5_zone.SetVisible(false)
					downtown_champion_dynbar_radius = downtown_champion_dynbar_radius + downtown_champion_dynbar_direction
					if downtown_champion_dynbar_radius >= 5
						downtown_champion_dynbar_radius = 5
						downtown_champion_dynbar_direction = -1
					if downtown_champion_dynbar_radius <= 1
						downtown_champion_dynbar_radius = 1
						downtown_champion_dynbar_direction = 1
					if downtown_champion_dynbar_radius == 1
						downtown_champion_dynbar_r1_zone.SetVisible(true)
					if downtown_champion_dynbar_radius == 2
						downtown_champion_dynbar_r2_zone.SetVisible(true)
					if downtown_champion_dynbar_radius == 3
						downtown_champion_dynbar_r3_zone.SetVisible(true)
					if downtown_champion_dynbar_radius == 4
						downtown_champion_dynbar_r4_zone.SetVisible(true)
					if downtown_champion_dynbar_radius == 5
						downtown_champion_dynbar_r5_zone.SetVisible(true)

				champion_in_barrier = false
				if downtown_champion_barrier1_zone.Inside() || downtown_champion_barrier2_zone.Inside() || downtown_champion_barrier3_zone.Inside() || downtown_champion_barrier4_zone.Inside()
					champion_in_barrier = true
				if downtown_champion_dynbar_radius == 1 && downtown_champion_dynbar_r1_zone.Inside()
					champion_in_barrier = true
				if downtown_champion_dynbar_radius == 2 && downtown_champion_dynbar_r2_zone.Inside()
					champion_in_barrier = true
				if downtown_champion_dynbar_radius == 3 && downtown_champion_dynbar_r3_zone.Inside()
					champion_in_barrier = true
				if downtown_champion_dynbar_radius == 4 && downtown_champion_dynbar_r4_zone.Inside()
					champion_in_barrier = true
				if downtown_champion_dynbar_radius == 5 && downtown_champion_dynbar_r5_zone.Inside()
					champion_in_barrier = true

				if downtown_champion_barrier_cooldown > 0
					downtown_champion_barrier_cooldown = downtown_champion_barrier_cooldown - _timediff
				if downtown_champion_barrier_cooldown <= 0 && champion_in_barrier
					SetPlayerPosition(x=downtown_champion_previous_x, y=downtown_champion_previous_y, z=downtown_champion_previous_z, rx=0, ry=1, rz=0, rw=0)
					warning_sound.Play()
					downtown_champion_barrier_cooldown = 1.5

				champion_in_trap = false
				if downtown_champion_pulse_radius == 1 && downtown_champion_pulse_r1_zone.Inside()
					champion_in_trap = true
				if downtown_champion_pulse_radius == 2 && downtown_champion_pulse_r2_zone.Inside()
					champion_in_trap = true
				if downtown_champion_pulse_radius == 3 && downtown_champion_pulse_r3_zone.Inside()
					champion_in_trap = true
				if downtown_champion_pulse_radius == 4 && downtown_champion_pulse_r4_zone.Inside()
					champion_in_trap = true
				if downtown_champion_pulse_radius == 5 && downtown_champion_pulse_r5_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap1_index == 1 && downtown_champion_trap1a_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap1_index == 2 && downtown_champion_trap1b_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap1_index == 3 && downtown_champion_trap1c_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap1_index == 4 && downtown_champion_trap1d_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap1_index == 5 && downtown_champion_trap1e_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap2_index == 1 && downtown_champion_trap2a_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap2_index == 2 && downtown_champion_trap2b_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap3_index == 1 && downtown_champion_trap3a_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap3_index == 2 && downtown_champion_trap3b_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap3_index == 3 && downtown_champion_trap3c_zone.Inside()
					champion_in_trap = true
				if downtown_champion_trap3_index == 4 && downtown_champion_trap3d_zone.Inside()
					champion_in_trap = true
				if downtown_champion_oldtrap4_index == 1 && downtown_champion_oldtrap4a_zone.Inside()
					champion_in_trap = true
				if downtown_champion_oldtrap4_index == 2 && downtown_champion_oldtrap4b_zone.Inside()
					champion_in_trap = true
				if downtown_champion_oldtrap4_index == 3 && downtown_champion_oldtrap4c_zone.Inside()
					champion_in_trap = true
				if downtown_champion_oldtrap4_index == 4 && downtown_champion_oldtrap4d_zone.Inside()
					champion_in_trap = true
				if downtown_champion_bridge_trap_index == 1 && downtown_champion_bridge_trap1_zone.Inside()
					champion_in_trap = true
				if downtown_champion_bridge_trap_index == 2 && downtown_champion_bridge_trap2_zone.Inside()
					champion_in_trap = true
				if downtown_champion_bridge_trap_index == 3 && downtown_champion_bridge_trap3_zone.Inside()
					champion_in_trap = true
				if downtown_champion_bridge_trap_index == 4 && downtown_champion_bridge_trap4_zone.Inside()
					champion_in_trap = true
				if downtown_champion_bridge_trap_index == 5 && downtown_champion_bridge_trap5_zone.Inside()
					champion_in_trap = true

				if champion_in_trap && !downtown_champion_trap_player_inside
					# Champion Cup hard punishment: one trap hit applies all three effects together for 15s.
					downtown_champion_punish_vibrator = 15
					downtown_champion_punish_eyemask = 15
					downtown_champion_punish_walk = 15
					downtown_champion_trap_player_inside = true
				if !champion_in_trap
					downtown_champion_trap_player_inside = false

				downtown_champion_punish_force_timer = downtown_champion_punish_force_timer + _timediff
				if downtown_champion_punish_force_timer >= 0.25
					downtown_champion_punish_force_timer = 0
					if downtown_champion_punish_vibrator > 0
						if !_state.AdultToys["Vibrator"]
							EquipAdultToy("Vibrator")
						if !_state.AdultToys["TitRotor"]
							EquipAdultToy("TitRotor")
						if !_state.AdultToys["KuriRotor"]
							EquipAdultToy("KuriRotor")
						SetVibrator("Low")
					if downtown_champion_punish_eyemask > 0 && !_state.AdultToys["EyeMask"]
						EquipAdultToy("EyeMask")
					if downtown_champion_punish_walk > 0
						if _state.Action != "GanimataWalk"
							SetAction("GanimataWalk")
				if downtown_champion_punish_vibrator > 0
					downtown_champion_punish_vibrator = downtown_champion_punish_vibrator - _timediff
					if downtown_champion_punish_vibrator <= 0
						SetVibrator("Off")
						UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
						SetVibrator("Off")
				if downtown_champion_punish_eyemask > 0
					downtown_champion_punish_eyemask = downtown_champion_punish_eyemask - _timediff
					if downtown_champion_punish_eyemask <= 0
						if !downtown_champion_preserve_start_eyemask
							UnequipAdultToy("EyeMask")
				if downtown_champion_punish_walk > 0
					downtown_champion_punish_walk = downtown_champion_punish_walk - _timediff
					if downtown_champion_punish_walk <= 0
						SetAction("None")

			if downtown_state >= 91 && downtown_state <= 94
				champion_distance = Vector3Distance(Vector(_state.Position.x, _state.Position.y, _state.Position.z), downtown_champion_dest_pos)
				champion_gauge = 0
				if downtown_champion_total_distance > 0 && champion_distance < downtown_champion_total_distance
					champion_gauge = (downtown_champion_total_distance - champion_distance) / downtown_champion_total_distance
				downtown_champion_route_panel.SetGaugeProgress(champion_gauge)

			if downtown_state == 91 && downtown_champion_cp1_zone.Inside()
				downtown_champion_cp1_zone.SetVisible(false)
				downtown_champion_cp2_zone.SetVisible(true)
				downtown_champion_previous_x = -227.00
				downtown_champion_previous_y = 0.18
				downtown_champion_previous_z = -8.24
				downtown_champion_start_pos = Vector(_state.Position.x, _state.Position.y, _state.Position.z)
				downtown_champion_dest_pos = Vector(-282.31, 0.20, -7.73)
				downtown_champion_total_distance = Vector3Distance(downtown_champion_start_pos, downtown_champion_dest_pos)
				downtown_champion_route_panel.SetText("左转并直线跑向東京町一番街入口")
				downtown_champion_route_panel.SetGaugeProgress(0)
				downtown_champion_state = 92
				downtown_state = 92

			if downtown_state == 92 && downtown_champion_cp2_zone.Inside()
				downtown_champion_cp2_zone.SetVisible(false)
				downtown_champion_cp3_zone.SetVisible(true)
				downtown_champion_previous_x = -282.31
				downtown_champion_previous_y = 0.20
				downtown_champion_previous_z = -7.73
				downtown_champion_start_pos = Vector(_state.Position.x, _state.Position.y, _state.Position.z)
				downtown_champion_dest_pos = Vector(-274.10, 0.20, -36.91)
				downtown_champion_total_distance = Vector3Distance(downtown_champion_start_pos, downtown_champion_dest_pos)
				downtown_champion_route_panel.SetText("进入東京町一番街中心")
				downtown_champion_route_panel.SetGaugeProgress(0)
				downtown_champion_state = 93
				downtown_state = 93

			if downtown_state == 93 && downtown_champion_cp3_zone.Inside()
				downtown_champion_cp3_zone.SetVisible(false)
				downtown_champion_start_zone.SetVisible(true)
				downtown_champion_previous_x = -274.10
				downtown_champion_previous_y = 0.20
				downtown_champion_previous_z = -36.91
				downtown_champion_start_pos = Vector(_state.Position.x, _state.Position.y, _state.Position.z)
				downtown_champion_dest_pos = Vector(-227.05, 0.18, -54.32)
				downtown_champion_total_distance = Vector3Distance(downtown_champion_start_pos, downtown_champion_dest_pos)
				downtown_champion_route_panel.SetText("跑回起点")
				downtown_champion_route_panel.SetGaugeProgress(0)
				downtown_champion_state = 94
				downtown_state = 94

			if downtown_state == 94 && downtown_champion_start_zone.Inside()
				downtown_champion_start_zone.SetVisible(false)
				downtown_champion_route_panel.SetVisible(false)
				downtown_champion_trap_warning_panel.SetVisible(false)
				downtown_champion_barrier_warning_panel.SetVisible(false)
				downtown_champion_trap1a_zone.SetVisible(false)
				downtown_champion_trap1b_zone.SetVisible(false)
				downtown_champion_trap1c_zone.SetVisible(false)
				downtown_champion_trap1d_zone.SetVisible(false)
				downtown_champion_trap1e_zone.SetVisible(false)
				downtown_champion_pulse_r1_zone.SetVisible(false)
				downtown_champion_pulse_r2_zone.SetVisible(false)
				downtown_champion_pulse_r3_zone.SetVisible(false)
				downtown_champion_pulse_r4_zone.SetVisible(false)
				downtown_champion_pulse_r5_zone.SetVisible(false)
				downtown_champion_barrier1_visible_zone.SetVisible(false)
				downtown_champion_barrier2_visible_zone.SetVisible(false)
				downtown_champion_barrier3_visible_zone.SetVisible(false)
				downtown_champion_barrier4_visible_zone.SetVisible(false)
				downtown_champion_barrier1_zone.SetVisible(false)
				downtown_champion_barrier2_zone.SetVisible(false)
				downtown_champion_barrier3_zone.SetVisible(false)
				downtown_champion_barrier4_zone.SetVisible(false)
				downtown_champion_dynbar_r1_zone.SetVisible(false)
				downtown_champion_dynbar_r2_zone.SetVisible(false)
				downtown_champion_dynbar_r3_zone.SetVisible(false)
				downtown_champion_dynbar_r4_zone.SetVisible(false)
				downtown_champion_dynbar_r5_zone.SetVisible(false)
				downtown_champion_trap2a_zone.SetVisible(false)
				downtown_champion_trap2b_zone.SetVisible(false)
				downtown_champion_trap3a_zone.SetVisible(false)
				downtown_champion_trap3b_zone.SetVisible(false)
				downtown_champion_trap3c_zone.SetVisible(false)
				downtown_champion_trap3d_zone.SetVisible(false)
				downtown_champion_oldtrap4a_zone.SetVisible(false)
				downtown_champion_oldtrap4b_zone.SetVisible(false)
				downtown_champion_oldtrap4c_zone.SetVisible(false)
				downtown_champion_oldtrap4d_zone.SetVisible(false)
				downtown_champion_bridge_trap1_zone.SetVisible(false)
				downtown_champion_bridge_trap2_zone.SetVisible(false)
				downtown_champion_bridge_trap3_zone.SetVisible(false)
				downtown_champion_bridge_trap4_zone.SetVisible(false)
				downtown_champion_bridge_trap5_zone.SetVisible(false)
				SetVibrator("Off")
				UnequipAdultToy("Vibrator", "TitRotor", "KuriRotor")
				if !downtown_champion_preserve_start_eyemask
					UnequipAdultToy("EyeMask")
				SetVibrator("Off")
				if downtown_champion_punish_walk > 0
					SetAction("None")
				downtown_champion_punish_vibrator = 0
				downtown_champion_punish_eyemask = 0
				downtown_champion_punish_walk = 0
				downtown_champion_overlay.SetFace(color=Color(1,0.15,0.15,1), dilate=0.3)
				downtown_champion_overlay_alt.SetFace(color=Color(1,0.15,0.15,1), dilate=0.3)
				champion_final_text = "" + downtown_champion_minutes + ":"
				if downtown_champion_seconds < 10
					champion_final_text = champion_final_text + "0"
				champion_final_text = champion_final_text + downtown_champion_seconds
				champion_final_total = (downtown_champion_minutes * 60) + downtown_champion_seconds
				if _save.DowntownExpertMarathonBestTotal == 0 || champion_final_total < _save.DowntownExpertMarathonBestTotal
					_save.DowntownExpertMarathonBestTotal = champion_final_total
					_save.DowntownExpertMarathonBestMinutes = downtown_champion_minutes
					_save.DowntownExpertMarathonBestSeconds = downtown_champion_seconds
				downtown_champion_overlay.Clear()
				downtown_champion_overlay_alt.Clear()
				downtown_champion_overlay.Add(text=champion_final_text)
				downtown_champion_overlay_flip = false
				downtown_challenge_complete_overlay_message = ""
				if _save.DowntownChallengeNakedMarathonCompleted != 1 && downtown_challenge_naked_marathon_active && !downtown_challenge_naked_marathon_failed
					_save.DowntownChallengeNakedMarathonCompleted = 1
					_save.DowntownXP = _save.DowntownXP + 300
					if _save.DowntownBigJRewardNakedMarathon != 1
						_save.DowntownBigJRewardNakedMarathon = 1
						AddCurrentEarnRP(5000)
						_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 5000
						_save.DowntownBigJHistoryType.Insert(2)
						_save.DowntownBigJHistoryImage.Insert("")
						_save.DowntownBigJHistoryReply.Insert(0)
						_save.DowntownBigJHistoryTag.Insert(0)
						if downtown_bigj_chat != null
							downtown_bigj_chat.Add("你居然全裸跑遍了繁华街？BigJ 知道你很大胆，但这也太屌了！\n\n+5000 RP", "Left", user="BigJ", silent=false)
					downtown_challenge_complete_overlay_message = "Naked Marathon Challenge Completed!"
				if _save.DowntownChallengeBlindfoldMarathonCompleted != 1 && downtown_challenge_blindfold_marathon_active && !downtown_challenge_blindfold_marathon_failed
					_save.DowntownChallengeBlindfoldMarathonCompleted = 1
					_save.DowntownXP = _save.DowntownXP + 300
					if _save.DowntownBigJRewardBlindfoldMarathon != 1
						_save.DowntownBigJRewardBlindfoldMarathon = 1
						AddCurrentEarnRP(5000)
						_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 5000
						_save.DowntownBigJHistoryType.Insert(3)
						_save.DowntownBigJHistoryImage.Insert("")
						_save.DowntownBigJHistoryReply.Insert(0)
						_save.DowntownBigJHistoryTag.Insert(0)
						if downtown_bigj_chat != null
							downtown_bigj_chat.Add("你居然蒙着眼完成了马拉松？！BigJ 简直不敢相信自己的眼睛，真是讽刺，毕竟你当时根本用不了自己的眼睛！\n\n+5000 RP", "Left", user="BigJ", silent=false)
					if downtown_challenge_complete_overlay_message == ""
						downtown_challenge_complete_overlay_message = "Blindfold Marathon Challenge Completed!"
					else
						downtown_challenge_complete_overlay_message = downtown_challenge_complete_overlay_message + "\nBlindfold Marathon Challenge Completed!"
				if downtown_challenge_complete_overlay_message != ""
					downtown_challenge_complete_overlay.Clear()
					downtown_challenge_complete_overlay.Add(text=downtown_challenge_complete_overlay_message)
					downtown_challenge_complete_overlay_timer = 5
				AddCurrentEarnRP(350)
				_save.DowntownXP = _save.DowntownXP + 150
				_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 350
				if downtown_coat_moved
					CollectItem(itemtype="Coat")
					champion_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
					DropItem(itemtype="Coat", position=champion_coat_return, compass=false)
					downtown_coat_moved = false
				downtown_fail_panel.SetText("任务完成：350 RP，150 XP - 用时 " + champion_final_text)
				downtown_fail_panel.SetVisible(true)
				downtown_fail_timer = 6
				downtown_champion_state = 95
				downtown_state = 95

			if downtown_state == 95
				downtown_fail_timer = downtown_fail_timer - _timediff
				if downtown_fail_timer <= 0
					downtown_fail_panel.SetVisible(false)
					downtown_champion_overlay.Clear()
					downtown_champion_overlay_alt.Clear()
					downtown_champion_overlay_flip = true
					downtown_champion_precheck_duration = 0
					downtown_champion_bodypaint_duration = 0
					downtown_challenge_naked_marathon_wait_start_exit = false
					downtown_challenge_naked_marathon_active = false
					downtown_challenge_naked_marathon_failed = false
					downtown_challenge_blindfold_marathon_wait_start_exit = false
					downtown_challenge_blindfold_marathon_active = false
					downtown_challenge_blindfold_marathon_failed = false
					downtown_champion_state = 0
					downtown_state = 0





	IsCurrentMissionActive:
		_result = downtown_state != 0 || downtown_laundry_state != 0 || downtown_invisible_state != 0 || downtown_marathon_state != 0 || downtown_champion_state != 0

	Cancel:
		# Downtown cleanup.
		downtown_bigj_chat = null
		downtown_bigj_gallery = null
