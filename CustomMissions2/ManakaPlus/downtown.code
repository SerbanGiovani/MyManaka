							# Slow settle before the final facing snap; safer than aggressive repeated warps.
							expert1_turn_npc.ClearWaypoints()
							expert1_turn_npc.AddWaypoint(expert1_turn_pos)
							expert1_turn_npc.Warp(position=expert1_turn_pos, rotation=expert1_away_rot)
							downtown_expert1_watch_timer = 0
