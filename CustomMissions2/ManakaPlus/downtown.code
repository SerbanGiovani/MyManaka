							AddItemCount("Dildo", 1)
							downtown_expert2_dildo6 = DropItem(itemtype="DildoFloor", stage="StationFront", position=expert2_pos6, compass=false)
							downtown_expert2_zone1.SetVisible(true)
							downtown_expert2_zone2.SetVisible(true)
							downtown_expert2_zone3.SetVisible(true)
							downtown_expert2_zone4.SetVisible(true)
							downtown_expert2_zone5.SetVisible(true)
							downtown_expert2_zone6.SetVisible(true)
							downtown_expert2_main_panel.SetText("在每个地点连续使用假阳具 15 秒。建议先找齐全部地点再开始；请查看罗盘")
							downtown_expert2_main_panel.SetVisible(true)
							downtown_expert2_main_panel.SetGaugeVisible(true)
							downtown_expert2_main_panel.SetGaugeProgress(0)
							downtown_expert2_main_panel.SetRPText("0/6")
							downtown_expert2_action_panel.SetVisible(false)
							downtown_state = 81
						else
							downtown_outfit_panel.SetVisible(false)
							UnequipCosplay("m_cosplay_suit_chic_shirt", "m_cosplay_suit_chic_jacket", "m_cosplay_suit_chic_card", "m_cosplay_suit_chic_skirt", "m_cosplay_suit_chic_pants", "m_cosplay_suit_chic_panty", "m_cosplay_suit_chic_stocking", "m_cosplay_suit_chic_shoes")
							if downtown_coat_moved
								CollectItem(itemtype="Coat")
								expert2_failed_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
								DropItem(itemtype="Coat", position=expert2_failed_coat_return, compass=false)
								downtown_coat_moved = false
							downtown_fail_panel.SetText("服装缺失，任务已取消")
							downtown_fail_panel.SetVisible(true)
							downtown_fail_timer = 5
							downtown_state = 84

			if downtown_state == 81 || downtown_state == 82
				# Light outfit monitor: check once per second and only re-force if a required Suit A piece is missing.
				downtown_expert2_outfit_lock_timer = downtown_expert2_outfit_lock_timer + _timediff
				if downtown_expert2_outfit_lock_timer >= 1
					expert2_missing_required = false
					if downtown_expert2_allow_shirt && downtown_condition_suita_shirt.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_jacket && downtown_condition_suita_jacket.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_card && downtown_condition_suita_card.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_skirt && downtown_condition_suita_skirt.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_pants && downtown_condition_suita_pants.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_panty && downtown_condition_suita_panty.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_stocking && downtown_condition_suita_stocking.Check() == false
						expert2_missing_required = true
					if downtown_expert2_allow_shoes && downtown_condition_suita_shoes.Check() == false
						expert2_missing_required = true
					if expert2_missing_required
						UnequipAllCosplay()
						if downtown_expert2_allow_shirt
							EquipCosplay("m_cosplay_suit_chic_shirt")
						if downtown_expert2_allow_jacket
							EquipCosplay("m_cosplay_suit_chic_jacket")
						if downtown_expert2_allow_card
							EquipCosplay("m_cosplay_suit_chic_card")
						if downtown_expert2_allow_skirt
							EquipCosplay("m_cosplay_suit_chic_skirt")
						if downtown_expert2_allow_pants
							EquipCosplay("m_cosplay_suit_chic_pants")
						if downtown_expert2_allow_panty
							EquipCosplay("m_cosplay_suit_chic_panty")
						if downtown_expert2_allow_stocking
							EquipCosplay("m_cosplay_suit_chic_stocking")
						if downtown_expert2_allow_shoes
							EquipCosplay("m_cosplay_suit_chic_shoes")
					downtown_expert2_outfit_lock_timer = 0

			# Remove completed inspection dildos only after Manaka stops using them, matching Foods Deliver safety behavior.
			if downtown_state == 81 || downtown_state == 82
				if downtown_condition_floor_dildo_using.Check() == false
					if downtown_expert2_remove_pending1 && downtown_expert2_dildo1 != 0
						if CollectItem(itemtype=downtown_expert2_dildo1)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo1 = 0
						downtown_expert2_remove_pending1 = false
					if downtown_expert2_remove_pending2 && downtown_expert2_dildo2 != 0
						if CollectItem(itemtype=downtown_expert2_dildo2)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo2 = 0
						downtown_expert2_remove_pending2 = false
					if downtown_expert2_remove_pending3 && downtown_expert2_dildo3 != 0
						if CollectItem(itemtype=downtown_expert2_dildo3)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo3 = 0
						downtown_expert2_remove_pending3 = false
					if downtown_expert2_remove_pending4 && downtown_expert2_dildo4 != 0
						if CollectItem(itemtype=downtown_expert2_dildo4)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo4 = 0
						downtown_expert2_remove_pending4 = false
					if downtown_expert2_remove_pending5 && downtown_expert2_dildo5 != 0
						if CollectItem(itemtype=downtown_expert2_dildo5)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo5 = 0
						downtown_expert2_remove_pending5 = false
					if downtown_expert2_remove_pending6 && downtown_expert2_dildo6 != 0
						if CollectItem(itemtype=downtown_expert2_dildo6)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo6 = 0
						downtown_expert2_remove_pending6 = false

			if downtown_state == 81
				expert2_current_zone = 0
				if downtown_condition_floor_dildo_using.Check()
					if downtown_expert2_zone1.Inside() && downtown_expert2_done1 == false
						expert2_current_zone = 1
					if downtown_expert2_zone2.Inside() && downtown_expert2_done2 == false
						expert2_current_zone = 2
					if downtown_expert2_zone3.Inside() && downtown_expert2_done3 == false
						expert2_current_zone = 3
					if downtown_expert2_zone4.Inside() && downtown_expert2_done4 == false
						expert2_current_zone = 4
					if downtown_expert2_zone5.Inside() && downtown_expert2_done5 == false
						expert2_current_zone = 5
					if downtown_expert2_zone6.Inside() && downtown_expert2_done6 == false
						expert2_current_zone = 6
				if expert2_current_zone > 0
					if downtown_expert2_active_zone != expert2_current_zone
						downtown_expert2_action_duration = 0
						downtown_expert2_active_zone = expert2_current_zone
					downtown_expert2_action_duration = downtown_expert2_action_duration + _timediff
					downtown_expert2_action_panel.SetText("连续自慰 15 秒")
					downtown_expert2_action_panel.SetVisible(true)
					downtown_expert2_action_panel.SetGaugeProgress(downtown_expert2_action_duration / 15)
					downtown_expert2_action_panel.SetRPText("" + Floor(downtown_expert2_action_duration) + "/15秒")
				else
					downtown_expert2_action_duration = 0
					downtown_expert2_active_zone = 0
					downtown_expert2_action_panel.SetVisible(false)
					downtown_expert2_action_panel.SetGaugeProgress(0)
					downtown_expert2_action_panel.SetRPText("")
				if downtown_expert2_action_duration >= 15
					if downtown_expert2_active_zone == 1
						downtown_expert2_done1 = true
						downtown_expert2_remove_pending1 = true
						downtown_expert2_zone1.SetVisible(false)
					if downtown_expert2_active_zone == 2
						downtown_expert2_done2 = true
						downtown_expert2_remove_pending2 = true
						downtown_expert2_zone2.SetVisible(false)
					if downtown_expert2_active_zone == 3
						downtown_expert2_done3 = true
						downtown_expert2_remove_pending3 = true
						downtown_expert2_zone3.SetVisible(false)
					if downtown_expert2_active_zone == 4
						downtown_expert2_done4 = true
						downtown_expert2_remove_pending4 = true
						downtown_expert2_zone4.SetVisible(false)
					if downtown_expert2_active_zone == 5
						downtown_expert2_done5 = true
						downtown_expert2_remove_pending5 = true
						downtown_expert2_zone5.SetVisible(false)
					if downtown_expert2_active_zone == 6
						downtown_expert2_done6 = true
						downtown_expert2_remove_pending6 = true
						downtown_expert2_zone6.SetVisible(false)
					downtown_expert2_progress = downtown_expert2_progress + 1
					if downtown_expert2_suit_remaining.Count() > 0
						expert2_random_index = RandomInt(0, downtown_expert2_suit_remaining.Count() - 1)
						expert2_remove_item = downtown_expert2_suit_remaining[expert2_random_index]
						UnequipCosplay(expert2_remove_item)
						if expert2_remove_item == "m_cosplay_suit_chic_shirt"
							downtown_expert2_allow_shirt = false
						if expert2_remove_item == "m_cosplay_suit_chic_jacket"
							downtown_expert2_allow_jacket = false
						if expert2_remove_item == "m_cosplay_suit_chic_skirt"
							downtown_expert2_allow_skirt = false
						if expert2_remove_item == "m_cosplay_suit_chic_pants"
							downtown_expert2_allow_pants = false
						if expert2_remove_item == "m_cosplay_suit_chic_panty"
							downtown_expert2_allow_panty = false
						if expert2_remove_item == "m_cosplay_suit_chic_stocking"
							downtown_expert2_allow_stocking = false
						downtown_expert2_suit_remaining.Remove(expert2_random_index)
					downtown_expert2_main_panel.SetGaugeProgress(downtown_expert2_progress / 6)
					downtown_expert2_main_panel.SetRPText("" + downtown_expert2_progress + "/6")
					downtown_expert2_action_duration = 0
					downtown_expert2_active_zone = 0
					downtown_expert2_action_panel.SetVisible(false)
					if downtown_expert2_progress >= 6
						downtown_expert2_main_panel.SetVisible(false)
						downtown_expert2_action_panel.SetVisible(false)
						downtown_expert2_zone1.SetVisible(false)
						downtown_expert2_zone2.SetVisible(false)
						downtown_expert2_zone3.SetVisible(false)
						downtown_expert2_zone4.SetVisible(false)
						downtown_expert2_zone5.SetVisible(false)
						downtown_expert2_zone6.SetVisible(false)
						downtown_expert2_report_panel.SetText("返回任务中心报告")
						downtown_expert2_report_panel.SetVisible(true)
						downtown_state = 82

			if downtown_state == 82
				if downtown_hub_zone != null && downtown_hub_zone.Inside()
					AddCurrentEarnRP(350)
					_save.DowntownXP = _save.DowntownXP + 150
					_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 350
					downtown_expert2_report_panel.SetVisible(false)
					if downtown_expert2_dildo1 != 0
						if CollectItem(itemtype=downtown_expert2_dildo1)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo1 = 0
					if downtown_expert2_dildo2 != 0
						if CollectItem(itemtype=downtown_expert2_dildo2)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo2 = 0
					if downtown_expert2_dildo3 != 0
						if CollectItem(itemtype=downtown_expert2_dildo3)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo3 = 0
					if downtown_expert2_dildo4 != 0
						if CollectItem(itemtype=downtown_expert2_dildo4)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo4 = 0
					if downtown_expert2_dildo5 != 0
						if CollectItem(itemtype=downtown_expert2_dildo5)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo5 = 0
					if downtown_expert2_dildo6 != 0
						if CollectItem(itemtype=downtown_expert2_dildo6)
							AddItemCount("Dildo", -1)
						downtown_expert2_dildo6 = 0
					if downtown_coat_moved
						CollectItem(itemtype="Coat")
						expert2_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=expert2_coat_return, compass=false)
						downtown_coat_moved = false
					UnequipCosplay("m_cosplay_suit_chic_shirt", "m_cosplay_suit_chic_jacket", "m_cosplay_suit_chic_card", "m_cosplay_suit_chic_skirt", "m_cosplay_suit_chic_pants", "m_cosplay_suit_chic_panty", "m_cosplay_suit_chic_stocking", "m_cosplay_suit_chic_shoes")
					downtown_fail_panel.SetText("任务完成：350 RP，150 XP")
					downtown_fail_panel.SetVisible(true)
					downtown_fail_timer = 5
					downtown_state = 84

			if downtown_state == 84
				downtown_fail_timer = downtown_fail_timer - _timediff
				if downtown_fail_timer <= 0
					downtown_fail_panel.SetVisible(false)
					downtown_expert2_accept_duration = 0
					downtown_expert2_outfit_timer = 0
					downtown_expert2_progress = 0
					downtown_expert2_action_duration = 0
					downtown_expert2_active_zone = 0
					downtown_expert2_outfit_lock_timer = 0
					downtown_expert2_suit_remaining = CreateList()
					downtown_state = 0


			# Expert Mission 4: Invisible Master.
			if downtown_state == 110
				expert4_distance = Vector3Distance(Vector(_state.Position.x,_state.Position.y,_state.Position.z), Vector(-286.90,0.27,11.16))
				expert4_gauge = 0
				if expert4_distance < 80
					expert4_gauge = (80 - expert4_distance) / 80
				downtown_expert4_route_panel.SetGaugeProgress(expert4_gauge)
				if downtown_expert4_zone.Inside()
					downtown_expert4_route_panel.SetVisible(false)
					downtown_expert4_main_panel.SetText("全裸并使用透明药水，不要离开区域，坚持 90 秒——使用透明药水并做好准备")
					downtown_expert4_main_panel.SetVisible(true)
					downtown_expert4_main_panel.SetGaugeProgress(0)
					downtown_expert4_ready_duration = 0
					downtown_state = 111

			if downtown_state == 111
				if downtown_condition_invisible.Check()
					downtown_expert4_ready_duration = downtown_expert4_ready_duration + _timediff
					downtown_expert4_main_panel.SetGaugeProgress(downtown_expert4_ready_duration / 3)
					if downtown_expert4_ready_duration >= 3
						DropItem(itemtype="Coat", position=_state.Position, compass=false)
						CollectItem(itemtype="Coat")
						expert4_coat_away = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=expert4_coat_away, compass=false)
						downtown_coat_moved = true
						downtown_expert4_remaining = 90
						downtown_expert4_elapsed = 0
						downtown_expert4_second_timer = 0
						downtown_expert4_spawn_timer = 0
						downtown_expert4_next_spawn_delay = RandomInt(15,21) / 10
						downtown_expert4_npcs = CreateList()
						downtown_expert4_phase1_axis = RandomInt(1,3)
						downtown_expert4_phase_axis = 3
						downtown_expert4_phase_mode = 3
						downtown_expert4_phase_switch_timer = 0
						downtown_expert4_cap = 10
						downtown_expert4_main_panel.SetText("全裸并保持透明，不要离开区域，坚持 90 秒")
						downtown_expert4_main_panel.SetGaugeProgress(0)
						# Hidden passive Challenge: base mission continues immediately; only monitoring waits 3s.
						if _save.DowntownChallengeInvisibleArchMageCompleted != 1
							downtown_challenge_invisible_arch_grace_timer = 3
							downtown_challenge_invisible_arch_active = true
							downtown_challenge_invisible_arch_failed = false
						else
							downtown_challenge_invisible_arch_grace_timer = 0
							downtown_challenge_invisible_arch_active = false
							downtown_challenge_invisible_arch_failed = false
						downtown_state = 112
				else
					downtown_expert4_ready_duration = 0
					downtown_expert4_main_panel.SetGaugeProgress(0)

			if downtown_state == 112
				# Invisible Arch Mage: 3s grace after mission start, then one break disqualifies this run.
				if downtown_challenge_invisible_arch_active
					if downtown_challenge_invisible_arch_grace_timer > 0
						downtown_challenge_invisible_arch_grace_timer = downtown_challenge_invisible_arch_grace_timer - _timediff
					if downtown_challenge_invisible_arch_grace_timer <= 0 && !downtown_challenge_condition_ganimata_walk.Check()
						downtown_challenge_invisible_arch_grace_timer = 0
						downtown_challenge_invisible_arch_active = false
						downtown_challenge_invisible_arch_failed = true

				# Keep player inside the tight cuboid arena.
				if !downtown_expert4_zone.Inside()
					SetPlayerPosition(x=-286.90, y=0.27, z=11.16, rx=0, ry=0, rz=0, rw=1)

				downtown_expert4_second_timer = downtown_expert4_second_timer + _timediff
				if downtown_expert4_second_timer >= 1
					downtown_expert4_second_timer = downtown_expert4_second_timer - 1
					downtown_expert4_remaining = downtown_expert4_remaining - 1
					downtown_expert4_elapsed = 90 - downtown_expert4_remaining
					downtown_expert4_main_panel.SetText("全裸并保持透明，不要离开区域，坚持 " + downtown_expert4_remaining + "秒")
					downtown_expert4_main_panel.SetGaugeProgress((90 - downtown_expert4_remaining) / 90)

				# Final steady design: all sides are active from the start, with one default cap.
				downtown_expert4_phase_mode = 3
				downtown_expert4_phase_axis = 3
				downtown_expert4_cap = 10

				# Track only NPCs that are alive and still inside/around the Invisible Master arena.
				# The cap is concurrent NPCs, never a lifetime spawn counter.
				downtown_expert4_live_count = 0
				i = downtown_expert4_npcs.Count() - 1
				while i >= 0
					entry = downtown_expert4_npcs[i]
					expert4_remove_entry = false
					if entry.npc == null
						expert4_remove_entry = true
					else
						if !entry.npc.IsAlive()
							expert4_remove_entry = true
						else
							expert4_npc_position = entry.npc.GetPosition()
							expert4_npc_distance = Vector3Distance(expert4_npc_position, Vector(-286.90,0.27,11.16))
							if expert4_npc_distance > 6.2
								expert4_remove_entry = true
							else
								if entry.phase == 0
									if entry.npc.Finished()
										entry.npc.Stopped(true)
										entry.pause = RandomInt(8,16) / 10
										entry.phase = 1
								if entry.phase == 1
									entry.pause = entry.pause - _timediff
									if entry.pause <= 0
										entry.npc.Stopped(false)
										entry.npc.ClearWaypoints()
										entry.npc.AddWaypoint(entry.dest, last=true)
										entry.phase = 2
								if entry.phase == 2
									if entry.npc.Finished()
										expert4_remove_entry = true
					if expert4_remove_entry
						downtown_expert4_npcs.Remove(i)
					else
						downtown_expert4_live_count = downtown_expert4_live_count + 1
					i = i - 1

				downtown_expert4_spawn_timer = downtown_expert4_spawn_timer + _timediff
				if downtown_expert4_spawn_timer >= downtown_expert4_next_spawn_delay
					downtown_expert4_spawn_timer = 0
					if downtown_expert4_elapsed < 45
						downtown_expert4_next_spawn_delay = RandomInt(15,21) / 10
					else
						downtown_expert4_next_spawn_delay = RandomInt(12,17) / 10
					batch_count = 1
					if RandomInt(0,100) < 25
						batch_count = 3
					batch_index = 0
					while batch_index < batch_count
						if downtown_expert4_live_count < downtown_expert4_cap
							spawn_axis = RandomInt(1,3)
							spawn_side = RandomInt(1,3)
							spawn_x = -286.90
							spawn_z = 11.16
							dest_x = -286.90
							dest_z = 11.16
							spawn_rot = Quaternion(0,0,0,1)
							if spawn_axis == 1
								# Width routes: west/east side to opposite side, with corner margin.
								spawn_z = RandomInt(866,1367) / 100
								dest_z = spawn_z
								if spawn_side == 1
									spawn_x = -290.90
									dest_x = -281.90
									spawn_rot = Quaternion(0.00000, 0.71080, 0.00000, 0.70339)
								else
									spawn_x = -282.90
									dest_x = -291.90
									spawn_rot = Quaternion(0.00000, -0.70339, 0.00000, 0.71080)
							if spawn_axis == 2
								# Length routes: north/south side to opposite side, with corner margin.
								spawn_x = RandomInt(-28940,-28439) / 100
								dest_x = spawn_x
								if spawn_side == 1
									spawn_z = 7.16
									dest_z = 16.16
									spawn_rot = Quaternion(0.00000, 0.00524, 0.00000, 0.99999)
								else
									spawn_z = 15.16
									dest_z = 6.16
									spawn_rot = Quaternion(0.00000, 0.99999, 0.00000, -0.00524)
							avatar_roll = RandomInt(0,4)
							avatar_type = "NewFemale"
							if avatar_roll == 1
								avatar_type = "PreviousFemale"
							if avatar_roll == 2
								avatar_type = "NewMale"
							if avatar_roll == 3
								avatar_type = "PreviousMale"
							npc = CreateNPC(avatar_type, position=Vector(spawn_x,0.27,spawn_z), rotation=spawn_rot)
							npc.SkipStrangeness(false)
							npc.CanGameOver(true)
							npc.Stopped(false)
							if downtown_expert4_elapsed < 45
								speed_tenths = RandomInt(15,26)
							else
								speed_tenths = RandomInt(20,31)
							npc.Speed(speed_tenths / 10)
							npc.ClearWaypoints()
							dest_vec = Vector(dest_x,0.27,dest_z)
							mid_vec = Vector((spawn_x + dest_x) / 2,0.27,(spawn_z + dest_z) / 2)
							stop_choice = 0
							if RandomInt(0,100) < 20
								stop_choice = 1
							if stop_choice == 1
								npc.AddWaypoint(mid_vec)
								downtown_expert4_npcs.Insert(CreateList(npc=npc, life=22, dest=dest_vec, mid=mid_vec, phase=0, pause=0, change=0, axis=spawn_axis))
							else
								npc.AddWaypoint(dest_vec, last=true)
								downtown_expert4_npcs.Insert(CreateList(npc=npc, life=18, dest=dest_vec, mid=mid_vec, phase=2, pause=0, change=0, axis=spawn_axis))
							downtown_expert4_live_count = downtown_expert4_live_count + 1
						batch_index = batch_index + 1

				if downtown_expert4_remaining <= 0
					if _save.DowntownChallengeInvisibleArchMageCompleted != 1 && downtown_challenge_invisible_arch_active && !downtown_challenge_invisible_arch_failed && downtown_challenge_invisible_arch_grace_timer <= 0
						_save.DowntownChallengeInvisibleArchMageCompleted = 1
						_save.DowntownXP = _save.DowntownXP + 300
						if _save.DowntownBigJRewardInvisibleArchMage != 1
							_save.DowntownBigJRewardInvisibleArchMage = 1
							AddCurrentEarnRP(5000)
							_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 5000
							_save.DowntownBigJHistoryType.Insert(5)
							_save.DowntownBigJHistoryImage.Insert("")
							_save.DowntownBigJHistoryReply.Insert(0)
							_save.DowntownBigJHistoryTag.Insert(0)
							if downtown_bigj_chat != null
								downtown_bigj_chat.Add("全程叉腿走路穿过了那片闹市区？哇哦！真菜香，你该不会是什么隐身大师吧！\n\n+5000 RP", "Left", user="BigJ", silent=false)
						downtown_challenge_complete_overlay.Clear()
						downtown_challenge_complete_overlay.Add(text="INVISIBLE ARCH MAGE COMPLETED!")
						downtown_challenge_complete_overlay_timer = 5
					AddCurrentEarnRP(350)
					_save.DowntownXP = _save.DowntownXP + 150
					_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 350
					downtown_expert4_main_panel.SetVisible(false)
					if downtown_coat_moved
						CollectItem(itemtype="Coat")
						expert4_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=expert4_coat_return, compass=false)
						downtown_coat_moved = false
					downtown_fail_panel.SetText("任务完成：350 RP，150 XP")
					downtown_fail_panel.SetVisible(true)
					downtown_fail_timer = 5
					downtown_expert4_cleanup_timer = 12
					downtown_state = 113

			if downtown_state == 113
				# Spawning is stopped. Keep the arena visibly active for the complete 12-second cleanup.
				downtown_expert4_visible_zone.SetVisible(true)
				downtown_expert4_cleanup_timer = downtown_expert4_cleanup_timer - _timediff
				if downtown_fail_timer > 0
					downtown_fail_timer = downtown_fail_timer - _timediff
					if downtown_fail_timer <= 0
						downtown_fail_panel.SetVisible(false)
				if downtown_expert4_cleanup_timer <= 0
					downtown_expert4_visible_zone.SetVisible(false)
					downtown_expert4_npcs = CreateList()
					downtown_expert4_accept_duration = 0
					downtown_expert4_ready_duration = 0
					downtown_challenge_invisible_arch_grace_timer = 0
					downtown_challenge_invisible_arch_active = false
					downtown_challenge_invisible_arch_failed = false
					downtown_state = 0


			# Rookie Mission 5: Invisible Practicing.
			if downtown_state == 60
				invisible_distance = Vector3Distance(Vector(_state.Position.x,_state.Position.y,_state.Position.z), Vector(-283.99,0.25,17.34))
				invisible_gauge = 0
				if invisible_distance < 80
					invisible_gauge = (80 - invisible_distance) / 80
				downtown_invisible_route_panel.SetGaugeProgress(invisible_gauge)
				if downtown_invisible_zone.Inside()
					downtown_invisible_route_panel.SetVisible(false)
					downtown_invisible_main_panel.SetText("全裸并保持透明，不要离开区域，坚持 120 秒——使用透明药水并做好准备")
					downtown_invisible_main_panel.SetVisible(true)
					downtown_invisible_main_panel.SetGaugeProgress(0)
					downtown_invisible_ready_duration = 0
					downtown_invisible_state = 61
					downtown_state = 61

			if downtown_state == 61
				if downtown_condition_invisible.Check()
					downtown_invisible_ready_duration = downtown_invisible_ready_duration + _timediff
					downtown_invisible_main_panel.SetGaugeProgress(downtown_invisible_ready_duration / 3)
					if downtown_invisible_ready_duration >= 3
						DropItem(itemtype="Coat", position=_state.Position, compass=false)
						CollectItem(itemtype="Coat")
						invisible_coat_away = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=invisible_coat_away, compass=false)
						downtown_coat_moved = true
						downtown_invisible_remaining = 120
						downtown_invisible_second_timer = 0
						downtown_invisible_spawn_timer = 0
						downtown_invisible_main_panel.SetText("全裸并保持透明，不要离开区域，坚持 120 秒")
						downtown_invisible_main_panel.SetGaugeProgress(0)
						downtown_invisible_state = 62
						downtown_state = 62
				else
					downtown_invisible_ready_duration = 0
					downtown_invisible_main_panel.SetGaugeProgress(0)

			if downtown_state == 62
				# Keep the player inside the arena without creating a custom failure state.
				if !downtown_invisible_zone.Inside()
					SetPlayerPosition(x=-283.99, y=0.25, z=17.34, rx=0, ry=0, rz=0, rw=1)
				downtown_invisible_second_timer = downtown_invisible_second_timer + _timediff
				if downtown_invisible_second_timer >= 1
					downtown_invisible_second_timer = downtown_invisible_second_timer - 1
					downtown_invisible_remaining = downtown_invisible_remaining - 1
					downtown_invisible_main_panel.SetText("全裸并保持透明，不要离开区域，坚持 " + downtown_invisible_remaining + "秒")
					downtown_invisible_main_panel.SetGaugeProgress((120 - downtown_invisible_remaining) / 120)

				# Count only NPCs that are alive and still crossing the Rookie arena.
				# A spawned NPC is not retired from the cap until it has entered the arena
				# and then reached the opposite edge, or its NPC object is no longer alive.
				downtown_invisible_live_count = 0
				i = downtown_invisible_npcs.Count() - 1
				while i >= 0
					entry = downtown_invisible_npcs[i]
					invisible_remove_entry = false
					if entry.npc == null
						invisible_remove_entry = true
					else
						if !entry.npc.IsAlive()
							invisible_remove_entry = true
						else
							invisible_npc_position = entry.npc.GetPosition()
							invisible_npc_distance = Vector3Distance(invisible_npc_position, Vector(-283.99,0.25,17.34))
							if invisible_npc_distance < 4.75
								entry.entered = true
							if entry.entered && invisible_npc_distance > 4.95
								invisible_remove_entry = true
							if entry.npc.Finished()
								invisible_remove_entry = true
					if invisible_remove_entry
						downtown_invisible_npcs.Remove(i)
					else
						downtown_invisible_live_count = downtown_invisible_live_count + 1
					i = i - 1

				downtown_invisible_spawn_timer = downtown_invisible_spawn_timer + _timediff
				if downtown_invisible_spawn_timer >= 1
					spawn_delay_tenths = RandomInt(10,25)
					downtown_invisible_spawn_timer = downtown_invisible_spawn_timer - (spawn_delay_tenths / 10)
					if downtown_invisible_live_count < 15
						spawn_index = RandomInt(0, downtown_invisible_edge_points.Count())
						offset_index = RandomInt(18,49)
						destination_index = spawn_index + offset_index
						while destination_index >= downtown_invisible_edge_points.Count()
							destination_index = destination_index - downtown_invisible_edge_points.Count()
						avatar_roll = RandomInt(0,4)
						avatar_type = "NewFemale"
						if avatar_roll == 1
							avatar_type = "PreviousFemale"
						if avatar_roll == 2
							avatar_type = "NewMale"
						if avatar_roll == 3
							avatar_type = "PreviousMale"
						npc = CreateNPC(avatar_type, position=downtown_invisible_edge_points[spawn_index], rotation=Quaternion(0,0,0,1))
						npc.SkipStrangeness(false)
						npc.CanGameOver(true)
						npc.Stopped(false)
						# Random crossing speed from 1.5 to 2.0.
						speed_tenths = RandomInt(15,21)
						npc.Speed(speed_tenths / 10)
						npc.ClearWaypoints()
						invisible_destination = downtown_invisible_edge_points[destination_index]
						npc.AddWaypoint(invisible_destination, last=true)
						downtown_invisible_npcs.Insert(CreateList(npc=npc, dest=invisible_destination, entered=false))
						downtown_invisible_live_count = downtown_invisible_live_count + 1

				if downtown_invisible_remaining <= 0
					AddCurrentEarnRP(250)
					_save.DowntownXP = _save.DowntownXP + 75
					_save.ManakaPlusTotalRP = _save.ManakaPlusTotalRP + 250
					downtown_invisible_main_panel.SetVisible(false)
					if downtown_coat_moved
						CollectItem(itemtype="Coat")
						invisible_coat_return = CreateList(stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=invisible_coat_return, compass=false)
						downtown_coat_moved = false
					downtown_fail_panel.SetText("任务完成：250 RP，75 XP")
					downtown_fail_panel.SetVisible(true)
					downtown_fail_timer = 5
					downtown_invisible_cleanup_timer = 12
					downtown_invisible_state = 63
					downtown_state = 63

			if downtown_state == 63
				# Spawning is stopped. Keep the arena visibly active for the complete 12-second cleanup.
				downtown_invisible_zone.SetVisible(true)
				downtown_invisible_cleanup_timer = downtown_invisible_cleanup_timer - _timediff
				if downtown_fail_timer > 0
					downtown_fail_timer = downtown_fail_timer - _timediff
					if downtown_fail_timer <= 0
						downtown_fail_panel.SetVisible(false)
				if downtown_invisible_cleanup_timer <= 0
					downtown_invisible_zone.SetVisible(false)
					downtown_invisible_npcs = CreateList()
					downtown_invisible_state = 0
					downtown_state = 0

			# Rookie Mission 4: Downtown Marathon. Repeatable route with a visible run record.
			if downtown_state >= 51 && downtown_state <= 54
				downtown_marathon_elapsed_tick = downtown_marathon_elapsed_tick + _timediff
				if downtown_marathon_elapsed_tick >= 1
					downtown_marathon_elapsed_tick = downtown_marathon_elapsed_tick - 1
					downtown_marathon_seconds = downtown_marathon_seconds + 1
					if downtown_marathon_seconds >= 60
						downtown_marathon_seconds = 0
						downtown_marathon_minutes = downtown_marathon_minutes + 1
				marathon_time_text = "" + downtown_marathon_minutes + ":"
				if downtown_marathon_seconds < 10
					marathon_time_text = marathon_time_text + "0"
				marathon_time_text = marathon_time_text + downtown_marathon_seconds
				if downtown_marathon_overlay_flip
					downtown_marathon_overlay.Add(text=marathon_time_text)
					downtown_marathon_overlay_alt.Clear()
					downtown_marathon_overlay_flip = false
				else
					downtown_marathon_overlay_alt.Add(text=marathon_time_text)
					downtown_marathon_overlay.Clear()
					downtown_marathon_overlay_flip = true

			if downtown_state == 50
				if downtown_marathon_start_zone.Inside() && downtown_condition_bodypaint.Check()
					downtown_marathon_bodypaint_duration = downtown_marathon_bodypaint_duration + _timediff
					downtown_marathon_route_panel.SetGaugeProgress(downtown_marathon_bodypaint_duration / 3)
					if downtown_marathon_bodypaint_duration >= 3
						downtown_marathon_start_zone.SetVisible(false)
						DropItem(itemtype="Coat", position=_state.Position, compass=false)
						CollectItem(itemtype="Coat")
						marathon_coat_away = CreateList(stage="Apart", x=-1.84, y=0.00, z=-0.20, rx=0, ry=0, rz=0, rw=0)
						DropItem(itemtype="Coat", position=marathon_coat_away, compass=false)
						downtown_coat_moved = true
						downtown_marathon_elapsed_tick = 0
						downtown_marathon_minutes = 0
						downtown_marathon_seconds = 0
						downtown_marathon_overlay.SetFace(color=Color(1,1,1,1), dilate=0.3)
						downtown_marathon_overlay_alt.SetFace(color=Color(1,1,1,1), dilate=0.3)
						downtown_marathon_overlay.Clear()
						downtown_marathon_overlay_alt.Clear()
						downtown_marathon_overlay.Add(text="0:00")
						downtown_marathon_overlay_flip = false
						warning_sound.Play()
						# Activate every trap when the timed Marathon begins.
						downtown_marathon_trap_warning_panel.SetVisible(true)
						downtown_marathon_trap_pulse_timer = 0
						downtown_marathon_trap_pulse_radius = 1
						downtown_marathon_trap_pulse_direction = 1
						downtown_marathon_trap3_timer = 0
						downtown_marathon_trap3_index = 1
						downtown_marathon_trap3_direction = 1
						downtown_marathon_trap4_timer = 0
						downtown_marathon_trap4_index = 1
						downtown_marathon_trap4_direction = 1
						downtown_marathon_trap_player_inside = false
						downtown_marathon_punish_vibrator = 0
						downtown_marathon_punish_eyemask = 0
						downtown_marathon_punish_walk = 0
						downtown_marathon_punish_force_timer = 0
						downtown_marathon_trap1_r1_zone.SetVisible(true)
						downtown_marathon_trap5_r1_zone.SetVisible(true)
						downtown_marathon_trap2_zone.SetVisible(true)
						downtown_marathon_trap3a_zone.SetVisible(true)
						downtown_marathon_trap4a_zone.SetVisible(true)
						downtown_marathon_start_pos = Vector(_state.Position.x, _state.Position.y, _state.Position.z)
						downtown_marathon_dest_pos = Vector(-227.00, 0.18, -8.24)
						downtown_marathon_total_distance = Vector3Distance(downtown_marathon_start_pos, downtown_marathon_dest_pos)
						downtown_marathon_cp1_zone.SetVisible(true)
						downtown_marathon_route_panel.SetText("直线跑向第一个检查点：前方十字路口")
						downtown_marathon_route_panel.SetGaugeProgress(0)
						downtown_marathon_state = 51
						downtown_state = 51
				else
					downtown_marathon_bodypaint_duration = 0
					downtown_marathon_route_panel.SetGaugeProgress(0)

			# Marathon trap movement, entry detection, and independent 10-second punishments.
			if downtown_state >= 51 && downtown_state <= 54
				downtown_marathon_trap_pulse_timer = downtown_marathon_trap_pulse_timer + _timediff
				if downtown_marathon_trap_pulse_timer >= 1
					downtown_marathon_trap_pulse_timer = downtown_marathon_trap_pulse_timer - 1
					# Hide old pulse radius.
					if downtown_marathon_trap_pulse_radius == 1
						downtown_marathon_trap1_r1_zone.SetVisible(false)
						downtown_marathon_trap5_r1_zone.SetVisible(false)
					if downtown_marathon_trap_pulse_radius == 2
						downtown_marathon_trap1_r2_zone.SetVisible(false)
						downtown_marathon_trap5_r2_zone.SetVisible(false)
					if downtown_marathon_trap_pulse_radius == 3
						downtown_marathon_trap1_r3_zone.SetVisible(false)
						downtown_marathon_trap5_r3_zone.SetVisible(false)
					if downtown_marathon_trap_pulse_radius == 4
						downtown_marathon_trap1_r4_zone.SetVisible(false)
						downtown_marathon_trap5_r4_zone.SetVisible(false)
					if downtown_marathon_trap_pulse_radius == 5
						downtown_marathon_trap1_r5_zone.SetVisible(false)
						downtown_marathon_trap5_r5_zone.SetVisible(false)
					downtown_marathon_trap_pulse_radius = downtown_marathon_trap_pulse_radius + downtown_marathon_trap_pulse_direction
					if downtown_marathon_trap_pulse_radius >= 5
						downtown_marathon_trap_pulse_radius = 5
						downtown_marathon_trap_pulse_direction = -1
					if downtown_marathon_trap_pulse_radius <= 1
						downtown_marathon_trap_pulse_radius = 1
						downtown_marathon_trap_pulse_direction = 1
					if downtown_marathon_trap_pulse_radius == 1
						downtown_marathon_trap1_r1_zone.SetVisible(true)
						downtown_marathon_trap5_r1_zone.SetVisible(true)
					if downtown_marathon_trap_pulse_radius == 2
						downtown_marathon_trap1_r2_zone.SetVisible(true)
						downtown_marathon_trap5_r2_zone.SetVisible(true)
					if downtown_marathon_trap_pulse_radius == 3
						downtown_marathon_trap1_r3_zone.SetVisible(true)
						downtown_marathon_trap5_r3_zone.SetVisible(true)
					if downtown_marathon_trap_pulse_radius == 4
						downtown_marathon_trap1_r4_zone.SetVisible(true)
						downtown_marathon_trap5_r4_zone.SetVisible(true)
					if downtown_marathon_trap_pulse_radius == 5
						downtown_marathon_trap1_r5_zone.SetVisible(true)
						downtown_marathon_trap5_r5_zone.SetVisible(true)

				downtown_marathon_trap3_timer = downtown_marathon_trap3_timer + _timediff
				if downtown_marathon_trap3_timer >= 1.5
					downtown_marathon_trap3_timer = downtown_marathon_trap3_timer - 1.5
					if downtown_marathon_trap3_index == 1
						downtown_marathon_trap3a_zone.SetVisible(false)
					if downtown_marathon_trap3_index == 2
						downtown_marathon_trap3b_zone.SetVisible(false)
					if downtown_marathon_trap3_index == 3
						downtown_marathon_trap3c_zone.SetVisible(false)
					downtown_marathon_trap3_index = downtown_marathon_trap3_index + downtown_marathon_trap3_direction
					if downtown_marathon_trap3_index >= 3
						downtown_marathon_trap3_index = 3
						downtown_marathon_trap3_direction = -1
					if downtown_marathon_trap3_index <= 1
						downtown_marathon_trap3_index = 1
						downtown_marathon_trap3_direction = 1
					if downtown_marathon_trap3_index == 1
						downtown_marathon_trap3a_zone.SetVisible(true)
					if downtown_marathon_trap3_index == 2
						downtown_marathon_trap3b_zone.SetVisible(true)
					if downtown_marathon_trap3_index == 3
						downtown_marathon_trap3c_zone.SetVisible(true)

				downtown_marathon_trap4_timer = downtown_marathon_trap4_timer + _timediff
				if downtown_marathon_trap4_timer >= 2
					downtown_marathon_trap4_timer = downtown_marathon_trap4_timer - 2
					if downtown_marathon_trap4_index == 1
						downtown_marathon_trap4a_zone.SetVisible(false)
					if downtown_marathon_trap4_index == 2
						downtown_marathon_trap4b_zone.SetVisible(false)
					if downtown_marathon_trap4_index == 3
						downtown_marathon_trap4c_zone.SetVisible(false)
					if downtown_marathon_trap4_index == 4
						downtown_marathon_trap4d_zone.SetVisible(false)
					downtown_marathon_trap4_index = downtown_marathon_trap4_index + downtown_marathon_trap4_direction
					if downtown_marathon_trap4_index >= 4
						downtown_marathon_trap4_index = 4
						downtown_marathon_trap4_direction = -1
					if downtown_marathon_trap4_index <= 1
						downtown_marathon_trap4_index = 1
						downtown_marathon_trap4_direction = 1
					if downtown_marathon_trap4_index == 1
						downtown_marathon_trap4a_zone.SetVisible(true)
					if downtown_marathon_trap4_index == 2
						downtown_marathon_trap4b_zone.SetVisible(true)
					if downtown_marathon_trap4_index == 3
						downtown_marathon_trap4c_zone.SetVisible(true)
					if downtown_marathon_trap4_index == 4
						downtown_marathon_trap4d_zone.SetVisible(true)

				marathon_in_trap = false
				if downtown_marathon_trap_pulse_radius == 1 && (downtown_marathon_trap1_r1_zone.Inside() || downtown_marathon_trap5_r1_zone.Inside())
					marathon_in_trap = true
				if downtown_marathon_trap_pulse_radius == 2 && (downtown_marathon_trap1_r2_zone.Inside() || downtown_marathon_trap5_r2_zone.Inside())
					marathon_in_trap = true
				if downtown_marathon_trap_pulse_radius == 3 && (downtown_marathon_trap1_r3_zone.Inside() || downtown_marathon_trap5_r3_zone.Inside())
					marathon_in_trap = true
				if downtown_marathon_trap_pulse_radius == 4 && (downtown_marathon_trap1_r4_zone.Inside() || downtown_marathon_trap5_r4_zone.Inside())
					marathon_in_trap = true
				if downtown_marathon_trap_pulse_radius == 5 && (downtown_marathon_trap1_r5_zone.Inside() || downtown_marathon_trap5_r5_zone.Inside())
					marathon_in_trap = true
				if downtown_marathon_trap2_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap3_index == 1 && downtown_marathon_trap3a_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap3_index == 2 && downtown_marathon_trap3b_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap3_index == 3 && downtown_marathon_trap3c_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap4_index == 1 && downtown_marathon_trap4a_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap4_index == 2 && downtown_marathon_trap4b_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap4_index == 3 && downtown_marathon_trap4c_zone.Inside()
					marathon_in_trap = true
				if downtown_marathon_trap4_index == 4 && downtown_marathon_trap4d_zone.Inside()
					marathon_in_trap = true

				if marathon_in_trap && !downtown_marathon_trap_player_inside
					if downtown_marathon_punish_vibrator <= 0 || downtown_marathon_punish_eyemask <= 0 || downtown_marathon_punish_walk <= 0
						punish_pick = RandomInt(1,3)
						if punish_pick == 1 && downtown_marathon_punish_vibrator > 0
							punish_pick = 2
						if punish_pick == 2 && downtown_marathon_punish_eyemask > 0
							punish_pick = 3
						if punish_pick == 3 && downtown_marathon_punish_walk > 0
							punish_pick = 1
						if punish_pick == 1 && downtown_marathon_punish_vibrator > 0
							punish_pick = 2
						if punish_pick == 2 && downtown_marathon_punish_eyemask > 0
							punish_pick = 3
						if punish_pick == 1
							downtown_marathon_punish_vibrator = 10
						if punish_pick == 2
							downtown_marathon_punish_eyemask = 10
						if punish_pick == 3
							downtown_marathon_punish_walk = 10
					downtown_marathon_trap_player_inside = true
				if !marathon_in_trap
					downtown_marathon_trap_player_inside = false

