					if downtown_marathon_punish_walk <= 0
						SetAction("None")

			if downtown_state >= 51 && downtown_state <= 54
				marathon_distance = Vector3Distance(Vector(_state.Position.x, _state.Position.y, _state.Position.z), downtown_marathon_dest_pos)
