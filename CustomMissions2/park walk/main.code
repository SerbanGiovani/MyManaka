CreateRenSubtitleObject:
	obj = CreateText()
	obj.SetSize(30)
	obj.SetAnchor(0.5, 0.4)
	obj.SetFace(color=Color(0,0,0.6), dilate=0.4)
	obj.SetOutline(color=Color(1,1,1), width=0.2)
	obj.SetFrontLayer(true)
	_result = obj
	

subtitles_ren = CreateRenSubtitleObject()
subtitles_ren_interrupt = CreateRenSubtitleObject()

subtitles_manaka = CreateText()
subtitles_manaka.SetSize(30)
subtitles_manaka.SetAnchor(0.5,0.4)
subtitles_manaka.SetFace(color=Color(0.8,0.1,0.6), dilate=0.4)
subtitles_manaka.SetOutline(color=Color(1,1,1), width=0.2)
subtitles_manaka.SetFrontLayer(true)
subtitles_manaka_internal = CreateText()
subtitles_manaka_internal.SetSize(30)
subtitles_manaka_internal.SetAnchor(0.5,0.4)
subtitles_manaka_internal.SetFace(color=Color(0.4,0.1,0.3), dilate=0.4)
subtitles_manaka_internal.SetOutline(color=Color(1,1,1), width=0.2)
subtitles_manaka_internal.SetFrontLayer(true)

subtitles_generic = CreateText()
subtitles_generic.SetSize(30)
subtitles_generic.SetAnchor(0.5,0.4)
subtitles_generic.SetFace(color=Color(0.2,0.2,0.2), dilate=0.4)
subtitles_generic.SetOutline(color=Color(1,1,1), width=0.2)
subtitles_generic.SetFrontLayer(true)

subtitle_thread = CreateThread("subtitles_manager")
ecstasy_thread = CreateThread("ecstasy_manager")

bus_init:
	result = CreateList()
	result.flags = CreateList()
	_result = result
	
bus = bus_init()

chat = null
missionpanel = CreateMissionPanel()
	
zipsound = CreateAudio("zip.wav")
gaspsound = CreateAudio("gasp.wav")
orgasmsound = CreateAudio("orgasm.wav")
	
ren = null

rengender = null

globals = CreateList()

mainthread = CreateThread("main")

mp = CreateMissionPanel()

#DumpVariable(_state, 6)

gender_suffix:
	if rengender == "male"
		_result = ".male"
	elseif rengender == "female"
		_result = ".female"
	elseif rengender == "nonbinary"
		_result = ".nonbinary"
	else
		_result = null
		

main:
	thread = _this
	
	start_subtitles_and_wait:
		manager.Start(data=data)
		_result = CreateListenerLocal("subtitle_listener", manager=manager, nextstep=nextstep)
					
					
	
	thread.Goto("init")
	init:
		#DumpVariable(GetAllWaypoints(),3)
		
		Log("Creating chat")
		chat = CreateMessengerChat(loc("name_chat"), iconcolor = Color(0,1,0), icontext = "PB", icontextcolor = Color(1,1,1))	
		chat.Add(loc("main_chat_boss_001"), "Left", user=loc("name_boss"), silent=true)
		if (_save.checkpoint == null)
			_save.checkpoint = 0
			
		if _save.checkpoint == 0
			chat.SetButtons(loc("main_chat_button_001"))
		else
			chat.SetButtons(loc("main_chat_button_001"), loc("main_chat_button_002"))
			
		listener = CreateListenerLocal("waitforbuttoncheckpoint")
			
		waitforbuttoncheckpoint:
			if chat.Clicked() == 0
				chat.SetButtons()
				chat.Add(loc("main_chat_button_001"), "Right", user="Manaka", silent=true)
				_save.checkpoint = 0
				thread.Goto("start")
				
			elseif chat.Clicked() == 1
				chat.SetButtons()
				chat.Add(loc("main_chat_button_002"), "Right", user=loc("name_manaka"), silent=true)
				chat.Add(loc("main_chat_boss_002"), "Left", user=loc("name_boss"), silent=true)
				thread.Goto("start")
	
	
	
	start:			
		subtitle_thread.Init(bus=bus)
		ecstasy_thread.Init(bus=bus)
		ShowBlackscreen(fadein = 0.2, duration = 2, fadeout = 0.2)
		SetStage("Park")
		#CollectItem(itemtype="HandcuffKey")
		SetPlayerPosition(x=30.6, y=52, z=35)
		
		w = CreateListenerLocal("wait_listener", duration=0.5, nextcheckpoint="start_2")
		
	start_2:
		
		npc_types = CreateList()
		if _settings.ren_can_be_male
			npc_types.Insert("NewMale")
		if _settings.ren_can_be_female
			npc_types.Insert("NewFemale")
			
		if npc_types.Count() == 0
			npc_types = CreateList("NewFemale", "NewMale")
			
		ren_type = npc_types[ RandomInt(0, npc_types.Count()) ]
		
		rengender = get_gender(ren_type)
		
		if _settings.ren_non_binary == true
			rengender = "nonbinary"
		
		ren = CreateNPC(ren_type, position=Vector(71.57, 51.00, 57.53), rotation=Quaternion(0.00000, 0.87335, 0.00000, 0.48710))	
		ren.SkipStrangeness(true)
		ren.Smartphone(false)
		ren.Headset(false)
		ren.Speed(0.8)
				
		UnequipAdultToy("AnalPlug", "Vibrator", "EyeMask", "Handcuff", "KeyHandcuff", "TimerHandcuff", "TitRotor", "KuriRotor", "PistonFuta", "PistonAnal", "PistonPussy")
		UnlockHandcuffs()

		if _save.checkpoint != 0
			Log("Checkpoint " + _save.checkpoint)
			if _save.checkpoint == 1
				thread.Goto("checkpoint_1")
			elseif _save.checkpoint == 2
				thread.Goto("checkpoint_2")
			elseif _save.checkpoint == 3
				thread.Goto("checkpoint_3")
			elseif _save.checkpoint == 4
				thread.Goto("checkpoint_4")
			elseif _save.checkpoint == 5
				thread.Goto("checkpoint_5")
			elseif _save.checkpoint == 6
				thread.Goto("checkpoint_6")
		else
			thread.Goto("start_3")
		
	start_3:
		SetPlayerPosition(x=77.14, y=51.00, z=55.69, rx=0.00000, ry=0.99808, rz=0.00000, rw=0.06192)

		UnequipAllCosplay()
		EquipCosplay(CreateList("m_cosplay_general_upper_race_pants", "m_cosplay_suit_chic_stocking", "m_cosplay_suit_chic_shirt", "m_cosplay_suit_chic_jacket", "m_cosplay_suit_chic_card", "m_cosplay_suit_chic_skirt", "m_cosplay_suit_chic_shoes"))
		DropItem(itemtype="Coat", stage="Apart", x=1.8, y=0, z=0.5)
		
		chat.Add(loc("main_chat_boss_003"), "Left", user=loc("name_boss"), silent=true)
			
		w = CreateListenerLocal("chat_closed_listener", nextcheckpoint="start_4")
		
	start_4:
		Log("starto")
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("start_4_manaka_internal_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_4_manaka_002", suffix=gender_suffix())))
		#---Ren walks up from behind---
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_4_ren_003", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("start_4_manaka_internal_004", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_4_manaka_005", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_4_manaka_006", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_4_ren_007", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_4_manaka_008", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_4_manaka_009", suffix=gender_suffix())))
		
		
		
		wd = CreateList()
		wd.Insert(WP_Move(Position=Vector(76.16, 51.00, 55.08))) #path
		wd.Insert(WP_FacePlayerForever())
		
		subtitle_thread.Start(data=sd)
		subtitle_finished_listener = CreateListenerLocal("subtitle_listener", manager=subtitle_thread, nextstep = "start_5")
		
		npc_escort = CreateThread("escort_manager")
		npc_escort.StartEscort(data=wd, npc=ren, bus=bus)
		
	start_5:
	
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_5_ren_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_5_ren_002", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_5_ren_003", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_5_manaka_internal_004", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_5_manaka_005", suffix=gender_suffix())))
		sd.Insert(SP_WaitForMarker(marker="ren_walk_to_tree"))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_5_ren_006", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_5_manaka_007", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_5_ren_008", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("start_5_manaka_internal_009", suffix=gender_suffix())))
		sd.Insert(SP_WaitForMarker(marker="tree_walk_done"))
		
		wd = CreateList()
		wd.Insert(WP_Move(Position=Vector(80.06, 50.05, 39.56))) #path
		wd.Insert(WP_EmitMarker(marker="ren_walk_to_tree"))
		wd.Insert(WP_Move(Position=Vector(83.76, 50.64, 23.63))) #tree
		wd.Insert(WP_EmitMarker(marker="tree_walk_done"))
		wd.Insert(WP_FacePlayerForever())
		
		subtitle_thread.Start(data=sd)
		subtitle_finished_listener = CreateListenerLocal("subtitle_listener", manager=subtitle_thread, nextstep = "start_6")
		
		npc_escort = CreateThread("escort_manager")
		npc_escort.StartEscort(data=wd, npc=ren, max_distance=5, resume_distance=4, subtitles=subtitles_ren, interrupt_subtitle=subtitles_ren_interrupt, bus=bus)
		
	start_6:
		sd = CreateList(
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("start_6_manaka_internal_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_6_manaka_002", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_6_ren_003", suffix=gender_suffix())))
		#---Ren pulls out the cuffs.---
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_6_manaka_004", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("start_6_ren_005", suffix=gender_suffix())))
		#---Ren steps closer---
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("start_6_manaka_006", suffix=gender_suffix())))

		
		subtitle_thread.Start(data=sd)
		subtitle_finished_listener = CreateListenerLocal("subtitle_listener", manager=subtitle_thread, nextstep = "undress_1")
		
		npc_escort = CreateThread("escort_manager")
		npc_escort.StartEscort(data=CreateList(WP_FacePlayerForever()), max_distance=1.5, resume_distance=1, interrupt_subtitle=subtitles_ren_interrupt, npc=ren, face_player_when_waiting=true)
		
	checkpoint_1:
		ren.Warp(position=Vector(83.76, 50.64, 23.63), rotation=Quaternion(0.00000, 0.99038, 0.00000, -0.13835))
		
		SetPlayerPosition(x=85.08, y=50.56, z=23.02, rx=0.00000, ry=-0.38852, rz=0.00000, rw=0.92144)
		
		UnequipAllCosplay()
		EquipCosplay(CreateList("m_cosplay_general_upper_race_pants", "m_cosplay_suit_chic_stocking", "m_cosplay_suit_chic_shirt", "m_cosplay_suit_chic_jacket", "m_cosplay_suit_chic_card", "m_cosplay_suit_chic_skirt", "m_cosplay_suit_chic_shoes"))
		DropItem(itemtype="Coat", stage="Apart", x=1.8, y=0, z=0.5)
		
		w = CreateListenerLocal("chat_closed_listener", nextcheckpoint="undress_1")
	
	
	undress_1:
		wd = CreateList()
		wd.Insert(WP_FacePlayer())
		
		npc_escort = CreateThread("escort_manager")
		npc_escort.StartEscort(data=wd, npc=ren)
		
		_save.checkpoint = 1
		mp.SetText(loc("undress_1_settext_001"))
		mp.SetVisible(true)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_1_ren_001", suffix=gender_suffix())))
		#---Manaka reluctantly removes her jacket.---
		subtitle_thread.Start(data=sd)
		
		npc_escort = CreateThread("escort_manager")
		npc_escort.StartEscort(data=CreateList(WP_FacePlayerForever()), max_distance=1.5, resume_distance=1, interrupt_subtitle=subtitles_ren_interrupt, npc=ren, face_player_when_waiting=true)
		
		jacket_prompt = CreateInteractArea(stage = "Park", x=85.08, y=50.56, z=23.02, r=0.3, text=loc("undress_1_interact_area_001"))
		
		condition = CreateCondition("!Cosplay_m_cosplay_suit_chic_jacket")
		
		double_condition:
			if jacket_prompt.Check()
				UnequipCosplay("m_cosplay_suit_chic_jacket")
		
			if condition.Check()
				thread.Goto("undress_2")
				
		w = CreateListenerLocal("double_condition")
		
	undress_2:
		mp.SetVisible(false)
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_2_manaka_001", suffix=gender_suffix())))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="undress_3")
		
	undress_3:
		mp.SetText(loc("undress_3_settext_002"))
		mp.SetVisible(true)
		prompt = CreateInteractArea(stage = "Park", x=84.12, y=50.62, z=23.50, r=0.3, text=loc("undress_3_interact_area_002"))
		
		double_condition:
			if prompt.Check()
				LockHandcuffs(handcuffstype="TimerHandcuff", duration=999)
				thread.Goto("undress_5")
				
		w = CreateListenerLocal("double_condition")
		
		
	undress_5:
		mp.SetText(loc("undress_5_settext_003"))
		mp.SetVisible(true)
		prompt = CreateInteractArea(stage = "Park", x=85.08, y=50.56, z=23.02, r=0.3, text=loc("undress_5_interact_area_003"))
		
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_5_ren_001", suffix=gender_suffix())))
		subtitle_thread.Start(data=sd)
		
		double_condition:
			if prompt.Check()
				SetPlayerPosition(x=85.02, y=50.59, z=23.17, rx=0.00000, ry=0.99386, rz=0.00000, rw=-0.11065)
				UnlockHandcuffs()
				LockHandcuffs(handcuffstype="TimerHandcuff", attachtoobject=true, duration=999)
				thread.Goto("undress_6")
				
		w = CreateListenerLocal("double_condition")
		
	undress_6:
	
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_6_ren_001", suffix=gender_suffix())))
		sd.Insert(SP_Blackout(delay = 1, duration=9, fadeout=0))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_6_manaka_002", suffix=gender_suffix())))
		sd.Insert(SP_EmitMarker(marker="ren_approach"))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_6_ren_003", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("undress_6_manaka_internal_004", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("undress_6_manaka_internal_005", suffix=gender_suffix())))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="undress_8")
		
		npc_escort = CreateThread("escort_manager")
		wd = CreateList()
		wd.Insert(WP_WaitForMarker(marker="ren_approach"))
		wd.Insert(WP_Move(Position=Vector(84.51, 50.47, 22.67)))
		wd.Insert(WP_FacePlayer())
		wd.Insert(WP_Move(Position=Vector(84.83, 50.52, 22.83)))
		wd.Insert(WP_FacePlayerForever())
		npc_escort.StartEscort(data=wd, npc=ren, face_player_when_waiting=true)
		
		
	undress_7:

		mp.SetVisible(false)
		sd = CreateList()

		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_7_manaka_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_7_ren_002", suffix=gender_suffix())))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="undress_8")
		
	undress_8:
		zipsound.Play()
		UnequipCosplay("m_cosplay_suit_chic_skirt")
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_8_ren_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("undress_8_manaka_internal_002", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_8_manaka_003", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_8_ren_004", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_8_manaka_internal_005", suffix=gender_suffix())))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="undress_9")
		
	undress_9: 
