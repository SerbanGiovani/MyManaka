		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_9_manaka_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_9_ren_002", suffix=gender_suffix())))
