		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_9_manaka_internal_004", suffix=gender_suffix())))
		listener = start_subtitles_and_wait(data=sd, manager=subtitle_thread, nextstep="undress_10")
	
	undress_10:
		UnequipCosplay("m_cosplay_suit_chic_stocking")
		sd = CreateList()
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_10_ren_001", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka_internal, data=tr("undress_10_manaka_internal_002", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_10_manaka_003", suffix=gender_suffix())))
