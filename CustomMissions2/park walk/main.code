		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_10_ren_004", suffix=gender_suffix())))
		sd.Insert(SP_WaitForMarker(marker="ren_is_back"))
		
		#---Ren looks her over, standing in the moonlight---
		sd.Insert(SP_Message(subtitle=subtitles_ren, data=tr("undress_10_ren_005", suffix=gender_suffix())))
		sd.Insert(SP_Message(subtitle=subtitles_manaka, data=tr("undress_10_manaka_006", suffix=gender_suffix())))
