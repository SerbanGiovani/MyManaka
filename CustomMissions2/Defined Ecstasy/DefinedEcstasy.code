		# it's not perfect but seems that the natural Log get's pretty close to the real drop off mechanic
		#if !noDecay && prevDecay # if just stopped ecstasy gain from default game mechanics (masturbations)
		#	time2 = 0
		#	#Log("Time 2 = 0")
		#if time2 < 10.5 # don't apply full correction for 10.5 seconds
		#	val = 2.71828182846 * (time2 / 10.5)
		#	if val > 1
		#		correction = LogN(val) / 20
		#	else
		#		correction = 0
		#	#Log("correction = "+correction)
		#else #(0.05 is the rate of ecstasy drop / delta time of the game by default, so we need to compensate for it)
		#	correction = 0.05

		multipliers = 1
		i = 0
		while i < gnrlMult.Count()
			multipliers = multipliers * gnrlMult[i]
			i = i + 1

		finalEcstasy = 0
		anyModifier = false
		i = 0
		while i < nrOfModifiers
			if modifier[i] != null
				ecstasy[i] = (modifier[i] * 3 * multipliers) / 100000
				if i > 0
					ecstasy[i] = ecstasy[i] * cospMult[0]
				finalEcstasy = finalEcstasy + ecstasy[i]
				anyModifier = true
			i = i + 1

		crtEcstasy = GetEcstasy()
		if anyModifier	
			if _state.Orgasm
				time = 0
			elseif time > 0.2
				#if !noDecay
				#	finalEcstasy = (correction * _timediff) + finalEcstasy
				if prevEcstasy > crtEcstasy # there is at least one active modifier so don't let ecstasy drop
					SetEcstasy(prevEcstasy)
				AddEcstasy(finalEcstasy)

		crtEcstasy = GetEcstasy()
		if ((crtEcstasy > prevEcstasy) && _settings.multiplier_active)
			ecstasyGain = (crtEcstasy - prevEcstasy) * _settings.multiplier
			SetEcstasy(prevEcstasy + ecstasyGain)


		time = time + _timediff
		time2 = time2 + _timediff
		prevEcstasy = GetEcstasy()
		prevDecay = noDecay
		noDecay = false






