part4 = CreateThread("part4")

part4:
	thread = _this
	
	missionpanel = CreateMissionPanel()
	mp:
		if text == null
			missionpanel.SetVisible(false)
		else
			missionpanel.SetVisible(true)
			missionpanel.SetText(text)
		if progress == null
			missionpanel.SetGaugeVisible(false)
		else
			missionpanel.SetGaugeVisible(true)
			missionpanel.GetGaugeProgress(progress)
		if rp == null
			rp = ""
		else
			missionpanel.SetRPText(rp)
	
	cameraClick = CreateAudio("sound\\camera.ogg")
	clothesFold = CreateAudio("sound\\clothes.ogg")
	moanLong = CreateAudio("sound\\moaning.ogg")
	boobGrope = CreateAudio("sound\\squeak.ogg")
	
	listNPC = CreateList()
	mei = null
	meiListener = null
	witnesses = CreateList()
	
	easy_mode = false
	listenNPC = null
	listenWitness = null
	listenTimer = null
	listenStalker = null
	
	condition_none = CreateCondition("[]")
	gloves = CreateList(get=false,name="gloves",color="red")
	harness = CreateList(get=false,name="harness",color="red")
	garter = CreateList(get=false,name="garter",color="red")
	stockings = CreateList(get=false,name="stockings",color="red")
	shoes = CreateList(get=false,name="shoes",color="red")
	used_pos = CreateList()
	
	zStart = CreateList(x=-29.4,y=-0.09,z=-117.4,r=0.5)
	zMeiSpawn = CreateList(x=-28.5,y=-0.09,z=-117.4,r=0.5)
	zStreetLamp = CreateList(x=5.9,y=-0.1,z=-103.25,r=0.5)
	zMeiTouch = CreateList(x=6.5,y=-0.10,z=-103.1,r=0.5)
	zGuySpawn = CreateList(x=7.7,y=-0.10,z=-103.1,r=0.5)
	zWomanSpawn = CreateList(x=7.1,y=-0.10,z=-101.8,r=0.5)
	zOldSpawn = CreateList(x=5.8,y=-0.10,z=-101.3,r=0.5)
	
	
	DropClothesAtRandom:
		clothes = _args[0]
		nb = _args[1]
		
		ok = false
		while !ok
			ok = true
			clothes.pos = GetRandomPosition(20)
			x = Round(clothes.pos.x)
			z = Round(clothes.pos.z)
			if used_pos[x] != null
				if used_pos[x][z] != null
					ok = false
					Log(clothes.name+" : Redrawing random position, "+x+"/"+z+" already used by "+used_pos[x][z])
		if used_pos[x] == null
			used_pos[x] = CreateList()
		used_pos[x][z] = clothes.name
		Log(clothes.name+" : Dropped on position "+x+"/"+z)
		
		clothes.hud = CreateHUD(0.005, 0.35-(0.03*nb))
		clothes.label = CreateHUDlabel(0.02, 0.35-(0.03*nb), "Clothing "+nb)
		clothes.area = CreateArea(type="sphere",stage="Residence",x=clothes.pos.x,y=clothes.pos.y-0.02,z=clothes.pos.z,r=0.5,compass=easy_mode)
		clothes.zone = CreateZone(clothes.area)
		clothes.listener = CreateListener("scavenger_travellistener",zone=clothes.zone,thread=thread,clothes=clothes,nextcp="cp_"+clothes.name)
	
	watchNPCs:
		if _state.Position.stage != "Apart"
			i = _state.NPCs.Count()
			while i > 0
				i -= 1
				
				# Each NPC that spawns get flagged with custom variables
				id = _state.NPCs[i].ID
				if listNPC[id] == null
					if debug
						Log("[ExhibUrges4] NPC " + id + " registered ")
					npc_temp = CreateNPC(id)
					listNPC[id] = CreateList(npc=npc_temp, duration=-1, prevStrange=0, stalker=false)
	
	npcTimer:
		i = _state.NPCs.Count()
		while i > 0
			i -= 1
			id = _state.NPCs[i].ID
			if listNPC[id].duration >= 0
				listNPC[id].duration += _timediff
				# NPC stops being shocked
				if id != havingSex && listNPC[id].duration >= 3
					if debug
						Log("[ExhibUrges4] NPC " + id + " is following")
					listNPC[id].duration = -1
					listNPC[id].stalker = true
					listNPC[id].npc.Speed(1.2)
					listNPC[id].npc.Smartphone(true)
					listNPC[id].npc.TracePlayer(true)
	
	npcWitness:
		if _state.FoundNPC != -1
			if debug
				Log("[ExhibUrges4] NPC " + _state.FoundNPC + " is a witness")
			# Must do this, if they follow without delay they get locked in the shocked animation and move to you like on rollerskates
			#listNPC[_state.FoundNPC].npc.TracePlayer(true)
			listNPC[_state.FoundNPC].duration = 0
	
	
	caughtByNPC:
		i = _state.NPCs.Count()
		while i > 0
			i -= 1
			id = _state.NPCs[i].ID
			
			if listNPC[id].stalker
			
				# Lose them by getting away
				if Vector3Distance(_state.Position, listNPC[id].npc.GetPosition()) > 30
					if debug
						Log("[ExhibUrges4] Stalker " + id + " lost you")
					listNPC[id].stalker = false
					listNPC[id].npc.Speed(1)
					listNPC[id].npc.Smartphone(false)
					listNPC[id].npc.TracePlayer(false)
				
				# Not the thrall, or you're in the light
				if Vector3Distance(_state.Position, listNPC[id].npc.GetPosition()) < 2
					if debug
						Log("[ExhibUrges4] Stalker " + id + " reaches you")
					
					# Picture!
					ShowBlackscreen(color=Color(1,1,1,0.8), fadein=0, duration=0.1, fadeout=0.3)
					cameraClick.Play()
					
					#Comment
					subtitleMind.Clear()
					if listNPC[id].npc.GetType()=="NewMale" || listNPC[id].npc.GetType()=="PreviousMale" || listNPC[id].npc.GetType()=="NewOji"
						he = "He"
						his = "his"
					else
						he = "She"
						her = "her"
					
					pos = _state.Position
					dirPlayer = Vector(2*pos.rw*pos.ry, 0, 1-2*pos.ry*pos.ry)
					pos = listNPC[id].npc.GetPosition()
					dirNPC = Vector(2*pos.rw*pos.ry, 0, 1-2*pos.ry*pos.ry)
					dir = Vector3Dot(dirPlayer, dirNPC)
					
					if dir < -0.4
						rng = RandomInt(2)
						if rng == 0
							subtitleMind.Add(text="("+he+" took a close-up of my pussy...)", delay=1, fadein=0.2, duration=3, fadeout=0.3)
						else
							subtitleMind.Add(text="(This is so humiliating... Why am I so wet?)", delay=1, fadein=0.2, duration=4, fadeout=0.3)
					elseif dir > 0.4
						rng = RandomInt(2)
						if rng == 0
							subtitleMind.Add(text="(Another picture of me butt naked on the loose...)", delay=1, fadein=0.2, duration=4, fadeout=0.3)
						else
							subtitleMind.Add(text="(Trop taking pictures of my butt, you have one too!)", delay=1, fadein=0.2, duration=4, fadeout=0.3)
					else
						rng = RandomInt(2)
						if rng == 0
							subtitleMind.Add(text="(I feel my nipples hardening... And now it's in "+his+" camera too!)", delay=1, fadein=0.2, duration=4, fadeout=0.3)
						else
							subtitleMind.Add(text="(That one was aimed at my boobs...)", delay=1, fadein=0.2, duration=3, fadeout=0.3)
					
					# Make the NPC get lost
					listNPC[id].stalker = false
					listNPC[id].npc.Speed(1)
					rng = RandomInt(2)
					if rng == 0
						listNPC[id].npc.Smartphone(false)
					listNPC[id].npc.TracePlayer(false)
	
	
	cp1:
		CanGameOver(false)
		SetStage("Residence",daytime=false)
		
		listener = CreateListenerLocal("wait_listener",duration=1,nextcp="cp2")
		#listener = CreateListenerLocal("wait_listener",duration=1,nextcp="test")
	
	test:
		clothesFold.Play()
		UnequipAllCosplay()
		DropItem(itemtype="Coat", stage="Apart",x=3.4,y=0,z=2.5)
		SetPlayerPosition(position=Vector(zStart.x, zStart.y, zStart.z))
