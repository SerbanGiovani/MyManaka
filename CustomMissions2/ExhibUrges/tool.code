		if missionpanel.GetGaugeProgress()>= 0.09 & missionpanel.GetGaugeProgress()< 0.1
			subtitle.Clear()
			subtitleB.Clear()
		if missionpanel.GetGaugeProgress()>= 0.1 & missionpanel.GetGaugeProgress()< 0.29
			subtitle.Add(text=text1)
	if text2 != null		
		if missionpanel.GetGaugeProgress()>= 0.29 & missionpanel.GetGaugeProgress()< 0.3
			subtitle.Clear()
			subtitleB.Clear()
		if missionpanel.GetGaugeProgress()>= 0.3 & missionpanel.GetGaugeProgress()< 0.49
			subtitle.Add(text=text2)
	if text3 != null	
		if missionpanel.GetGaugeProgress()>= 0.49 & missionpanel.GetGaugeProgress()< 0.5
			subtitle.Clear()
			subtitleB.Clear()
		if missionpanel.GetGaugeProgress()>= 0.5 & missionpanel.GetGaugeProgress()< 0.69
			subtitle.Add(text=text3)
	if text4 != null	
		if missionpanel.GetGaugeProgress()>= 0.69 & missionpanel.GetGaugeProgress()< 0.7
			subtitle.Clear()
			subtitleB.Clear()
		if missionpanel.GetGaugeProgress()>= 0.7 & missionpanel.GetGaugeProgress()< 0.89
			subtitle.Add(text=text4)
	if text5 != null	
		if missionpanel.GetGaugeProgress()>= 0.89 & missionpanel.GetGaugeProgress()< 0.9
			subtitle.Clear()
			subtitleB.Clear()
		if missionpanel.GetGaugeProgress()>= 0.9 & missionpanel.GetGaugeProgress()< 0.99
			subtitle.Add(text=text5)	
	if missionpanel.GetGaugeProgress()>= 0.99 & missionpanel.GetGaugeProgress()< 1.0
		subtitle.Clear()
		subtitleB.Clear()


basic_travellistener:
	missionpanel.SetGaugeVisible(true)
	if violated == null
		violated = false
		missionpanel.SetGaugeProgress(0)		
	if zone.Inside() & !violated
		missionpanel.SetVisible(false)
		if sclear == null
			subtitle.Clear()
		if nextparameters != null
			thread.Goto(nextcp, parameters=nextparameters)
		else
			thread.Goto(nextcp)
	elseif lastzone.Inside()
		if violated
			violated = false
			zone.SetColor(1,0.75,0.5)
			zone.SetVisible(true)
			lastzone.SetVisible(false)
			missionpanel.SetText(text)
			missionpanel.SetGaugeProgress(0)
	elseif (!condition.Check())
		if !violated
			violated = true
			lastzone.SetColor(1,0.5,0.5)
			lastzone.SetVisible(true)
			zone.SetVisible(false)
			missionpanel.SetText(violatetext)
			missionpanel.SetGaugeProgress(0)
	else
		dlast = lastzone.DistanceToLastPosition()
		dnext = zone.DistanceToNearest()
		if (dlast != null)
			missionpanel.SetGaugeProgress(dlast/(dlast+dnext))


scavenger_travellistener:
	if zone.Inside()
		thread.Goto(nextcp)
	else
		#Can't refresh the text withing the same frame as the Clear()
		if clothes.color != clothes.queue && clothes.queue != null
			#Log(clothes.name+" : "+clothes.queue)
			clothes.hud.SetFace(color=colors[clothes.queue])
			clothes.hud.Add(text="●")
			clothes.color = clothes.queue
			clothes.queue = null
		
		dist = zone.DistanceToNearest()
		if dist < 10
			if clothes.color != "green"
				clothes.queue = "green"
				clothes.hud.Clear()
		elseif dist > 30
			if clothes.color != "red"
				clothes.queue = "red"
				clothes.hud.Clear()
		else
			if clothes.color != "orange"
				clothes.queue = "orange"
				clothes.hud.Clear()


wait_listener:
	if time == null
		time = 0
	time = time + _timediff
	if time>duration
		missionpanel.SetVisible(false)
		ClearAllSubs()
		if nextparameters != null
			thread.Goto(nextcp, lastzone = zone, parameters=nextparameters)
		else
			thread.Goto(nextcp, lastzone = zone) 
			
timelimit_listener:
	if zone.Inside()
		if condition.Check()
			if time == null
				time = 0
			time = time + _timediff
			if time>duration
				missionpanel.SetVisible(false)
				subtitle.Clear()
				if nextparameters != null
					thread.Goto(nextcp, lastzone = zone, parameters=nextparameters)
				else
					thread.Goto(nextcp, lastzone = zone) 
			
			
int_listener:
