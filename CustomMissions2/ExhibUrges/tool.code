gallery_listener:
	choice = chat.Clicked()
	if choice != null
		if choice == 0
			gallery.Show()
		elseif choice == 1
			gallery1.Show()
		
			
confirmed_listener:
	if gallery.Confirmed()
		selection = gallery.GetSelection()
		if selection.Count() > 0
			image = selection[0]
			subtitle.Clear()
			chat.SetButtons()
			thread.Goto(nextcp, image=image)
		else
			return
	if gallery1 != null
		if gallery1.Confirmed()
			selection = gallery1.GetSelection()
			if selection.Count() > 0
				image = selection[0]
				subtitle.Clear()
				chat.SetButtons()
				thread.Goto(nextcp1, image=image)
			else
				return

		
inthandcuff_listener:
	if duration == null
		duration = 0
	duration = duration + _timediff
	if duration < 1
		LockHandcuffs(handcuffstype="Handcuff",attachtoobject=true)
	else
		return

keephandcuff_listener:
	LockHandcuffs(handcuffstype="Handcuff",attachtoobject=true)
	
distance_listener:
	if !initialized
		prevPosition = _state.Position
		distance = 0
		progress = 0
		initialized = true
		return
	if zone.Inside()
		if condition.Check()
			missionpanel.SetGaugeVisible(true)
			position = _state.Position 
			if prevPosition != null
				d = Vector3Length(Vector3Sub(position, prevPosition))
				distance = distance + d
				progress = distance / target
				if progress > 1
					progress = 1

				missionpanel.SetGaugeProgress(progress)
				prevPosition = position
				if distance >= target
					missionpanel.SetVisible(false)
					subtitle.Clear()
					thread.Goto(nextcp)
		else
			if reset
				distance = 0
				progress = 0
				missionpanel.SetGaugeProgress(0)
			prevPosition = _state.Position
			
leavedistance_listener:
	if !initialized
		dropPos = _state.Position
		initialized = true
		return
	currentPos = _state.Position
	d = Vector3Length(Vector3Sub(currentPos, dropPos))
	progress = d / targetDist
	if progress > 1
		progress = 1
	missionpanel.SetGaugeVisible(true)
	missionpanel.SetGaugeProgress(progress)
	if d >= targetDist
		missionpanel.SetVisible(false)
		subtitle.Clear()
		thread.Goto(nextcp)
		
DistanceSubtitle_listener:
	currentPos = _state.Position
	diff = Vector3Sub(targetPos, currentPos)
	remain = Vector3Length(diff)
	if text1 != null
		if !shown1
			if remain <= D1+0.5
				subtitle.Clear()
			if remain <= D1
				subtitle.Add(text=text1,duration=keep1)
				shown1 = true
	if text2 != null
		if !shown2
			if remain <= D2+0.5
				subtitle.Clear()
			if remain <= D2
				subtitle.Add(text=text2,duration=keep2)
				shown2 = true
