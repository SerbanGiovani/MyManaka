travelListeners = CreateList()

getZone:
	getArea = CreateArea(type="sphere", stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y, z=_state.Position.z, r=0.8)
	getzone = CreateZone(getArea)
	getzone.SetVisible(false)
	_result = getzone

colors = CreateList(red=Color(1,0,0,1), orange=Color(1,0.5,0,1), green=Color(0,0.6,0,1))

subtitle = CreateSubs()
subtitleMind = CreateSubs(Color(0.7,0.7,0.7,1))
subtitleMei = CreateSubs(Color(1,0.5,0,1))
subtitleDeliv = CreateSubs(Color(0,0.6,0,1))
subtitleClerk = CreateSubs(Color(0.3,1,1,1))
subtitleGirl = CreateSubs(Color(1,0.4,0.7,1))
subtitleGuy = CreateSubs(Color(1,1,0.4,1))
subtitleWoman = CreateSubs(Color(0.7,0.2,1,1))
subtitleThug = CreateSubs(Color(0.9,0.1,0.1,1))
subtitleOld = CreateSubs(Color(0.3,0.3,1,1))

subtitleB = CreateText()
subtitleB.SetSize(36)
subtitleB.SetAnchor(0.2,0.126)
subtitleB.SetAlignment("TopLeft")
subtitleB.SetWidth(830)
subtitleB.SetFace(dilate=0.3)
subtitleB.SetOutline(width=0.2)
subtitleB.SetFrontLayer(true)

CreateSubs:
	subs = CreateText()
	subs.SetSize(30)
	subs.SetAnchor(0.2,0.126)
	subs.SetAlignment("TopLeft")
	subs.SetWidth(830)
	subs.SetOutline(width=0.2)
	if _args[0]==null
		subs.SetFace(dilate=0.3)
	else
		subs.SetFace(color=_args[0],dilate=0.3)
	subs.SetOutline(color=Color(0.06,0.06,0.06,1),width=0.3)
	subs.SetFrontLayer(true)
	_result = subs

CreateHUD:
	x = _args[0]
	y = _args[1]
	subs = CreateText()
	subs.SetSize(24)
	subs.SetAnchor(x,y)
	subs.SetAlignment("TopLeft")
	subs.SetWidth(1024)
	subs.SetOutline(width=0.2)
	subs.SetFace(color=colors.red,dilate=0.3)
	subs.SetOutline(color=Color(0.06,0.06,0.06,1),width=0.3)
	subs.SetFrontLayer(true)
	subs.Add(text="●")
	_result = subs

CreateHUDlabel:
	x = _args[0]
	y = _args[1]
	text = _args[2]
	subs = CreateText()
	subs.SetSize(24)
	subs.SetAnchor(x,y)
	subs.SetAlignment("TopLeft")
	subs.SetWidth(1024)
	subs.SetOutline(width=0.2)
	subs.SetFace(dilate=0.3)
	subs.SetOutline(color=Color(0.06,0.06,0.06,1),width=0.3)
	subs.SetFrontLayer(true)
	subs.Add(text=text)
	_result = subs

ClearAllSubs:
	subtitle.Clear()
	subtitleMind.Clear()
	subtitleMei.Clear()
	subtitleDeliv.Clear()
	subtitleClerk.Clear()
	subtitleGirl.Clear()
	subtitleGuy.Clear()
	subtitleWoman.Clear()
	subtitleThug.Clear()
	subtitleOld.Clear()

MoveNPC:
	if npc.IsAlive()
		npc.Stopped(false)
		npc.ClearWaypoints()
		if rotation != null || nextcp != null
			travelListeners[npc.GetID()] = CreateListener("travel_listener",npc=npc,position=coord,rotation=rotation,thread=thread,nextcp=nextcp)
		npc.AddWaypoint(coord)

IsNearArea:
	entity = _args[0]
	zone = _args[1]
	margin = 0.17
	#if entity.x == zone.x && entity.y == zone.y && entity.z == zone.z
	#Log("NPC : x="+entity.x+" / y="+entity.y+" / z="+entity.z)
	#Log("ZON : x="+zone.x+" / y="+zone.y+" / z="+zone.z)
	if entity.x > zone.x-margin && entity.x < zone.x+margin && entity.y > zone.y-margin && entity.y < zone.y+margin && entity.z > zone.z-margin && entity.z < zone.z+margin
		#Log("OK")
		_result = true
	else
		_result = false

#Unusable because it SOMEHOW returns an object. Copy/pasting the same code outside a function works fine. WTF
FacingPlayer:
	npc = _args[0]
	pos = _state.Position
	dirPlayer = Vector(2*pos.rw*pos.ry, 0, 1-2*pos.ry*pos.ry)
	pos = npc.GetPosition()
	dirNPC = Vector(2*pos.rw*pos.ry, 0, 1-2*pos.ry*pos.ry)
	_return = Vector3Dot(dirPlayer, dirNPC)

CreateMei:
	#temp_npc = CreateNPC("PreviousFemale", position=position, rotation=rotation, body=3, size=0.9, face=1, hair=0)
	temp_npc = CreateNPC("NewFemale", position=position, rotation=rotation, body=0, size=0.9, face=6, hair=3)
	temp_npc.Smartphone(false)
	temp_npc.Headset(false)
	temp_npc.Glasses(true)
	temp_npc.SkipStrangeness(true)
	temp_npc.Speed(1.4)
	_result = temp_npc


npc_follow_listener:
	if npc.IsAlive()
		if !npc.Stopped()
			if Vector3Distance(_state.Position, npc.GetPosition()) < distance-0.1
				npc.TracePlayer(false)
				npc.Stopped(true)
		else
			if Vector3Distance(_state.Position, npc.GetPosition()) > distance+0.1
				npc.TracePlayer(true)
				npc.Stopped(false)

npc_lead_listener:
	if npc.IsAlive()
		if !npc.Stopped()
			if Vector3Distance(_state.Position, npc.GetPosition()) > distance+0.1
				npc.Stopped(true)
				
				dir = Vector3Sub(_state.Position, npc.GetPosition())
				angle_deg = yaw_from_direction(dir)
				half = (angle_deg * PI / 180) * 0.5
				dir = Quaternion(0, Sin(half), 0, Cos(half))
				npc.Warp(rotation=dir)
		else
			if Vector3Distance(_state.Position, npc.GetPosition()) < distance-0.1
				npc.Stopped(false)

travel_listener:
	if !npc.IsAlive()
		if nextcp != null
			thread.Goto(nextcp)
		travelListeners[npc.GetID()] = null
	else
		#pos = npc.GetPosition()
		#Log(pos.y)
		if IsNearArea(npc.GetPosition(), position)
			npc.Stopped(true)
			if rotation != null
				npc.Warp(rotation=rotation)
			if nextcp != null
				ClearAllSubs()
				thread.Goto(nextcp)
			travelListeners[npc.GetID()] = null


PI = 3.14159

atan2: #(y, x) 
	if y == null
		y = _args[0]
		x = _args[1]
		
	if x > 0
		_result = Atan(y / x) 
		
	elseif x < 0
		if y >= 0
			_result = Atan(y / x) + PI 
		else 
			_result = Atan(y / x) - PI 
	else # x == 0 
		if y > 0
			_result = PI / 2 
		elseif y < 0
			_result = -PI / 2 
		else
			_result = 0 # undefined, but fine

yaw_from_direction: #dir
	dir = _args[0]
	
	# dir.x and dir.z define the horizontal direction
	
	yaw_rad = atan2(dir.x, dir.z)
	_result = yaw_rad * 180 / PI


basic_listener:
	if panelmode == null
		panelmode = 0
	if duration == null
		duration = 0
	if maxduration == null
		maxduration = 0
		missionpanel.SetGaugeVisible(false)
	else
		missionpanel.SetGaugeVisible(true)
	if reset == null
		reset = true
	if zone.Inside()
		if panelmode == 2
			missionpanel.SetVisible(true)
		if condition.Check()
			if panelmode == 1
				missionpanel.SetVisible(true)
			duration = duration + _timediff
			zone.SetColor(0.5,1,0.5)
			if duration >= maxduration
				missionpanel.SetVisible(false)
				if nextcp != null
					if sclear == null
						subtitle.Clear()
					if nextparameters != null
						thread.Goto(nextcp, lastzone = zone, parameters=nextparameters)
					else
						thread.Goto(nextcp, lastzone = zone)
		else
			if reset
				duration = 0
			zone.SetColor(1,1,0.5)
		if maxduration>0
			missionpanel.SetGaugeProgress(duration/maxduration)
		
	else
		zone.SetColor(1,0.75,0.5)
		if panelmode >= 1
			missionpanel.SetVisible(false)
		if reset
			duration = 0
	
	
add_ecstasy_listener:
	missionpanel.SetVisible(true)
	missionpanel.SetGaugeVisible(true)
	ecstasy = GetEcstasy()
	ecstasy += ecstasy_add
	SetEcstasy(ecstasy)
	progress = ecstasy / ecstasy_goal
	missionpanel.SetGaugeProgress(progress)
	if missionpanel.GetGaugeProgress() >= 1
		if ecstasy >= 0.999
			SetEcstasy(1.1)
		if nextcp != null
			ClearAllSubs()
			thread.Goto(nextcp)


mpProgressST_listenerST_listener:
	if text0 != null
