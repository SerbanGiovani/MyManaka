chatClicked_listener:
	choice = chat.Clicked()
	if choice != null
		if choice == 0
			chat.Add(text1,"Right")
			chat.SetButtons()
			subtitle.Clear()
			thread.Goto(nextcp)
		elseif choice == 1
			chat.Add(text2,"Right")
			chat.SetButtons()
			subtitle.Clear()
			thread.Goto(nextcp2)
		elseif choice == 2
			chat.Add(text3,"Right")
			chat.SetButtons()
			subtitle.Clear()
			thread.Goto(nextcp3)
		elseif choice == 3
			chat.Add(text4,"Right")
			chat.SetButtons()
			subtitle.Clear()
