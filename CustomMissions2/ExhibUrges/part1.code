		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text="　[Hand the money] ")
		listener = CreateListenerLocal("int_listener",nextcp="cp55")
	
