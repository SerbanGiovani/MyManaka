		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp56")
	
