		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp43")
	
	################################################## MONEY ##################################################
	cp43:
		mp(text="Go take some money")
		area = CreateArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r)
		zone = CreateZone(area)
		condition = CreateCondition("[]")
		listener = CreateListenerLocal("basic_travellistener",lastzone=getZone(),nextcp="cp44")
	
	cp44:
		subtitle.Add(text="*You almost bend over to grab the money and leave the pizzas, then stop.*")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp45")
	
	cp45:
		subtitleMind.Add(text="(Wait, I'm just wearing this small bathrobe... If I bend over, I'll treat him with a full view of...)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp46")
	
	cp46:
		subtitleMind.Add(text="(I can feel Mei's stare boring holes in the back of my head. I bet that's exactly what she wants.)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp47")
	
	cp47:
		subtitleMind.Add(text="(Damn it, I have a feeling that... it's also what I want. I feel like doing something stupid.)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp48")
	
	cp48:
		subtitleMind.Add(text="(Screw this, let's treat him before I change my mind)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp49")
	
	cp49:
