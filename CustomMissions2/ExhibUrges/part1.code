part1 = CreateThread("part1")

part1:
	thread = _this
	
	missionpanel = CreateMissionPanel()
	mp:
		if text == null
			missionpanel.SetVisible(false)
		else
			missionpanel.SetVisible(true)
			missionpanel.SetText(text)
		if progress == null
			missionpanel.SetGaugeVisible(false)
		else
			missionpanel.SetGaugeVisible(true)
			missionpanel.GetGaugeProgress(progress)
		if rp == null
			rp = ""
		else
			missionpanel.SetRPText(rp)
	
	cameraClick = CreateAudio("sound\\camera.ogg")
	showerFlow = CreateAudio("sound\\shower.ogg")
	doorKnock = CreateAudio("sound\\knock.ogg")
	clothesDrop = CreateAudio("sound\\drop.ogg")
	
	mei = null
	meiListener = null
	deliv = null
	
	zDoorFront = CreateList(x=-241.7,y=3.2,z=-58.6,r=0.5)
	zMeiSpawn = CreateList(x=-249.1,y=6.26,z=-56.3,r=0.5)
	zDoorBack = CreateList(x=-243.5,y=3.26,z=-58.6,r=0.5)
	zDoorBack2 = CreateList(x=-244.3,y=3.32,z=-58.7,r=0.5)
	zShower = CreateList(x=-245.3,y=6.26,z=-59.7,r=0.5)
	zShowerMei = CreateList(x=-245.2,y=6.26,z=-57.7,r=0.5)
	zBathrobe = CreateList(x=-243.4,y=6.26,z=-59.4,r=0.5)
	zBalcony = CreateList(x=-247.7,y=6.30,z=-52.1,r=0.5)
	zBalconyMei = CreateList(x=-246.7,y=6.26,z=-53.6,r=0.5)
	zBalconyMei2 = CreateList(x=-248.8,y=6.30,z=-52.1,r=0.5)
	zMeiSpot = CreateList(x=-243.1,y=3.32,z=-55,r=0.5)
	zBendOver = CreateList(x=-246.9,y=3.32,z=-57.8,r=0.5)
	
	cp1:
		CanGameOver(false)
		UnequipAllCosplay()
		EquipCosplay("m_cosplay_general_upper_race_pants","m_cosplay_general_leg_stocking","m_cosplay_suit_chic_shirt","m_cosplay_suit_chic_jacket","m_cosplay_suit_chic_skirt","m_cosplay_suit_chic_shoes")
		DropItem(itemtype="Coat", stage="Apart",x=3.4,y=0,z=2.5)
		SetStage("StationFront",daytime=false)
		
		listener = CreateListenerLocal("wait_listener",duration=1,nextcp="cp2")
		#listener = CreateListenerLocal("wait_listener",duration=1,nextcp="test")
	
	test:
		SetPlayerPosition(position=Vector(zShowerMei.x,zShowerMei.y,zShowerMei.z))
		thread.Goto("cp24")
	
	cp2:
		#SetPlayerPosition(position=Vector(zDoorFront.x,zDoorFront.y,zDoorFront.z))
		
		mei = CreateMei(position=Vector(zMeiSpawn.x, zMeiSpawn.y, zMeiSpawn.z), rotation=Quaternion(0, 0.69, 0, 0.72))
		mp(text="Go knock on Mei's door")
		area = CreateArea(type="sphere",stage="StationFront",x=zDoorFront.x,y=zDoorFront.y,z=zDoorFront.z,r=zDoorFront.r)
		zone = CreateZone(area)
		condition = CreateCondition("[]")
		listener = CreateListenerLocal("basic_travellistener",lastzone=getZone(),nextcp="cp3")
	
	cp3:
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorFront.x,y=zDoorFront.y,z=zDoorFront.z,r=zDoorFront.r, text="　[Knock] ")
		listener = CreateListenerLocal("int_listener",nextcp="cp4")
	
	cp4:
		doorKnock.Play()
		subtitle.Add(text="*Knock knock*", delay=0, fadein=0.2, duration=2, fadeout=0.5)
		listener = CreateListenerLocal("wait_listener",duration=2,nextcp="cp5")
	
	cp5:
		subtitleMei.Add(text="\"Coming right up!\"", duration=3)
		MoveNPC(npc=mei, coord=Vector(zDoorBack.x, zDoorBack.y, zDoorBack.z), rotation=Quaternion(0, 0.69, 0, 0.72), thread=thread, nextcp="cp6")
	
	cp6:
		subtitleMei.Add(text="\"Here you are! Come in!\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorFront.x,y=zDoorFront.y,z=zDoorFront.z,r=zDoorFront.r, text="　[Get in] ")
		listener = CreateListenerLocal("int_listener",nextcp="cp7")
	
	cp7:
		PlaySoundEffect("OpenDoor")
		ShowBlackscreen(fadein=0.3, duration=0.4, fadeout=0.3)
		listener = CreateListenerLocal("wait_listener",duration=0.5,nextcp="cp8")
	
	cp8:
		mei.Warp(position=Vector(zDoorBack2.x,zDoorBack2.y,zDoorBack2.z))
		#MoveNPC(npc=mei, coord=Vector(zDoorBack2.x, zDoorBack2.y, zDoorBack2.z), rotation=Quaternion(0, 0.69, 0, 0.72))
		MoveNPC(npc=mei, coord=Vector(zDoorBack2.x, zDoorBack2.y, zDoorBack2.z))
		SetPlayerPosition(position=Vector(zDoorBack.x,zDoorBack.y,zDoorBack.z))
		listener = CreateListenerLocal("wait_listener",duration=0.5,nextcp="cp9")
	
	cp9:
		subtitleMei.Add(text="\"Welcome to my home! Please pretend the furniture isn't invisible...\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp10")
	
	cp10:
		subtitle.Add(text="\"Yeah, it's weirdly common in this neighborhood... So, what should we do until pizza gets here?\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp11")
	
	cp11:
		subtitleMei.Add(text="\"I was thinking of having you try out my shower. It has pressure jets and everything!\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp12")
	
	cp12:
		subtitle.Add(text="\"More like you were thinking of getting me to undress by any means necessary...\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp13")
	
	cp13:
		subtitleMei.Add(text="\"...\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp14")
	
	cp14:
		subtitleMei.Add(text="\"Is it working?\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp15")
	
	cp15:
		subtitleMind.Add(text="(Damn, I'm getting curious about that shower...)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp16")
	
	cp16:
		subtitle.Add(text="\"A little...\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp17")
	
	cp17:
		subtitleMei.Add(text="\"Awesome! Come on, I'll show you around!\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp18")
	
	cp18:
		mp(text="Follow Mei")
		MoveNPC(npc=mei, coord=Vector(zShowerMei.x, zShowerMei.y, zShowerMei.z), rotation=Quaternion(0, 0.99, 0, 0.01), thread=thread, nextcp="cp19")
	
	################################################## SHOWER ##################################################
	cp19:
		subtitleMei.Add(text="\"Here it is! Isn't it a beauty?\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp20")
	
	cp20:
		subtitle.Add(text="\"The shower head does look like it has a ton of settings...\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp21")
	
	cp21:
		subtitleMei.Add(text="\"Go on, I'll let you try it.\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp22")
	
	cp22:
		subtitle.Add(text="\"What, right now?\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp23")
	
	cp23:
		subtitleMei.Add(text="\"Of course! I'll order pizza while you shower, so don't take too long!\"")
		mei.Smartphone(true)
		MoveNPC(npc=mei, coord=Vector(zBalconyMei.x, zBalconyMei.y, zBalconyMei.z), rotation=Quaternion(0, 0.63, 0, 0.78))
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp24")
	
	cp24:
		subtitleMind.Add(text="(Well, might as well do it...)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShowerMei.x,y=zShowerMei.y,z=zShowerMei.z,r=1, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp25")
	
	cp25:
		mp(text="Go undress in the shower")
		area = CreateArea(type="sphere",stage="StationFront",x=zShower.x,y=zShower.y,z=zShower.z,r=zShower.r)
		zone = CreateZone(area)
		condition = CreateCondition("[!Cosplay_m_cosplay_general_upper_race_pants,!Cosplay_m_cosplay_suit_chic_shirt,!Cosplay_m_cosplay_suit_chic_jacket,!Cosplay_m_cosplay_suit_chic_skirt,!Cosplay_m_cosplay_general_leg_stocking,!Cosplay_m_cosplay_suit_chic_shoes]")
		listener = CreateListenerLocal("basic_listener",lastzone=getZone(),nextcp="cp26")
	
	cp26:
		showerFlow.Play()
		ShowBlackscreen(fadein=1, duration=2, fadeout=1)
		listener = CreateListenerLocal("wait_listener",duration=2,nextcp="cp27")
	
	cp27:
		DropItem(itemtype="Coat", stage="StationFront",x=zBathrobe.x,y=zBathrobe.y,z=zBathrobe.z)
		mei.Smartphone(false)
		mei.Warp(position=Vector(zMeiSpot.x,zMeiSpot.y,zMeiSpot.z), rotation=Quaternion(0, 0.99, 0, -0.16))
		#MoveNPC(npc=mei, coord=Vector(zMeiSpot.x, zMeiSpot.y, zMeiSpot.z), rotation=Quaternion(0, 0.99, 0, -0.16))
		MoveNPC(npc=mei, coord=Vector(zMeiSpot.x, zMeiSpot.y, zMeiSpot.z))
		listener = CreateListenerLocal("wait_listener",duration=0.5,nextcp="cp28")
	
	cp28:
		subtitleMind.Add(text="(I have to admit, that high tech shower was great.)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zShower.x,y=zShower.y,z=zShower.z,r=zShower.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp29")
	
	cp29:
		mp(text="Wear the bathrobe Mei prepared for you")
		area = CreateArea(type="sphere",stage="StationFront",x=zBathrobe.x,y=zBathrobe.y,z=zBathrobe.z,r=50)
		zone = CreateZone(area)
		condition = CreateCondition("[!CoatDropped,!Exposed_Front,!Exposed_Hip]")
		listener = CreateListenerLocal("basic_listener",nextcp="cp30")

	################################################## DELIVERY ##################################################
	cp30:
		deliv = CreateNPC("NewMale", position=Vector(zDoorFront.x, zDoorFront.y, zDoorFront.z), rotation=Quaternion(0, -0.70, 0, 0.71), body=4, face=2, hair=4)
		MoveNPC(npc=deliv, coord=Vector(zDoorFront.x, zDoorFront.y, zDoorFront.z))
		deliv.Smartphone(false)
		deliv.Headset(false)
		deliv.Glasses(false)
		
		doorKnock.Play()
		subtitle.Add(text="*Knock knock*", delay=0, fadein=0.2, duration=2, fadeout=0.5)
		listener = CreateListenerLocal("wait_listener",duration=2,nextcp="cp31")
	
	cp31:
		subtitleMei.Add(text="\"Manaka! Get the door, it's the pizza!\"")
		intArea = CreateInteractArea(type="sphere", stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y-0.02, z=_state.Position.z, r=10, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp32")
	
	cp32:
		subtitle.Add(text="\"What? What about you?\"")
		intArea = CreateInteractArea(type="sphere", stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y-0.02, z=_state.Position.z, r=10, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp33")
	
	cp33:
		subtitleMei.Add(text="\"I'm, er... No time to explain, go open the door! I left money on the stool in the corner\"")
		intArea = CreateInteractArea(type="sphere", stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y-0.02, z=_state.Position.z, r=10, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp34")
	
	cp34:
		subtitleMind.Add(text="(Riiight...)")
		intArea = CreateInteractArea(type="sphere", stage=_state.Position.stage, x=_state.Position.x, y=_state.Position.y-0.02, z=_state.Position.z, r=10, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp35")
	
	cp35:
		mp(text="Go open the door")
		area = CreateArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=zDoorBack.r)
		zone = CreateZone(area)
		condition = CreateCondition("[!CoatDropped,!Exposed_Front,!Exposed_Hip]")
		listener = CreateListenerLocal("basic_travellistener",lastzone=getZone(),nextcp="cp36")
	
	cp36:
		subtitleMind.Add(text="(Of course she's here to watch the action... Well, here goes nothing...)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack.x,y=zDoorBack.y,z=zDoorBack.z,r=1, text="　[Open the door] ")
		listener = CreateListenerLocal("int_listener",nextcp="cp37")
	
	cp37:
		PlaySoundEffect("OpenDoor")
		ShowBlackscreen(fadein=0.3, duration=0.4, fadeout=0.3)
		listener = CreateListenerLocal("wait_listener",duration=0.5,nextcp="cp38")
	
	cp38:
		deliv.Warp(position=Vector(zDoorBack.x,zDoorBack.y,zDoorBack.z))
		#MoveNPC(npc=mei, coord=Vector(zDoorBack.x, zDoorBack.y, zDoorBack.z), rotation=Quaternion(0, 0.70, 0, 0.71))
		MoveNPC(npc=deliv, coord=Vector(zDoorBack.x, zDoorBack.y, zDoorBack.z))
		SetPlayerPosition(position=Vector(zDoorBack2.x,zDoorBack2.y,zDoorBack2.z))
		listener = CreateListenerLocal("wait_listener",duration=0.5,nextcp="cp39")
	
	cp39:
		subtitle.Add(text="\"Hum, hi... Sorry about the clothes, I'm just out of the shower.\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp40")
	
	cp40:
		subtitleDeliv.Add(text="\"Oh... No problem, miss. No problem at all.\"")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp41")
	
	cp41:
		subtitleMind.Add(text="(He doesn't look like he's buying it... Can't blame him though.)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r, text=" [Take the pizzas] ")
		listener = CreateListenerLocal("int_listener",nextcp="cp42")
	
	cp42:
