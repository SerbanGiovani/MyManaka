		subtitleMind.Add(text="(I'm a bit scared to look, but just from the sound he made, it looks like he enjoyed it.)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp51")
	
	cp51:
		deliv.Respawn(position=Vector(zDoorBack.x,zDoorBack.y,zDoorBack.z))
		#MoveNPC(npc=mei, coord=Vector(zDoorBack.x, zDoorBack.y, zDoorBack.z), rotation=Quaternion(0, 0.70, 0, 0.71))
		MoveNPC(npc=deliv, coord=Vector(zDoorBack.x, zDoorBack.y, zDoorBack.z))
		subtitle.Add(text="(And now I'm getting hit full blast with the post-action embarrassment... Why did I do that?)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp52")
	
	cp52:
		subtitleMind.Add(text="(I have to go back give the money before it becomes even more awkward...)")
		intArea = CreateInteractArea(type="sphere",stage="StationFront",x=zBendOver.x,y=zBendOver.y,z=zBendOver.z,r=zBendOver.r, text="　next ▼")
		listener = CreateListenerLocal("int_listener",nextcp="cp53")
	
	cp53:
		mp(text="Go give the delivery boy his money")
		area = CreateArea(type="sphere",stage="StationFront",x=zDoorBack2.x,y=zDoorBack2.y,z=zDoorBack2.z,r=zDoorBack2.r)
