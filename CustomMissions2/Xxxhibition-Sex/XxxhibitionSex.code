		load_save()
		# might need to move setups to here to reset values on restart(first_time, duration, duration2)
		# NPC Area
		exposedFrontNPCAreaSexListener = CreateListenerLocal("basic_listener", condition=exposedFrontNPCAreaSexCondition, msg="Have sex while flashing your front in a place where people pass by", RP=30, RPsec=1, mission="exposedFrontNPCAreaSex")
