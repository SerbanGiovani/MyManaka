		load_individual: #(name)
			MissionMenuItem[name].SetMark(save[name].marked)
			MissionMenuItem[name].SetClears(save[name].clears)
			MissionMenuItem[name].SetMaxRP(save[name].maxrp)
			if (save[name].maxrp > 1.5) # White
				MissionMenuItem[name].SetBackgroundColor(Color(1.000, 1.000, 1.000, 1.000), Color(0.358, 0.358, 0.358, 1.000))
			elseif (save[name].maxrp > 2) # Green
				MissionMenuItem[name].SetBackgroundColor(Color(0.495, 1.000, 0.521, 1.000), Color(0.000, 0.434, 0.024, 1.000))
			elseif (save[name].maxrp > 2.5) # Blue
				MissionMenuItem[name].SetBackgroundColor(Color(0.429, 0.644, 1.000, 1.000), Color(0.000, 0.379, 1.000, 1.000))
			elseif (save[name].maxrp > 3) # Purple
				MissionMenuItem[name].SetBackgroundColor(Color(0.788, 0.458, 1.000, 1.000), Color(0.607, 0.000, 1.000, 1.000))
			elseif (save[name].maxrp > 3.5) # Gold
				MissionMenuItem[name].SetBackgroundColor(Color(1.000, 0.751, 0.325, 1.000), Color(0.604, 0.378, 0.000, 1.000))
			elseif (save[name].maxrp > 4) # Red
				MissionMenuItem[name].SetBackgroundColor(Color(1.000, 0.306, 0.306, 1.000), Color(0.651, 0.000, 0.000, 1.000))

		save_individual: #(mission, marked, clears, maxrp)
			if (marked != null)
