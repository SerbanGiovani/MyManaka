		basic_listener: #(condition, msg, RP, RPsec, mission)
			if (condition.Check() && (first_time[mission] != 1))
				MissionPanel[mission].SetText(msg)
				MissionPanel[mission].SetRPText(Format("{0}RP", RP))
				MissionPanel[mission].SetVisible(true)
				MissionPanel[mission].SetGaugeVisible(true)
				AddCurrentEarnRP(RPsec * _timediff)
				duration[mission] += _timediff # add duration with time
				MissionPanel[mission].SetGaugeProgress(duration[mission]/max_duration[mission])
				if (duration[mission] >= max_duration[mission])
					first_time[mission] = 1
					PlaySoundEffect("UICompleteMission")
					AddCurrentEarnRP(RP)
					MissionMenuItem[mission].SetCleared(true)
					MissionMenuItem[mission].SetMark(true)
					MissionPanel[mission].SetVisible(false)
					MissionPanel[mission].SetGaugeVisible(false)
				if (_state.RpBonus > save[mission].maxrp) #save_individual(mission, marked, clears, maxrp)
					save[mission].runrp = _state.RpBonus

			elseif (condition.Check() && (first_time[mission] == 1))
				MissionPanel[mission].SetVisible(true)
				MissionPanel[mission].SetText(msg)
				MissionPanel[mission].SetRPText(Format("{0}RP/sec", RPsec))
				MissionPanel[mission].SetGaugeVisible(false)
				AddCurrentEarnRP(RPsec * _timediff)
				if (_state.RpBonus > save[mission].maxrp) 
					save[mission].runrp = _state.RpBonus

			else
				MissionPanel[mission].SetVisible(false)
				MissionPanel[mission].SetGaugeVisible(false)
				if (_state.Skills.ContinueMission)
					duration[mission] = 0
				else
					duration[mission] = duration[mission]
			if (_stagechanged)
				duration[mission] = 0
			if (_stagechanged && _state.Position.stage == "Apart")
				if MissionMenuItem[mission].GetCleared()
					MissionMenuItem[mission].SetCleared(false)
					first_time[mission] = 0
					clears = save[mission].clears + 1
					save_individual(mission=mission, marked=true, clears=clears, maxrp=save[mission].runrp) #save_individual(mission, marked, clears, maxrp)
					thread.Goto("exhibition_mission")
				else
					thread.Goto("exhibition_mission")

