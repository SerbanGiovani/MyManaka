	messenger:
		thread = _this

		chat = CreateMessengerChat("Exhibition Sex", iconcolor = Color(245, 40, 145), icontext = "ExS", icontextcolor = Color(0, 0, 0))

		thread.Goto("step1")

		step1:
			if exhibition_sex_options.is_male
				chat.Add("Hey did you want me to come over, baby?", "Left", user="Daddy", silent=true)
			else
				chat.Add("Hey did you want me to come over, sugar?", "Left", user="Mommy", silent=true)

	exhibition_mission:
		thread = _this
