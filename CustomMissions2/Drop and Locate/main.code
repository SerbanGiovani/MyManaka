dalHud = CreateText()
dalHud.SetSize(24)
dalHud.SetAnchor(0.005, 0.96)
dalHud.SetAlignment("TopLeft")
dalHud.SetWidth(1200)
dalHud.SetFace(color=Color(0.0, 0.9, 0.9, 1), dilate=0.3)
dalHud.SetOutline(color=Color(0.02, 0.02, 0.02, 1), width=0.3)
dalHud.SetFrontLayer(true)

dalCoatHeldCondition = CreateCondition("[!CoatDropped]")
dalKeyHeldCondition = CreateCondition("[Item_HandcuffKey]")
dalRemoteHeldCondition = CreateCondition("[Item_VibeRemocon]")

dalLastX = 0.005
dalLastY = 0.96
dalLastSize = 24
dalLastTransparency = 1
dalRefreshTimer = 0
dalLastHudText = ""
dalLastStage = ""
dalLastItemSignature = ""
dalCachedCoatPos = null
dalCachedKeyPos = null
dalCachedRemotePos = null
dalLastDroppedCount = -1
dalLastVibeDroppedCount = -1
dalLastDroppedSummary = ""
dalPlaceKeyInput = null
dalPlaceRemoteInput = null
dalPlacePistonRemoteInput = null
dalPlaceModifierInput = null

if _save.pendingDrop == null
	_save.pendingDrop = false
if _save.pendingType == null
	_save.pendingType = ""
if _save.pendingStage == null
	_save.pendingStage = "Apart"
if _save.pendingX == null
	_save.pendingX = 0
if _save.pendingY == null
	_save.pendingY = 0
if _save.pendingZ == null
	_save.pendingZ = 0
if _save.pendingTime == null
	_save.pendingTime = 0
if _save.pistonRemoteOwned == null
	_save.pistonRemoteOwned = true
if _save.pistonRemoteDropped == null
	_save.pistonRemoteDropped = false
if _save.pistonRemoteStage == null
	_save.pistonRemoteStage = "Apart"
if _save.pistonRemoteX == null
	_save.pistonRemoteX = 3.4
if _save.pistonRemoteY == null
	_save.pistonRemoteY = 0
if _save.pistonRemoteZ == null
	_save.pistonRemoteZ = 2.5
if _save.pistonRemotePendingDrop == null
	_save.pistonRemotePendingDrop = false
if _save.pistonRemotePendingTime == null
	_save.pistonRemotePendingTime = 0
if _save.pistonRemoteDropTime == null
	_save.pistonRemoteDropTime = 0

DropAndLocateThread = CreateThread("main")

main:
	__dalSetupInputs()
	listenDropAndLocate = CreateListener("update")

update:
	if _settings.enabled && _state != null && _state.Position != null
		__dalHandleManualDrop()
		__dalProcessPendingDrop()
		__dalProcessPistonRemote()
		__dalRefreshItemCacheIfNeeded()
		__dalDebugDroppedItems()
		__dalApplyHudSettings()
		if _settings.show_hud
			hudText = __dalHudText()
			dalHud.Clear()
			dalHud.Add(text=hudText)
			dalLastHudText = hudText
		else
			dalHud.Clear()
			dalLastHudText = ""
	else
		if dalHud != null
			dalHud.Clear()
			dalLastHudText = ""

__dalSetupInputs:
	keyKey = "K"
	remoteKey = "V"
	pistonRemoteKey = "P"
	modifierKey = "shift"
	if _settings.place_key_key != null
		keyKey = _settings.place_key_key
	if _settings.place_remote_key != null
		remoteKey = _settings.place_remote_key
	if _settings.place_piston_remote_key != null
		pistonRemoteKey = _settings.place_piston_remote_key
	if _settings.place_modifier_key != null
		modifierKey = _settings.place_modifier_key
	if keyKey == "k"
		keyKey = "K"
	if remoteKey == "v"
		remoteKey = "V"
	if pistonRemoteKey == "p"
		pistonRemoteKey = "P"
	dalPlaceKeyInput = CreateInput("<Keyboard>/"+keyKey)
	dalPlaceRemoteInput = CreateInput("<Keyboard>/"+remoteKey)
	dalPlacePistonRemoteInput = CreateInput("<Keyboard>/"+pistonRemoteKey)
	if modifierKey != ""
		dalPlaceModifierInput = CreateInput("<Keyboard>/"+modifierKey)

__dalHandleManualDrop:
	enabled = true
	if _settings.place_enabled != null
		enabled = _settings.place_enabled
	if enabled && __dalModifierHeld()
		if dalPlaceKeyInput != null && dalPlaceKeyInput.WasPressed()
			__dalDropKey()
		if dalPlaceRemoteInput != null && dalPlaceRemoteInput.WasPressed()
			__dalDropRemote()
		if dalPlacePistonRemoteInput != null && dalPlacePistonRemoteInput.WasPressed()
			__dalDropPistonRemote()

__dalModifierHeld:
	if dalPlaceModifierInput == null
		_result = true
	else
		_result = dalPlaceModifierInput.IsPressed()

__dalDropKey:
	if __dalIsHeld("HandcuffKey")
		pos = __dalDropPositionKey()
		__dalQueueDrop("HandcuffKey", pos)
		_result = true
	else
		_result = false

__dalDropRemote:
	if __dalIsHeld("VibeRemocon")
		pos = __dalDropPosition()
		__dalQueueDrop("VibeRemocon", pos)
		_result = true
	else
		_result = false

__dalDropPistonRemote:
	if _save.pistonRemoteOwned
		pos = __dalDropPosition()
		__dalQueuePistonRemoteDrop(pos)
		_result = true
	else
		_result = false

__dalQueueDrop:
	pos = _args[1]
	SetAction("PickUpItem")
	_save.pendingDrop = true
	_save.pendingType = _args[0]
	_save.pendingStage = pos.stage
	_save.pendingX = pos.x
	_save.pendingY = pos.y
	_save.pendingZ = pos.z
	_save.pendingTime = _time

__dalProcessPendingDrop:
	if _save.pendingDrop && _time > _save.pendingTime + 0.25
		if _save.pendingType == "HandcuffKey"
			dropResult = DropItem(itemtype="HandcuffKey", stage=_save.pendingStage, x=_save.pendingX, y=_save.pendingY, z=_save.pendingZ, compass=false)
			if dropResult != null
				_save.pendingDrop = false
		elseif _save.pendingType == "VibeRemocon"
			dropResult = DropItem(itemtype="VibeRemocon", stage=_save.pendingStage, x=_save.pendingX, y=_save.pendingY, z=_save.pendingZ, compass=false)
			if dropResult != null
				_save.pendingDrop = false

__dalQueuePistonRemoteDrop:
	pos = _args[0]
	SetAction("PickUpItem")
	_save.pistonRemoteOwned = false
	_save.pistonRemoteDropped = false
	_save.pistonRemoteStage = pos.stage
	_save.pistonRemoteX = pos.x
	_save.pistonRemoteY = pos.y
	_save.pistonRemoteZ = pos.z
	_save.pistonRemotePendingDrop = true
	_save.pistonRemotePendingTime = _time
	_save.pistonRemoteDropTime = _time

__dalProcessPistonRemote:
	if _save.pistonRemotePendingDrop && _time > _save.pistonRemotePendingTime + 0.25
		dropResult = DropItem(itemtype="VibeRemocon", stage=_save.pistonRemoteStage, x=_save.pistonRemoteX, y=_save.pistonRemoteY, z=_save.pistonRemoteZ, compass=false)
		if dropResult != null
			_save.pistonRemotePendingDrop = false
			_save.pistonRemoteDropped = true
			_save.pistonRemoteDropTime = _time
	if !_save.pistonRemoteOwned && _save.pistonRemoteDropped
		pos = __dalPistonRemotePosition()
		if _time > _save.pistonRemoteDropTime + 1 && __dalPlayerNear(pos, 4.0) && !__dalVibeRemoconAt(pos)
			SetAction("PickUpItem")
			_save.pistonRemoteOwned = true
			_save.pistonRemoteDropped = false

__dalDropPosition:
	p = _state.Position
	offset = 0.8
	if _settings.place_forward_offset != null
		offset = _settings.place_forward_offset
	fx = 0
	fz = 1
	if p.ry != null && p.rw != null
		fx = 2 * p.rw * p.ry
		fz = 1 - 2 * p.ry * p.ry
	_result = CreateList(stage=p.stage, x=p.x + fx * offset, y=p.y, z=p.z + fz * offset)

__dalDropPositionKey:
	p = _state.Position
	offset = 1.8
	if _settings.place_key_forward_offset != null
		offset = _settings.place_key_forward_offset
	fx = 0
	fz = 1
	if p.ry != null && p.rw != null
		fx = 2 * p.rw * p.ry
		fz = 1 - 2 * p.ry * p.ry
	_result = CreateList(stage=p.stage, x=p.x + fx * offset, y=p.y, z=p.z + fz * offset)

__dalApplyHudSettings:
	if _settings.x_position != dalLastX || _settings.y_position != dalLastY || _settings.text_size != dalLastSize || _settings.transparency != dalLastTransparency
		dalHud.Clear()
		dalHud = CreateText()
		dalHud.SetAlignment("TopLeft")
		dalHud.SetWidth(1200)
		dalHud.SetOutline(color=Color(0.02, 0.02, 0.02, 1), width=0.3)
		dalHud.SetFrontLayer(true)
		dalLastX = _settings.x_position
		dalLastY = _settings.y_position
		dalLastSize = _settings.text_size
		dalLastTransparency = _settings.transparency
	dalHud.SetAnchor(dalLastX, dalLastY)
	dalHud.SetSize(dalLastSize)
	dalHud.SetFace(color=Color(0.0, 0.9, 0.9, dalLastTransparency), dilate=0.3)

__dalHudText:
	p = _state.Position
	text = "Player: " + __dalStageName(p.stage) + __dalFormatPos(p)
	text = text + "\n" + __dalTrackedItemText("Coat", "Coat", "worn")
	text = text + "\n" + __dalTrackedItemText("Key", "HandcuffKey", "held")
	text = text + "\n" + __dalTrackedItemText("Remote", "VibeRemocon", "held")
	text = text + "\n" + __dalPistonRemoteText()
	_result = text

__dalTrackedItemText:
	label = _args[0]
	itemtype = _args[1]
	heldText = _args[2]
	if itemtype != "Coat" && __dalIsHeld(itemtype)
		p = _state.Position
		_result = label + ": " + __dalStageName(p.stage) + __dalFormatPos(p) + " d=0.00 " + heldText
	else
		groundText = __dalNearestItemText(label, itemtype)
		if groundText != null
			_result = groundText
		elseif itemtype == "Coat" && dalCoatHeldCondition.Check()
			p = _state.Position
			_result = label + ": " + __dalStageName(p.stage) + __dalFormatPos(p) + " d=0.00 " + heldText
		else
			_result = label + ": none"

__dalNearestItemText:
	label = _args[0]
	itemtype = _args[1]
	pos = null
	if itemtype == "Coat"
		pos = dalCachedCoatPos
	elseif itemtype == "HandcuffKey"
		pos = dalCachedKeyPos
	elseif itemtype == "VibeRemocon"
		pos = dalCachedRemotePos
	if pos != null
		_result = label + ": " + __dalStageName(pos.stage) + __dalFormatPos(pos) + __dalDistanceSuffix(pos)
	else
		_result = null

__dalRefreshItemCacheIfNeeded:
	stage = _state.Position.stage
	signature = __dalDroppedItemSignature()
	if stage != dalLastStage || signature != dalLastItemSignature
		dalLastStage = stage
		dalLastItemSignature = signature
		dalCachedCoatPos = __dalFindDroppedPosition("Coat")
		dalCachedKeyPos = __dalFindDroppedPosition("HandcuffKey")
		dalCachedRemotePos = __dalFindDroppedPosition("VibeRemocon")

__dalDroppedItemSignature:
	text = ""
	if _state.DroppedItems != null
		i = _state.DroppedItems.Count()
		while i > 0
			i -= 1
			item = _state.DroppedItems[i]
			if item != null
				pos = item.Position
				if pos != null
					text = text + Format("|{0}@{1}:{2:F2},{3:F2},{4:F2}", item.Type, pos.stage, pos.x, pos.y, pos.z)
	_result = text

__dalFindDroppedPosition:
	itemtype = _args[0]
	player = _state.Position
	best = null
	bestDist = 999999
	fallback = null
	if _state.DroppedItems != null
		i = _state.DroppedItems.Count()
		while i > 0
			i -= 1
			item = _state.DroppedItems[i]
			if item != null && item.Type == itemtype
				pos = item.Position
				if pos != null
					if itemtype != "VibeRemocon" || !__dalIsPistonRemotePos(pos)
						if fallback == null
							fallback = pos
						if pos.stage == player.stage
							dist = Vector3Distance(player, pos)
							if best == null || dist < bestDist
								best = pos
								bestDist = dist
	if best != null
		_result = CreateList(stage=best.stage, x=best.x, y=best.y, z=best.z)
	elseif fallback != null
		_result = CreateList(stage=fallback.stage, x=fallback.x, y=fallback.y, z=fallback.z)
	else
		_result = null

__dalPistonRemoteText:
	if _save.pistonRemoteOwned
		p = _state.Position
		_result = "Piston Remote: " + __dalStageName(p.stage) + __dalFormatPos(p) + " d=0.00 held"
	elseif _save.pistonRemoteDropped || _save.pistonRemotePendingDrop
		pos = __dalPistonRemotePosition()
		_result = "Piston Remote: " + __dalStageName(pos.stage) + __dalFormatPos(pos) + __dalDistanceSuffix(pos)
	else
		_result = "Piston Remote: none"

__dalPistonRemotePosition:
	_result = CreateList(stage=_save.pistonRemoteStage, x=_save.pistonRemoteX, y=_save.pistonRemoteY, z=_save.pistonRemoteZ)

__dalIsPistonRemotePos:
	pos = _args[0]
	target = __dalPistonRemotePosition()
	if pos != null && target != null && pos.stage == target.stage
		_result = Vector3Distance(pos, target) < 0.75
	else
		_result = false

__dalVibeRemoconAt:
	target = _args[0]
	_result = false
	if _state.DroppedItems != null
		i = _state.DroppedItems.Count()
		while i > 0 && !_result
			i -= 1
			item = _state.DroppedItems[i]
			if item.Type == "VibeRemocon"
				pos = item.Position
				if pos.stage == target.stage
					if Vector3Distance(pos, target) < 0.75
						_result = true

__dalPlayerNear:
	pos = _args[0]
	radius = _args[1]
	player = _state.Position
	if pos != null && player != null && pos.stage == player.stage
		_result = Vector3Distance(player, pos) < radius
	else
		_result = false

__dalDebugDroppedItems:
	enabled = true
	if _settings.debug_drop_log != null
		enabled = _settings.debug_drop_log
	if enabled
		count = 0
		vibeCount = 0
		summary = ""
		if _state.DroppedItems != null
			count = _state.DroppedItems.Count()
			i = count
			while i > 0
				i -= 1
				item = _state.DroppedItems[i]
				if item != null
					pos = item.Position
					if pos != null
						isPiston = false
						if item.Type == "VibeRemocon"
							vibeCount += 1
							isPiston = __dalIsPistonRemotePos(pos)
						if isPiston
							summary = summary + Format(" PistonRemote[VibeRemocon]@{0}({1:F2},{2:F2},{3:F2})", pos.stage, pos.x, pos.y, pos.z)
						else
							summary = summary + Format(" {0}@{1}({2:F2},{3:F2},{4:F2})", item.Type, pos.stage, pos.x, pos.y, pos.z)
		if count != dalLastDroppedCount || vibeCount != dalLastVibeDroppedCount || summary != dalLastDroppedSummary
			Log(Format("[Drop and Locate] DroppedItems count={0:0} vibe={1:0}", count, vibeCount) + summary)
			dalLastDroppedCount = count
			dalLastVibeDroppedCount = vibeCount
			dalLastDroppedSummary = summary

__dalDistanceSuffix:
	pos = _args[0]
	player = _state.Position
	if pos != null && player != null
		dist = Vector3Distance(player, pos)
		_result = Format(" d={0:F2}", dist)
	else
		_result = " d=--"

__dalIsHeld:
	itemtype = _args[0]
	if __dalItemCount(itemtype) > 0
		_result = true
	elseif itemtype == "HandcuffKey"
		_result = dalKeyHeldCondition.Check()
	elseif itemtype == "VibeRemocon"
		_result = dalRemoteHeldCondition.Check()
	else
		_result = false

__dalItemCount:
	itemtype = _args[0]
	if _state.Items != null && _state.Items[itemtype] != null
		_result = _state.Items[itemtype]
	else
		_result = 0

__dalFormatPos:
	pos = _args[0]
	_result = Format("({0:F3},{1:F3},{2:F3})", pos.x, pos.y, pos.z)

__dalStageName:
	stage = _args[0]
	if stage == "Apart"
		_result = "自宅"
	elseif stage == "Residence"
		_result = "住宅区"
	elseif stage == "Park"
		_result = "综合公园"
	elseif stage == "StationFront"
		_result = "繁华街"
	elseif stage == "Convenience"
		_result = "便利店"
	elseif stage == "Mansion"
		_result = "公寓前"
	elseif stage == "ShoppingMall"
		_result = "购物中心"
	elseif stage == "FashionShop"
		_result = "服装店"
	else
		_result = stage
