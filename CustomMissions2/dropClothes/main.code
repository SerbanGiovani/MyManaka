	item_names["m_cosplay_general_leg_stocking_race"] = "蕾丝丝袜"
	item_names["m_cosplay_general_leg_stocking_race_dark"] = "蕾丝丝袜（暗）"
	item_names["m_cosplay_general_leg_stocking_net"] = "网眼丝袜"
	item_names["m_cosplay_general_leg_stocking_net_thin"] = "细网眼丝袜"
