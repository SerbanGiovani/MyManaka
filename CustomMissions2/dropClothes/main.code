	item_names["m_cosplay_general_leg_stocking_net_dark_thin"] = "细网眼丝袜（暗）"
	item_names["m_cosplay_general_leg_stocking"] = "丝袜"
	item_names["m_cosplay_general_leg_stocking_stripe"] = "条纹丝袜"
